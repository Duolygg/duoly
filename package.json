{
  "name": "duoly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "astro dev",
    "stripe:listen": "stripe listen --forward-to localhost:4321/api/webhooks/stripe --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired",
    "check": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "astro build",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test:unit && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/vercel": "11.0.16",
    "@stripe/stripe-js": "10.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "oxc-transform-react": "0.145.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}

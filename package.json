{
  "name": "duoly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test && playwright test --config playwright.chat.config.ts && playwright test --config playwright.completion.config.ts && playwright test --config playwright.teammate.config.ts && playwright test --config playwright.analytics.config.ts && playwright test --config playwright.profiles.config.ts",
    "build": "astro build && node scripts/posthog-sourcemaps.mjs",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test:unit && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "7.1.4",
    "@astrojs/vercel": "11.0.20",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@stripe/stripe-js": "10.2.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/functions": "3.11.0",
    "astro": "7.4.7",
    "posthog-js": "1.447.3",
    "posthog-node": "5.63.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@posthog/cli": "0.19.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "oxc-transform-react": "0.157.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}

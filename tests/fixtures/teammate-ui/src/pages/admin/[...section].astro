---
// Isolated fictional browser fixture for admin screens, never a production route.
import SiteLayout from '../../../../../../src/layouts/SiteLayout.astro';
import AdminRoot from '../../../../../../src/components/admin/AdminRoot.jsx';
import { sectionFromPath } from '../../../../../../src/components/admin/AdminApp.jsx';
const admin = {
  id: '66666666-6666-4666-8666-666666666666',
  name: 'Fixture Admin',
  email: null,
  image: '/assets/avatars/avatar-1.png',
  country: 'at',
  role: 'admin' as const,
  provider: 'email' as const,
};
// ?access=restricted: an admin with the default sections; ?access=owner: an owner. Without it the
// dashboard shows everything, like before permissions (migration 20261105130000).
const mode = Astro.url.searchParams.get('access');
const access =
  mode === 'owner'
    ? { owner: true, sections: [] }
    : mode === 'restricted'
      ? {
          owner: false,
          sections: [
            'overview',
            'live',
            'priority',
            'performance',
            'teammates',
            'users',
            'support',
            'safety',
            'audit',
            'settings',
          ],
        }
      : undefined;
---

<SiteLayout title="Local admin fixture | Duoly" bare>
  <AdminRoot
    client:load
    admin={admin}
    owner={mode === 'owner'}
    access={access}
    csrf="fixture-csrf"
    section={sectionFromPath(Astro.url.pathname)}
    chatEnabled={false}
    reportsEnabled={false}
    stripeTest={false}
  />
</SiteLayout>

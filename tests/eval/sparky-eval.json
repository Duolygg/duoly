    {
      "id": "T09",
      "asker": "teammate",
      "topic": "priority",
      "question": "How many seconds earlier do Veteran teammates see high-value orders, and from what order value?",
      "expect": [["high[- ]value", "earlier", "first"]],
      "forbid": [
        "\\b15\\b",
        "\\b20 ?(€|eur)",
        "€ ?20\\b",
        "\\b10 ?(s|sec|secs|seconds)\\b"

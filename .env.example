# Approved public origin. No production credentials are needed for the design preview.
SITE_URL=
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Real account integration stays off until its providers and database are verified.
# Server-only values. Never prefix keys/secrets with PUBLIC_.
AUTH_ENABLED=false
AUTH_ORIGIN=http://localhost:4321
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_COOKIE_SECRET=
AUTH_GOOGLE_ENABLED=false
AUTH_DISCORD_ENABLED=false
AUTH_EMAIL_ENABLED=false
# Closed staging by default. Before SMTP tests, keep provider signups disabled too.
AUTH_ALLOW_SIGNUP=false
AUTH_TEST_EMAIL=sebastian.schrottenbach@gmail.com

# Transactional email through Resend (src/server/email). off | test | live.
# test redirects every send to EMAIL_TEST_RECIPIENT with a [TEST] subject. live needs owner approval.
EMAIL_MODE=off
RESEND_API_KEY=
EMAIL_FROM=Duoly <hello@duoly.gg>
EMAIL_REPLY_TO=
EMAIL_TEST_RECIPIENT=sebastian.schrottenbach@gmail.com
EMAIL_SITE_URL=https://duoly.gg
EMAIL_ASSET_ORIGIN=https://duoly.gg

# Inbound mail forwarding (src/pages/api/webhooks/resend.ts). Resend receives every duoly.gg
# address and posts email.received; the handler forwards to INBOUND_FORWARD_TO.
RESEND_INBOUND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_FORWARD_TO=duolygg@proton.me
INBOUND_FORWARD_FROM=Duoly Inbox <inbox@duoly.gg>

# Discord role sync for Teammate, Online and In Session (ledger #40). Off unless all are set.
# DISCORD_ROLES_TICK_SECRET must match Supabase Vault secret discord_roles_tick_secret (32+ chars).
DISCORD_ROLE_SYNC_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLES_TICK_SECRET=
# Order posts in the game channels (ledger #41); SILENT shows the Teammate mention without notifying.
DISCORD_ORDER_POSTS_ENABLED=false
DISCORD_ORDER_POSTS_SILENT=false

# Duoly PRO subscription (ledger #39, docs/product/pro.md). Off unless exactly true and payments are configured.
# STRIPE_PRO_PORTAL_CONFIG is the Customer Portal configuration (bpc_...) from scripts/stripe/setup-pro.mjs.
PRO_ENABLED=false
# Stripe Connect Express payouts for teammates (M9, docs/product/connect-payouts.md).
# Off by default: the manual payout rail is unchanged. Test keys only for now.
CONNECT_PAYOUTS_ENABLED=false
# eur (default, from the EUR platform balance at the ECB rate) or usd (needs a USD balance).
CONNECT_TRANSFER_CURRENCY=eur
# Signing secret of the separate Connect webhook endpoint /api/webhooks/stripe-connect.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRO_PORTAL_CONFIG=

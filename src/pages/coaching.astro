---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Steps from '../components/seo/Steps.astro';
import Topics from '../components/seo/Topics.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/directory.css';
import { pageViewer } from '../site/viewer';
import { viewerCurrency } from '../server/currency';
import { eurToUsd } from '../server/fx';
import { coachingDirectory, directoryPrice } from '../server/seo/directories';
import { CATALOG_PRICES_UPDATED_LABEL } from '../site/price-dates';
import { faqSchema } from '../server/seo/offers';
import {
  serializeJsonLd,
  bookingHref,
  CONTENT_DATES,
  organizationSchema,
  REPORT_PATH,
} from '../site/seo';
import { HOURLY_COACHING } from '../server/seo/price-report';
import { SURVEY_CHECKED_LABEL } from '../content/price-report-2026';
const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
const games = coachingDirectory({
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
});
const price = directoryPrice(games);
const path = '/coaching';
const title = 'Esports Coaching: Book a Gaming Coach | Duoly';
const h1 = 'Esports coaching: book a gaming coach by game';
const dedicated = games.filter((game) => game.dedicated);
const faqItems: [string, string][] = [
  [
    'What is esports coaching?',
    'Esports coaching is a paid lesson with a higher-ranked player of the same game, built around one goal you name before the session starts.',
  ],
  [
    'How much does a gaming coach cost on Duoly?',
    `Every lesson costs ${price.replace(/^From /, '')}, in all ${games.length} games, at every rank. Bundles and quantity discounts do not apply to coaching, so a second hour costs the same as the first.`,
  ],
  [
    'Do I need a recording for my first lesson?',
    'Only for a review format: VOD Review, Demo Review or Replay Review. For example, live Play and Learn needs no recording at all.',
  ],
  [
    'Does a coach play on my account?',
    'No. Every lesson runs on your own account, and your coach joins from a separate one, with Discord carrying the voice and the screen share. Nobody on Duoly ever needs your password.',
  ],
  [
    'What is the difference between a coach and a teammate?',
    'A coach spends the session on a stated learning goal and a review. A teammate is shared playing time, priced per game or per hour.',
  ],
  [
    'Which games have a dedicated coaching page?',
    `${dedicated.length} of the ${games.length} games below. The rest sell the same lessons from their game hub, at the same ${price.replace(/^From /, '')}.`,
  ],
];
const article = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: h1,
  url: new URL(path, Astro.site!).href,
  description: `Book an esports coach in ${games.length} games on Duoly. Compare lessons, prices and formats, then book the game you play.`,
  dateModified: CONTENT_DATES[path],
  isPartOf: { '@id': new URL('/#website', Astro.site!).href },
  publisher: organizationSchema(Astro.site!),
};
---

<SiteLayout
  title={title}
  description={`Esports coaching from ${price.replace(/^From /, '').toLowerCase()} on Duoly, in ${games.length} games. Compare live lessons, replay reviews and drill hours, then book a gaming coach.`}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Coaching', path },
      ]}
    />
    <SeoHero
      eyebrow="Esports coaching"
      h1={h1}
      lead={`Book a gaming coach in ${games.length} games. Choose a live lesson, a review of your own recording or a focused hour on one skill, then meet your coach on Discord.`}
      price={price}
      cta={{ href: '#games-h', label: 'Browse coaching by game' }}
      secondary={{ href: '#prices-h', label: 'See what a lesson costs' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        {
          src: '/assets/games/counter-strike-2.png',
          alt: 'Counter-Strike 2 game art',
        },
      ]}
      facts={[
        'Checked by Duoly before any order',
        'One flat price in every game',
        'Live lessons, reviews and drill hours',
        'Your own account, voice on Discord',
      ]}
      note={`Coaching prices as of ${CATALOG_PRICES_UPDATED_LABEL}.`}
    />
    <section aria-labelledby="what-h">
      <h2 id="what-h">What is esports coaching?</h2>
      <p>
        Esports coaching is a paid lesson with a higher-ranked player of your
        own game, built around one goal you name before the session starts.
        Duoly sells it in three shapes. Play and Learn puts the coach in the
        match beside you, explaining each decision out loud. A review hour
        pauses a recording of your own game and rebuilds the round with you. A
        drill hour works on one skill only: aim, utility, movement or a
        rotation.
      </p>
      <p>
        A lesson pays for the explanation. A teammate booking pays for the
        playing time you share. So if you win your fights and still lose games,
        the honest answer is a review hour rather than another duo. Every lesson
        costs {price}, whichever of the {games.length} games you play, it runs
        on your own account, and it uses Discord for voice and screen share.
      </p>
    </section>
    <section aria-labelledby="prices-h">
      <h2 id="prices-h">How much does a gaming coach cost?</h2>
      <p class="section-intro">
        A gaming coach on Duoly is {price}, whichever game you play and whatever
        rank you hold. What changes is the unit. Play and Learn is sold per game
        in titles where a match has a fixed length, and by the hour in battle
        royale, extraction and sandbox games where it does not. Review and drill
        lessons are always hourly, because an hour is what buys the pauses and
        rewinds a live match cannot give you.
      </p>
      <p class="section-intro">
        Nothing is added at checkout, and coaching takes no bundle or quantity
        discount, so a second hour costs {price.replace(/^From /, '')} like the
        first. A dollar total follows the daily European Central Bank rate plus
        1%. For a sense of the wider market, our{' '}
        <a href={REPORT_PATH}>2026 gaming coaching and teammate price survey</a>{' '}
        put the median coaching hour at {HOURLY_COACHING.median} across{' '}
        {HOURLY_COACHING.count} rates read on {SURVEY_CHECKED_LABEL}.
      </p>
    </section>
    <section aria-labelledby="games-h">
      <h2 id="games-h">Which game do you want coaching for?</h2>
      <p class="section-intro">
        Pick your game below and the card names the lessons that game really
        sells. The names differ because the games do: a VOD Review in Valorant,
        a Demo Review in Counter-Strike 2, a Replay Review in Dota 2, and in
        Minecraft no review at all, just PvP Coaching and Bedwars Coaching. The
        price does not differ. All of it is {price.replace(/^From /, '')}.
      </p>
      <p class="section-intro">
        {dedicated.length} of the {games.length} games have a coaching page of
        their own, with a worked lesson and a list of what to bring. The rest
        book from their game hub. Press Book on a card and checkout opens on the
        coaching tab for that game, which is where you name the goal before a
        coach takes the order.
      </p>
      <div class="directory-grid">
        {games.map((game) => (
          <article class="card directory-card">
            <img
              src={game.img}
              alt={`${game.name} game art`}
              width="44"
              height="44"
              loading="lazy"
              decoding="async"
            />
            <strong class="directory-name">{game.name}</strong>
            <span class="directory-list">{game.titles.join(', ')}</span>
            <span class="directory-price">
              <span class="money">{game.cheapest.display}</span> /{' '}
              {game.cheapest.unit}
            </span>
            <div class="directory-links">
              <a
                class="btn-sm"
                href={bookingHref(game.id, { tab: 'training' })}
              >
                Book
              </a>
              <a href={game.path}>
                {game.dedicated
                  ? `${game.name} coaching guide`
                  : `${game.name} hub`}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <Steps
      heading="How do you book a gaming coach?"
      steps={[
        `Pick the game and the format: a live lesson, a review of a recording of your own, or a drill hour on one skill. Every format is ${price.replace(/^From /, '')}.`,
        'Pay once, upfront. Coaching takes no bundle and no quantity discount, so the figure on the card is the figure you pay. Two hours of review cost twice one hour, and nothing is added at checkout.',
        'Send your region, your rank and one sentence naming the habit you want changed by the end of the session. Your coach reads that first, then you meet in the order chat and move to Discord for voice and screen share.',
      ]}
    >
      <p>
        Every coach passes a review before taking a first order. Read about{' '}
        <a href="/contact">the team behind Duoly</a>, check the{' '}
        <a href="/terms">payment, cancellation and refund terms</a>, or look at
        the <a href="/find-gaming-buddies">teammate side of Duoly</a> if what
        you want is playing time rather than a lesson.
      </p>
    </Steps>
    <Topics
      label="Coaching"
      sections={[
        {
          heading: 'What happens in a coaching hour?',
          paragraphs: [
            'A coaching hour is one goal, one worked example and one habit to take away. The goal gets agreed in the order chat before anyone loads a game, which is the thing that keeps an hour from drifting into a general chat about the game. The middle of the hour is the worked example: one round, one pull, one rotation or one duel, replayed and explained until the decision behind the result is obvious.',
            `The last few minutes are the review, and a good coach leaves you with three things: the signal to watch for, the change to make, and the drill to repeat before the next session. An hour is ${price.replace(/^From /, '')}, and so is the hour after it, because coaching takes no quantity discount. You stay on your own account the whole time, with voice and screen share on Discord, and nobody at Duoly ever asks for a password.`,
          ],
        },
        {
          heading: 'Should you book a coach or a teammate?',
          paragraphs: [
            'Book a coach when you know something is going wrong and cannot name it. Book a teammate when you want company, a filled seat, or simply a better evening of games. Ask yourself whether you want the next session explained or played, and the answer is usually obvious. A player who can already describe the losing pattern is ready for a review hour, because an hour of pausing will beat another live match.',
            `Losing the same site retake every match? That is a review hour. Short one player for a five-stack? That is a Teams service. Coaching stays ${price.replace(/^From /, '')} whichever game you pick, while teammate prices follow the mode and, in ranked modes, your own rank. Those sit on each game hub and on the [teammate and LFG pages](/find-gaming-buddies). Both run on your own account with Discord voice.`,
          ],
        },
      ]}
    />
    <Faq
      heading="What do players ask about esports coaching?"
      items={faqItems}
    />
    <ClosingCta
      heading="Ready to book a gaming coach?"
      text={`An esports lesson is one booked session on one problem you pick, in any of the ${games.length} games above. Choose your game from the grid, name the goal in the order chat, then meet your coach with Discord voice. You stay on your own account, and nobody here needs a password.`}
      extra={`Lessons are sold one unit at a time: one hour, or one game in the titles where a match has a fixed length. A Dota 2 Replay Review, for example, ends with three things to fix, written out after the hour. Bundles and quantity discounts do not reach coaching, so the figure on the card is the figure you pay. Coaching is`}
      href={bookingHref('val', { service: 'vod' })}
      label="Book a coaching session"
      price={price}
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />
    <nav class="related" aria-label="Related pages">
      <h2>Keep exploring</h2>
      <div class="chips">
        <a href="/find-gaming-buddies">Find gaming buddies and teammates</a>
        <a href="/blog/what-does-lfg-mean">What does LFG mean?</a>
        <a href="/blog/how-to-choose-a-gaming-coach">
          How to choose a gaming coach
        </a>
        <a href="/games">All games and services</a>
        <a href="/compare/e-pal">Duoly vs E-Pal compared</a>
        <a href="/compare/metafy">Duoly vs Metafy compared</a>
        <a href="/compare/queueup">Duoly vs QueueUp compared</a>
        {dedicated.slice(0, 6).map((game) => (
          <a href={game.path}>{game.name} coaching</a>
        ))}
        <a href="/get-paid-to-play-games">Get paid to coach</a>
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(article)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faqItems, path, Astro.site!))}
  />
</SiteLayout>

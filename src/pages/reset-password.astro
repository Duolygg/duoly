---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import { accountContext } from '../server/auth/context';
const account = accountContext(Astro.request, Astro.cookies);
let viewer;
try {
  viewer = (await account.identity())?.viewer;
} catch {
  viewer = undefined;
}
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
const csrf = account.csrf();
const params = Astro.url.searchParams;
const step = params.get('step') === 'new' && viewer ? 'new' : 'request';
const sent = params.get('sent') === '1';
const errors: Record<string, string> = {
  email: 'Enter a valid email address.',
  password: 'Use 8 to 128 characters for your new password.',
  expired: 'That reset link has expired. Request a new one.',
  unavailable: 'Password reset is unavailable right now. Try again shortly.',
};
const error = errors[params.get('error') ?? ''];
---

<SiteLayout title="Reset password | Duoly" viewer={viewer} csrf={csrf}>
  <PageIntro
    eyebrow="Account"
    title={step === 'new' ? 'Choose a new password' : 'Reset your password'}
    lead={
      step === 'new'
        ? 'Pick something you don’t use anywhere else.'
        : 'We’ll email you a link to set a new one.'
    }
    narrow
  >
    {error && (
      <p class="error" role="alert">
        {error}
      </p>
    )}
    {sent ? (
      <p class="card" role="status">
        If an account exists for that address, a reset link is on its way. Check
        your inbox and spam folder.
      </p>
    ) : step === 'new' ? (
      <form class="card" method="POST" action="/auth/password/update">
        <input type="hidden" name="csrf" value={csrf} />
        <label for="new-password">New password</label>
        <input
          id="new-password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          maxlength="128"
          required
        />
        <button type="submit">Save new password</button>
      </form>
    ) : (
      <form class="card" method="POST" action="/auth/password/forgot">
        <input type="hidden" name="csrf" value={csrf} />
        <label for="reset-email">Email address</label>
        <input
          id="reset-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
        />
        <button type="submit">Send reset link</button>
      </form>
    )}
    <p class="back">
      <a href="/login">Back to sign in</a>
    </p>
  </PageIntro>
</SiteLayout>

<style>
  form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 440px;
  }
  label {
    font-size: 14px;
    font-weight: 600;
  }
  input {
    min-height: 48px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid rgba(214, 187, 255, 0.2);
    background: #0d0719;
    color: #fff;
    font: inherit;
  }
  button {
    min-height: 48px;
    margin-top: 6px;
    border: 0;
    border-radius: 13px;
    background: #f3eeff;
    color: #17092e;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .error {
    margin-top: 20px;
    color: #ffb2be;
  }
  .back {
    margin-top: 16px;
  }
</style>

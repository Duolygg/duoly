---
import SiteLayout from '../layouts/SiteLayout.astro';
import Rules from '../design-reference/components/Rules.jsx';
import { pageViewer } from '../site/viewer';
const { viewer, csrf } = await pageViewer(Astro);
// The teammate rules are for teammates (and admins): signed out, sign in first; customers get
// their dashboard. Personal to the viewer, so never cached.
Astro.response.headers.set('Cache-Control', 'private, no-store');
if (!viewer) return Astro.redirect('/?signin=1', 303);
if (viewer.role === 'customer') return Astro.redirect('/dashboard', 303);
---

<SiteLayout title="Rules | Duoly" viewer={viewer} csrf={csrf}>
  <Rules
    chrome={false}
    back={{ href: '/', label: 'Back to Duoly' }}
    client:load
  />
</SiteLayout>

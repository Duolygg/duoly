---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import '../../components/seo/seo.css';
import { gameBySlug } from '../../site/games';
import { pageViewer } from '../../site/viewer';
import { hubChips, serializeJsonLd } from '../../site/seo';
import {
  CHECKED,
  comparisonExample,
  comparisonRows,
  epalSources,
} from '../../content/epal-comparison';

const { viewer, csrf } = await pageViewer(Astro);
const game = gameBySlug('league-of-legends')!;
// Additive related links: the biggest game hubs, so each keeps editorial inbound links.
const HUB_LINKS = hubChips([
  'league-of-legends',
  'counter-strike-2',
  'fortnite',
  'marvel-rivals',
]);
const path = '/compare/e-pal';
const title = 'Duoly vs E-Pal: Prices, Fees and Refunds | Duoly';
const description =
  'Duoly vs E-Pal compared from first-party pages: player-set prices and Buff fees on E-Pal, Duoly fixed prices, checked teammates and direct payment.';
const icons = {
  yes: 'M4 8.5 6.8 11.2 12 5.4',
  no: 'M5 5 11 11M11 5 5 11',
  part: 'M4.5 8H11.5',
  neutral: 'M8 8h.01',
  unknown: 'M6 6a2 2 0 1 1 3 1.7C8 8.2 8 8.5 8 9M8 11h.01',
} as const;
const word = {
  yes: 'Yes',
  no: 'No',
  part: 'Partly',
  neutral: 'Different model or stated fact',
  unknown: 'Not stated',
} as const;
const { price, unitPrice, discountPercent } = comparisonExample;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: new URL(path, Astro.site!).href,
  name: title,
  description,
  dateModified: CHECKED,
  isPartOf: { '@id': new URL('/#website', Astro.site!).href },
};
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page cmp-page" data-compare-page>
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Duoly vs E-Pal', path },
      ]}
    />
    <section class="cmp-hero">
      <div>
        <span class="eyebrow">Platform comparison</span>
        <h1>Duoly vs E-Pal</h1>
        <p class="lead">
          Duoly and E-Pal are both marketplaces for playing online games with
          another person. Duoly sells fixed-price sessions with reviewed
          teammates and coaches. E-Pal is a large marketplace where each
          provider, called an ePal, sets a price in Buff, the E-Pal platform
          currency.
        </p>
        <div class="cmp-actions">
          <a class="cta" href={comparisonExample.href}>
            Book the {price} example
          </a>
          <a class="cta-ghost" href="#table-h">
            See the comparison
          </a>
        </div>
        <div class="cmp-checked">
          Last checked {CHECKED}. Published by Duoly.
        </div>
      </div>
      <div class="cmp-hero-card">
        <img
          src={game.img}
          alt="League of Legends game art"
          width="96"
          height="96"
          loading="eager"
        />
        <div>
          <div class="cmp-label">Example Duoly price</div>
          <div class="cmp-big">{price}</div>
          <div class="cmp-sub">
            3 ranked League of Legends games, Duo Pro, Gold, EUW
          </div>
        </div>
      </div>
    </section>

    <section class="cmp-answer" aria-label="Short answer">
      <p>
        <strong>Short answer:</strong> E-Pal has the far broader range, and
        Duoly has the fixed price. E-Pal says over 1,000,000 users have tried
        its services across 100+ games and social categories, with each provider
        setting their own price in Buff. Duoly covers 20 games plus Social at
        one published price per game, service and rank: one ranked League of
        Legends game with a Master+ teammate at Gold on EUW is {unitPrice}, and
        three of them come to {price} with the {discountPercent}% discount
        already inside it. On E-Pal a Buff top-up also adds a 10% service fee
        plus a payment channel fee. Pick E-Pal for range. Pick Duoly for a
        figure you can read before you pay. Every E-Pal fact here comes from
        E-Pal's own pages, read on {CHECKED}.
      </p>
    </section>

    <section aria-labelledby="table-h">
      <h2 id="table-h">How do Duoly and E-Pal compare side by side?</h2>
      <p>
        Most rows below mark a difference in how the two platforms work, with no
        score attached. E-Pal lists 100+ games and lifestyle services combined;
        Duoly lists 20 games plus Social. Duoly charges a card through Stripe;
        E-Pal sells Buff first, with a 10% service fee on the top-up. E-Pal is
        marked ahead where it is ahead: you can choose a named provider there
        and read public client reviews before booking, neither of which Duoly
        offers today. A neutral dot marks a model or a destination without
        scoring it, and Not stated means the pages we read do not say.
      </p>
      <div class="cmp-legend" aria-hidden="true">
        {(['yes', 'part', 'no', 'neutral', 'unknown'] as const).map((k) => (
          <span>
            <svg
              class={`mark mark-${k}`}
              viewBox="0 0 16 16"
              aria-hidden="true"
            >
              <path d={icons[k]} />
            </svg>{' '}
            {word[k]}
          </span>
        ))}
      </div>
      <div class="cmp-table-wrap">
        <table class="cmp-table">
          <caption class="sr-only">
            {`Duoly and E-Pal compared on public facts, checked ${CHECKED}`}
          </caption>
          <thead>
            <tr>
              <th scope="col">Topic</th>
              <th scope="col">Duoly</th>
              <th scope="col">E-Pal</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>
                  <span class="cmp-cell">
                    <svg
                      class={`mark mark-${row.duoly}`}
                      viewBox="0 0 16 16"
                      aria-hidden="true"
                    >
                      <path d={icons[row.duoly]} />
                    </svg>
                    <span>
                      <span class="sr-only">{word[row.duoly]}.</span>{' '}
                      {row.duolyNote}
                    </span>
                  </span>
                </td>
                <td>
                  <span class="cmp-cell">
                    <svg
                      class={`mark mark-${row.epal}`}
                      viewBox="0 0 16 16"
                      aria-hidden="true"
                    >
                      <path d={icons[row.epal]} />
                    </svg>
                    <span>
                      <span class="sr-only">{word[row.epal]}.</span>{' '}
                      {row.epalNote}{' '}
                      <a
                        href={`#epal-source-${epalSources.findIndex((source) => source.url === row.epalSource)}`}
                        aria-label={`E-Pal source for ${row.label}`}
                      >
                        Source
                      </a>
                    </span>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="price-h">
      <h2 id="price-h">What do the League of Legends price examples show?</h2>
      <div class="cmp-two">
        <div class="cmp-card cmp-duoly">
          <div class="cmp-card-head">
            <img src={game.img} alt="" width="48" height="48" loading="lazy" />
            <div>
              <div class="cmp-label">Duoly</div>
              <div class="cmp-card-title">Duo Pro, Gold, EUW, 3 games</div>
            </div>
          </div>
          <div class="cmp-big">{price}</div>
          <div class="cmp-sub">
            {unitPrice} per game, {discountPercent}% off for 3 games. Fixed
            published price, paid through Stripe.
          </div>
          <a class="btn-sm" href={comparisonExample.href}>
            Book this example
          </a>
        </div>
        <div class="cmp-card">
          <div class="cmp-card-head">
            <span class="cmp-coin" aria-hidden="true">
              B
            </span>
            <div>
              <div class="cmp-label">E-Pal</div>
              <div class="cmp-card-title">Price set by each provider</div>
            </div>
          </div>
          <div class="cmp-big">2.00 to 3.00 Buff</div>
          <div class="cmp-sub">
            Sample homepage listings per game or session on {CHECKED}. Buff
            top-ups add a 10% service fee plus a payment channel fee.
          </div>
        </div>
      </div>
      <p>
        The two prices answer different questions, so read the unit before the
        number. Duo Pro is a ranked Solo/Duo session with a Master+ teammate,
        paid through Stripe: {unitPrice} for one game at Gold on EUW, and{' '}
        {price} for three, because Duoly takes {discountPercent}% off 3 games,
        20% off 5 and 25% off 10. On E-Pal each provider sets their own price in
        Buff, and on 8 November 2026 the homepage showed sample listings from 2
        to 3 Buff. The E-Pal wallet page puts 1 Buff at 1 USD, adds a 10%
        service fee to a top-up, and notes that payment channels add 3% to 30%.
        So 3 games at 2 to 3 Buff come to about USD 6.60 to 9.90 once the 10%
        fee lands, before channel fees. E-Pal can genuinely come out cheaper.
        Those sample listings name no rank, though, so this is not a
        like-for-like comparison.
      </p>
    </section>

    <section aria-labelledby="pay-h">
      <h2 id="pay-h">How do payment, fees and refunds work?</h2>
      <p>
        Duoly takes one card payment through Stripe in EUR or USD, so 3{' '}
        <a href="/games/league-of-legends">League of Legends</a> games cost what
        the card above says, with no top-up in the way. You can cancel free of
        charge until a teammate accepts, an order nobody accepts within 5
        minutes cancels itself, and refunds go to the Duoly balance by default.
        The <a href="/terms#balance">Duoly balance terms</a> add that refunded
        money can be paid back to the original payment method on request, while
        promotional cashback and gifts cannot be paid out as cash.{' '}
        <a href="/games/social">Duoly Social</a> sells the company-only hours
        E-Pal is best known for.
      </p>
      <p>
        E-Pal runs on Buff, a platform currency worth USD 1.00 per Buff, and the
        wallet page puts a 10% service fee on every top-up. Buff bought that way
        cannot be withdrawn again. For a refund, an E-Pal client has 72 hours
        after an ePal accepts the order to open a dispute, and a decision
        typically takes 3 to 7 business days. The dispute page says disputed
        funds return to the E-Pal account, which works much like the default
        Duoly balance refund. Whether an original-payment refund is available is
        not stated on the help pages we read, which is why the table marks it
        Not stated rather than No. The Duoly side sits in full on{' '}
        <a href="/fees-and-refunds">Duoly fees and refunds</a>, and{' '}
        <a href="/about">about Duoly</a> names the Austrian operator behind it.
      </p>
    </section>

    <section aria-labelledby="games-h">
      <h2 id="games-h">Which games and services does each platform cover?</h2>
      <p>
        E-Pal is the larger platform by a long way. Its homepage counts 100+
        online games and lifestyle services, including Valorant, League of
        Legends, Marvel Rivals, Minecraft and Roblox, plus social categories
        such as E-Chat, karaoke, watching movies together and studying together.
        E-Pal says over 1,000,000 users have tried its services and that it has
        attracted 100,000+ online ePals.
      </p>
      <p>
        Duoly is the narrower list: 20 games plus Social, among them League of
        Legends, Valorant, Counter-Strike 2, Fortnite, Apex Legends, Marvel
        Rivals, Rocket League and Pokémon Unite. Every one of them sells both
        teammate sessions and coaching, so a League of Legends VOD Review is an
        hour with a Grandmaster+ coach in the same checkout as a duo game. Duoly
        Social covers friendly voice sessions for adults, such as Just Chat, and
        never dating services. If you want a rare game, or a wide spread of
        social services, E-Pal is simply the better place to look. Both lists
        were read on {CHECKED}.
      </p>
    </section>

    <section aria-labelledby="check-h">
      <h2 id="check-h">
        How are teammates checked, and who can use each service?
      </h2>
      <p>
        Both platforms check their providers, in different ways. The E-Pal help
        page says staff review each service application within 2 to 3 business
        days, and that a gaming applicant can upload a rank or level screenshot
        and a voice clip of 3 to 15 seconds. Duoly reviews every teammate before
        a first order and names the tier on the service itself, so Duo Pro in
        League of Legends always comes with a Master+ teammate.
      </p>
      <p>
        Both are adults-only. The E-Pal Terms of Service require users to be 18
        or older, and the Duoly terms set the same minimum, both read on{' '}
        {CHECKED}. One thing Duoly has that E-Pal does not is a public MCP
        server, so an assistant like Claude or ChatGPT can look up a price and
        build a booking link for you. Payment still happens on Duoly through
        Stripe, and the order chat keeps the session on record either way.
      </p>
    </section>

    <section aria-labelledby="fit-h">
      <h2 id="fit-h">Which one fits you?</h2>
      <p>
        There is no single winner here, only a trade between range and price
        certainty. Somebody who wants karaoke one night and Roblox the next will
        find far more on E-Pal. Somebody who wants 3 ranked League of Legends
        games and wants to read the total before paying is better served on
        Duoly.
      </p>
      <div class="cmp-two">
        <div class="cmp-card">
          <div class="cmp-card-title">Choose E-Pal if</div>
          <ul class="checklist">
            <li>
              You want the widest choice, with 100+ games and social services.
            </li>
            <li>
              You enjoy browsing ePal profiles and public client reviews before
              choosing.
            </li>
            <li>
              You want karaoke, study sessions or watching movies together with
              a provider.
            </li>
            <li>
              You are fine buying Buff first, with a 10% service fee per top-up.
            </li>
          </ul>
        </div>
        <div class="cmp-card cmp-duoly">
          <div class="cmp-card-title">Choose Duoly if</div>
          <ul class="checklist">
            <li>
              You want a fixed price before checkout, {price} for 3 League of
              Legends games.
            </li>
            <li>You want to pay by card through Stripe in EUR or USD.</li>
            <li>
              You want a reviewed teammate or a coach in one of 20 games plus
              Social.
            </li>
            <li>
              You want an AI assistant to find a price and create a booking
              link.
            </li>
          </ul>
          <a class="btn-sm" href={comparisonExample.href}>
            Book a Duoly session
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="sources-h">
      <h2 id="sources-h">Where do these facts come from?</h2>
      <p>
        Every E-Pal fact here comes from 6 public E-Pal pages, read on 8
        November 2026 and listed below. The 10% top-up fee, for instance, is on
        the E-Pal wallet page. The Duoly facts come from the{' '}
        <a href="/terms">Duoly terms</a> and the live price list, which is why
        the example above always matches checkout. Duoly publishes this
        comparison, so it is not independent. E-Pal is a trademark of its owner
        and is named here for comparison only. Prices and policies change, so
        open the source pages before booking anything.
      </p>
      <ol class="cmp-sources">
        {epalSources.map((source, index) => (
          <li id={`epal-source-${index}`}>
            <a href={source.url} rel="nofollow noopener">
              {source.title}
            </a>{' '}
            <span class="cmp-sub">(accessed {source.accessed})</span>
          </li>
        ))}
      </ol>
    </section>

    <nav class="related" aria-label="Related pages">
      <h2>Related Duoly pages</h2>
      <div class="chips">
        <a href="/games/league-of-legends/play-with-someone">
          Play League of Legends with someone
        </a>
        <a href="/games/valorant">Find Valorant teammates</a>
        <a href="/games/social">Friendly Social sessions</a>
        <a href="/developers/mcp">Book through an AI assistant</a>
        <a href="/compare/metafy">Duoly compared with Metafy</a>
        <a href="/compare/queueup">Duoly compared with QueueUp</a>
        <a href="/games">All games and services</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(schema)}
  />
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .cmp-page > section {
    margin: 48px 0;
  }
  .cmp-page h2 {
    scroll-margin-top: 96px;
  }
  .cmp-page > section > p {
    max-width: 75ch;
  }
  .cmp-page > .cmp-hero {
    display: grid;
    gap: 28px;
    align-items: center;
    margin-top: 8px;
  }
  @media (min-width: 900px) {
    .cmp-page > .cmp-hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    }
  }
  .cmp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }
  .cmp-checked {
    margin-top: 14px;
    font-size: 14px;
    color: #c9bfe6;
  }
  .cmp-hero-card,
  .cmp-card {
    border-radius: 20px;
    border: 1px solid rgba(196, 170, 255, 0.22);
    background:
      radial-gradient(
        120% 90% at 100% 0%,
        rgba(255, 79, 176, 0.12),
        transparent 60%
      ),
      linear-gradient(160deg, #1b1033, #120b22 65%);
    padding: 22px;
  }
  .cmp-hero-card {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .cmp-hero-card img,
  .cmp-card-head img {
    border-radius: 18px;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.4);
    flex: none;
  }
  .cmp-card-head img {
    border-radius: 12px;
  }
  .cmp-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #d6bbff;
  }
  .cmp-big {
    font-family: 'Bricolage Grotesque', 'Bricolage Fallback', sans-serif;
    font-size: 34px;
    font-weight: 800;
    line-height: 1.1;
    color: #f3eeff;
    margin: 4px 0;
  }
  .cmp-sub {
    font-size: 15px;
    color: #b9add8;
    line-height: 1.5;
  }
  .cmp-answer p {
    margin: 0;
    padding: 20px 22px;
    border-radius: 18px;
    border-left: 4px solid #d6bbff;
    background: rgba(214, 187, 255, 0.07);
    max-width: 80ch;
  }
  .cmp-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0 0 14px;
    font-size: 14px;
    color: #b9add8;
  }
  .cmp-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cmp-table-wrap {
    border: 1px solid rgba(196, 170, 255, 0.22);
    border-radius: 18px;
    overflow: hidden;
    background: #120b22;
  }
  .cmp-table {
    width: 100%;
    border-collapse: collapse;
  }
  .cmp-table th,
  .cmp-table td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid rgba(196, 170, 255, 0.2);
    line-height: 1.5;
  }
  .cmp-table thead th {
    border-top: 0;
    background: #1b1033;
    color: #f3eeff;
    font-size: 15px;
  }
  .cmp-table tbody th {
    color: #f3eeff;
    font-weight: 650;
    width: 30%;
  }
  .cmp-table td {
    width: 35%;
  }
  .cmp-table td:nth-child(2) {
    background: rgba(214, 187, 255, 0.05);
  }
  .cmp-cell {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 15px;
  }
  .mark {
    flex: none;
    width: 24px;
    height: 24px;
    padding: 4px;
    border-radius: 50%;
    border: 1px solid;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mark-yes {
    background: rgba(74, 222, 128, 0.16);
    border-color: rgba(74, 222, 128, 0.5);
    color: #86efac;
  }
  .mark-no {
    background: rgba(248, 113, 113, 0.18);
    border-color: rgba(248, 113, 113, 0.7);
    color: #fecaca;
  }
  .mark-neutral,
  .mark-unknown {
    background: rgba(185, 173, 216, 0.1);
    border-color: #b9add8;
    color: #d8d1e8;
  }
  .mark-part {
    background: rgba(251, 191, 36, 0.14);
    border-color: rgba(251, 191, 36, 0.5);
    color: #fcd34d;
  }
  @media (max-width: 640px) {
    .cmp-table thead {
      display: none;
    }
    .cmp-table tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      border-top: 1px solid rgba(196, 170, 255, 0.12);
    }
    .cmp-table tbody tr:first-child {
      border-top: 0;
    }
    .cmp-table tbody th {
      grid-column: 1 / -1;
      width: auto;
      padding-bottom: 4px;
      border-top: 0;
    }
    .cmp-table td {
      display: block;
      width: auto;
      border-top: 0;
      padding-top: 6px;
    }
    .cmp-table td::before {
      display: block;
      margin-bottom: 6px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #d6bbff;
    }
    .cmp-table td:nth-child(2)::before {
      content: 'Duoly';
    }
    .cmp-table td:nth-child(3)::before {
      content: 'E-Pal';
    }
  }
  .cmp-two {
    display: grid;
    gap: 16px;
    margin: 18px 0;
  }
  @media (min-width: 760px) {
    .cmp-two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
  .cmp-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cmp-card .btn-sm {
    align-self: flex-start;
    margin-top: 8px;
  }
  .cmp-duoly {
    border-color: rgba(214, 187, 255, 0.5);
  }
  .cmp-card-head {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 4px;
  }
  .cmp-card-title {
    font-family: 'Bricolage Grotesque', 'Bricolage Fallback', sans-serif;
    font-size: 19px;
    font-weight: 700;
    color: #f3eeff;
  }
  .cmp-coin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(251, 191, 36, 0.14);
    border: 1px solid rgba(251, 191, 36, 0.5);
    color: #fcd34d;
    font-weight: 800;
    font-size: 20px;
  }
  .cmp-card .checklist {
    margin: 6px 0 0;
  }
  .cmp-sources li {
    scroll-margin-top: 96px;
  }
  .cmp-sources {
    display: grid;
    gap: 8px;
    padding-left: 22px;
    overflow-wrap: anywhere;
  }
</style>

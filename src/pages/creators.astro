---
import SiteLayout from '../layouts/SiteLayout.astro';
import Creators from '../components/site/Creators.jsx';
import { pageViewer } from '../site/viewer';
import { accountContext } from '../server/auth/context';
import { supportService, supportTeam } from '../server/support/store';

const { viewer, csrf } = await pageViewer(Astro);
// The form needs an account now, so a signed-out visitor gets the sign-in popup first. The CSRF
// token is still issued for everyone, because the popup posts with it too.
const account = accountContext(Astro.request, Astro.cookies);
const formCsrf = account.config ? csrf || account.csrf() : '';
const service = formCsrf ? supportService() : null;
const team = service ? await supportTeam(service).catch(() => []) : [];
const me = viewer ? { name: viewer.name, email: viewer.email ?? '' } : {};
// Whether this account already applied or is already a creator, so the card can send them to
// their dashboard instead of showing the form a second time.
let status = 'none';
if (viewer && account.client) {
  try {
    // Bound: supabase-js rpc reads `this` (tests/unit/rpc-binding.test.ts).
    const rpc = (
      account.client.rpc as unknown as (
        name: string,
      ) => PromiseLike<{ data: unknown; error: unknown }>
    ).bind(account.client);
    const { data, error } = await rpc('creator_portal');
    const payload = data as { status?: string; error?: unknown } | null;
    if (
      !error &&
      payload &&
      !payload.error &&
      typeof payload.status === 'string'
    )
      status = payload.status;
  } catch {
    status = 'none';
  }
}
---

<SiteLayout title="Creator program | Duoly" viewer={viewer} csrf={csrf}>
  <Creators
    chrome={false}
    closed={!service}
    csrf={formCsrf}
    me={me}
    team={team}
    signedIn={!!viewer}
    status={status}
    client:load
  />
</SiteLayout>

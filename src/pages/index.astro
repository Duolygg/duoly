---
import SiteLayout from '../layouts/SiteLayout.astro';
// The order preview's proof list (QueuePreview uses the stylesheet-free ProofView).
import '../components/proofs/proofs.css';
import LiveHome from '../components/account/LiveHome';
import { accountContext } from '../server/auth/context';
import { paymentsConfig } from '../server/payments/config';
import { customerUsdRate, eurToUsd } from '../server/fx';
import { CurrencySchema } from '../contracts/account';
import { homeLive } from '../server/home/live';
import { loadProView } from '../server/pro/status';
const account = accountContext(Astro.request, Astro.cookies);
let viewer = null;
let accountCurrency = null;
if (account.config) {
  try {
    const identity = await account.identity();
    viewer = identity?.viewer ?? null;
    accountCurrency = identity?.profile.currency ?? null;
  } catch {
    /* Signed-out header; account routes report their own errors. */
  }
  for (const [name, value] of account.headers)
    Astro.response.headers.set(name, value);
}
const csrf = account.config ? account.csrf() : '';
const checkoutEnabled = !!account.config && paymentsConfig() !== null;
const { rate } = await eurToUsd();
const usdRate = customerUsdRate(rate);
// Original app/page.jsx: the account's currency wins, then the cookie; none means auto-detect.
const cookieCurrency = CurrencySchema.safeParse(
  Astro.cookies.get('duoly-currency')?.value,
);
// What auto-detect found on an earlier visit, so the navbar shows it on first paint too.
const autoCurrency = CurrencySchema.safeParse(
  Astro.cookies.get('duoly-currency-auto')?.value,
);
// Teammates online and recent matches: public, cached per instance (src/server/home/live.ts).
const { onlineNow, recentMatches, stats, teammates } = await homeLive();
// Duoly PRO strip and member discount in the order summary (null while PRO_ENABLED is off).
const pro = await loadProView(account.client, viewer?.role);
---

<SiteLayout
  title="Duoly | Duo up in under 2 minutes"
  viewer={viewer ?? undefined}
  bare
>
  <LiveHome
    viewer={viewer}
    csrf={csrf}
    checkoutEnabled={checkoutEnabled}
    usdRate={usdRate}
    accountCurrency={accountCurrency}
    cookieCurrency={cookieCurrency.success ? cookieCurrency.data : null}
    autoCurrency={autoCurrency.success ? autoCurrency.data : null}
    onlineNow={onlineNow}
    recentMatches={recentMatches}
    stats={stats}
    teammates={teammates}
    pro={pro}
    askLogin={!viewer && Astro.url.searchParams.get('signin') === '1'}
    client:load
  />
</SiteLayout>

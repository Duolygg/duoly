---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Claim from '../../components/teammate/Claim.jsx';
import { pageViewer } from '../../site/viewer';

const { viewer, csrf } = await pageViewer(Astro);
const token = Astro.params.token ?? '';
const user = { name: viewer?.name || 'Teammate' };
---

<SiteLayout title="Handover | Duoly" viewer={viewer} csrf={csrf} bare>
  <Claim client:load token={token} user={user} csrf={csrf} />
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Steps from '../components/seo/Steps.astro';
import Topics from '../components/seo/Topics.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/directory.css';
import { pageViewer } from '../site/viewer';
import { viewerCurrency } from '../server/currency';
import { eurToUsd } from '../server/fx';
import { teammateDirectory, directoryPrice } from '../server/seo/directories';
import { faqSchema, seoOffers } from '../server/seo/offers';
import { BUNDLE_PERCENTS as bundle } from '../server/seo/teammate-facts';
import {
  serializeJsonLd,
  bookingHref,
  CONTENT_DATES,
  organizationSchema,
} from '../site/seo';
const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
const context = {
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
};
const games = teammateDirectory(context);
const price = directoryPrice(games);
const from = price.replace(/^From /, '');
// Social is company without a game, so it sits beside the directory rather
// than inside it: the same checkout, a different thing to book.
const social = seoOffers('social', 'gg', context);
const socialPrice = social[0]!.display;
const withPage = games.filter((game) => game.dedicated);
// The cheapest card in the directory, so the copy names a real floor rather
// than repeating the "from" line the hero already carries.
const floor = [...games].sort(
  (a, b) => a.cheapest.amountMinor - b.cheapest.amountMinor,
)[0]!;
const path = '/find-gaming-buddies';
const title = 'Find Gaming Buddies to Play Games With | Duoly';
const h1 = 'Find gaming buddies for the game you actually play';
const faqItems: [string, string][] = [
  [
    'What is a gaming buddy?',
    'A gaming buddy is somebody who plays with you regularly rather than once. On Duoly a buddy is a reviewed player booked for a set number of games or hours.',
  ],
  [
    'How much does it cost to play games with someone?',
    `Teammate sessions start at ${from}. The price follows the mode and, in ranked modes, your own rank, and a bundle of 3 or more games takes a discount off the total.`,
  ],
  [
    'Can I find people to play games with for free?',
    'Yes, and free is the right first try: game Discords, in-client group finders and the people you enjoyed a match with all cost nothing.',
  ],
  [
    'Do I have to share my account?',
    'No. Your buddy plays from a separate account and joins your party, so nobody on Duoly ever needs your password.',
  ],
  [
    'Can I play with a pro?',
    'Duoly books reviewed higher-ranked players, not signed professionals, and every card names the tier it hires, such as a Grand Champion partner in Rocket League.',
  ],
  [
    'What if I just want company without a game?',
    `Duoly Social is the game-free option at ${socialPrice} an hour: Just Chat, Watch Together, Sleep Call or Karaoke, for adults only.`,
  ],
];
const article = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: h1,
  url: new URL(path, Astro.site!).href,
  description: `Find gaming buddies in ${games.length} games on Duoly. Compare free routes with a booked teammate, then pick the game you play.`,
  dateModified: CONTENT_DATES[path],
  isPartOf: { '@id': new URL('/#website', Astro.site!).href },
  publisher: organizationSchema(Astro.site!),
};
---

<SiteLayout
  title={title}
  description={`Find gaming buddies in ${games.length} games, from ${from.toLowerCase()} on Duoly. Compare free LFG routes with a booked duo partner, then pick your game and mode.`}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Find gaming buddies', path },
      ]}
    />
    <SeoHero
      eyebrow="Gaming buddies"
      h1={h1}
      lead={`Find people to play games with in ${games.length} games. Start with the free routes, or book a reviewed buddy for a set number of games with the rank, mode and comms agreed first.`}
      price={price}
      cta={{ href: '#games-h', label: 'Pick your game' }}
      secondary={{ href: '#free-h', label: 'Free ways to find someone' }}
      art={[
        {
          src: '/assets/games/marvel-rivals.png',
          alt: 'Marvel Rivals game art',
        },
        { src: '/assets/games/minecraft.png', alt: 'Minecraft game art' },
      ]}
      facts={[
        'Checked by Duoly before any order',
        'Ranked, casual and co-op modes',
        'Your own account, voice on Discord',
        'Book the same person again',
      ]}
    />
    <section aria-labelledby="what-h">
      <h2 id="what-h">What is a gaming buddy?</h2>
      <p>
        A gaming buddy is somebody who plays with you regularly rather than
        once. The word covers three fairly different asks: a duo partner for
        ranked, a relaxed companion for casual or co-op evenings, and a filled
        seat when a group is short one player. Say which you want, because a
        ranked grinder and a survival partner want opposite things from an
        evening.
      </p>
      <p>
        A booked buddy on Duoly is a reviewed player who joins for a set number
        of games or hours, on your own account, with the rank, the mode and the
        voice setup agreed in the order chat before anyone queues. Sessions
        start at {from}, and the cheapest card in the whole directory below is a{' '}
        {floor.name} session at {floor.cheapest.display} per{' '}
        {floor.cheapest.unit}. If the evening goes well, you can book the same
        person again from your order history.
      </p>
    </section>
    <section aria-labelledby="free-h">
      <h2 id="free-h">How do you find people to play games with for free?</h2>
      <p>
        Free is the right first try, and three routes cost nothing at all. The
        game itself is the fastest: in-client group finders, Squad Fill and
        party invites put a stranger beside you in seconds, with no agreed time
        and no comms. Game Discords and LFG channels are slower and much better,
        as long as your post names your region, your rank, your role and your
        mode. "Anyone want to play" gets scrolled past. And the people you
        already enjoyed a match with are the best route of all, so add them
        after the game instead of going back to a server next week.
      </p>
      <p>
        A booked session buys the three parts a free post cannot promise: a set
        time, a named rank, and comms agreed with Discord before the first
        queue.
      </p>
    </section>
    <section aria-labelledby="games-h">
      <h2 id="games-h">Which game do you want a buddy for?</h2>
      <p class="section-intro">
        Every card below shows the cheapest real session in that game rather
        than a headline number. Treat it as a floor: ranked modes are priced by
        your own rank, while casual and co-op modes hold one price for
        everybody. Some cards are priced per game and some per hour, because a
        Minecraft evening has no fixed length and a Valorant match does, so
        check the unit before you choose a quantity.
      </p>
      <p class="section-intro">
        {withPage.length} of the {games.length} games have an LFG or duo page of
        their own, with the modes written out and a worked example. The rest
        book from their game hub, carrying the same price cards. Press Book and
        checkout opens with that game already chosen, which is where you settle
        the mode and the voice setup.
      </p>
      <div class="directory-grid">
        {games.map((game) => (
          <article class="card directory-card">
            <img
              src={game.img}
              alt={`${game.name} game art`}
              width="44"
              height="44"
              loading="lazy"
              decoding="async"
            />
            <strong class="directory-name">{game.name}</strong>
            <span class="directory-list">
              {game.titles.slice(0, 4).join(', ')}
            </span>
            <span class="directory-price">
              <span class="from">From </span>
              <span class="money">{game.cheapest.display}</span> /{' '}
              {game.cheapest.unit}
            </span>
            <div class="directory-links">
              <a class="btn-sm" href={bookingHref(game.id, { tab: 'duo' })}>
                Book
              </a>
              <a href={game.path}>
                {game.dedicated
                  ? `${game.name} teammate guide`
                  : `${game.name} hub`}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <Steps
      heading="How do you book a gaming buddy?"
      steps={[
        `Pick the game, the mode and how much time you want: a single game, a bundle of 3 or 5, or an hour in the games sold by time.`,
        'Add your region, rank, role and language. That written request is the first thing your buddy reads, so name the mode and the kind of evening you have in mind. "EU, Gold, support, ranked, short calls" tells somebody everything in six words.',
        'Meet in the order chat, agree on voice with Discord and send the invite yourself. Your buddy plays from a separate account, so your login stays private.',
      ]}
    >
      <p>
        Every teammate passes a review before taking a first order. Read about{' '}
        <a href="/contact">the team behind Duoly</a>, check the{' '}
        <a href="/terms">payment, cancellation and refund terms</a>, or browse{' '}
        <a href="/coaching">esports coaching</a> if what you want is a lesson
        rather than company.
      </p>
    </Steps>
    <Topics
      label="Gaming buddies"
      sections={[
        {
          heading: 'What makes a good gaming partner?',
          paragraphs: [
            'A good gaming partner is a match on the mode you both want, the hours you are both online, and how much talking you each want. Rank matters least of the four. Mode is the one people skip, and it is the one that ruins evenings: a ranked grinder and somebody who wants a relaxed hour will annoy each other inside a single match, however well the ranks line up.',
            `Say how you like comms early, because "short calls only" and "chat the whole time" are both perfectly fine and only one of them is what you want. If being coached mid game irritates you, say so before the first queue rather than after a lost round. A booked buddy turns up already knowing all of that, because the order chat asks for it before anyone queues.`,
          ],
        },
        {
          heading: 'Do you want a teammate, a coach or just company?',
          paragraphs: [
            'Book a teammate for playing together, a coach for learning, or Social for company without a game at all. A teammate plays the mode you choose and talks through it with you. A coach is a teacher working on one problem: bring a replay or a question, and ask for a practice task at the end. If a Valorant retake keeps going wrong and you cannot say why, that is a coach. If you want to win the next match, that is a teammate.',
            `Duoly Social is the game-free option at ${socialPrice} an hour: Just Chat, Watch Together, Sleep Call or Karaoke on voice, adults only. Somebody who wants conversation on a quiet evening is better served there than in a ranked queue. All three run with Discord voice on accounts both people own, and bundles cut the total on each game's main teammate service.`,
          ],
        },
      ]}
    />
    <Faq heading="Questions before you book a buddy?" items={faqItems} />
    <ClosingCta
      heading="Ready to find a gaming buddy?"
      text={`A booking is one reviewed player for the games or hours you choose, in any of the ${games.length} games above. Pick your game from the grid, confirm the mode and your rank in the order chat, then test voice with Discord and send the invite from your own account. Do that and the paid time starts with the lobby already full.`}
      extra={`Check the service before you choose a bundle. Each game's main teammate service takes ${bundle[0]}% off 3 units, ${bundle[1]}% off 5 and ${bundle[2]}% off 10, while other services have their own quantity options. Check the unit too: a Minecraft hour and a Valorant game buy different amounts of playing time. A duo booking adds one player to your party, so pick a Teams service when you need several seats filled instead.`}
      href={bookingHref('mr', { service: 'duo2' })}
      label="Find your gaming buddy"
      price={price}
      art={{ src: '/assets/games/marvel-rivals.png', alt: '' }}
    />
    <nav class="related" aria-label="Related pages">
      <h2>Keep exploring</h2>
      <div class="chips">
        <a href="/coaching">Esports coaching by game</a>
        <a href="/blog/what-does-lfg-mean">What does LFG mean?</a>
        <a href="/blog/free-lfg-or-paid-teammate">
          Free LFG or a paid teammate?
        </a>
        <a href="/blog/how-to-find-a-valorant-duo">
          How to find a Valorant duo
        </a>
        <a href="/games/social">Social sessions without a game</a>
        <a href="/games">All games and services</a>
        <a href="/compare/e-pal">Duoly vs E-Pal compared</a>
        {withPage.slice(0, 6).map((game) => (
          <a href={game.path}>{game.name} teammates</a>
        ))}
        <a href="/get-paid-to-play-games">Get paid to play games</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(article)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faqItems, path, Astro.site!))}
  />
</SiteLayout>

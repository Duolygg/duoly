---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Steps from '../components/seo/Steps.astro';
import Topics from '../components/seo/Topics.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/directory.css';
import { pageViewer } from '../site/viewer';
import { viewerCurrency } from '../server/currency';
import { eurToUsd } from '../server/fx';
import { teammateDirectory, directoryPrice } from '../server/seo/directories';
import { faqSchema, seoOffers } from '../server/seo/offers';
import { BUNDLE_PERCENTS as bundle } from '../server/seo/teammate-facts';
import {
  serializeJsonLd,
  bookingHref,
  CONTENT_DATES,
  organizationSchema,
} from '../site/seo';
const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
const context = {
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
};
const games = teammateDirectory(context);
const price = directoryPrice(games);
const from = price.replace(/^From /, '');
// Social is company without a game, so it sits beside the directory rather
// than inside it: the same checkout, a different thing to book.
const social = seoOffers('social', 'gg', context);
const socialPrice = social[0]!.display;
const withPage = games.filter((game) => game.dedicated);
// The cheapest card in the directory, so the copy names a real floor rather
// than repeating the "from" line the hero already carries.
const floor = [...games].sort(
  (a, b) => a.cheapest.amountMinor - b.cheapest.amountMinor,
)[0]!;
const path = '/find-gaming-buddies';
const title = 'Find Gaming Buddies to Play Games With | Duoly';
const h1 = 'Find gaming buddies for the game you actually play';
const faqItems: [string, string][] = [
  [
    'What is a gaming buddy?',
    'A gaming buddy is somebody who plays with you regularly rather than once. On Duoly a buddy is a reviewed player booked for a set number of games or hours.',
  ],
  [
    'How much does it cost to play games with someone?',
    `Teammate sessions start at ${from} in 2026, and the price follows the mode and, in ranked modes, your own rank. For example, 3 games take a bundle discount.`,
  ],
  [
    'Can I find people to play games with for free?',
    'Yes, and free is the right first try: game Discords, in-client group finders and the people you enjoyed a match with all cost nothing.',
  ],
  [
    'Do I have to share my account?',
    'No. Your buddy plays from a separate account and joins your party, so nobody on Duoly ever needs your password.',
  ],
  [
    'Can I play with a pro?',
    'Duoly books reviewed higher-ranked players rather than signed professionals, and each card names the tier it hires. For example, a Grand Champion partner in Rocket League.',
  ],
  [
    'What if I just want company without a game?',
    `Duoly Social is the game-free option at ${socialPrice} per hour in 2026: Just Chat, Watch Together, Sleep Call or Karaoke, for adults only.`,
  ],
];
const article = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: h1,
  url: new URL(path, Astro.site!).href,
  description: `Find gaming buddies in ${games.length} games on Duoly. Compare free routes with a booked teammate, then pick the game you play.`,
  dateModified: CONTENT_DATES[path],
  isPartOf: { '@id': new URL('/#website', Astro.site!).href },
  publisher: organizationSchema(Astro.site!),
};
---

<SiteLayout
  title={title}
  description={`Find gaming buddies in ${games.length} games, from ${from.toLowerCase()} on Duoly. Compare free LFG routes with a booked duo partner, then pick your game and mode.`}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Find gaming buddies', path },
      ]}
    />
    <SeoHero
      eyebrow="Gaming buddies"
      h1={h1}
      lead={`Find people to play games with in ${games.length} games. Start with the free routes, or book a reviewed buddy for a set number of games with the rank, mode and comms agreed first.`}
      price={price}
      cta={{ href: '#games-h', label: 'Pick your game' }}
      secondary={{ href: '#free-h', label: 'Free ways to find someone' }}
      art={[
        {
          src: '/assets/games/marvel-rivals.png',
          alt: 'Marvel Rivals game art',
        },
        { src: '/assets/games/minecraft.png', alt: 'Minecraft game art' },
      ]}
      facts={[
        'Checked by Duoly before any order',
        'Ranked, casual and co-op modes',
        'Your own account, voice on Discord',
        'Book the same person again',
      ]}
    />
    <section aria-labelledby="what-h">
      <h2 id="what-h">What is a gaming buddy?</h2>
      <p>
        A gaming buddy is somebody who plays with you regularly rather than
        once, and the word covers 3 quite different asks: a duo partner for
        ranked, a relaxed companion for casual or co-op evenings, and a filled
        seat when a group is short. Name which of the 3 you want, because a
        ranked duo and a survival partner want opposite things from an evening.
        A booked buddy on Duoly is a reviewed player who joins for a set number
        of games or hours, on your own account, with the rank, the mode and the
        voice setup agreed in the order chat before anyone queues. For example,
        a player tired of silent randoms books a session from {from} in 2026
        instead, which settles the time and the rank. A {floor.name} session
        starts at {floor.cheapest.display} per {floor.cheapest.unit}, which is
        the floor of the whole directory below. The same person can be booked
        again from your order history, using Discord.
      </p>
    </section>
    <section aria-labelledby="free-h">
      <h2 id="free-h">How do you find people to play games with for free?</h2>
      <p>
        Finding people to play games with for free is the right first try, and 3
        routes cost nothing at all. The game itself: in-client group finders,
        Squad Fill and party invites put a stranger beside you in seconds, with
        no agreed time and no comms. Game Discords and LFG channels, where a
        post naming your region, your rank, your role and your mode gets
        answered far more often than a bare "anyone want to play". The people
        you already enjoyed a match with: add them after the game rather than
        scrolling a server. For example, a post with all 4 fields beats a
        one-line post. A paid booking from Duoly at {from} buys the parts free
        routes cannot promise: a set time, a named rank and comms settled before
        the first queue, agreed using Discord.
      </p>
    </section>
    <section aria-labelledby="games-h">
      <h2 id="games-h">Which game do you want a buddy for?</h2>
      <p class="section-intro">
        A teammate directory is one card per game Duoly sells sessions in, with
        the cheapest real session in that game rather than a headline number.
        {withPage.length} of the {games.length} games have a dedicated LFG or
        duo page with the modes, a preparation checklist and a worked example.
        The rest start from a game hub carrying the same price cards, and every
        session across the directory starts at {from} in 2026, read from Duoly’s
        pricing engine. A card price is the floor, because a ranked session is
        priced by your own rank while casual and co-op modes hold one price for
        everybody. For example, a Minecraft card starts at an hourly price,
        since a Minecraft session has no fixed length. Press Book to open
        checkout with the game preselected, then agree the mode and the voice
        setup using Discord.
      </p>
      <div class="directory-grid">
        {games.map((game) => (
          <article class="card directory-card">
            <img
              src={game.img}
              alt={`${game.name} game art`}
              width="44"
              height="44"
              loading="lazy"
              decoding="async"
            />
            <strong class="directory-name">{game.name}</strong>
            <span class="directory-list">
              {game.titles.slice(0, 4).join(', ')}
            </span>
            <span class="directory-price">
              <span class="from">From </span>
              <span class="money">{game.cheapest.display}</span> /{' '}
              {game.cheapest.unit}
            </span>
            <div class="directory-links">
              <a class="btn-sm" href={bookingHref(game.id, { tab: 'duo' })}>
                Book
              </a>
              <a href={game.path}>
                {game.dedicated
                  ? `${game.name} teammate guide`
                  : `${game.name} hub`}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <Steps
      heading="How do you book a gaming buddy?"
      steps={[
        `Pick the game, the mode and how much time you want: a single game, a bundle of 3 or 5, or an hour in the games sold by time. Sessions start at ${from} in 2026.`,
        'Add your region, rank, role and language. The written request is the first thing your buddy reads, so name the mode and the kind of evening you want. For example, "EU, Gold, support, ranked, short calls" answers all 5 at once.',
        'Meet in the order chat, agree on voice using Discord and send the invite yourself. Your buddy plays from a separate account, so your login stays private.',
      ]}
    >
      <p>
        Duoly reviews every teammate before any order. Read about{' '}
        <a href="/contact">the team behind Duoly</a>, check the{' '}
        <a href="/terms">payment, cancellation and refund terms</a>, or browse{' '}
        <a href="/coaching">esports coaching</a> when you want a lesson rather
        than company.
      </p>
    </Steps>
    <Topics
      label="Gaming buddies"
      sections={[
        {
          heading: 'What makes a good gaming partner?',
          paragraphs: [
            'A good gaming partner is a match on 3 things rather than on rank alone: the mode you both want to play, the hours you are both online, and how much talking you each want. Mode is the one people skip. A ranked grinder and a player who wants a relaxed evening will annoy each other inside one match, however well matched the ranks are.',
            `Say early how you like comms, because "short calls only" and "chat the whole time" are both fine and only one of them is what you want. For example, a player who hates being coached mid game should say so before the first queue. A booked buddy from Duoly starts at ${from} in 2026 and arrives already knowing all 3 answers, because the order chat asked for them first, agreed using Discord.`,
          ],
        },
        {
          heading: 'Do you want a teammate, a coach or just company?',
          paragraphs: [
            'Choose a teammate for playing together, a coach for learning, or Social for company without a game. A teammate is a partner in the mode you choose, with calls and coordination during play. A coach is a teacher for one problem. Bring a replay or a question and ask for a practice task. For example, choose coaching to understand a repeated Valorant retake mistake; choose a teammate to play the next match together.',
            `Duoly Social is company without a game at ${socialPrice} per hour: Just Chat, Watch Together, Sleep Call or Karaoke on voice, for adults only. For example, somebody who wants conversation on a quiet evening books Social rather than a ranked duo. All 3 run using Discord and on your own account, and teammate sessions start at ${from} in 2026. Bundles cut the total on the main teammate service.`,
          ],
        },
      ]}
    />
    <Faq heading="Questions before you book a buddy?" items={faqItems} />
    <ClosingCta
      heading="Ready to find a gaming buddy?"
      text={`A Duoly booking is one reviewed player for the games or hours you choose, across the ${games.length} games above. Pick your game from the grid. Before playing, confirm your mode and rank in the order chat. Test voice using Discord and send an invite from your own account, so the booked time starts with the lobby ready.`}
      extra={`Check the service before choosing a bundle. The main teammate service offers ${bundle[0]}% off 3 units, ${bundle[1]}% off 5 and ${bundle[2]}% off 10. Other services have their own quantity options, so check the unit and total before payment. For example, a Minecraft hour and a Valorant game measure different amounts of playing time. A duo booking adds 1 player to your party. Choose a Teams service when you need several seats filled. ${withPage.length} of the ${games.length} games above have dedicated teammate pages explaining the modes. Sessions start at`}
      href={bookingHref('mr', { service: 'duo2' })}
      label="Find your gaming buddy"
      price={price}
      art={{ src: '/assets/games/marvel-rivals.png', alt: '' }}
    />
    <nav class="related" aria-label="Related pages">
      <h2>Keep exploring</h2>
      <div class="chips">
        <a href="/coaching">Esports coaching by game</a>
        <a href="/blog/what-does-lfg-mean">What does LFG mean?</a>
        <a href="/blog/free-lfg-or-paid-teammate">
          Free LFG or a paid teammate?
        </a>
        <a href="/blog/how-to-find-a-valorant-duo">
          How to find a Valorant duo
        </a>
        <a href="/games/social">Social sessions without a game</a>
        <a href="/games">All games and services</a>
        <a href="/compare/e-pal">Duoly vs E-Pal compared</a>
        {withPage.slice(0, 6).map((game) => (
          <a href={game.path}>{game.name} teammates</a>
        ))}
        <a href="/get-paid-to-play-games">Get paid to play games</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(article)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faqItems, path, Astro.site!))}
  />
</SiteLayout>

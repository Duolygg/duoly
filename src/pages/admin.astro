---
import ProductLayout from '../layouts/ProductLayout.astro';
import { accountContext } from '../server/auth/context';
const account = accountContext(Astro.request, Astro.cookies);
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
let identity = null;
try {
  identity = await account.identity();
} catch {
  return new Response('Temporarily unavailable', {
    status: 503,
    headers: account.headers,
  });
}
if (identity?.viewer.role !== 'admin')
  return new Response('Not found', { status: 404, headers: account.headers });
---

<ProductLayout
  title="Administration | Duoly"
  viewer={identity.viewer}
  csrf={account.csrf()}
>
  <section style="max-width:960px;margin:32px auto;padding:24px">
    <h1>Administration</h1>
    <p>
      Signed in as {identity.viewer.name}. Operational tools are not connected
      yet. No orders, balances or sample data are shown here.
    </p>
    <a href="/profile">Manage your profile</a>
  </section>
</ProductLayout>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Directory from '../../components/teammates/Directory.astro';
import '../../components/teammates/profiles.css';
import '../../components/teammates/directory.css';
import { SITE_GAMES } from '../../site/games';
import { pageViewer } from '../../site/viewer';
import { accountContext } from '../../server/auth/context';
import {
  publicProfilesEnabled,
  fixturesEnabled,
} from '../../server/teammates/public-profiles';
import { directoryData, filtered } from '../../server/teammates/directory';
import { loadSavedSlugs } from '../../server/teammates/saved';
import { bookingMode } from '../../server/teammates/profile-page';
import { homeLive } from '../../server/home/live';
import { serializeJsonLd } from '../../site/seo';
if (!publicProfilesEnabled()) return Astro.rewrite('/404');
/* ?game= still works for old links; every game also has its own indexable page,
   /games/<game>/teammates, which is where the game menu and tiles now point. */
const requested = Astro.url.searchParams.get('game');
const game = SITE_GAMES.find((g) => g.id === requested || g.slug === requested);
const account = accountContext(Astro.request, Astro.cookies);
const [data, { viewer, csrf }, saved, live] = await Promise.all([
  directoryData(Astro.url.searchParams, game),
  pageViewer(Astro, account),
  loadSavedSlugs(Astro, account),
  homeLive(),
]);
Astro.response.headers.set('Cache-Control', 'no-store');

/**
 * The directory was the only indexable page on the site with no structured data, and an
 * ItemList is what it actually is. Only the profiles that qualify for indexing are listed,
 * so the list never points a crawler at a page marked noindex. Any filtered, sorted or
 * ?game= view is noindex, so it publishes no list of its own.
 */
const indexed =
  data.indexable.length >= 3 && !requested && !filtered(data.filters);
const itemList = indexed
  ? {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      url: new URL('/teammates', Astro.site!).href,
      name: 'Duoly teammates',
      description:
        'Duoly teammates with a public profile, their games and their verified ranks.',
      isPartOf: { '@id': new URL('/#website', Astro.site!).href },
      publisher: { '@id': new URL('/#organization', Astro.site!).href },
      // The newest profile change the directory shows, which is the only
      // date this page can claim honestly: its content is the profiles.
      dateModified: data.indexable
        .map((profile) => profile.updatedAt)
        .sort()
        .at(-1),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: data.indexable.length,
        itemListElement: data.indexable.map((profile, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: new URL(`/teammates/${profile.slug}`, Astro.site!).href,
        })),
      },
    }
  : null;
---

<SiteLayout
  title="Find your next teammate | Duoly"
  description="Meet Duoly teammates, explore their games and verified ranks, and find the play style for your next queue."
  indexing={indexed ? 'index, follow' : 'noindex, follow'}
  viewer={viewer}
  csrf={csrf}
>
  <Directory
    data={data}
    game={game}
    saved={saved}
    saveMode={bookingMode(viewer?.role)}
    csrf={csrf}
    recent={live.recentMatches}
    fixture={fixturesEnabled()}
  />
  {itemList && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={serializeJsonLd(itemList)}
    />
  )}
</SiteLayout>

<script src="../../components/teammates/directory.ts"></script>

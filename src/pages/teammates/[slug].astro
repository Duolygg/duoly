---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import TeammateCard from '../../components/teammates/TeammateCard.astro';
import Icon from '../../components/teammates/Icon.astro';
import TrophyCase from '../../components/teammates/TrophyCase.astro';
import { loadPublicTrophies } from '../../server/teammates/trophies';
import { trophyCase } from '../../server/teammates/trophy-view';
import { recommendFor } from '../../server/teammates/recommend';
import { seoOffers } from '../../server/seo/offers';
import '../../components/teammates/profiles.css';
import {
  loadPublicProfile,
  loadTeammateCards,
  publicProfilesEnabled,
  fixturesEnabled,
} from '../../server/teammates/public-profiles';
import {
  accentStyle,
  bookingLine,
  bookingMode,
  nameChars,
  profileAnswers,
  profileRoute,
  profileMetadata,
  profilePresentation,
  profileSchemas,
  profileGame,
  profileMonth,
  profileReviewLayout,
  pickLabel,
  rankEmblem,
} from '../../server/teammates/profile-page';
import { publicAvatarIsPhoto } from '../../server/teammates/public-avatar';
import { serializeJsonLd } from '../../site/seo';
import { pageViewer } from '../../site/viewer';
const result = publicProfilesEnabled()
  ? await loadPublicProfile(Astro.params.slug ?? '')
  : ({ status: 'missing' } as const);
const route = profileRoute(publicProfilesEnabled(), result);
if (route.status === 404) return Astro.rewrite('/404');
if (route.status === 301) return Astro.redirect(route.location!, 301);
Astro.response.status = route.status;
const { viewer, csrf } = await pageViewer(Astro);
Astro.response.headers.set('Cache-Control', 'no-store');
const p = result.status === 'ok' ? result.profile : null;
const view = p ? profilePresentation(p) : null;
const meta = p
  ? profileMetadata(p)
  : {
      title: 'Profile no longer available | Duoly',
      description:
        'This teammate profile is no longer public. Find another teammate on Duoly.',
      indexing: 'noindex, follow' as const,
    };
const related = p
  ? await loadTeammateCards({
      game: p.featuredGame,
      excludeSlug: p.slug,
      /* The related row is a moving strip now, so it can show everyone who fits rather
         than the first three. */
      limit: 12,
    })
  : [];
const schemas = p ? profileSchemas(p, Astro.site!) : [];
/* Approved trophies only; the case is simply absent when there are none. */
const trophies = p ? trophyCase(await loadPublicTrophies(p.slug)) : [];
const fixture = fixturesEnabled();
const reviews = p ? profileReviewLayout(p.reviews) : { lead: null, rest: [] };
const featuredRank =
  p?.games.find((g) => g.game === p.featuredGame && g.verified)?.rank ?? null;
/** One sentence about taking orders right now, reused by the closing band. */
const availability = p?.online ? 'Online now, ready to play' : null;
/*
 * A teammate who uploaded a profile picture gets their own face here, not a mascot. The file is a
 * 256 px square crop, so it is clipped to the ring and covered rather than drawn in its own light,
 * and it never renders above 160 CSS px (2x density at the largest it is shown).
 */
const photo = p ? publicAvatarIsPhoto(p.avatar) : false;
/*
 * Booking with a named teammate (plan option 1). Pressing a booking button saves the teammate to
 * the customer's favorites first, which is the one thing that changes the queue for them: a
 * favorite sees the order the moment it goes public, with no priority delay
 * (order_visible_at, 20261106150000_customer_favorites.sql). Checkout itself is untouched; the
 * buttons still point at the existing booking link, and that link is where the browser lands
 * whether the save worked or not.
 *
 * Nothing puts a sign-in wall in front of booking. A signed-out visitor goes to the same booking
 * link at the same speed and leaves a pending-favorite cookie behind; checkout asks them to sign
 * in before paying, and the after-login path spends that cookie for them
 * (src/server/teammates/pending-favorite.ts). Everything degrades to the plain booking link
 * without JavaScript.
 */
const saveMode = bookingMode(viewer?.role);
/*
 * Nothing on this page is rendered with a placeholder. Every teammate on Duoly today is new, so
 * the sections that have no data yet are simply not there, and the section nav lists what the
 * page actually contains. An empty reviews heading reads as a broken page; leaving it out does
 * not.
 */
const hasReviews = Boolean(
  p && (p.reviewTags.length > 0 || reviews.lead || reviews.rest.length > 0),
);
/*
 * The three answers the audit found missing: a profile was a name, a plate, a price and about
 * forty words. They are written from this profile's own data (profileAnswers), so a page with no
 * verified rank and no finished sessions says that rather than borrowing a sentence.
 */
const answers = p ? profileAnswers(p) : [];
const sections = [
  ...(trophies.length > 0 ? [{ id: 'trophies', label: 'Trophies' }] : []),
  { id: 'games', label: 'Games' },
  ...(hasReviews ? [{ id: 'reviews', label: 'Reviews' }] : []),
  ...(related.length > 0 ? [{ id: 'more', label: 'More teammates' }] : []),
];
/* The answers are not a tab. A fourth entry pushes the nav row to within 13 px of a 360 px
   viewport, and the row is the shared design; the section sits where the reader arrives
   anyway, between the last section and the closing band. */
/** One tab is not a nav, so the first section draws its own rule instead. */
const showTabs = sections.length > 1;
/*
 * The moving strips (reviews and related teammates). A strip is one set of cards followed by an
 * identical copy, and the track slides left by exactly half its width, so the loop never shows a
 * seam. A short list is repeated inside the set until it is wide enough to fill the row. Only
 * the first copy of each item is real to assistive tech and the keyboard; every repeat is
 * aria-hidden and inert, so a review is read once and a card is one tab stop.
 */
const reel = <T,>(items: T[], min: number) =>
  Array.from(
    { length: Math.max(1, Math.ceil(min / Math.max(1, items.length))) },
    (_, copy) => items.map((item) => ({ item, repeat: copy > 0 })),
  ).flat();
const allReviews = p
  ? (reviews.lead ? [reviews.lead] : []).concat(reviews.rest)
  : [];
const reviewRows =
  allReviews.length === 0
    ? []
    : allReviews.length >= 3
      ? [reel(allReviews, 5), reel([...allReviews].reverse(), 5)]
      : [reel(allReviews, 5)];
const relatedReel = reel(related, 6);
/*
 * The "reading the room" sequence over the booking answers. Every step is something the answers
 * are actually built from (profileAnswers): the reviews, the themes customers mention most, the
 * verified ranks and how this teammate plays. A step only appears when there is data behind it.
 */
const thinkSteps = p
  ? [
      ...(view?.rating
        ? [
            {
              label: `Reading ${view.rating.count} customer reviews`,
              count: view.rating.count,
              chips: [] as string[],
            },
          ]
        : []),
      ...(p.reviewTags.length
        ? [
            {
              label: 'Weighing what players mention most',
              count: 0,
              chips: p.reviewTags
                .slice(0, 4)
                .map((t) => `${t.tag} · ${t.count}`),
            },
          ]
        : []),
      ...(p.games.some((g) => g.verified && g.rank)
        ? [
            {
              label: 'Checking the ranks Duoly verified',
              count: 0,
              chips: p.games
                .filter((g) => g.verified && g.rank)
                .map((g) => `${profileGame(g.game).name} · ${g.rank}`),
            },
          ]
        : []),
      {
        label: `Matching how ${p.name} plays`,
        count: 0,
        chips: [
          ...(p.games.find((g) => g.game === p.featuredGame)?.roles ?? []),
          ...p.languages,
        ].slice(0, 5),
      },
      { label: 'Writing it up for you', count: 0, chips: [] as string[] },
    ]
  : [];
/** What a Social session can be, named on the Social game card (the catalog's own titles). */
const socialSessions = [
  ...new Set(
    seoOffers('social', 'gg', { customerCurrency: 'EUR', eurToUsd: 1 }).map(
      (o) => o.title,
    ),
  ),
];
/** Our pick: the product that fits a session with this teammate, and the facts behind it. */
const pick = p ? recommendFor(p) : null;
/** The booking explainer, one line under the price and the availability it belongs with. */
const bookingNote = p ? bookingLine(p) : '';
/*
 * The share sheet. Every target is a plain link built here, so the sheet works the moment it
 * opens and costs no script per app. The OS share sheet is still offered, but only as "More",
 * behind our own sheet, never as the first thing a click opens.
 */
const shareUrl = p ? new URL(`/teammates/${p.slug}`, Astro.site!).href : '';
const shareLine =
  p && view
    ? featuredRank
      ? `${p.name}, ${view.game.name} ${featuredRank} teammate on Duoly`
      : `${p.name}, ${view.game.name} teammate on Duoly`
    : '';
const enc = encodeURIComponent;
/*
 * Where players actually send a teammate: Discord first (friend groups and clan servers), then
 * WhatsApp, Instagram and Snapchat DMs, then X and Reddit for the gaming crowd. Six, so the row
 * fits a phone; "Copy link" covers everything else. Discord, Instagram and Snapchat have no web
 * address that prefills a message, so those buttons copy the link and open the app's messages,
 * where pasting is the one step left (copyFirst, handled by the share script).
 */
const shareApps: {
  id: string;
  label: string;
  href: string;
  copyFirst?: string;
}[] = p
  ? [
      {
        id: 'discord',
        label: 'Discord',
        href: 'https://discord.com/channels/@me',
        copyFirst: 'Paste it in any Discord chat or server.',
      },
      {
        id: 'whatsapp',
        label: 'WhatsApp',
        href: `https://wa.me/?text=${enc(`${shareLine} ${shareUrl}`)}`,
      },
      {
        id: 'instagram',
        label: 'Instagram',
        href: 'https://www.instagram.com/direct/inbox/',
        copyFirst: 'Paste it in an Instagram DM.',
      },
      {
        id: 'snapchat',
        label: 'Snapchat',
        href: 'https://web.snapchat.com/',
        copyFirst: 'Paste it in a Snapchat chat.',
      },
      {
        id: 'x',
        label: 'X',
        href: `https://x.com/intent/tweet?text=${enc(shareLine)}&url=${enc(shareUrl)}`,
      },
      {
        id: 'reddit',
        label: 'Reddit',
        href: `https://www.reddit.com/submit?url=${enc(shareUrl)}&title=${enc(shareLine)}`,
      },
    ]
  : [];
---

<SiteLayout {...meta} viewer={viewer} csrf={csrf}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(schemas)}
  />
  {p && view ? (
    <article
      class="tp-page"
      style={`${accentStyle(p.accent)};--name-chars:${nameChars(p.name)}`}
      data-banner={p.banner}
      data-tier={p.tier}
      data-profile={p.slug}
      data-save-mode={saveMode}
      data-csrf={saveMode === 'customer' ? csrf : undefined}
    >
      {fixture && (
        <p class="tp-fixture">
          Design preview. These teammates and reviews are fictional.
        </p>
      )}
      <section class="tp-hero" aria-labelledby="profile-name">
        {/*
          The teammate's own header picture, when they uploaded one. It comes before the pool of
          light in the markup on purpose: both layers sit at z-index 0, so the light and every
          word paint over the picture. The file is already the 1500x500 strip the cropper wrote,
          so one file serves every width, and the box takes its height from the aspect ratio
          rather than from the picture, which means the hero never moves while it loads.
        */}
        {p.header && (
          <span class="tp-hero-art" aria-hidden="true">
            <img
              src={p.header}
              width="1500"
              height="500"
              alt=""
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </span>
        )}
        <span class="tp-sky" aria-hidden="true"></span>
        {/* Motion layers: two slow drifting lights, and a soft spotlight that follows the
            pointer. Decorative only, and still when the visitor asks for reduced motion. */}
        <span class="tp-aurora" aria-hidden="true"></span>
        <span class="tp-spot" aria-hidden="true"></span>
        <div class="tp-hero-top">
          {/* Two round glass buttons. The words live in a tooltip that is also the
              accessible name, so the pair stays small enough to clear the avatar ring. */}
          <div class="tp-utilities">
            {saveMode === 'customer' ? (
              <button
                class="tp-util tp-save"
                type="button"
                aria-pressed="false"
                data-profile-save
                data-saved-label={`${p.name} is in your favorites`}
              >
                <Icon name="heart" />
                <span class="tp-tip" data-save-label>
                  Save {p.name}
                </span>
              </button>
            ) : (
              saveMode === 'signin' && (
                <a class="tp-util tp-save" href="/login" data-profile-signin>
                  <Icon name="heart" />
                  <span class="tp-tip">Save {p.name}</span>
                </a>
              )
            )}
            <a
              class="tp-util"
              href={`#share-${p.slug}`}
              aria-haspopup="dialog"
              data-profile-share
            >
              <Icon name="share" />
              <span class="tp-tip">Share</span>
            </a>
          </div>
          <p class="tp-save-status" role="status" data-save-status></p>
        </div>
        <dialog
          id={`share-${p.slug}`}
          class="tp-sharebox"
          aria-labelledby="share-title"
          data-share-dialog
        >
          <div class="tp-sharebox-head">
            <p id="share-title" class="tp-sharebox-title">
              Share {p.name}
            </p>
            <button
              class="tp-sharebox-close"
              type="button"
              aria-label="Close"
              data-share-close
            >
              <svg
                viewBox="0 0 16 16"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <path
                  d="M4 4l8 8M12 4l-8 8"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                ></path>
              </svg>
            </button>
          </div>
          <div class="tp-sharebox-card">
            <img
              class:list={{ 'is-photo': photo }}
              src={p.avatar}
              width="56"
              height="56"
              alt=""
              loading="lazy"
            />
            <div>
              <strong>{p.name}</strong>
              <span>
                {featuredRank
                  ? `${view.game.name}, ${featuredRank}`
                  : view.game.name}
              </span>
            </div>
          </div>
          <div class="tp-sharebox-copy">
            <input aria-label="Profile link" readonly value={shareUrl} />
            <button type="button" data-share-copy>
              <svg
                viewBox="0 0 16 16"
                width="15"
                height="15"
                aria-hidden="true"
              >
                <rect
                  x="5.25"
                  y="5.25"
                  width="8"
                  height="8"
                  rx="2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                ></rect>
                <path
                  d="M10.75 3.5V3.25a1.5 1.5 0 0 0-1.5-1.5h-4.5a2 2 0 0 0-2 2v4.5a1.5 1.5 0 0 0 1.5 1.5h.25"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                ></path>
              </svg>
              <span data-share-copy-label>Copy link</span>
            </button>
          </div>
          <ul class="tp-sharebox-apps" aria-label="Share to">
            {shareApps.map((app) => (
              <li>
                <a
                  href={app.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-share-app={app.id}
                  data-share-copy-first={app.copyFirst}
                >
                  <span class="tp-sharebox-icon" aria-hidden="true">
                    {app.id === 'whatsapp' && (
                      <svg viewBox="0 0 24 24">
                        <path
                          d="M12 3.2a8.7 8.7 0 0 0-7.5 13.2L3.3 20.8l4.5-1.2A8.7 8.7 0 1 0 12 3.2Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round"
                        ></path>
                        <path
                          d="M9 8.3c.3-.6.6-.6.9-.6h.5c.2 0 .4 0 .6.5l.7 1.6c.1.2.1.4 0 .6l-.5.6c-.1.2-.1.4 0 .6.6 1 1.3 1.6 2.3 2.1.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.4.5 0 .7-.4 1.4-1.1 1.7-.8.3-1.9.2-3.4-.6a9.3 9.3 0 0 1-3.6-3.6C8.6 10.2 8.6 9 9 8.3Z"
                          fill="currentColor"
                        ></path>
                      </svg>
                    )}
                    {app.id === 'discord' && (
                      <svg viewBox="0 0 24 24">
                        <path
                          d="M19.3 5.4A16.6 16.6 0 0 0 15.2 4l-.5 1a15.4 15.4 0 0 0-5.4 0l-.5-1a16.6 16.6 0 0 0-4.1 1.4C2.1 9.4 1.4 13.2 1.8 17a16.7 16.7 0 0 0 5 2.6l1.1-1.7a10.8 10.8 0 0 1-1.7-.8l.4-.3a11.9 11.9 0 0 0 10.8 0l.4.3c-.5.3-1.1.6-1.7.8l1.1 1.7a16.6 16.6 0 0 0 5-2.6c.5-4.4-.8-8.2-2.9-11.6ZM8.6 14.7c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.8 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z"
                          fill="currentColor"
                        ></path>
                      </svg>
                    )}
                    {app.id === 'instagram' && (
                      <svg viewBox="0 0 24 24">
                        <rect
                          x="3.5"
                          y="3.5"
                          width="17"
                          height="17"
                          rx="5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                        ></rect>
                        <circle
                          cx="12"
                          cy="12"
                          r="3.9"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                        ></circle>
                        <circle
                          cx="17.1"
                          cy="6.9"
                          r="1.1"
                          fill="currentColor"
                        ></circle>
                      </svg>
                    )}
                    {app.id === 'snapchat' && (
                      <svg viewBox="0 0 24 24">
                        <path
                          d="M12 3.3c2.9 0 4.9 2.2 4.9 5v2.1l1.6-.6c.6-.2 1.1.5.6.9l-1.9 1.3c.6 1.8 1.9 3.1 3.6 3.6.5.2.5.8 0 1-.8.3-1.7.4-2.4.6-.3.1-.4.9-.7 1.1-.3.2-1.2-.1-2 0-1.1.1-1.9 1.5-3.7 1.5s-2.6-1.4-3.7-1.5c-.8-.1-1.7.2-2 0-.3-.2-.4-1-.7-1.1-.7-.2-1.6-.3-2.4-.6-.5-.2-.5-.8 0-1 1.7-.5 3-1.8 3.6-3.6L4.9 10.6c-.5-.4 0-1.1.6-.9l1.6.6V8.3c0-2.8 2-5 4.9-5Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linejoin="round"
                        ></path>
                      </svg>
                    )}
                    {app.id === 'x' && (
                      <svg viewBox="0 0 24 24">
                        <path
                          d="M17.6 3.5h3l-6.6 7.6 7.8 9.4h-6.1l-4.8-5.9-5.5 5.9h-3l7-7.9-7.4-9.1h6.2l4.3 5.4 5.1-5.4Zm-1 15.3h1.7L7.5 5.1H5.7l10.9 13.7Z"
                          fill="currentColor"
                        ></path>
                      </svg>
                    )}
                    {app.id === 'reddit' && (
                      <svg viewBox="0 0 24 24">
                        <ellipse
                          cx="12"
                          cy="14.2"
                          rx="7.6"
                          ry="5.4"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                        ></ellipse>
                        <circle
                          cx="9.2"
                          cy="13.6"
                          r="1.2"
                          fill="currentColor"
                        ></circle>
                        <circle
                          cx="14.8"
                          cy="13.6"
                          r="1.2"
                          fill="currentColor"
                        ></circle>
                        <path
                          d="M9.3 16.6c1.6 1 3.8 1 5.4 0M12 8.8l1.2-4.6 3.6.9"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        ></path>
                        <circle
                          cx="18"
                          cy="5.4"
                          r="1.5"
                          fill="currentColor"
                        ></circle>
                      </svg>
                    )}
                  </span>
                  <span class="tp-sharebox-label">{app.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="tp-sharebox-hint" data-share-hint hidden></p>
          <p class="tp-sharebox-status" role="status" data-share-status></p>
        </dialog>
        <div class="tp-hero-grid">
          <div class="tp-hero-name">
            <h1 id="profile-name">{p.name}</h1>
            {/* The game's own icon at text size. A solid coloured crest here read as a
                warning sign rather than as a game, and the icon is the thing a player
                recognises without reading. */}
            <p class="tp-rankline">
              <img
                class="tp-rankline-icon"
                src={view.game.img}
                width="22"
                height="22"
                alt=""
                fetchpriority="high"
              />
              <span>
                {featuredRank
                  ? `${view.game.name}, ${featuredRank}`
                  : view.game.name}
              </span>
              {featuredRank && (
                <span
                  class="tp-verified"
                  role="img"
                  aria-label="Rank verified by Duoly"
                >
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="m5 12.5 4.5 4.5L19 7.5"
                      stroke="currentColor"
                      stroke-width="3.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              )}
              {p.gamerGirl && (
                <span
                  class="tp-gg-badge"
                  title="Verified by Duoly as a Gamer Girl"
                >
                  <svg
                    viewBox="0 0 16 16"
                    width="12"
                    height="12"
                    aria-hidden="true"
                  >
                    <path
                      d="M8 1.5 9.6 6.4l4.9 1.6-4.9 1.6L8 14.5 6.4 9.6 1.5 8l4.9-1.6Z"
                      fill="currentColor"
                    ></path>
                  </svg>
                  Verified Gamer Girl
                </span>
              )}
            </p>
          </div>
          <div class="tp-aside">
            <div class:list={['tp-figure', { 'tp-figure-photo': photo }]}>
              <span class="tp-ring" aria-hidden="true"></span>
              <img
                src={p.avatar}
                width="160"
                height="160"
                alt={
                  photo
                    ? `${p.name}, teammate on Duoly`
                    : `${p.name}'s robot avatar`
                }
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="tp-identity">
              {view.showTier && (
                <p class="tp-plate">
                  <svg viewBox="0 0 40 48" fill="none" aria-hidden="true">
                    <path
                      d="M20 2 37 11 33 33 20 45 7 33 3 11Z"
                      stroke="currentColor"
                    />
                    <path
                      d="m10 17 10 17 10-17M13 12l7 12 7-12"
                      stroke="currentColor"
                      stroke-width="3"
                    />
                  </svg>
                  <strong>{p.tier}</strong>
                </p>
              )}
              <dl class="tp-idlist">
                <div>
                  <dt>Member since</dt>
                  <dd>{profileMonth(p.memberSince)}</dd>
                </div>
                {p.languages.length > 0 && (
                  <div>
                    <dt>Speaks</dt>
                    <dd>{p.languages.join(', ')}</dd>
                  </div>
                )}
                {p.country && (
                  <div>
                    <dt>Based in</dt>
                    <dd>{p.country}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>
          <div class="tp-hero-body">
            {p.bio && <p class="tp-bio">{p.bio}</p>}
            {p.vibeTags.length > 0 && (
              <ul class="tp-vibes" aria-label="Play style">
                {p.vibeTags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
            <div class="tp-cta" data-hero-booking>
              <div class="tp-buy">
                <a
                  class="tp-button tp-primary"
                  href={view.book}
                  data-profile-book="primary"
                >
                  {view.primary}
                  <Icon name="arrow" />
                </a>
                {view.offer && (
                  <p class="tp-price" data-profile-price>
                    from <strong>{view.offer.display}</strong> per{' '}
                    {view.offer.unit}
                  </p>
                )}
              </div>
              {p.coaching && (
                <div class="tp-buy tp-buy-quiet">
                  <a
                    class="tp-button tp-ghost"
                    href={view.booking(p.featuredGame, true)}
                    data-profile-book="game"
                  >
                    Coaching with {p.name}
                  </a>
                  {view.coachOffer && (
                    <p class="tp-price tp-price-quiet">
                      from <strong>{view.coachOffer.display}</strong> per{' '}
                      {view.coachOffer.unit}
                    </p>
                  )}
                </div>
              )}
              {availability && (
                <p class="tp-availability">
                  <i aria-hidden="true"></i>
                  {availability}
                </p>
              )}
              <p class="tp-note">{bookingNote}</p>
            </div>
          </div>
        </div>
        {view.showStats ? (
          <div class="tp-scoreboard" aria-label={`${p.name}'s track record`}>
            {view.rating && (
              <a class="tp-stat" href="#reviews">
                <strong>
                  {view.rating.average.toFixed(1)}
                  <span class="tp-unit" aria-hidden="true">
                    ★
                  </span>
                </strong>
                <span class="tp-stat-name">Customer rating</span>
                <span class="tp-stat-sub">
                  from {view.rating.count} reviews
                </span>
              </a>
            )}
            {view.showSessions && (
              <div class="tp-stat">
                <strong>{p.sessions.toLocaleString('en-US')}</strong>
                <span class="tp-stat-name">Sessions completed</span>
                <span class="tp-stat-sub">on Duoly</span>
              </div>
            )}
            {view.winRate && (
              <div class="tp-stat">
                <strong>
                  {view.winRate.percent}
                  <span class="tp-unit">%</span>
                </strong>
                <span class="tp-stat-name">Win rate</span>
                <span class="tp-stat-sub">
                  from {view.winRate.games} reported matches
                </span>
              </div>
            )}
          </div>
        ) : (
          <div class="tp-fresh" data-profile-new>
            <p class="tp-kicker">New on Duoly</p>
            <p>Ratings and sessions show here after {p.name}'s first games.</p>
          </div>
        )}
      </section>
      {showTabs && (
        <nav class="tp-tabs" aria-label="Profile sections" data-tabs>
          {sections.map((section, i) => (
            <a
              href={`#${section.id}`}
              class:list={{ 'is-current': i === 0 }}
              aria-current={i === 0 ? 'true' : undefined}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
      {trophies.length > 0 && <TrophyCase trophies={trophies} name={p.name} />}
      <section id="games" class="tp-section" aria-labelledby="games-title">
        <div class="tp-section-head">
          <div>
            <h2 id="games-title">Games</h2>
            <p>
              {p.games.some((g) => g.verified && g.rank)
                ? `Ranks verified by Duoly, with the roles ${p.name} plays.`
                : `What ${p.name} is approved to play on Duoly, and how they play it.`}
            </p>
          </div>
        </div>
        <div class="tp-games">
          {p.games.map((g) => {
            const game = profileGame(g.game);
            return (
              <article class="tp-game" data-game={g.game}>
                <div class="tp-game-header">
                  <img
                    src={game.img}
                    width="30"
                    height="30"
                    alt=""
                    loading="lazy"
                  />

      )}
      <section
        id="booking"
        class="tp-section tp-answers"
        aria-labelledby="booking-title"
      >
        <div class="tp-section-head">
          <div>
            <h2 id="booking-title">Booking {p.name}</h2>
            <p>
              What a session is, what Duoly checked and what the queue does.
            </p>
          </div>
        </div>
        {/* The answers below are built from this profile's data. The panel shows that work
            as it happens, step by step, then the answers stream in. Without JavaScript it is
            a finished checklist and the answers are simply there. */}
        <div class="tp-think" data-think>
          <div class="tp-think-head">
            <span class="tp-orb" aria-hidden="true">
              <i></i>
            </span>
            <div>
              <p class="tp-think-title">Reading the room on {p.name}</p>
              <p class="tp-think-status" data-think-status aria-live="polite">
                Everything below comes from {p.name}'s verified profile and
                reviews.
              </p>
            </div>
          </div>
          <ol class="tp-think-steps">
            {thinkSteps.map((step, i) => (
              <li class="tp-think-step" style={`--i:${i}`} data-think-step>
                <span class="tp-think-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="12" height="12">
                    <path
                      d="m3.5 8.5 3 3 6-7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </span>
                <span class="tp-think-label">{step.label}</span>
                {step.chips.length > 0 && (
                  <span class="tp-think-chips">
                    {step.chips.map((chip, c) => (
                      <span class="tp-think-chip" style={`--c:${c}`}>
                        {chip}
                      </span>
                    ))}
                  </span>
                )}
              </li>
            ))}
          </ol>
          <span class="tp-think-scan" aria-hidden="true"></span>
        </div>
        {/* The pick: which product fits a session with this teammate, with the facts that
            decided it (src/server/teammates/recommend.ts). The reasoning runs down the left
            as a chain; the product it lands on is the lit card on the right. */}
        {pick && (
          <div class="tp-pick" data-pick>
            <div class="tp-pick-why">
              <p class="tp-pick-eyebrow">
                <span class="tp-pick-spark" aria-hidden="true"></span>
                Our pick for a session with {p.name}
              </p>
              <p class="tp-pick-intro">
                We weighed {pick.signals} signals from {p.name}'s verified
                profile and reviews. These are the ones that decided it.
              </p>
              <ol class="tp-pick-chain">
                {pick.pick.reasons.map((reason, i) => (
                  <li style={`--i:${i}`} data-pick-reason>
                    <span class="tp-pick-node" aria-hidden="true"></span>
                    <span class="tp-pick-fact">{reason.fact}</span>
                    <span class="tp-pick-because">{reason.because}</span>
                  </li>
                ))}
              </ol>
            </div>
            <div class="tp-pick-card" data-pick-card>
              <span class="tp-pick-shine" aria-hidden="true"></span>
              <div class="tp-pick-top">
                <span class="tp-pick-badge">
                  <svg
                    viewBox="0 0 16 16"
                    width="12"
                    height="12"
                    aria-hidden="true"
                  >
                    <path
                      d="M8 1.5 9.6 6.4l4.9 1.6-4.9 1.6L8 14.5 6.4 9.6 1.5 8l4.9-1.6Z"
                      fill="currentColor"
                    ></path>
                  </svg>
                  Best fit
                </span>
                <span class="tp-pick-who">
                  <img
                    class:list={{ 'is-photo': photo }}
                    src={p.avatar}
                    width="40"
                    height="40"
                    alt=""
                    loading="lazy"
                  />
                  with {p.name}
                </span>
              </div>
              <p class="tp-pick-title">{pick.pick.title}</p>
              <p class="tp-pick-tier">{pick.pick.tier}</p>
              <p class="tp-pick-desc">{pick.pick.desc}</p>
              <p class="tp-pick-price">
                from <strong>{pick.pick.price}</strong> per {pick.pick.unit}
              </p>
              <a
                class="tp-button tp-primary"
                href={pick.pick.href}
                data-profile-book="pick"
              >
                Book {pick.pick.title} with {p.name}
                <Icon name="arrow" />
              </a>
              {pick.alternatives.length > 0 && (
                <p class="tp-pick-alts">
                  <span>Also a good fit</span>
                  {pick.alternatives.map((alt) => (
                    <a href={alt.href} data-profile-book="pick-alt">
                      {alt.title}
                      <small>from {alt.price}</small>
                    </a>
                  ))}
                </p>
              )}
            </div>
          </div>
        )}
        {answers.map((answer) => (
          <div class="tp-answer">
            <h3 id={`answer-${answer.id}`}>{answer.heading}</h3>
            {answer.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ))}
        <p class="tp-answer-links">
          Before you book {p.name}, read{' '}
          <a href="/how-it-works">how Duoly works</a>,{' '}
          <a href="/trust-and-safety">how teammates are reviewed</a> and the{' '}
          <a href="/fees-and-refunds">fees and refunds</a>.
        </p>
      </section>
      <section class="tp-closing" aria-label={`Book ${p.name}`} data-closing>
        <div
          class:list={[
            'tp-figure',
            'tp-figure-small',
            { 'tp-figure-photo': photo },
          ]}
        >
          <span class="tp-ring" aria-hidden="true"></span>
          <img src={p.avatar} width="160" height="160" alt="" loading="lazy" />
        </div>
        <div class="tp-closing-copy">
          <p class="tp-closing-title">Ready when you are.</p>
          <p class:list={['tp-availability', { 'is-off': !p.online }]}>
            <i aria-hidden="true"></i>
            {availability ?? `${p.name} is offline right now`}
          </p>
        </div>
        <a
          class="tp-button tp-primary"
          href={view.book}
          data-profile-book="primary"
        >
          {view.primary}
          <Icon name="arrow" />

                </div>
                <div class="tp-rank">
                  <svg
                    class="tp-rank-glyph"
                    viewBox="0 0 64 72"
                    aria-hidden="true"
                  >
                    <path class="tp-rank-shape" d={rankEmblem(g.game).shape} />
                    <path class="tp-rank-mark" d={rankEmblem(g.game).mark} />
                  </svg>
                  <div>
                    <p class="tp-rank-label">
                      {g.game === 'social'
                        ? 'Gamer Girl'
                        : g.verified && g.rank
                          ? 'Rank verified'

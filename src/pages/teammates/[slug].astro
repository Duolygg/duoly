  ) : (
    <div class="tp-page tp-gone">
      <PageIntro
        eyebrow="410 / Off air"
        title="This player has left the spotlight."
        lead="This teammate profile is no longer public. There's still a lobby waiting for you."
        centered
      >
        <a class="tp-button tp-primary" href="/teammates">
          Find a teammate
          <Icon name="arrow" />
        </a>
      </PageIntro>
    </div>
  )}
</SiteLayout>
<script>
  /* Motion: the pointer-driven parts of the hero. Like the
     homepage, it plays for every visitor, whatever their OS animation setting. */
  const hero = document.querySelector<HTMLElement>('.tp-hero');
  const figure = hero?.querySelector<HTMLElement>('.tp-figure');

  /* Spotlight and avatar tilt follow a mouse or pen, never a finger. */
  if (hero && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let frame = 0;
    hero.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const box = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', `${event.clientX - box.left}px`);
        hero.style.setProperty('--my', `${event.clientY - box.top}px`);
        hero.classList.add('is-lit');
        if (!figure) return;
        const art = figure.getBoundingClientRect();
        const dx = (event.clientX - (art.left + art.width / 2)) / box.width;
        const dy = (event.clientY - (art.top + art.height / 2)) / box.height;
        const clamp = (v: number) => Math.max(-1, Math.min(1, v));
        figure.style.setProperty('--ry', `${clamp(dx * 2) * 14}deg`);
        figure.style.setProperty('--rx', `${clamp(dy * 2) * -14}deg`);
      });
    });
    hero.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      hero.classList.remove('is-lit');
      figure?.style.setProperty('--rx', '0deg');
      figure?.style.setProperty('--ry', '0deg');
    });
  }

  /* Review cards tilt toward the pointer and carry a glare where it sits. */
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>(
      '[data-review]',
    )) {
      let raf = 0;
      card.addEventListener('pointermove', (event) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const box = card.getBoundingClientRect();
          const x = (event.clientX - box.left) / box.width;
          const y = (event.clientY - box.top) / box.height;
          /* Wide cards tilt less, so the featured quote never swings. */
          const range = box.width > 800 ? 2.5 : 5;
          card.style.setProperty('--ry', `${(x - 0.5) * range * 2}deg`);
          card.style.setProperty('--rx', `${(0.5 - y) * range * 2}deg`);
          card.style.setProperty('--gx', `${x * 100}%`);
          card.style.setProperty('--gy', `${y * 100}%`);
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    }
  }

  /* Booking: the panel plays out the steps the answers are built from, then the answers
     stream in. It starts when the section comes into view and runs once. */
  const think = document.querySelector<HTMLElement>('[data-think]');
  const answersSection = think?.closest<HTMLElement>('.tp-answers');
  if (think && answersSection && 'IntersectionObserver' in window) {
    const status = think.querySelector<HTMLElement>('[data-think-status]');
    const steps = [...think.querySelectorAll<HTMLElement>('[data-think-step]')];
    const finalStatus = status?.textContent?.trim() ?? '';
    const name = think
      .querySelector('.tp-think-title')
      ?.textContent?.replace('Reading the room on ', '')
      .trim();
    /* Every word of the answers becomes its own span so it can arrive on its own beat. Only
       text nodes are split, so links and headings keep their markup and their text. */
    const words: HTMLElement[] = [];
    for (const block of answersSection.querySelectorAll<HTMLElement>(
      '.tp-answer, .tp-answer-links',
    )) {
      const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      for (const node of nodes) {
        const parts = (node.textContent ?? '').split(/(\s+)/);
        const fragment = document.createDocumentFragment();
        for (const part of parts) {
          if (!part) continue;
          if (/^\s+$/.test(part)) {
            fragment.append(part);
            continue;
          }
          const word = document.createElement('span');
          word.className = 'tp-w';
          word.textContent = part;
          words.push(word);
          fragment.append(word);
        }
        node.replaceWith(fragment);
      }
    }
    think.classList.add('is-armed');
    answersSection.classList.add('is-armed');
    const pickBox = answersSection.querySelector<HTMLElement>('[data-pick]');
    const pickChain = pickBox?.querySelector<HTMLElement>('.tp-pick-chain');
    const pickReasons = [
      ...(pickBox?.querySelectorAll<HTMLElement>('[data-pick-reason]') ?? []),
    ];
    pickBox?.classList.add('is-armed');

    const wait = (ms: number) =>
      new Promise((resolve) => window.setTimeout(resolve, ms));
    const run = async () => {
      think.classList.add('is-running');
      for (const step of steps) {
        const label = step.querySelector<HTMLElement>('.tp-think-label');
        const chips = step.querySelectorAll('.tp-think-chip').length;
        if (status && label) status.textContent = `${label.textContent}…`;
        step.classList.add('is-active');
        const time = 850 + chips * 140;
        await wait(time);
        step.classList.remove('is-active');
        step.classList.add('is-done');
        await wait(120);
      }
      think.classList.remove('is-running');
      /* The pick: the chain draws down fact by fact, then the product card lands. */
      if (pickBox && pickChain) {
        if (status) status.textContent = 'Picking the best fit for you…';
        await wait(350);
        for (const [i, reason] of pickReasons.entries()) {
          pickChain.style.setProperty(
            '--drawn',
            String((i + 1) / pickReasons.length),
          );
          reason.classList.add('is-in');
          await wait(520);
        }
        pickBox.classList.add('is-landed');
        await wait(650);
      }
      if (status)
        status.textContent = name
          ? `Done. Here's how booking ${name} works.`
          : finalStatus;
      /* Stream the answers: a steady beat per word, capped so long answers still land in
         about three seconds. */
      const beat = Math.min(0.022, 3 / Math.max(1, words.length));
      words.forEach((word, i) =>
        word.style.setProperty('--d', `${(i * beat).toFixed(3)}s`),
      );
      answersSection.classList.add('is-streaming');
      await wait(words.length * beat * 1000 + 700);
      answersSection.classList.remove('is-armed', 'is-streaming');
      if (status) status.textContent = finalStatus;
    };

    const watcher = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        watcher.disconnect();
        run();
      },
      { threshold: 0.35 },
    );
    watcher.observe(think);
  }

  /* Share opens Duoly's own sheet. Without JavaScript the link still jumps to the sheet,
     which CSS shows when it is the target. */
  const share = document.querySelector<HTMLAnchorElement>(
    '[data-profile-share]',
  );
  const sheet = document.querySelector<HTMLDialogElement>(
    '[data-share-dialog]',
  );
  const input = sheet?.querySelector<HTMLInputElement>('input');
  const status = sheet?.querySelector<HTMLElement>('[data-share-status]');
  const copy = sheet?.querySelector<HTMLButtonElement>('[data-share-copy]');
  const copyLabel = sheet?.querySelector<HTMLElement>(
    '[data-share-copy-label]',
  );
  const hint = sheet?.querySelector<HTMLElement>('[data-share-hint]');
  if (sheet && typeof sheet.showModal === 'function') {
    share?.setAttribute('aria-controls', sheet.id);
    share?.addEventListener('click', (event) => {
      event.preventDefault();
      if (status) status.textContent = '';
      sheet.showModal();
      copy?.focus();
    });
    sheet
      .querySelector('[data-share-close]')
      ?.addEventListener('click', () => sheet.close());
    /* A click on the dimmed page around the sheet lands on the dialog element itself. */
    sheet.addEventListener('click', (event) => {
      if (event.target === sheet) sheet.close();
    });
    let reset = 0;
    copy?.addEventListener('click', async () => {
      if (!input) return;
      try {
        await navigator.clipboard.writeText(input.value);
        copy.classList.add('is-copied');
        if (copyLabel) copyLabel.textContent = 'Copied';
        if (status) status.textContent = 'Link copied.';
        window.clearTimeout(reset);
        reset = window.setTimeout(() => {
          copy.classList.remove('is-copied');
          if (copyLabel) copyLabel.textContent = 'Copy link';
        }, 2200);
      } catch {
        input.focus();
        input.select();
        if (status) status.textContent = 'Press Ctrl+C to copy the link.';
      }
    });
    /* Discord, Instagram and Snapchat cannot prefill a message from the web, so their buttons
       copy the link first; the app opens in a new tab and the hint says what is left: paste. */
    for (const app of sheet.querySelectorAll<HTMLAnchorElement>(
      '[data-share-copy-first]',
    )) {
      app.addEventListener('click', () => {
        if (!input) return;
        navigator.clipboard?.writeText(input.value).then(
          () => {
            if (hint) {
              hint.textContent = `Link copied. ${app.dataset.shareCopyFirst ?? ''}`;
              hint.hidden = false;
            }
          },
          () => {
            input.focus();
            input.select();
          },
        );
      });
    }
  }

  /* The sticky bar is a duplicate of a button that is already on screen while the
     hero block or the closing band is visible, so it steps aside for both. Without
     JavaScript it simply stays, which is the safe default. */
  const bar = document.querySelector<HTMLElement>('[data-sticky-booking]');
  const anchors = document.querySelectorAll<HTMLElement>(
    '[data-hero-booking], [data-closing], .site-footer',
  );
  if (bar && anchors.length && 'IntersectionObserver' in window) {
    const shown = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) shown.add(entry.target);
          else shown.delete(entry.target);
        }
        bar.classList.toggle('is-stowed', shown.size > 0);
      },
      { rootMargin: '0px 0px -72px 0px' },
    );
    for (const anchor of anchors) observer.observe(anchor);
  }

  /* The section nav sticks under the site header, so it has to know how tall that header
     is. Without JavaScript the CSS fallback keeps it readable, it simply sticks a few
     pixels off. The same measurement drives the scroll margin of every section. */
  const page = document.querySelector<HTMLElement>('article.tp-page');
  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  if (page && tabs) {
    const header = document.querySelector<HTMLElement>('.site-header');
    const measure = () =>
      page.style.setProperty(
        '--tp-header',
        `${Math.round(header?.getBoundingClientRect().height ?? 58)}px`,
      );
    measure();
    addEventListener('resize', measure);

    /* Scroll spy: the current tab is the last section that has reached the nav. Clicking a
       tab already works on its own, this only keeps the marker honest while scrolling. */
    const links = [...tabs.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((link) =>
      document.querySelector<HTMLElement>(link.hash),
    );
    let queued = false;
    const spy = () => {
      queued = false;
      const line = tabs.getBoundingClientRect().bottom + 8;
      let index = 0;
      targets.forEach((target, i) => {
        if (target && target.getBoundingClientRect().top <= line) index = i;
      });
      links.forEach((link, i) => {
        link.classList.toggle('is-current', i === index);
        if (i === index) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(spy);
      },
      { passive: true },
    );
    spy();
  }

  /* Booking with a named teammate, and the Save heart. Both put the teammate in the
     customer's favorites through /api/favorites/by-slug, which is the one thing that
     changes the queue for them: a favorite sees the order the moment it goes public,
     with no priority delay. Every booking button is a real link to the existing booking
     page first, so a slow or failing save never costs the visitor their booking. */
  const slug = page?.dataset.profile ?? '';
  const mode = page?.dataset.saveMode ?? 'none';
  const csrf = page?.dataset.csrf ?? '';
  const saveStatus = document.querySelector<HTMLElement>('[data-save-status]');
  const heart = document.querySelector<HTMLButtonElement>(
    '[data-profile-save]',
  );
  const heartLabel = document.querySelector<HTMLElement>('[data-save-label]');

  /** Carried over the sign-in round trip by the Save heart and read back by afterLoginPath(). */
  const resume = (prefix: string) => {
    document.cookie = `duoly_resume=${prefix}${slug}; Max-Age=1800; Path=/; SameSite=Lax; Secure`;
  };

  /* A signed-out visitor books at once; this is the note that says who they were booking.
     The after-login path spends it the moment checkout has them sign in or sign up. */
  const remember = () => {
    document.cookie = `duoly_pending_favorite=${slug}; Max-Age=7200; Path=/; SameSite=Lax; Secure`;
  };

  let done = false;
  const save = async (): Promise<{ ok: boolean; error: string }> => {
    if (done) return { ok: true, error: '' };
    if (!slug || !csrf)
      return { ok: false, error: 'Reload the page and try again.' };
    try {
      const response = await fetch('/api/favorites/by-slug', {
        method: 'POST',
        credentials: 'same-origin',
        redirect: 'error',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ csrf, slug }),
      });
      const data = await response.json().catch(() => ({}));
      done = response.ok;
      return {
        ok: response.ok,
        error: response.ok ? '' : (data.error ?? 'Saving failed.'),
      };
    } catch {
      return { ok: false, error: 'Saving failed.' };
    }
  };

  const markSaved = () => {
    if (!heart) return;
    heart.setAttribute('aria-pressed', 'true');
    if (heartLabel && heart.dataset.savedLabel)
      heartLabel.textContent = heart.dataset.savedLabel;
  };

  heart?.addEventListener('click', async () => {
    if (heart.getAttribute('aria-pressed') === 'true') return;
    heart.disabled = true;
    if (saveStatus) saveStatus.textContent = '';
    const result = await save();
    heart.disabled = false;
    if (result.ok) markSaved();
    else if (saveStatus) saveStatus.textContent = result.error;
  });

  /* The heart for a visitor who is not signed in: sign in, come back here, save. */
  document
    .querySelector<HTMLAnchorElement>('[data-profile-signin]')
    ?.addEventListener('click', () => resume('profile-save:'));

  const plainClick = (event: MouseEvent) =>
    !event.defaultPrevented &&
    event.button === 0 &&
    !event.metaKey &&
    !event.ctrlKey &&
    !event.shiftKey &&
    !event.altKey;

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '[data-profile-book]',
  )) {
    link.addEventListener('click', (event) => {
      if (!plainClick(event)) return;
      if (mode === 'customer') {
        event.preventDefault();
        const href = link.href;
        /* Booking wins over saving: whichever finishes first, the browser moves on. */
        let left = false;
        const go = () => {
          if (left) return;
          left = true;
          location.href = href;
        };
        setTimeout(go, 1200);
        save().then(go, go);
        return;
      }
      /* Signed out: no detour and no wait. The link is followed as written and the slug is
         left in a cookie, which the sign-in that checkout asks for turns into a favorite. */
      if (mode === 'signin') remember();
    });
  }

  /* Back from sign-in with the Save heart: ?save=1 saves and stays put. */
  if (new URLSearchParams(location.search).get('save') === '1') {
    history.replaceState(null, '', location.pathname + location.hash);
    if (mode === 'customer')
      save().then((result) => {
        if (result.ok) markSaved();
        else if (saveStatus) saveStatus.textContent = result.error;
      });
  }
</script>

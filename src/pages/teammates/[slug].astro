                  </div>
                </div>
                {g.game === 'social' ? (
                  <dl>
                    <div>
                      <dt>Sessions</dt>
                      <dd>{socialSessions.join(', ')}</dd>
                    </div>
                    <div>
                      <dt>With</dt>
                      <dd>A verified Gamer Girl, on Discord voice</dd>
                    </div>
                  </dl>
                ) : (
                  <dl>
                    {g.verified && g.peakRank && (
                      <div>
                        <dt>Peak</dt>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import TeammateCard from '../../components/teammates/TeammateCard.astro';
import Icon from '../../components/teammates/Icon.astro';
import '../../components/teammates/profiles.css';
import {
  loadPublicProfile,
  loadTeammateCards,
  publicProfilesEnabled,
  fixturesEnabled,
} from '../../server/teammates/public-profiles';
import {
  accentStyle,
  profileRoute,
  profileMetadata,
  profilePresentation,
  profileSchemas,
  profileGame,
  profileMonth,
  profileReviewLayout,
  rankEmblem,
} from '../../server/teammates/profile-page';
import { serializeJsonLd } from '../../site/seo';
import { pageViewer } from '../../site/viewer';
const result = publicProfilesEnabled()
  ? await loadPublicProfile(Astro.params.slug ?? '')
  : ({ status: 'missing' } as const);
const route = profileRoute(publicProfilesEnabled(), result);
if (route.status === 404) return Astro.rewrite('/404');
if (route.status === 301) return Astro.redirect(route.location!, 301);
Astro.response.status = route.status;
const { viewer, csrf } = await pageViewer(Astro);
Astro.response.headers.set('Cache-Control', 'no-store');
const p = result.status === 'ok' ? result.profile : null;
const view = p ? profilePresentation(p) : null;
const meta = p
  ? profileMetadata(p)
  : {
      title: 'Profile no longer available | Duoly',
      description:
        'This teammate profile is no longer public. Find another teammate on Duoly.',
      indexing: 'noindex, follow' as const,
    };
const related = p
  ? await loadTeammateCards({
      game: p.featuredGame,
      excludeSlug: p.slug,
      limit: 3,
    })
  : [];
const schemas = p ? profileSchemas(p, Astro.site!) : [];
const fixture = fixturesEnabled();
const reviews = p ? profileReviewLayout(p.reviews) : { lead: null, rest: [] };
const featuredRank =
  p?.games.find((g) => g.game === p.featuredGame && g.verified)?.rank ?? null;
/** One sentence about how fast an order is picked up, reused by the closing band. */
const availability = p?.online
  ? 'Online now, usually accepts within 2 minutes'
  : null;
const sections = [
  { id: 'games', label: 'Games' },
  { id: 'reviews', label: 'Reviews' },
  { id: 'more', label: 'More teammates' },
];
---

<SiteLayout {...meta} viewer={viewer} csrf={csrf}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(schemas)}
  />
  {p && view ? (
    <article
      class="tp-page"
      style={accentStyle(p.accent)}
      data-banner={p.banner}
      data-tier={p.tier}
      data-profile={p.slug}
    >
      <nav class="tp-crumbs" aria-label="Breadcrumb">
        <a href="/">Duoly</a>
        <span aria-hidden="true">/</span>
        <a href="/teammates">Teammates</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{p.name}</span>
      </nav>
      {fixture && (
        <p class="tp-fixture">
          Design preview. These teammates and reviews are fictional.
        </p>
      )}
      <section class="tp-hero" aria-labelledby="profile-name">
        <span class="tp-sky" aria-hidden="true"></span>
        <div class="tp-hero-top">
          <div class="tp-utilities">
            <a
              href={`/login?next=${encodeURIComponent(`/teammates/${p.slug}`)}`}
              title="Sign in to manage your favorites"
            >
              <Icon name="heart" /> Save {p.name}
            </a>
            <a href={`#share-${p.slug}`} data-profile-share>
              <Icon name="share" /> Share
            </a>
          </div>
        </div>
        <div id={`share-${p.slug}`} class="tp-share-link">
          <label>
            Profile link
            <input
              aria-label="Profile link"
              readonly
              value={new URL(`/teammates/${p.slug}`, Astro.site!).href}
            />
          </label>
          <p data-share-status role="status"></p>
        </div>
        <div class="tp-hero-grid">
          <div class="tp-hero-name">
            <h1 id="profile-name">{p.name}</h1>
            <p class="tp-rankline" data-game={p.featuredGame}>
              <svg class="tp-crest" viewBox="0 0 64 72" aria-hidden="true">
                <path d={rankEmblem(p.featuredGame).shape} />
              </svg>
              <span>
                {featuredRank
                  ? `${view.game.name}, ${featuredRank}`
                  : `${view.game.name} teammate`}
              </span>
              {featuredRank && (
                <span
                  class="tp-verified"
                  role="img"
                  aria-label="Rank verified by Duoly"
                >
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="m5 12.5 4.5 4.5L19 7.5"
                      stroke="currentColor"
                      stroke-width="3.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              )}
            </p>
          </div>
          <div class="tp-aside">
            <span
              class="tp-ghostname"
              style={`--ghost-chars:${p.name.length}`}
              aria-hidden="true"
            >
              {p.name}
            </span>
            <div class="tp-figure">
              <span class="tp-ring" aria-hidden="true"></span>
              <img
                src={p.avatar}
                width="160"
                height="160"
                alt={`${p.name}'s robot avatar`}
                fetchpriority="high"
              />
              {p.online && <span class="tp-ring-dot" aria-hidden="true"></span>}
            </div>
            <div class="tp-identity">
              <p class="tp-plate">
                <svg viewBox="0 0 40 48" fill="none" aria-hidden="true">
                  <path
                    d="M20 2 37 11 33 33 20 45 7 33 3 11Z"
                    stroke="currentColor"
                  />
                  <path
                    d="m10 17 10 17 10-17M13 12l7 12 7-12"
                    stroke="currentColor"
                    stroke-width="3"
                  />
                </svg>
                <strong>{p.tier}</strong>
              </p>
              <dl class="tp-idlist">
                <div>
                  <dt>Member since</dt>
                  <dd>{profileMonth(p.memberSince)}</dd>
                </div>
                <div>
                  <dt>Speaks</dt>
                  <dd>{p.languages.join(', ')}</dd>
                </div>
                {p.country && (
                  <div>
                    <dt>Based in</dt>
                    <dd>{p.country}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>
          <div class="tp-hero-body">
            <p class="tp-bio">{p.bio}</p>
            <ul class="tp-vibes" aria-label="Play style">
              {p.vibeTags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <div class="tp-cta" data-hero-booking>
              <div class="tp-buy">
                <a class="tp-button tp-primary" href={view.book}>
                  {view.primary}
                  <Icon name="arrow" />
                </a>
                <p class="tp-price" data-profile-price>
                  from <strong>{view.offer.display}</strong> per{' '}
                  {view.offer.unit}
                </p>
              </div>
              {p.coaching && (
                <div class="tp-buy tp-buy-quiet">
                  <a
                    class="tp-button tp-ghost"
                    href={view.booking(p.featuredGame, true)}
                  >
                    Coaching with {p.name}
                  </a>
                  {view.coachOffer && (
                    <p class="tp-price tp-price-quiet">
                      from <strong>{view.coachOffer.display}</strong> per{' '}
                      {view.coachOffer.unit}
                    </p>
                  )}
                </div>
              )}
              {availability && (
                <p class="tp-availability">
                  <i aria-hidden="true"></i>
                  {availability}
                </p>
              )}
            </div>
            <p class="tp-note">
              {p.online
                ? `You get ${p.name} first. If ${p.name} is already in a match, the next verified teammate takes your order, so you never wait.`
                : `${p.name} is offline right now. Book a verified ${view.game.name} teammate today, or save this profile and come back when ${p.name} is online.`}
            </p>
          </div>
        </div>
        <div class="tp-scoreboard" aria-label={`${p.name}'s track record`}>
          {view.rating && (
            <a class="tp-stat" href="#reviews">
              <strong>
                {view.rating.average.toFixed(1)}
                <span class="tp-unit" aria-hidden="true">
                  ★
                </span>
              </strong>
              <span class="tp-stat-name">Customer rating</span>
              <span class="tp-stat-sub">from {view.rating.count} reviews</span>
            </a>
          )}
          {view.showSessions && (
            <div class="tp-stat">
              <strong>{p.sessions.toLocaleString('en-US')}</strong>
              <span class="tp-stat-name">Sessions completed</span>
              <span class="tp-stat-sub">on Duoly</span>
            </div>
          )}
          {view.winRate && (
            <div class="tp-stat">
              <strong>
                {view.winRate.percent}
                <span class="tp-unit">%</span>
              </strong>
              <span class="tp-stat-name">Win rate</span>
              <span class="tp-stat-sub">
                from {view.winRate.games} reported matches
              </span>
            </div>
          )}
          {p.tier === 'rookie' && (
            <div class="tp-welcome">
              <strong>A fresh face for your next queue.</strong>
              <p>Meet {p.name} through their games and play style.</p>
            </div>
          )}
        </div>
      </section>
      <nav class="tp-tabs" aria-label="Profile sections" data-tabs>
        {sections.map((section, i) => (
          <a
            href={`#${section.id}`}
            class:list={{ 'is-current': i === 0 }}
            aria-current={i === 0 ? 'true' : undefined}
          >
            {section.label}
          </a>
        ))}
      </nav>
      <section id="games" class="tp-section" aria-labelledby="games-title">
        <div class="tp-section-head">
          <div>
            <h2 id="games-title">Games</h2>
            <p>Ranks verified by Duoly, with the roles {p.name} plays.</p>
          </div>
        </div>
        <div class="tp-games">
          {p.games.map((g) => {
            const game = profileGame(g.game);
            return (
              <article class="tp-game" data-game={g.game}>
                <div class="tp-game-header">
                  <img
                    src={game.img}
                    width="30"
                    height="30"
                    alt=""
                    loading="lazy"
                  />
                  <h3>{game.name}</h3>
                </div>
                <div class="tp-rank">
                  <svg
                    class="tp-rank-glyph"
                    viewBox="0 0 64 72"
                    aria-hidden="true"
                  >
                    <path class="tp-rank-shape" d={rankEmblem(g.game).shape} />
                    <path class="tp-rank-mark" d={rankEmblem(g.game).mark} />
                  </svg>
                  <div>
                    <p class="tp-rank-label">
                      {g.verified && g.rank ? 'Rank verified' : 'Teammate'}
                    </p>
                    <h4>
                      {g.verified
                        ? (g.rank ?? 'Ready to play')
                        : 'Ready to play'}
                    </h4>
                  </div>
                </div>
                <dl>
                  {g.verified && g.peakRank && (
                    <div>
                      <dt>Peak</dt>
                      <dd>{g.peakRank}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Roles</dt>
                    <dd>{g.roles.join(', ') || 'Flexible'}</dd>
                  </div>
                  {g.picks.length > 0 && (
                    <div>
                      <dt>{g.game === 'lol' ? 'Champions' : 'Agents'}</dt>
                      <dd>{g.picks.join(', ')}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Plays</dt>
                    <dd>
                      Duo
                      {p.coaching && g.game === p.featuredGame
                        ? ', coaching'
                        : ''}
                    </dd>
                  </div>
                </dl>
                <a class="tp-game-book" href={view.booking(g.game)}>
                  Book {game.name} with {p.name}
                  <Icon name="arrow" />
                </a>
              </article>
            );
          })}
        </div>
      </section>
      <section
        id="reviews"
        class="tp-section tp-reviews"
        aria-labelledby="reviews-title"
      >
        <div class="tp-section-head">
          <div>
            <h2 id="reviews-title">Reviews</h2>
            <p>What customers said after playing with {p.name}.</p>
          </div>
        </div>
        {p.reviewTags.length > 0 && (
          <div class="tp-tags">
            {p.reviewTags.map((tag) => (
              <div
                class="tp-tag"
                style={`--bar:${Math.min(100, Math.round((tag.count / (p.reviewTags[0]?.count || tag.count)) * 100))}%`}
              >
                <span>{tag.tag}</span>
                <strong>{tag.count} mentions</strong>
              </div>
            ))}
          </div>
        )}
        {reviews.lead || reviews.rest.length > 0 ? (
          <div class="tp-review-wrap">
            {(reviews.lead ? [reviews.lead] : [])
              .concat(reviews.rest)
              .map((review, i) => (
                <figure
                  class:list={[
                    'tp-review',
                    { 'tp-review-lead': i === 0 && reviews.lead },
                  ]}
                >
                  <div
                    class="tp-stars"
                    aria-label={`${review.rating} out of 5 stars`}
                  >
                    {'★'.repeat(review.rating)}
                  </div>
                  <blockquote>{review.text}</blockquote>
                  <figcaption>
                    Verified customer, {profileGame(review.game).name},{' '}
                    {profileMonth(review.month)}
                  </figcaption>
                </figure>
              ))}
          </div>
        ) : (
          <p class="tp-empty">
            Reviews will appear here after completed sessions.
          </p>
        )}
      </section>
      <section id="more" class="tp-section" aria-labelledby="more-title">
        <div class="tp-section-head">
          <div>
            <h2 id="more-title">More teammates</h2>
            <p>Other {view.game.name} players on Duoly.</p>
          </div>
          <a class="tp-more-link" href="/teammates">
            See all teammates
            <Icon name="arrow" />
          </a>
        </div>
        <div class="tp-cards">
          {related.map((card) => (
            <TeammateCard card={card} />
          ))}
        </div>
      </section>
      <section class="tp-closing" aria-label={`Book ${p.name}`} data-closing>
        <div class="tp-figure tp-figure-small">
          <span class="tp-ring" aria-hidden="true"></span>
          <img src={p.avatar} width="160" height="160" alt="" loading="lazy" />
          {p.online && <span class="tp-ring-dot" aria-hidden="true"></span>}
        </div>
        <div class="tp-closing-copy">
          <p class="tp-closing-title">Ready when you are.</p>
          <p class:list={['tp-availability', { 'is-off': !p.online }]}>
            <i aria-hidden="true"></i>
            {availability ?? `${p.name} is offline right now`}
          </p>
        </div>
        <a class="tp-button tp-primary" href={view.book}>
          {view.primary}
          <Icon name="arrow" />
        </a>
      </section>
      <div class="tp-mobile-booking" data-sticky-booking>
        <a class="tp-button tp-primary" href={view.book}>
          <span
            class:list={['tp-dot', { 'is-online': p.online }]}
            aria-hidden="true"
          ></span>
          {view.primary}
          <Icon name="arrow" />
        </a>
      </div>
    </article>
  ) : (
    <div class="tp-page tp-gone">
      <PageIntro
        eyebrow="410 / Off air"
        title="This player has left the spotlight."
        lead="This teammate profile is no longer public. There's still a lobby waiting for you."
        centered
      >
        <a class="tp-button tp-primary" href="/teammates">
          Find a teammate
          <Icon name="arrow" />
        </a>
      </PageIntro>
    </div>
  )}
</SiteLayout>
<script>
  const share = document.querySelector<HTMLAnchorElement>(
    '[data-profile-share]',
  );
  const input = document.querySelector<HTMLInputElement>(
    '.tp-share-link input',
  );
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  share?.addEventListener('click', async (event) => {
    if (!input || !status) return;
    event.preventDefault();
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url: input.value });
        return;
      }
      if (navigator.clipboard) {
        await navigator.clipboard.writeText(input.value);
        status.textContent = 'Link copied.';
      } else {
        input.focus();
        input.select();
        status.textContent = 'Copy this profile link.';
      }
    } catch (error) {
      if (!(error instanceof DOMException && error.name === 'AbortError')) {
        input.focus();
        input.select();
        status.textContent = 'Copy this profile link.';
      }
    }
  });

  /* The sticky bar is a duplicate of a button that is already on screen while the
     hero block or the closing band is visible, so it steps aside for both. Without
     JavaScript it simply stays, which is the safe default. */
  const bar = document.querySelector<HTMLElement>('[data-sticky-booking]');
  const anchors = document.querySelectorAll<HTMLElement>(
    '[data-hero-booking], [data-closing], .site-footer',
  );
  if (bar && anchors.length && 'IntersectionObserver' in window) {
    const shown = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) shown.add(entry.target);
          else shown.delete(entry.target);
        }
        bar.classList.toggle('is-stowed', shown.size > 0);
      },
      { rootMargin: '0px 0px -72px 0px' },
    );
    for (const anchor of anchors) observer.observe(anchor);
  }

  /* The section nav sticks under the site header, so it has to know how tall that header
     is. Without JavaScript the CSS fallback keeps it readable, it simply sticks a few
     pixels off. The same measurement drives the scroll margin of every section. */
  const page = document.querySelector<HTMLElement>('article.tp-page');
  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  if (page && tabs) {
    const header = document.querySelector<HTMLElement>('.site-header');
    const measure = () =>
      page.style.setProperty(
        '--tp-header',
        `${Math.round(header?.getBoundingClientRect().height ?? 58)}px`,
      );
    measure();
    addEventListener('resize', measure);

    /* Scroll spy: the current tab is the last section that has reached the nav. Clicking a
       tab already works on its own, this only keeps the marker honest while scrolling. */
    const links = [...tabs.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((link) =>
      document.querySelector<HTMLElement>(link.hash),
    );
    let queued = false;
    const spy = () => {
      queued = false;
      const line = tabs.getBoundingClientRect().bottom + 8;
      let index = 0;
      targets.forEach((target, i) => {
        if (target && target.getBoundingClientRect().top <= line) index = i;
      });
      links.forEach((link, i) => {
        link.classList.toggle('is-current', i === index);
        if (i === index) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(spy);
      },
      { passive: true },
    );
    spy();
  }
</script>

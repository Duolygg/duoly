---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import TeammateCard from '../../components/teammates/TeammateCard.astro';
import Icon from '../../components/teammates/Icon.astro';
import '../../components/teammates/profiles.css';
import { PROFILE_ACCENTS } from '../../contracts/teammate-profile';
import {
  loadPublicProfile,
  loadTeammateCards,
  publicProfilesEnabled,
  fixturesEnabled,
} from '../../server/teammates/public-profiles';
import {
  profileRoute,
  profileMetadata,
  profilePresentation,
  profileSchemas,
  profileGame,
  profileMonth,
  profileReviewLayout,
} from '../../server/teammates/profile-page';
import { serializeJsonLd } from '../../site/seo';
import { pageViewer } from '../../site/viewer';
const result = publicProfilesEnabled()
  ? await loadPublicProfile(Astro.params.slug ?? '')
  : ({ status: 'missing' } as const);
const route = profileRoute(publicProfilesEnabled(), result);
if (route.status === 404) return Astro.rewrite('/404');
if (route.status === 301) return Astro.redirect(route.location!, 301);
Astro.response.status = route.status;
const { viewer, csrf } = await pageViewer(Astro);
Astro.response.headers.set('Cache-Control', 'no-store');
const p = result.status === 'ok' ? result.profile : null;
const view = p ? profilePresentation(p) : null;
const meta = p
  ? profileMetadata(p)
  : {
      title: 'Profile no longer available | Duoly',
      description:
        'This teammate profile is no longer public. Find another teammate on Duoly.',
      indexing: 'noindex, follow' as const,
    };
const related = p
  ? await loadTeammateCards({
      game: p.featuredGame,
      excludeSlug: p.slug,
      limit: 3,
    })
  : [];
const schemas = p ? profileSchemas(p, Astro.site!) : [];
const fixture = fixturesEnabled();
const reviews = p ? profileReviewLayout(p.reviews) : { lead: null, rest: [] };
const featuredRank = p?.games.find(
  (g) => g.game === p.featuredGame && g.verified,
)?.rank;
---

<SiteLayout {...meta} viewer={viewer} csrf={csrf}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(schemas)}
  />
  {p && view ? (
    <article
      class="tp-page"
      style={`--accent:${PROFILE_ACCENTS[p.accent]}`}
      data-banner={p.banner}
      data-tier={p.tier}
      data-profile={p.slug}
    >
      <nav class="tp-crumbs" aria-label="Breadcrumb">
        <a href="/">Duoly</a>
        <span aria-hidden="true">/</span>
        <a href="/teammates">Teammates</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{p.name}</span>
      </nav>
      {fixture && (
        <p class="tp-fixture">
          Design preview. These teammates and reviews are fictional.
        </p>
      )}
      <section class="tp-hero" aria-labelledby="profile-name">
        <div class="tp-hero-top">
          <span class:list={['tp-presence', { 'is-online': p.online }]}>
            <i aria-hidden="true"></i>
            {p.online ? 'Online now' : 'Offline'}
          </span>
          <div class="tp-utilities">
            <a
              href={`/login?next=${encodeURIComponent(`/teammates/${p.slug}`)}`}
              title="Sign in to manage your favorites"
            >
              <Icon name="heart" /> Save {p.name}
            </a>
            <a href={`#share-${p.slug}`} data-profile-share>
              <Icon name="share" /> Share
            </a>
          </div>
        </div>
        <div id={`share-${p.slug}`} class="tp-share-link">
          <label>
            Profile link
            <input
              aria-label="Profile link"
              readonly
              value={new URL(`/teammates/${p.slug}`, Astro.site!).href}
            />
          </label>
          <p data-share-status role="status"></p>
        </div>
        <div class="tp-hero-grid">
          <p class="tp-plate">
            <svg viewBox="0 0 40 48" fill="none" aria-hidden="true">
              <path
                d="M20 2 37 11 33 33 20 45 7 33 3 11Z"
                stroke="currentColor"
              />
              <path
                d="m10 17 10 17 10-17M13 12l7 12 7-12"
                stroke="currentColor"
                stroke-width="3"
              />
            </svg>
            <strong>{p.tier}</strong>
            <span>
              {view.game.name}
              {featuredRank ? ` ${featuredRank}` : ''}
            </span>
          </p>
          <div class="tp-hero-name">
            <h1 id="profile-name">
              {p.name}
              {p.games.some((g) => g.verified && g.rank) && (
                <span class="tp-verified" aria-label="Rank verified">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="m5 12.5 4.5 4.5L19 7.5"
                      stroke="currentColor"
                      stroke-width="3.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              )}
            </h1>
          </div>
          <div class="tp-figure">
            <span class="tp-halo" aria-hidden="true"></span>
            <img
              src={p.avatar}
              width="420"
              height="420"
              alt={`${p.name}'s robot avatar`}
              fetchpriority="high"
            />
          </div>
          <div class="tp-hero-body">
            <p class="tp-meta">
              {p.country && <span>{p.country}</span>}
              <span>{p.languages.join(', ')}</span>
            </p>
            <p class="tp-bio">{p.bio}</p>
            <ul class="tp-vibes" aria-label="Play style">
              {p.vibeTags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <div class="tp-cta" data-hero-booking>
              <a class="tp-button tp-primary" href={view.book}>
                {view.primary}
                <Icon name="arrow" />
              </a>
              <div class="tp-offer">
                <p class="tp-price" data-profile-price>
                  from <strong>{view.offer.display}</strong> per{' '}
                  {view.offer.unit}
                </p>
                {p.online && (
                  <p class="tp-availability">
                    Online now, usually accepts within 2 minutes
                  </p>
                )}
              </div>
              {p.coaching && (
                <a
                  class="tp-button tp-ghost"
                  href={view.booking(p.featuredGame, true)}
                >
                  Coaching with {p.name}
                </a>
              )}
            </div>
            <p class="tp-note">
              {p.online
                ? `${p.name} sees your order first. If ${p.name} is busy, another verified teammate takes it.`
                : `${p.name} is offline. Book another verified teammate or save this profile for later.`}
            </p>
          </div>
        </div>
        <div class="tp-scoreboard" aria-label={`${p.name}'s track record`}>
          {view.rating && (
            <a class="tp-stat" href="#reviews">
              <strong>
                {view.rating.average.toFixed(1)}
                <span class="tp-star" aria-hidden="true">
                  ★
                </span>
              </strong>
              <span class="tp-stat-name">Customer rating</span>
              <span class="tp-stat-sub">from {view.rating.count} reviews</span>
            </a>
          )}
          {view.showSessions && (
            <div class="tp-stat">
              <strong>{p.sessions.toLocaleString('en-US')}</strong>
              <span class="tp-stat-name">Sessions completed</span>
              <span class="tp-stat-sub">on Duoly</span>
            </div>
          )}
          {view.winRate && (
            <div class="tp-stat">
              <strong>
                {view.winRate.percent}
                <span class="tp-unit">%</span>
              </strong>
              <span class="tp-stat-name">Win rate</span>
              <span class="tp-stat-sub">
                from {view.winRate.games} reported matches
              </span>
            </div>
          )}
          {p.tier === 'rookie' && (
            <div class="tp-welcome">
              <strong>A fresh face for your next queue.</strong>
              <p>Meet {p.name} through their games and play style.</p>
            </div>
          )}
        </div>
      </section>
      <nav class="tp-tabs" aria-label="Profile sections">
        <a href="#games" class="is-current">
          Games
        </a>
        <a href="#reviews">Reviews</a>
        <a href="#more">More teammates</a>
        <span>Member since {profileMonth(p.memberSince)}</span>
      </nav>
      <section id="games" class="tp-section" aria-labelledby="games-title">
        <div class="tp-section-head">
          <div>
            <h2 id="games-title">Games</h2>
            <p>Ranks an admin checked, with the roles {p.name} plays.</p>
          </div>
        </div>
        <div class="tp-games">
          {p.games.map((g) => {
            const game = profileGame(g.game);
            return (
              <article class="tp-game" data-game={g.game}>
                <div class="tp-game-header">
                  <img
                    src={game.img}
                    width="30"
                    height="30"
                    alt=""
                    loading="lazy"
                  />
                  <h3>{game.name}</h3>
                  {g.game === p.featuredGame && <span>Featured</span>}
                </div>
                <div class="tp-rank">
                  <svg viewBox="0 0 64 72" aria-hidden="true">
                    <path
                      d={
                        g.game === 'lol'
                          ? 'M32 3 58 20 51 52 32 68 13 52 6 20Z'
                          : 'M32 3 60 21 48 57 32 69 16 57 4 21Z'
                      }
                    />
                    <path
                      d={
                        g.game === 'lol'
                          ? 'M20 24h24l-4 22-8 8-8-8ZM32 13v41'
                          : 'm15 24 17 28 17-28M22 17l10 18 10-18'
                      }
                    />
                  </svg>
                  <div>
                    <p class="tp-rank-label">
                      {g.verified && g.rank ? 'Rank verified' : 'Teammate'}
                    </p>
                    <h4>
                      {g.verified
                        ? (g.rank ?? 'Ready to play')
                        : 'Ready to play'}
                    </h4>
                  </div>
                </div>
                <dl>
                  {g.verified && g.peakRank && (
                    <div>
                      <dt>Peak</dt>
                      <dd>{g.peakRank}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Roles</dt>
                    <dd>{g.roles.join(', ') || 'Flexible'}</dd>
                  </div>
                  {g.picks.length > 0 && (
                    <div>
                      <dt>{g.game === 'lol' ? 'Champions' : 'Agents'}</dt>
                      <dd>{g.picks.join(', ')}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Plays</dt>
                    <dd>
                      Duo
                      {p.coaching && g.game === p.featuredGame
                        ? ', coaching'
                        : ''}
                    </dd>
                  </div>
                </dl>
                <a class="tp-game-book" href={view.booking(g.game)}>
                  Book {game.name} with {p.name}
                  <Icon name="arrow" />
                </a>
              </article>
            );
          })}
        </div>
      </section>
      <section
        id="reviews"
        class="tp-section tp-reviews"
        aria-labelledby="reviews-title"
      >
        <div class="tp-section-head">
          <div>
            <h2 id="reviews-title">Reviews</h2>
            <p>What customers said after playing with {p.name}.</p>
          </div>
        </div>
        {p.reviewTags.length > 0 && (
          <div class="tp-tags">
            {p.reviewTags.map((tag) => (
              <div
                class="tp-tag"
                style={`--bar:${Math.min(100, Math.round((tag.count / (p.reviewTags[0]?.count || tag.count)) * 100))}%`}
              >
                <span>{tag.tag}</span>
                <strong>{tag.count} mentions</strong>
              </div>
            ))}
          </div>
        )}
        {reviews.lead || reviews.rest.length > 0 ? (
          <div class="tp-review-wrap">
            {reviews.lead && (
              <figure class="tp-review tp-review-lead">
                <div
                  class="tp-stars"
                  aria-label={`${reviews.lead.rating} out of 5 stars`}
                >
                  {'★'.repeat(reviews.lead.rating)}
                </div>
                <blockquote>{reviews.lead.text}</blockquote>
                <figcaption>
                  Verified customer, {profileGame(reviews.lead.game).name},{' '}
                  {profileMonth(reviews.lead.month)}
                </figcaption>
              </figure>
            )}
            {reviews.rest.length > 0 && (
              <div class="tp-review-grid">
                {reviews.rest.map((review) => (
                  <figure class="tp-review">
                    <div
                      class="tp-stars"
                      aria-label={`${review.rating} out of 5 stars`}
                    >
                      {'★'.repeat(review.rating)}
                    </div>
                    <blockquote>{review.text}</blockquote>
                    <figcaption>
                      Verified customer, {profileGame(review.game).name},{' '}
                      {profileMonth(review.month)}
                    </figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
        ) : (
          <p class="tp-empty">
            Reviews will appear here after completed sessions.
          </p>
        )}
      </section>
      <section id="more" class="tp-section" aria-labelledby="more-title">
        <div class="tp-section-head">
          <div>
            <h2 id="more-title">More teammates</h2>
            <p>Other {view.game.name} players on Duoly.</p>
          </div>
          <a class="tp-more-link" href="/teammates">
            See all teammates
            <Icon name="arrow" />
          </a>
        </div>
        <div class="tp-cards">
          {related.map((card) => (
            <TeammateCard card={card} />
          ))}
        </div>
      </section>
      <section class="tp-closing" aria-label={`Book ${p.name}`} data-closing>
        <p class="tp-closing-title">Ready when you are.</p>
        <a class="tp-button tp-primary" href={view.book}>
          {view.primary}
          <Icon name="arrow" />
        </a>
      </section>
      <div class="tp-mobile-booking" data-sticky-booking>
        <a class="tp-button tp-primary" href={view.book}>
          <span
            class:list={['tp-dot', { 'is-online': p.online }]}
            aria-hidden="true"
          ></span>
          {view.primary}
          <Icon name="arrow" />
        </a>
      </div>
    </article>
  ) : (
    <div class="tp-page tp-gone">
      <PageIntro
        eyebrow="410 / Off air"
        title="This player has left the spotlight."
        lead="This teammate profile is no longer public. There's still a lobby waiting for you."
        centered
      >
        <a class="tp-button tp-primary" href="/teammates">
          Find a teammate
          <Icon name="arrow" />
        </a>
      </PageIntro>
    </div>
  )}
</SiteLayout>
<script>
  const share = document.querySelector<HTMLAnchorElement>(
    '[data-profile-share]',
  );
  const input = document.querySelector<HTMLInputElement>(
    '.tp-share-link input',
  );
  const status = document.querySelector<HTMLElement>('[data-share-status]');
  share?.addEventListener('click', async (event) => {
    if (!input || !status) return;
    event.preventDefault();
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url: input.value });
        return;
      }
      if (navigator.clipboard) {
        await navigator.clipboard.writeText(input.value);
        status.textContent = 'Link copied.';
      } else {
        input.focus();
        input.select();
        status.textContent = 'Copy this profile link.';
      }
    } catch (error) {
      if (!(error instanceof DOMException && error.name === 'AbortError')) {
        input.focus();
        input.select();
        status.textContent = 'Copy this profile link.';
      }
    }
  });

  /* The sticky bar is a duplicate of a button that is already on screen while the
     hero block or the closing band is visible, so it steps aside for both. Without
     JavaScript it simply stays, which is the safe default. */
  const bar = document.querySelector<HTMLElement>('[data-sticky-booking]');
  const anchors = document.querySelectorAll<HTMLElement>(
    '[data-hero-booking], [data-closing], .site-footer',
  );
  if (bar && anchors.length && 'IntersectionObserver' in window) {
    const shown = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          entry.isIntersecting
            ? shown.add(entry.target)
            : shown.delete(entry.target);
        bar.classList.toggle('is-stowed', shown.size > 0);
      },
      { rootMargin: '0px 0px -72px 0px' },
    );
    for (const anchor of anchors) observer.observe(anchor);
  }
</script>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { accountContext } from '../../server/auth/context';
import { ADMIN_SECTIONS } from '../../site/nav';
import ChatModeration from '../../components/admin/ChatModeration';
import { orderChatEnabled } from '../../server/chat/config';
const account = accountContext(Astro.request, Astro.cookies);
let identity: Awaited<ReturnType<typeof account.identity>>;
try {
  identity = await account.identity();
} catch {
  return new Response('Temporarily unavailable', {
    status: 503,
    headers: account.headers,
  });
}
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
// Admin is invisible to everyone else.
if (identity?.viewer.role !== 'admin') return Astro.rewrite('/404');
const section = ADMIN_SECTIONS[0];
---

<SiteLayout
  title={`${section.label} | Duoly admin`}
  viewer={identity.viewer}
  csrf={account.csrf()}
  admin
>
  <p class="eyebrow">Admin</p>
  <h1>{section.label}</h1>
  <p class="note">{section.note}</p>
  <div class="soon">
    <strong>Not connected yet.</strong>
    <span>
      This section is part of the admin build-out. No sample data is shown.
    </span>
  </div>
  {orderChatEnabled() && <ChatModeration csrf={account.csrf()} client:load />}
</SiteLayout>

<style>
  .eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ff8a9b;
  }
  h1 {
    margin: 6px 0 0;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 34px;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .note {
    color: #a79dc4;
  }
  .soon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 20px;
    padding: 20px;
    border-radius: 18px;
    border: 1px dashed rgba(214, 187, 255, 0.24);
    color: #cfc4ea;
  }
</style>

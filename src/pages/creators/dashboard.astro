---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CreatorPortal from '../../components/site/CreatorPortal.jsx';
import { accountContext } from '../../server/auth/context';

// The creator's own dashboard. Signed out visitors go to the sign-in popup, like every other
// account page. The portal payload is read here, so the first paint already has the real
// numbers; the component refreshes it after a save.
const account = accountContext(Astro.request, Astro.cookies);
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
let identity: Awaited<ReturnType<typeof account.identity>> = null;
let failed = false;
try {
  identity = await account.identity();
} catch {
  failed = true;
}
if (!identity && !failed) return account.redirect('/?signin=1');
const csrf = account.csrf();
let initial: unknown = null;
if (identity && account.client) {
  try {
    // Bound: supabase-js rpc reads `this` (tests/unit/rpc-binding.test.ts).
    const rpc = (
      account.client.rpc as unknown as (
        name: string,
      ) => PromiseLike<{ data: unknown; error: unknown }>
    ).bind(account.client);
    const { data, error } = await rpc('creator_portal');
    initial =
      error || !data || (data as { error?: unknown }).error ? null : data;
  } catch {
    initial = null;
  }
}
const origin = (Astro.site ?? new URL('https://duoly.gg')).origin;
---

<SiteLayout
  title="Creator dashboard | Duoly"
  viewer={identity?.viewer}
  csrf={csrf}
>
  {failed ? (
    <section class="cp-sec" role="alert">
      <h1>Creator dashboard unavailable</h1>
      <p>We could not load your account. Please try again shortly.</p>
    </section>
  ) : (
    <CreatorPortal initial={initial} csrf={csrf} origin={origin} client:load />
  )}
</SiteLayout>

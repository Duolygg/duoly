---
import ProductLayout from '../../layouts/ProductLayout.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import LiveQueueRoom from '../../components/account/LiveQueueRoom';
import { OrderCommandSchema, type CustomerOrder } from '../../contracts/orders';
import { accountContext } from '../../server/auth/context';
import { decodeOrderRpcResult } from '../../server/orders/results';
import { orderChatEnabled } from '../../server/chat/config';
import { loadProView } from '../../server/pro/status';
const chatEnabled = orderChatEnabled();
const reportsEnabled = process.env.REPORTS_ENABLED === 'true';
const command = OrderCommandSchema.safeParse({ order_id: Astro.params.id });
const operational = command.success;
let identity = null;
let order: CustomerOrder | null = null;
let csrf = '';
let message = 'Order not found.';
let proMember = false;
if (operational) {
  const account = accountContext(Astro.request, Astro.cookies);
  try {
    identity = await account.identity();
    if (!identity) return account.redirect('/?signin=1');
    if (identity.viewer.role !== 'customer')
      return account.redirect(
        identity.viewer.role === 'admin' ? '/admin' : '/teammate',
      );
    if (!account.client) throw new Error('Account unavailable');
    const { data, error } = await account.client.rpc('customer_order', {
      p_order_id: command.data.order_id,
    });
    const result = decodeOrderRpcResult('customerOrder', data, error);
    if (result.ok && result.payload.order.id === command.data.order_id) {
      order = result.payload.order;
      csrf = account.csrf();
      // R2: PRO members re-roll without the limit of 2 (reroll_order checks is_pro too).
      proMember =
        (await loadProView(account.client, identity.viewer.role))?.member ===
        true;
    } else if (!result.ok) {
      Astro.response.status = result.status;
      message =
        result.status === 404
          ? 'Order not found.'
          : 'Order temporarily unavailable. Please refresh to try again.';
    } else {
      Astro.response.status = 502;
      message = 'Order temporarily unavailable. Please refresh to try again.';
    }
  } catch {
    Astro.response.status = 503;
    message =
      'Account or order temporarily unavailable. Please try again shortly.';
  }
  // Copy after identity/RPC so refreshed authentication headers are preserved.
  for (const [name, value] of account.headers)
    Astro.response.headers.set(name, value);
} else return Astro.rewrite('/404');
---

{operational && order && identity ? (
  <SiteLayout
    title="Your order | Duoly"
    viewer={identity.viewer}
    csrf={csrf}
    bare
  >
    <LiveQueueRoom
      id={order.id}
      viewer={identity.viewer}
      csrf={csrf}
      chatEnabled={chatEnabled}
      reportsEnabled={reportsEnabled}
      proMember={proMember}
      client:load
    />
  </SiteLayout>
) : (
  <ProductLayout
    title="Your order | Duoly"
    viewer={identity?.viewer}
    csrf={csrf}
  >
    <section class="customer-orders" role="alert">
      <h1>
        {Astro.response.status === 404
          ? 'Order not found'
          : 'Order unavailable'}
      </h1>
      <p>{message}</p>
      <a href="/dashboard">Back to dashboard</a>
    </section>
  </ProductLayout>
)}

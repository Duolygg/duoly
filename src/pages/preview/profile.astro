---
import DesignLayout from '../../layouts/DesignLayout.astro';
import Profile from '../../design-reference/components/Profile.jsx';
import { SAMPLE_USER } from '../../design-preview/sample-data';
---

<DesignLayout title="Profile | Duoly design preview">
  <Profile
    user={SAMPLE_USER}
    profile={{
      country: 'at',
      bio: 'Sample profile only.',
      languages: ['English'],
    }}
    home="/preview/dashboard"
    languages={['English', 'German']}
    discord={null}
    discordResult=""
    client:load
  />
</DesignLayout>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SeoHero from '../../components/seo/SeoHero.astro';
import Faq from '../../components/seo/Faq.astro';
import ClosingCta from '../../components/seo/ClosingCta.astro';
import OfferCard from '../../components/seo/OfferCard.astro';
import '../../components/seo/article.css';
import '../../components/seo/seo.css';
import '../../components/seo/free-vs-paid.css';
import '../../components/seo/guide-article.css';
import '../../components/seo/official.css';
import '../../components/seo/report.css';
import { pageViewer } from '../../site/viewer';
import { faqSchema, seoOffers } from '../../server/seo/offers';
import { heroOffer } from '../../server/seo/hero-offer';
import { viewerCurrency } from '../../server/currency';
import { eurToUsd } from '../../server/fx';
import {
  EPAL_TWO_FIGURE_CARDS,
  SURVEY_CHECKED,
  SURVEY_CHECKED_LABEL,
  SURVEY_FX,
} from '../../content/price-report-2026';
import { BUNDLE_PERCENTS } from '../../server/seo/teammate-facts';
import {
  ANSWERED_COUNT,
  BLOCKED_PLATFORMS,
  COMPETITOR_COUNT,
  CSV_HEADER,
  DUOLY,
  FREE_PLATFORMS,
  HOURLY_BANDS,
  HOURLY_BY_SOURCE,
  HOURLY_COACHING,
  HOURLY_TOP_SOURCE,
  NO_PRICE_PLATFORMS,
  OBSERVATION_COUNT,
  SESSION_COACHING,
  TABLE,
  TEAMMATE_PER_GAME,
  VERIFIED_PLATFORM_NAMES,
  VERIFIED_PLATFORMS,
} from '../../server/seo/price-report';
import {
  REPORT_CSV_PATH,
  REPORT_LICENSE,
  REPORT_PATH,
  bookingHref,
  CONTENT_DATES,
  organizationSchema,
  serializeJsonLd,
} from '../../site/seo';

const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
/**
 * Duoly's own lesson, priced through the engine checkout charges on.
 *
 * It sits under the findings rather than in the hero: a reader arriving at a
 * price survey is owed the numbers first, and a survey that opened with its
 * publisher's own offer would be an advertisement with a method section.
 */
const reportCurrency = await viewerCurrency(Astro.cookies, accountCurrency);
const reportOffer = heroOffer(
  'val',
  'vod',
  seoOffers('val', 'training', {
    customerCurrency: reportCurrency.cur,
    eurToUsd: reportCurrency.cur === 'USD' ? (await eurToUsd()).rate : 1,
  }),
  { coach: true },
)!;
const path = REPORT_PATH;
const csv = REPORT_CSV_PATH;
const title = 'Gaming Coaching and Teammate Prices 2026 | Duoly';
const h1 = 'Gaming coaching and teammate prices in 2026';
const published = SURVEY_CHECKED;
const description = `Original survey: ${HOURLY_COACHING.count} verified hourly coaching rates across ${COMPETITOR_COUNT} platforms, a median of ${HOURLY_COACHING.median} an hour, with the method, every source and a CSV download.`;
/** The band chart's widest bar, so the bars are drawn to scale. */
const widestBand = Math.max(...HOURLY_BANDS.map((band) => band.count));
const weCoachValorant = HOURLY_BY_SOURCE.find(
  (entry) => entry.platform === 'WeCoach' && entry.game === 'Valorant',
)!;
const weCoachLeague = HOURLY_BY_SOURCE.find(
  (entry) => entry.platform === 'WeCoach' && entry.game === 'League of Legends',
)!;
const metafyHours = HOURLY_BY_SOURCE.find(
  (entry) => entry.platform === 'Metafy',
)!;
const platform = (name: string) => TABLE.find((row) => row.name === name)!;
const metafy = platform('Metafy');
const queueup = platform('QueueUp');
const epal = platform('E-Pal');
const sensei = platform('Gamer Sensei');
const silhouette = platform('Silhouette');
const kaki = platform('KAKI Gaming');
const wecoach = platform('WeCoach');
const duoly = platform('Duoly');
const bandList = HOURLY_BANDS.map(
  (band) => `${band.label}, ${band.count} rates`,
).join('; ');
/** The platforms that published a price, numbered, for the answer-first FAQ. */
const verifiedList = VERIFIED_PLATFORM_NAMES.map(
  (name, index) =>
    `${index === VERIFIED_PLATFORM_NAMES.length - 1 ? 'and ' : ''}${index + 1}) ${name}`,
).join(VERIFIED_PLATFORM_NAMES.length > 2 ? ', ' : ' ');
const sources = TABLE.flatMap((row) =>
  row.sources.map((source) => ({
    platform: row.name,
    title: source.title,
    url: source.url,
  })),
);
const faqItems: [string, string][] = [
  [
    'How much does gaming coaching cost in 2026?',
    `The median verified price is ${HOURLY_COACHING.median} an hour, or ${HOURLY_COACHING.medianEur}, from ${HOURLY_COACHING.count} coach rates read on ${SURVEY_CHECKED_LABEL}. Rates ran ${HOURLY_COACHING.low} to ${HOURLY_COACHING.high}. A Duoly lesson is ${DUOLY.coachingHour} an hour.`,
  ],
  [
    'What does a paid gaming teammate cost per game?',
    `On E-Pal, ${TEAMMATE_PER_GAME.count} Valorant cards showed one price per game, ${TEAMMATE_PER_GAME.low} to ${TEAMMATE_PER_GAME.high}, median ${TEAMMATE_PER_GAME.median}. E-Pal prices 1 Buff at USD 1.00. A Duoly teammate game runs ${DUOLY.teammateFrom} to ${DUOLY.teammateTo}.`,
  ],
  [
    'Which gaming platforms publish their prices openly?',
    `${VERIFIED_PLATFORMS} of the ${COMPETITOR_COUNT} did: ${verifiedList}. ${FREE_PLATFORMS.length} charge nothing, ${NO_PRICE_PLATFORMS.length - FREE_PLATFORMS.length - BLOCKED_PLATFORMS.length} describe provider-set prices without showing one, and ${BLOCKED_PLATFORMS.length} returned HTTP 403.`,
  ],
  [
    'How were these prices verified?',
    `Our survey read each figure from the platform's own public page on ${SURVEY_CHECKED_LABEL}, and every dataset row carries that URL and date. A price we could not read was dropped rather than estimated.`,
  ],
  [
    'Can I download this price data?',
    `Yes. The CSV at duoly.gg${csv} carries all ${OBSERVATION_COUNT} observations plus the Duoly rows, each with its source URL and check date. It is free to reuse under ${REPORT_LICENSE.name} with credit to Duoly.`,
  ],
  [
    'Do platform fees change the price you pay?',
    `Yes, and they differ. Metafy states a 3.7% platform fee plus USD 1.79 and a 2.9% processing fee plus USD 0.40. E-Pal charges 10% on a top-up. Duoly adds nothing at checkout.`,
  ],
];
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  mainEntityOfPage: new URL(path, Astro.site!).href,
  datePublished: published,
  dateModified: CONTENT_DATES[path],
  author: organizationSchema(Astro.site!),
  publisher: organizationSchema(Astro.site!),
  image: new URL('/og/duoly.jpg', Astro.site!).href,
};
const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Gaming coaching and teammate prices, November 2026',
  description: `Prices for gaming coaching and paid gaming teammates, read from ${COMPETITOR_COUNT} platforms' own public pages on ${SURVEY_CHECKED}, plus Duoly's own published prices from its pricing engine. ${OBSERVATION_COUNT} verified observations with the source URL and check date on every row.`,
  url: new URL(path, Astro.site!).href,
  identifier: new URL(path, Astro.site!).href,
  creator: organizationSchema(Astro.site!),
  publisher: { '@id': new URL('/#organization', Astro.site!).href },
  datePublished: published,
  dateModified: CONTENT_DATES[path],
  temporalCoverage: SURVEY_CHECKED,
  isAccessibleForFree: true,
  license: REPORT_LICENSE.url,
  measurementTechnique:
    'Manual reading of each platform public pricing page, one row per displayed price, with no estimated values',
  variableMeasured: [...CSV_HEADER],
  distribution: [
    {
      '@type': 'DataDownload',
      name: 'Gaming coaching and teammate prices 2026 (CSV)',
      encodingFormat: 'text/csv',
      license: REPORT_LICENSE.url,
      contentUrl: new URL(csv, Astro.site!).href,
    },
  ],
};
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page official-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Pricing', path: '/pricing' },
        { name: 'Gaming coaching and teammate prices 2026', path },
      ]}
    />
    <SeoHero
      eyebrow="Price report"
      h1={h1}
      lead={`We read the public pricing pages of ${COMPETITOR_COUNT} gaming coaching and teammate platforms on ${SURVEY_CHECKED_LABEL} and recorded every price each one published. This page is the result: ${OBSERVATION_COUNT} verified prices, the method behind them, every source link and a CSV you can download.`}
      price={`Median coaching hour: ${HOURLY_COACHING.median}`}
      cta={{ href: '#findings-h', label: 'Read the findings' }}
      secondary={{ href: csv, label: 'Download the CSV' }}
      art={[
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
      ]}
      chip={`Checked ${SURVEY_CHECKED}`}
      facts={[
        `${OBSERVATION_COUNT} verified prices`,
        `${VERIFIED_PLATFORMS} of ${COMPETITOR_COUNT} platforms published one`,
        `${HOURLY_COACHING.count} hourly coaching rates`,
        'Every row carries its source and date',
      ]}
    />
    <p class="byline">
      Research by the <a href="/contact">Duoly team</a>. Published{' '}
      <time datetime={published}>{SURVEY_CHECKED_LABEL}</time>. This report is a
      reading of public pricing pages rather than a test of the services. Our
      survey opened {COMPETITOR_COUNT} gaming coaching and teammate platforms on
      one day and recorded {OBSERVATION_COUNT} published prices from the{' '}
      {VERIFIED_PLATFORMS} platforms that showed one. The median coaching hour
      came out at {HOURLY_COACHING.median}, or {HOURLY_COACHING.medianEur}, with{' '}
      {HOURLY_BANDS[0]!.percent}% of hourly rates under USD 20.00 and{' '}
      {HOURLY_BANDS[4]!.percent}% at USD 50.00 or more. Every euro figure in the
      report uses one rate, the {SURVEY_FX.source} of {SURVEY_FX.publishedLabel}
      , so a reader can reproduce the arithmetic. A listed price is a listed
      price: our survey ran no checkout, measured no coaching outcome and
      compared no quality. For example, provider-set prices move daily, so treat
      each figure as the price a page showed on {SURVEY_CHECKED_LABEL}.
    </p>
    <nav class="guide-toc" aria-label="In this report">
      <strong>In this report</strong>
      <ul>
        <li>
          <a href="#findings-h">What did this price survey find?</a>
        </li>
        <li>
          <a href="#hourly-h">How much does gaming coaching cost per hour?</a>
        </li>
        <li>
          <a href="#teammate-h">What does a paid teammate cost?</a>
        </li>
        <li>
          <a href="#fees-h">How do fees and refunds differ?</a>
        </li>
        <li>
          <a href="#method-h">How was this survey done?</a>
        </li>
        <li>
          <a href="#table-h">Which prices did the survey verify?</a>
        </li>
        <li>
          <a href="#sources-h">Which pages did the survey read?</a>
        </li>
        <li>
          <a href="#limits-h">What does this survey not show?</a>
        </li>
        <li>
          <a href="#data-h">Where can you download the data?</a>
        </li>
        <li>
          <a href="#faq-h">What do readers ask about prices?</a>
        </li>
      </ul>
    </nav>

    <section aria-labelledby="findings-h">
      <h2 id="findings-h">What did this price survey find?</h2>
      <p>
        The median published price of a gaming coaching hour is{' '}
        {HOURLY_COACHING.median}, or {HOURLY_COACHING.medianEur}, and the full
        set runs from {HOURLY_COACHING.low} to {HOURLY_COACHING.high} an hour.
        We read {COMPETITOR_COUNT} platforms on {SURVEY_CHECKED_LABEL} and
        recorded {OBSERVATION_COUNT} prices from the {VERIFIED_PLATFORMS} that
        published one. Three findings follow, and every figure sits in the table
        below with the page it came from.
      </p>
      <ul class="report-findings">
        <li>
          <span class="report-finding-label">Median coaching hour</span>
          <span class="report-finding-big">{HOURLY_COACHING.median}</span>
          <span class="report-finding-sub">
            {HOURLY_COACHING.medianEur} at the ECB rate of{' '}
            {SURVEY_FX.publishedLabel}
          </span>
          <span class="report-finding-text">
            An hour of one-to-one coaching is the one unit most platforms price
            openly. Our survey median covers {HOURLY_COACHING.count} coach-set
            rates on {HOURLY_COACHING.platforms.join(' and ')}. The cheapest
            hour was {HOURLY_COACHING.low} and the dearest{' '}
            {HOURLY_COACHING.high}. Duoly charges a flat {DUOLY.coachingHour}{' '}
            instead.
          </span>
        </li>
        <li>
          <span class="report-finding-label">Range by service type</span>
          <span class="report-finding-big">
            {TEAMMATE_PER_GAME.lowEur} to {HOURLY_COACHING.highEur}
          </span>
          <span class="report-finding-sub">
            One teammate game at the low end, one coaching hour at the high end
          </span>
          <span class="report-finding-text">
            Three service types price differently. Coaching by the hour ran{' '}
            {HOURLY_COACHING.low} to {HOURLY_COACHING.high}. Coaching sold as a
            session with no stated duration ran {SESSION_COACHING.low} to{' '}
            {SESSION_COACHING.high}. Teammate time per game ran{' '}
            {TEAMMATE_PER_GAME.low} to {TEAMMATE_PER_GAME.high}, and E-Pal
            prices 1 Buff at USD 1.00.
          </span>
        </li>
        <li>
          <span class="report-finding-label">Platform fees vary</span>
          <span class="report-finding-big">3.7% plus USD 1.79</span>
          <span class="report-finding-sub">
            What Metafy states it adds to a buyer's subtotal
          </span>
          <span class="report-finding-text">
            Fees decide the total. Metafy publishes a 3.7% platform fee plus USD
            1.79 and a 2.9% processing fee plus USD 0.40. E-Pal charges 10% on a
            wallet top-up. QueueUp refunds up to USD 35.00 after a first paid
            session. For example, a Duoly order nobody accepts refunds itself
            after {DUOLY.autoCancelMinutes} minutes.
          </span>
        </li>
      </ul>
      <OfferCard
        offer={reportOffer}
        coach
        art={{ src: '/assets/games/valorant.png', alt: '' }}
        text={`Duoly is one of the platforms in this survey, and this is the price it publishes: the same lesson price in every game it coaches, with nothing added at checkout.`}
      />
    </section>

    <section aria-labelledby="hourly-h">
      <h2 id="hourly-h">How much does gaming coaching cost per hour?</h2>
      <p>
        Gaming coaching costs a median of {HOURLY_COACHING.median} an hour,
        which is {HOURLY_COACHING.medianEur} at the{' '}
        <a href={SURVEY_FX.url} rel="nofollow noopener">
          {SURVEY_FX.source}
        </a>{' '}
        published on {SURVEY_FX.publishedLabel}. Our survey found{' '}
        {HOURLY_COACHING.count} rates sold explicitly by the hour, from only{' '}
        {HOURLY_COACHING.platforms.length} platforms that publish one openly. 1){' '}
        {weCoachValorant.spread.count} Valorant coach cards on{' '}
        {weCoachValorant.platform} with a median of{' '}
        {weCoachValorant.spread.median}, then {weCoachLeague.spread.count}{' '}
        League of Legends cards at the same {weCoachLeague.spread.median}{' '}
        median, and {metafyHours.spread.count} Overwatch 2 sessions labelled one
        hour on {metafyHours.platform} at {metafyHours.spread.low} to{' '}
        {metafyHours.spread.high}. The spread is wide:{' '}
        {HOURLY_BANDS[1]!.percent}% of rates sit between USD 20.00 and USD
        29.99, while {HOURLY_BANDS[4]!.percent}% ask USD 50.00 or more. For
        example, the dearest single hour was {HOURLY_COACHING.high}, which is{' '}
        {HOURLY_COACHING.highEur}. Two prices come close to an hour without
        being one: {queueup.name} fixes an Instant session at USD 24.00 for 45
        minutes, and {sensei.name} sells a 30 minute skills assessment at USD
        24.99. Duoly lists {DUOLY.coachingHour} an hour in all{' '}
        {DUOLY.coachedGames} coached games.
      </p>
      <div
        class="report-bands"
        aria-label="Verified hourly rates by price band"
      >
        {HOURLY_BANDS.map((band) => (
          <div class="report-band">
            <span class="report-band-label">{band.label}</span>
            <span class="report-band-track">
              <span
                class="report-band-fill"
                style={`width: ${Math.round((band.count / widestBand) * 100)}%`}
              />
              <span class="report-band-count">
                {band.count} rates, {band.percent}%
              </span>
            </span>
          </div>
        ))}
        <p class="report-band-note">
          {HOURLY_COACHING.count} hourly rates read on {SURVEY_CHECKED_LABEL}:{' '}
          {bandList}. Bands are in US dollars, the currency every one of these
          pages priced in.
        </p>
      </div>
    </section>

    <section aria-labelledby="teammate-h">
      <h2 id="teammate-h">What does a paid gaming teammate cost?</h2>
      <p>
        A paid teammate is a price per game on most platforms, and the figures
        are far smaller than a coaching hour. On {epal.name},{' '}
        {TEAMMATE_PER_GAME.count} Valorant provider cards showed a single price
        per game from {TEAMMATE_PER_GAME.low} to {TEAMMATE_PER_GAME.high}, with
        a median of {TEAMMATE_PER_GAME.median}, which is{' '}
        {TEAMMATE_PER_GAME.medianEur} at the recorded rate.{' '}
        {EPAL_TWO_FIGURE_CARDS} further cards showed a discount badge with two
        figures each, so our survey left those out rather than publish a price
        that depends on an offer. One card on the same page sold time rather
        than games, at 15.00 Buff per 30 minutes, which is the only time-based
        teammate price the survey could read anywhere. For example, a Duoly
        teammate game runs {DUOLY.teammateFrom} for {DUOLY.teammateFromService}{' '}
        in {DUOLY.teammateFromGame} up to {DUOLY.teammateTo} for{' '}
        {DUOLY.teammateToService} in {DUOLY.teammateToGame}, before the{' '}
        {BUNDLE_PERCENTS[0]}% to {BUNDLE_PERCENTS[2]}% bundle discounts. Two
        platforms charge nothing:{' '}
        {FREE_PLATFORMS.map((free) => free.name).join(' and ')} both run free
        looking-for-group matching.
      </p>
      <div class="guide-one">
        <article class="card guide-card" aria-label="Teammate prices by model">
          <p class="guide-card-title">Three ways a teammate is priced</p>
          <ul class="checklist">
            <li>
              <strong>Per game, provider-set.</strong> {epal.name} at{' '}
              {TEAMMATE_PER_GAME.low} to {TEAMMATE_PER_GAME.high} in Buff, set
              by each provider and changed whenever they like.
            </li>
            <li>
              <strong>Per time block, provider-set.</strong> {epal.name} again,
              at 15.00 Buff for 30 minutes on one card, so the same roster sells
              both a game and a clock.
            </li>
            <li>
              <strong>Per game, published tariff.</strong> {duoly.name} at{' '}
              {DUOLY.teammateFrom} to {DUOLY.teammateTo}, set by the service and
              the rank rather than by the teammate.
            </li>
          </ul>
          <a class="btn-sm" href={bookingHref('val', { service: 'duo2' })}>
            See a Valorant teammate price
          </a>
        </article>
      </div>
    </section>

    <section aria-labelledby="fees-h">
      <h2 id="fees-h">How do fees and refunds differ?</h2>
      <p>
        A listed price is the total on some platforms and the start of the total
        on others, so fees decide what you actually pay. According to the{' '}
        <a
          href="https://help.metafy.gg/en/articles/14676126-buyer-fees-breakdown"
          rel="nofollow noopener"
        >
          {metafy.name} buyer fee page
        </a>
        , checkout adds a 3.7% platform fee plus USD 1.79, capped at USD 20.00
        or 30% of the total, and a 2.9% processing fee plus USD 0.40, unless a
        partner covers them. {epal.name} publishes a 10% service fee on every
        wallet top-up plus a 3% to 4.5% channel fee on the web.{' '}
        {silhouette.name} states companions keep 83% of a completed session, and{' '}
        {kaki.name} states a 0% platform fee on regular orders. Refund wording
        is thinner. For example, {queueup.name} publishes the most of it: a full
        refund of up to USD 35.00 after a first paid session, a refund when a
        coach does not show, and a free intro of 10 to 15 minutes.{' '}
        {wecoach.name} advertises a free first intro with participating coaches.
        Our survey found no refund window at all on the {epal.name},{' '}
        {metafy.name} or {sensei.name} pages. Duoly adds nothing at checkout and
        cancels an unaccepted order after {DUOLY.autoCancelMinutes} minutes.
      </p>
    </section>

    <section aria-labelledby="method-h">
      <h2 id="method-h">How was this survey done?</h2>
      <p>
        The method is a reading of public pages rather than a test of the
        services. On {SURVEY_CHECKED_LABEL} our survey opened the pricing,
        coaching or provider page of each of the {COMPETITOR_COUNT} platforms
        and recorded every price shown, one row per displayed figure, with the
        URL and the date on each row. We created no account and contacted
        nobody, so a logged-in price is outside this survey. Each row keeps the
        billing unit the page stated, which is why {HOURLY_COACHING.count} of{' '}
        {OBSERVATION_COUNT} rows reach the hourly median. For example, a USD
        44.99 package with no stated duration stays a session and never becomes
        an hour. Euro figures use one rate, 1 euro to {SURVEY_FX.usdPerEur} US
        dollars, from the {SURVEY_FX.source} of {SURVEY_FX.publishedLabel}, and
        a wallet unit converts only where the platform publishes the rate:{' '}
        {epal.name} prices 1 Buff at USD 1.00. Duoly figures come from the
        pricing engine at build time.
      </p>
      <div class="guide-one">
        <article class="card guide-card" aria-label="Survey rules">
          <p class="guide-tag">Rules we held to</p>
          <p class="guide-card-title">Four rules behind every row</p>
          <ul class="checklist">
            <li>
              <strong>First-party only.</strong> A price counts when the
              platform's own page showed it on {SURVEY_CHECKED_LABEL}. No
              roundup, no competitor comparison and no older capture.
            </li>
            <li>
              <strong>Dropped, never estimated.</strong>{' '}
              {BLOCKED_PLATFORMS.length} platforms answered with HTTP 403, so
              they have no price rows at all.
            </li>
            <li>
              <strong>The page's own unit.</strong> Per hour, per game, per
              session or per 30 minutes, exactly as labelled.
            </li>
            <li>
              <strong>One recorded rate.</strong> Every euro figure uses the
              same {SURVEY_FX.publishedLabel} ECB reference rate, so the numbers
              stay reproducible.
            </li>
          </ul>
        </article>
      </div>
    </section>

    <section aria-labelledby="table-h">
      <h2 id="table-h">Which prices did the survey verify?</h2>
      <p>
        The table below is our survey in full: {COMPETITOR_COUNT} platforms plus
        Duoly, in alphabetical order, with the prices we verified, who sets
        them, the published fees and the published refund terms. Alphabetical
        order is deliberate, because any other order would be an argument rather
        than a result. For example, {sensei.name} publishes three fixed packages
        while {wecoach.name} publishes a rate per coach, so the two rows answer
        different questions. {ANSWERED_COUNT} of the {COMPETITOR_COUNT}{' '}
        platforms answered our request at all.
      </p>
      <div class="official-table-wrap">
        <table class="report-table">
          <caption class="sr-only">
            {`Verified gaming coaching and teammate prices on ${COMPETITOR_COUNT} platforms plus Duoly, read on ${SURVEY_CHECKED_LABEL}`}
          </caption>
          <colgroup>
            <col class="report-col-platform" />
            <col class="report-col-prices" />
            <col class="report-col-model" />
            <col class="report-col-fees" />
            <col class="report-col-refunds" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">Platform</th>
              <th scope="col">Verified prices</th>
              <th scope="col">Who sets the price</th>
              <th scope="col">Published fees</th>
              <th scope="col">Published refunds</th>
            </tr>
          </thead>
          <tbody>
            {TABLE.map((row) => (
              <tr>
                <th scope="row">
                  {row.name}
                  <span class="report-sells">{row.sells}</span>
                </th>
                <td class="report-prices">{row.prices}</td>
                <td>{row.priceModel}</td>
                <td>{row.fees}</td>
                <td>{row.refunds}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="official-table-note">
        Read on <time datetime={SURVEY_CHECKED}>{SURVEY_CHECKED_LABEL}</time>.
        Prices in a wallet unit are written in that unit. Duoly prices come from
        the <a href="/pricing">Duoly price list</a>, which is generated from the
        pricing engine.
      </p>
    </section>

    <section aria-labelledby="sources-h">
      <h2 id="sources-h">Which pages did the survey read?</h2>
      <p>
        A source list is the whole point of a price report, so every page our
        survey opened is listed below with the date it was read. Each entry is a
        first-party page published by the platform itself rather than a roundup
        written about it. The {BLOCKED_PLATFORMS.length} pages that answered
        with HTTP 403 are listed anyway, because a reader deserves to know which
        pages we tried and failed to read. The {SURVEY_FX.source} entry is the{' '}
        {SURVEY_FX.usdPerEur} rate every euro figure here is converted at. For
        example, {HOURLY_TOP_SOURCE.percent}% of the hourly rates came from the
        two {wecoach.name} rosters and the other{' '}
        {100 - HOURLY_TOP_SOURCE.percent}% from the {metafy.name} session list,
        so three pages rebuild the {HOURLY_COACHING.median} median.
      </p>
      <ol class="report-sources">
        {sources.map((source) => (
          <li>
            <a href={source.url} rel="nofollow noopener">
              {source.platform}: {source.title}
            </a>{' '}
            <span class="report-sub">(accessed {SURVEY_CHECKED}).</span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="limits-h">
      <h2 id="limits-h">What does this survey not show?</h2>
      <p>
        A price survey of one day is a snapshot, and five limits matter before
        anyone quotes it. The hourly median leans on one platform:{' '}
        {HOURLY_TOP_SOURCE.percent}% of the {HOURLY_COACHING.count} hourly rates
        are {HOURLY_TOP_SOURCE.platform} coach cards, because almost nobody else
        publishes a rate per hour openly. Provider-set prices change whenever
        the provider likes, so {SURVEY_CHECKED_LABEL} is one reading rather than
        a trend. These are listed prices rather than totals paid: our survey ran
        no checkout anywhere, so the fee column describes published fees instead
        of measured ones, and no figure includes tax. For example, a{' '}
        {metafy.name} session listed at USD 25.00 reaches a buyer at more than
        USD 25.00 once the stated 3.7% and 2.9% fees land. An HTTP 403 describes
        our access rather than the platform: the {BLOCKED_PLATFORMS.length}{' '}
        pages that answered that way run bot protection that a scripted reader
        trips, and a person opening the same URL in a browser may well see
        prices. A price says nothing about quality: this survey measures no
        coaching outcome, no rank change and no satisfaction. Unknown here means
        we could not establish it on a public page on {SURVEY_CHECKED_LABEL}.
      </p>
    </section>

    <section aria-labelledby="data-h">
      <h2 id="data-h">Where can you download the data?</h2>
      <p>
        The dataset is a CSV at <a href={csv}>duoly.gg{csv}</a>, generated at
        build time from the same data file this page renders from. It carries
        one line per observation our survey recorded, {OBSERVATION_COUNT} of
        them from the platforms plus the Duoly rows out of the pricing engine,
        and every line names its source URL and the date it was read. The amount
        column keeps the figure the page showed and amount_eur converts it at
        the one recorded rate of {SURVEY_FX.usdPerEur}, so the{' '}
        {HOURLY_COACHING.median} median and the {HOURLY_COACHING.medianEur}{' '}
        conversion can both be rebuilt in a spreadsheet. Quote any figure with a
        link to this page and the check date, or go straight to the source page
        named in the row. For example, filtering billing_unit to hour and
        currency to USD gives the {HOURLY_COACHING.count} rates behind the
        median, of which {HOURLY_BANDS[0]!.percent}% sit under USD 20.00.
      </p>
      <p>
        The data is published under{' '}
        <a href={REPORT_LICENSE.url} rel="license">
          {REPORT_LICENSE.name}
        </a>
        : you may reuse, share and adapt it, including commercially, as long as
        you credit Duoly and link to this page.
      </p>
      <div class="report-download">
        <ul class="report-columns">
          {CSV_HEADER.map((column) => (
            <li>{column}</li>
          ))}
        </ul>
        <a class="cta" href={csv} download>
          Download the CSV
        </a>
      </div>
    </section>

    <Faq
      heading="What do readers ask about gaming coaching prices?"
      items={faqItems}
    />

    <ClosingCta
      heading="Book a session at a price you can read first"
      text={`The survey median for a coaching hour is ${HOURLY_COACHING.median}, or ${HOURLY_COACHING.medianEur}, across ${HOURLY_COACHING.count} rates read on ${SURVEY_CHECKED_LABEL}. A Duoly lesson is ${DUOLY.coachingHour} an hour in all ${DUOLY.coachedGames} coached games, and a teammate game starts at ${DUOLY.teammateFrom}.`}
      extra={`Three facts make the Duoly figures checkable. Every Duoly price on this page comes from the pricing engine checkout charges on, with catalog prices last changed on ${DUOLY.pricesUpdated}. Nothing is added at checkout, so the euro figure is the total, and a US dollar price uses the daily ECB rate plus ${DUOLY.usdMarginPercent}%. A teammate or coach keeps ${DUOLY.sharePercent}% of a flat-priced hour, which Duoly publishes. For example, an unaccepted order cancels and refunds itself after ${DUOLY.autoCancelMinutes} minutes.`}
      href={bookingHref('val', { service: 'vod' })}
      label="Book a coaching hour"
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Keep reading</h2>
      <div class="chips">
        <a href="/pricing">Every Duoly price in one table</a>
        <a href="/fees-and-refunds">Duoly fees and refunds</a>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import { pageViewer } from '../site/viewer';
import { CONTENT_DATES, hubChips, serializeJsonLd } from '../site/seo';
import { faqSchema } from '../server/seo/offers';
import { BUSINESS, BUSINESS_LOCATION } from '../site/entity';
import {
  COACHING_PRICE,
  PLAYABLE_GAMES,
  SHARE_PERCENT,
  SHORT_GAME_PRICE,
} from '../server/seo/teammate-facts';
import {
  AUTO_CANCEL_MINUTES,
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED,
  COACHING_HOUR,
  FIVE_COACHING_HOURS,
  FIVE_GAMES,
  MAX_QUANTITY,
  PRICE_EXAMPLES,
  QUANTITY_PERCENT,
  SINGLE_GAME,
  TEN_GAME_BUNDLE,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/fees-and-refunds';
const title = 'Duoly Fees and Refunds: What a Session Costs | Duoly';
const description = `What a Duoly session costs and what you get back. Real prices from ${SHORT_GAME_PRICE}, bundle discounts of ${BUNDLE_PERCENTS.join(', ')} percent, and the refund rules in full.`;
const HUB_LINKS = hubChips([
  'league-of-legends',
  'valorant',
  'fortnite',
  'rocket-league',
]);
/** The catalog price date the rest of the SEO pages already state. */
const PRICES_UPDATED = CATALOG_PRICES_UPDATED;
const pricesLabel = '8 November 2026';
const faq: [string, string][] = [
  [
    'Does Duoly add a booking fee or a service fee?',
    'No. The total shown before checkout is the amount Stripe charges, and the Duoly terms say the price you see at checkout is the price you pay. There is no booking fee, no payment surcharge and no subscription.',
  ],
  [
    'How much is the cheapest Duoly session?',
    `The lowest listed price is ${SHORT_GAME_PRICE} for a Valorant Skirmish 2v2 game. Coaching is ${COACHING_PRICE} per hour or game in every coachable title.`,
  ],
  [
    'Do I get money back if nobody takes my order?',
    `Yes. An order nobody accepts within ${AUTO_CANCEL_MINUTES} minutes cancels itself and the full amount returns to your Duoly balance, with nothing to claim.`,
  ],
  [
    'Can a refund go back to my card instead of my Duoly balance?',
    'Refunds go to your Duoly balance by default so you can rebook at once. The terms say money refunded to your balance can be paid back to your original payment method on request, and promotional cashback and gifts cannot.',
  ],
  [
    'What if my teammate never shows up?',
    'Report the order from your order room. The terms cover a no-show, a teammate leaving and toxic behaviour the same way: a real person reviews the report and can refund the order to your balance.',
  ],
  [
    'Do bundle discounts apply to coaching?',
    `No. Coaching never takes a quantity discount, so ${MAX_QUANTITY} lessons cost ${FIVE_COACHING_HOURS.total} at ${COACHING_HOUR.total} each. Teammate bundles of ${BUNDLE_SIZES.join(', ')} units take ${BUNDLE_PERCENTS.join(', ')}% off.`,
  ],
  [
    'Am I charged per game or once for the whole order?',
    'Once, when you queue. The terms state one upfront payment for every game or hour in the order, with no charge after each game.',
  ],
  [
    'Where can I read every Duoly price in one place?',
    'duoly.gg/pricing.md lists every game and every bookable service as plain text, with the price for each rank. It is generated from the pricing engine on each deploy, so it matches checkout rather than a copy of it.',
  ],
  [
    'Who operates Duoly, and where?',
    `Duoly is a sole proprietorship based in ${BUSINESS_LOCATION}, registered under trade register number GISA ${BUSINESS.gisa} and legally represented by ${BUSINESS.representedBy}. The about page and the imprint carry the full operator details.`,
  ],
  [
    'Can I still cancel after paying?',
    'Yes, free of charge until a teammate accepts the order, from your order room. Once the session has been fully played, the EU 14-day right of withdrawal has ended, because queueing asks Duoly to start the service right away.',
  ],
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: new URL(path, Astro.site!).href,
  name: title,
  description,
  dateModified: CONTENT_DATES[path],
  isPartOf: { '@id': new URL('/#website', Astro.site!).href },
  publisher: { '@id': new URL('/#organization', Astro.site!).href },
};
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page fees-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Fees and refunds', path },
      ]}
    />
    <SeoHero
      eyebrow="Prices and policy"
      h1="Duoly fees and refunds"
      lead="One upfront payment, the price you saw, no fee on top. Here is how a Duoly total is built, what the discounts are and exactly when money comes back."
      price={`${SINGLE_GAME.short}: ${SINGLE_GAME.total}`}
      cta={{ href: '/games', label: `See prices for ${PLAYABLE_GAMES} games` }}
      secondary={{ href: '#refund-h', label: 'Jump to refunds' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
      ]}
      chip={`Bundles up to ${BUNDLE_PERCENTS[2]}% off`}
      facts={[
        'One payment when you queue',
        'No booking or payment fee',
        `Free cancel until a teammate accepts`,
        'Refunds reviewed by a person',
      ]}
      note={`Prices read from the Duoly pricing engine. Catalog prices as of ${pricesLabel}.`}
    />

    <section aria-labelledby="fees-h">
      <h2 id="fees-h">What fees does Duoly charge on top of the price?</h2>
      <p>
        None. The total Duoly shows before checkout is the amount Stripe
        charges, and the <a href="/terms#payment">terms</a> put it plainly: “The
        price you see at checkout is the price you pay.” There is no booking
        fee, no payment surcharge and no subscription, so{' '}
        <a href={SINGLE_GAME.href}>a {SINGLE_GAME.short} order</a> costs{' '}
        {SINGLE_GAME.total} and nothing else. Duoly’s own cut comes out of that
        same figure as commission, covered further down, rather than being added
        to it. Duoly also takes one payment rather than a charge per game: the{' '}
        <a href="/terms#payment">payment section</a> states that the full price
        for every game or hour in the order is paid once, when you queue.
        Additionally, no wallet top-up stands between you and a session, which
        is how some marketplaces add a percentage before you ever book. For
        example, a reader comparing{' '}
        <a href="/compare/e-pal">Duoly with E-Pal</a> will find a 10% top-up
        service fee on that platform and none here.
      </p>
    </section>

    <section aria-labelledby="price-h">
      <h2 id="price-h">How is a Duoly price calculated?</h2>
      <p>
        A Duoly price is the service price for your rank, multiplied by how many
        games or hours you book, minus the quantity discount. Three inputs move
        the figure. First, the service: a League of Legends Duo Pro session and
        a Valorant VOD Review are different listings at different prices.
        Second, your own rank, which only applies to ranked play: lower ranks
        pay less and higher ranks pay more, because higher lobbies need stronger
        teammates. Third, the quantity. Coaching is flat at {COACHING_PRICE} per
        hour or game in every coachable title, with no rank multiplier at all.
        The examples below come straight from the same pricing engine checkout
        uses, so each total is the figure Stripe would charge today.
      </p>
      <div class="fees-table-wrap">
        <table class="fees-table">
          <caption class="sr-only">
            Duoly price examples, read from the pricing engine on{pricesLabel}
          </caption>
          <thead>
            <tr>
              <th scope="col">Selection</th>
              <th scope="col">Per unit</th>
              <th scope="col">Discount</th>
              <th scope="col">You pay</th>
            </tr>
          </thead>
          <tbody>
            {PRICE_EXAMPLES.map((item) => (
              <tr>
                <th scope="row">
                  <a href={item.href}>{item.short}</a>
                </th>
                <td>
                  {item.perUnit} per {item.unit}
                </td>
                <td>
                  {item.discountPercent
                    ? `${item.discountPercent}% off, saving ${item.saved}`
                    : 'None'}
                </td>
                <td class="fees-total">{item.total}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fees-note">
        Catalog prices as of{' '}
        <time datetime={PRICES_UPDATED}>{pricesLabel}</time>. Each selection
        above opens the checkout with that exact order prefilled. Open{' '}
        <a href="/games">any game page</a> for the full price list per rank, or{' '}
        <a href="/pricing.md">pricing.md</a> for every game and service as plain
        text, generated from the same pricing engine on every deploy.
      </p>
    </section>

    <section aria-labelledby="discount-h">
      <h2 id="discount-h">Which Duoly discounts are automatic?</h2>
      <p>
        Two quantity discounts exist, and both are applied in the checkout
        rather than on request. First, the quantity picker offers 1 to{' '}
        {MAX_QUANTITY} games or hours, and {MAX_QUANTITY} units take{' '}
        {QUANTITY_PERCENT}% off: {FIVE_GAMES.label} cost {FIVE_GAMES.total}{' '}
        instead of {MAX_QUANTITY} times {SINGLE_GAME.total}, saving{' '}
        {FIVE_GAMES.saved}. Second, the Bundles tab sells a game’s main service
        in packs of {BUNDLE_SIZES.join(', ')} units at {BUNDLE_PERCENTS[0]}%,{' '}
        {BUNDLE_PERCENTS[1]}% and {BUNDLE_PERCENTS[2]}% off, so{' '}
        {TEN_GAME_BUNDLE.label} costs {TEN_GAME_BUNDLE.total} and saves{' '}
        {TEN_GAME_BUNDLE.saved}, the largest discount Duoly offers. A bundle
        always covers one teammate. Coaching takes no quantity discount, so{' '}
        {FIVE_COACHING_HOURS.label} cost {FIVE_COACHING_HOURS.total}.
        Additionally, prices can change over time, and the{' '}
        <a href="/terms#payment">terms</a> hold an order you already placed to
        the price you paid.
      </p>
    </section>

    <section aria-labelledby="currency-h">
      <h2 id="currency-h">Does Duoly charge in euros or US dollars?</h2>
      <p>
        Duoly prices are set in euros and charged in euros or US dollars,
        whichever you pick. According to the{' '}
        <a href="/terms#payment">payment terms</a>, a dollar price is the euro
        price converted at the day’s European Central Bank rate plus a{' '}
        {USD_MARGIN_PERCENT}% currency margin, rounded up to .99, so a dollar
        total is a few cents above the plain mid-market conversion. Payment runs
        through Stripe, which means Duoly never sees or stores full card
        details. You can also pay part or all of an order from your Duoly
        balance, where refunds, cashback and level-up gifts land. For example, a
        customer with {SINGLE_GAME.total} of balance can cover a{' '}
        {SINGLE_GAME.short} order without a card charge at all. Your bank may
        still apply its own foreign currency handling, which is outside Duoly’s
        control.
      </p>
    </section>

    <section aria-labelledby="refund-h">
      <h2 id="refund-h">
        When can you cancel a Duoly order and get money back?
      </h2>
      <p>
        Three cases are written into the{' '}
        <a href="/terms#cancel">cancellations and refunds section</a> of the
        Duoly terms, quoted here in order. First, before a teammate accepts:
        “Cancel any time in your order room, free of charge. The full amount
        goes back to your Duoly balance.” Second, when nobody accepts within{' '}
        {AUTO_CANCEL_MINUTES} minutes: “The order cancels itself automatically
        and the full amount goes back to your Duoly balance. You don’t need to
        do anything.” Third, when a session goes wrong: “No-show, a teammate
        leaving, toxic behaviour: report it from your order room. A real person
        reviews it and can refund the order to your balance.” Refunds reach your
        balance by default, and the same section says money refunded there can
        be paid back to your original payment method on request.
      </p>
    </section>

    <section aria-labelledby="withdraw-h">
      <h2 id="withdraw-h">
        What about the EU right of withdrawal and promotional credit?
      </h2>
      <p>
        Queueing an order asks Duoly to start the service right away, which
        shortens the usual EU cooling-off period. The{' '}
        <a href="/terms#cancel">terms</a> state it directly: for EU and EEA
        consumers the 14-day right of withdrawal ends once the session has been
        fully played, and until a teammate accepts you can cancel for free
        anyway. Promotional money follows a second rule. According to the{' '}
        <a href="/terms#balance">Duoly balance section</a>, your balance never
        expires, cashback and level-up gifts can only be spent on Duoly and
        cannot be paid out as cash, while money refunded to the balance can go
        back to your card on request. Austrian law governs the terms, consumers
        keep the mandatory protections of their own country, and EU consumers
        can use the online dispute resolution platform at
        ec.europa.eu/consumers/odr.
      </p>
    </section>

    <section aria-labelledby="split-h">
      <h2 id="split-h">Where does the money you pay actually go?</h2>
      <p>
        A completed Duoly order splits {SHARE_PERCENT}% to the teammate and the
        rest to Duoly. The <a href="/terms#teammates">teammate terms</a> state
        the figure: teammates earn {SHARE_PERCENT}% of each order’s price, and
        Duoly keeps the remainder for payments, matching, support and running
        the platform. Teammate earnings are paid weekly, Friday to Friday, and{' '}
        <a href="/get-paid-to-play-games">the teammate guide</a> adds that a
        payout runs once a balance passes $25, with smaller amounts carried
        over. A customer discount comes off first, so the {SHARE_PERCENT}% share
        is calculated on the discounted total: {TEN_GAME_BUNDLE.label} at{' '}
        {TEN_GAME_BUNDLE.total} pays the teammate a share of that figure rather
        than of the undiscounted one. Nobody earns a bonus for a win, which is
        why Duoly promises no rank and no result. The company keeping that share
        is the sole proprietorship named on <a href="/about">the about page</a>,
        based in {BUSINESS_LOCATION} under trade register GISA {BUSINESS.gisa}.
      </p>
    </section>

    <Faq heading="What do customers ask about Duoly fees?" items={faq} />

    <ClosingCta
      heading="Check a real price before you decide"
      text={`Every figure on this page comes from the pricing engine behind checkout, operated from ${BUSINESS_LOCATION}. Open your game, pick the rank you really have and read the total before paying anything.`}
      extra={`Three rules cover almost every question. First, one upfront payment and no fee on top, so ${SINGLE_GAME.short} is ${SINGLE_GAME.total}. Second, discounts are automatic: ${QUANTITY_PERCENT}% at ${MAX_QUANTITY} units and up to ${BUNDLE_PERCENTS[2]}% on bundles, with coaching flat at ${COACHING_PRICE}. Third, cancel free until a teammate accepts, and an unaccepted order refunds itself after ${AUTO_CANCEL_MINUTES} minutes. For anything else, a real person reviews the report you file from the order room.`}
      href="/games"
      label="Open the game catalog"
      art={{ src: '/assets/games/league-of-legends.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/about">About Duoly and who runs it</a>
        <a href="/terms">Full terms of service</a>
        <a href="/games">All games and prices</a>
        <a href="/compare/e-pal">Duoly compared with E-Pal</a>
        <a href="/contact">Ask the Duoly team</a>
        <a href="/get-paid-to-play-games">Teammate earnings</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(schema)}
  />
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .fees-page h2 {
    scroll-margin-top: 96px;
  }
  .fees-table-wrap {
    margin-top: 22px;
    border: 1px solid rgba(196, 170, 255, 0.22);
    border-radius: 18px;
    overflow: hidden;
    background: #120b22;
  }
  .fees-table {
    width: 100%;
    border-collapse: collapse;
  }
  .fees-table th,
  .fees-table td {
    padding: 13px 16px;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    font-size: 15px;
    border-top: 1px solid rgba(196, 170, 255, 0.16);
  }
  .fees-table thead th {
    border-top: 0;
    background: #1b1033;
    color: #f3eeff;
  }
  .fees-table tbody th {
    color: #f3eeff;
    font-weight: 650;
    width: 38%;
  }
  .fees-table .fees-total {
    color: #f3eeff;
    font-weight: 700;
    white-space: nowrap;
  }
  .fees-page .fees-note {
    margin-top: 14px;
    font-size: 15px;
    color: #a79dc4;
  }
  @media (max-width: 680px) {
    .fees-table thead {
      display: none;
    }
    .fees-table tbody tr {
      display: grid;
      border-top: 1px solid rgba(196, 170, 255, 0.16);
    }
    .fees-table tbody tr:first-child {
      border-top: 0;
    }
    .fees-table tbody th,
    .fees-table tbody td {
      width: auto;
      border-top: 0;
      padding-top: 4px;
      padding-bottom: 4px;
    }
    .fees-table tbody th {
      padding-top: 14px;
    }
    .fees-table tbody tr td:last-child {
      padding-bottom: 14px;
    }
    .fees-table tbody td::before {
      display: inline-block;
      min-width: 92px;
      color: #a79dc4;
    }
    .fees-table tbody td:nth-of-type(1)::before {
      content: 'Per unit';
    }
    .fees-table tbody td:nth-of-type(2)::before {
      content: 'Discount';
    }
    .fees-table tbody td:nth-of-type(3)::before {
      content: 'You pay';
    }
  }
</style>

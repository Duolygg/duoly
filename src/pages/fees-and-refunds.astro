---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import { pageViewer } from '../site/viewer';
import { CONTENT_DATES, hubChips, serializeJsonLd } from '../site/seo';
import { faqSchema } from '../server/seo/offers';
import { BUSINESS, BUSINESS_LOCATION } from '../site/entity';
import {
  COACHING_PRICE,
  PLAYABLE_GAMES,
  SHARE_PERCENT,
  SHORT_GAME_PRICE,
} from '../server/seo/teammate-facts';
import {
  AUTO_CANCEL_MINUTES,
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED,
  CATALOG_PRICES_UPDATED_LABEL,
  COACHING_HOUR,
  FIVE_COACHING_HOURS,
  FIVE_GAMES,
  MAX_QUANTITY,
  PRICE_EXAMPLES,
  QUANTITY_PERCENT,
  SINGLE_GAME,
  TEN_GAME_BUNDLE,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';
import { LEGAL_UPDATED } from '../design-reference/lib/site.js';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/fees-and-refunds';
const title = 'Duoly Fees and Refunds: What a Session Costs | Duoly';
const description = `What a Duoly session costs and what you get back. Real prices from ${SHORT_GAME_PRICE}, bundle discounts of ${BUNDLE_PERCENTS.join(', ')} percent, and the refund rules in full.`;
const HUB_LINKS = hubChips([
  'league-of-legends',
  'valorant',
  'fortnite',
  'rocket-league',
]);
/** The day the catalog's prices last changed, from one shared constant. */
const PRICES_UPDATED = CATALOG_PRICES_UPDATED;
const pricesLabel = CATALOG_PRICES_UPDATED_LABEL;
/** The catalog year, derived so "in 2026" cannot outlive the prices it dates. */
const CATALOG_YEAR = CATALOG_PRICES_UPDATED.slice(0, 4);
const faq: [string, string][] = [
  [
    'Does Duoly add a booking fee or a service fee?',
    'No. The total shown before checkout is the amount Stripe charges, and the Duoly terms say the price you see at checkout is the price you pay. There is no booking fee, no payment surcharge and no subscription.',
  ],
  [
    'How much is the cheapest Duoly session?',
    `The lowest listed price is ${SHORT_GAME_PRICE} for a Valorant Skirmish 2v2 game. Coaching is ${COACHING_PRICE} per hour or game in every coachable title, for example a ${COACHING_PRICE} Valorant VOD Review, which runs with Discord screen share.`,
  ],
  [
    'Do I get money back if nobody takes my order?',
    `Yes. An order nobody accepts within ${AUTO_CANCEL_MINUTES} minutes cancels itself and the full amount returns to your Duoly balance, with nothing to claim.`,
  ],
  [
    'Can a refund go back to my card instead of my Duoly balance?',
    'Refunds go to your Duoly balance by default so you can rebook at once. The terms say money refunded to your balance can be paid back to your original payment method on request, and promotional cashback and gifts cannot.',
  ],
  [
    'What if my teammate never shows up?',
    'Report the order from your order room. The terms cover a no-show, a teammate leaving and toxic behaviour the same way: a real person reviews the report and can refund the order to your balance.',
  ],
  [
    'Do bundle discounts apply to coaching?',
    `No. Coaching never takes a quantity discount, so ${MAX_QUANTITY} lessons cost ${FIVE_COACHING_HOURS.total} at ${COACHING_HOUR.total} each. Teammate bundles of ${BUNDLE_SIZES.join(', ')} units take ${BUNDLE_PERCENTS[0]}%, ${BUNDLE_PERCENTS[1]}% and ${BUNDLE_PERCENTS[2]}% off.`,
  ],
  [
    'Am I charged per game or once for the whole order?',
    'Once, when you queue. The terms state one upfront payment for every game or hour in the order, with no charge after each game.',
  ],
  [
    'Where can I read every Duoly price in one place?',
    `duoly.gg/pricing.md lists every game and every bookable service as plain text, with the price for each rank, as of ${pricesLabel}. It carries the same figures as checkout, so an assistant reading it quotes the real total.`,
  ],
  [
    'Who operates Duoly, and where?',
    `Duoly is a sole proprietorship based in ${BUSINESS_LOCATION}, registered under trade register number GISA ${BUSINESS.gisa} and legally represented by ${BUSINESS.representedBy}. The about page and the imprint both carry the same operator details.`,
  ],
  [
    'Can I still cancel after paying?',
    'Yes, free of charge until a teammate accepts the order, from your order room. Once the session has been fully played, the EU 14-day right of withdrawal has ended, because queueing asks Duoly to start the service right away.',
  ],
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: new URL(path, Astro.site!).href,
  name: title,
  description,
  dateModified: CONTENT_DATES[path],
  isPartOf: { '@id': new URL('/#website', Astro.site!).href },
  publisher: { '@id': new URL('/#organization', Astro.site!).href },
};
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page fees-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Fees and refunds', path },
      ]}
    />
    <SeoHero
      eyebrow="Prices and policy"
      h1="Duoly fees and refunds"
      lead="One upfront payment, the price you saw, no fee on top. Here is how a Duoly total is built, what the discounts are and exactly when money comes back."
      price={`${SINGLE_GAME.short}: ${SINGLE_GAME.total}`}
      cta={{ href: '/games', label: `See prices for ${PLAYABLE_GAMES} games` }}
      secondary={{ href: '#refund-h', label: 'Jump to refunds' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
      ]}
      chip={`Bundles up to ${BUNDLE_PERCENTS[2]}% off`}
      facts={[
        'One payment when you queue',
        'No booking or payment fee',
        `Free cancel until a teammate accepts`,
        'Refunds reviewed by a person',
      ]}
      note={`Catalog prices as of ${pricesLabel}.`}
    />

    <section aria-labelledby="fees-h">
      <h2 id="fees-h">What fees does Duoly charge on top of the price?</h2>
      <p>
        None. A Duoly total is the service price for your selection, and that
        total is the amount Stripe charges. According to{' '}
        <a href="/terms#payment">Duoly’s payment terms</a>, dated{' '}
        {LEGAL_UPDATED}, “The price you see at checkout is the price you pay.”
        No booking fee, no payment surcharge, no subscription, so{' '}
        <a href={SINGLE_GAME.href}>a {SINGLE_GAME.short} order</a> costs{' '}
        {SINGLE_GAME.total} and nothing else. Duoly’s own cut is a commission
        out of that same figure, covered further down.
      </p>
      <p>
        You also pay once rather than per game. The{' '}
        <a href="/terms#payment">payment section</a> states that the full price
        for every game or hour in an order is paid at the moment you queue it.
        There is no wallet to top up first, which is where some marketplaces add
        their percentage: compare <a href="/compare/e-pal">Duoly with E-Pal</a>{' '}
        and the difference is a 10% top-up service fee on that platform against
        0% here.
      </p>
    </section>

    <section aria-labelledby="price-h">
      <h2 id="price-h">How is a Duoly price calculated?</h2>
      <p>
        A Duoly price is the service price for your rank, multiplied by how many
        games or hours you book, minus the quantity discount. Three things move
        the figure. The service comes first, because a League of Legends Duo Pro
        session and a Valorant VOD Review are separate listings at separate
        prices. Then your own rank, in ranked play only: higher lobbies need
        stronger teammates, so they cost more. Then the quantity, where{' '}
        {MAX_QUANTITY} units take {QUANTITY_PERCENT}% off.
      </p>
      <p>
        Coaching sits outside all of that, flat at {COACHING_PRICE} per hour or
        game in every coachable title, with no rank multiplier. Read the unit
        before the figure, since a game and an hour buy different amounts of
        play. Every total in the table below is what Stripe would charge today,
        down to {SINGLE_GAME.total} for one Gold-rank League of Legends game, as
        of {pricesLabel}.
      </p>
      <div class="fees-table-wrap">
        <table class="fees-table">
          {/* One expression rather than prose around `{pricesLabel}`: an
              adjacent text node and expression render with no space between
              them here, which read as "on9 November 2026". */}
          <caption class="sr-only">
            {`Duoly price examples, as of ${pricesLabel}`}
          </caption>
          <thead>
            <tr>
              <th scope="col">Selection</th>
              <th scope="col">Per unit</th>
              <th scope="col">Discount</th>
              <th scope="col">You pay</th>
            </tr>
          </thead>
          <tbody>
            {PRICE_EXAMPLES.map((item) => (
              <tr>
                <th scope="row">
                  <a href={item.href}>{item.short}</a>
                </th>
                <td>
                  {item.perUnit} per {item.unit}
                </td>
                <td>
                  {item.discountPercent
                    ? `${item.discountPercent}% off, saving ${item.saved}`
                    : 'None'}
                </td>
                <td class="fees-total">{item.total}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fees-note">
        Catalog prices as of{' '}
        <time datetime={PRICES_UPDATED}>{pricesLabel}</time>. Each row opens the
        checkout with that order prefilled. Open{' '}
        <a href="/pricing">the full price table</a> for every game and service
        in one place, <a href="/games">any game page</a> for the price list per
        rank, or <a href="/pricing.md">pricing.md</a> for every game as plain
        text.
      </p>
    </section>

    <section aria-labelledby="discount-h">
      <h2 id="discount-h">Which Duoly discounts are automatic?</h2>
      <p>
        Every Duoly discount is a quantity discount, there are two of them, and
        both come off in the checkout rather than on request. The quantity
        picker offers 1 to {MAX_QUANTITY} games or hours, where {MAX_QUANTITY}{' '}
        units take {QUANTITY_PERCENT}% off: {FIVE_GAMES.label} cost{' '}
        {FIVE_GAMES.total} instead of {MAX_QUANTITY} times {SINGLE_GAME.total},
        saving {FIVE_GAMES.saved}. The Bundles tab sells a game’s main service
        in packs of {BUNDLE_SIZES.join(', ')} units at {BUNDLE_PERCENTS[0]}%,{' '}
        {BUNDLE_PERCENTS[1]}% and {BUNDLE_PERCENTS[2]}% off, which puts{' '}
        {TEN_GAME_BUNDLE.label} at {TEN_GAME_BUNDLE.total} and saves{' '}
        {TEN_GAME_BUNDLE.saved}, the biggest discount on the site in{' '}
        {CATALOG_YEAR}.
      </p>
      <p>
        Which tab you open decides which discount you get, because the picker
        and the Bundles tab are separate controls. A bundle always covers one
        teammate. Coaching takes no quantity discount at all, so{' '}
        {FIVE_COACHING_HOURS.label} cost {FIVE_COACHING_HOURS.total}. According
        to <a href="/terms#payment">Duoly’s payment terms</a>, prices can change
        over time, and an order already placed keeps the price paid.
      </p>
    </section>

    <section aria-labelledby="currency-h">
      <h2 id="currency-h">Does Duoly charge in euros or US dollars?</h2>
      <p>
        A Duoly price is set in euros and charged in euros or US dollars,
        whichever you pick. According to{' '}
        <a href="/terms#payment">Duoly’s payment terms</a>, dated{' '}
        {LEGAL_UPDATED}, a dollar price is the euro price converted at the day’s
        European Central Bank rate plus a {USD_MARGIN_PERCENT}% currency margin,
        rounded up to .99, so it sits a few cents above the plain mid-market
        conversion. Your bank may add a foreign currency handling fee of its
        own.
      </p>
      <p>
        Payment itself runs through Stripe, which is why Duoly never sees or
        stores full card details. You can also pay part or all of an order from
        your Duoly balance, where refunds, cashback and level-up gifts land,
        once you switch the balance on at checkout. Holding {SINGLE_GAME.total}{' '}
        of balance covers a {SINGLE_GAME.short} order with no card charge at
        all, and 100% of a refund lands back in the same place.
      </p>
    </section>

    <section aria-labelledby="refund-h">
      <h2 id="refund-h">
        When can you cancel a Duoly order and get money back?
      </h2>
      <p>
        A Duoly order is cancellable for free until a teammate accepts, and
        three cases are written into the{' '}
        <a href="/terms#cancel">cancellations and refunds section</a> of the
        terms dated {LEGAL_UPDATED}. Before a teammate accepts: “Cancel any time
        in your order room, free of charge. The full amount goes back to your
        Duoly balance.” When nobody accepts within {AUTO_CANCEL_MINUTES}{' '}
        minutes: “The order cancels itself automatically and the full amount
        goes back to your Duoly balance. You don’t need to do anything.” When a
        session goes wrong: “No-show, a teammate leaving, toxic behaviour:
        report it from your order room. A real person reviews it and can refund
        the order to your balance.”
      </p>
      <p>
        A refund is the whole amount, not a share of it: a {FIVE_GAMES.total}{' '}
        order comes back as {FIVE_GAMES.total}, discount included. Refunds reach
        your balance by default so you can rebook at once. How a report gets
        reviewed sits on <a href="/trust-and-safety">trust and safety</a>, and
        the whole booking flow on <a href="/how-it-works">how Duoly works</a>.
      </p>
    </section>

    <section aria-labelledby="withdraw-h">
      <h2 id="withdraw-h">
        What about the EU right of withdrawal and promotional credit?
      </h2>
      <p>
        The EU right of withdrawal is a 14-day cooling-off period, and queueing
        a Duoly order shortens the window. According to{' '}
        <a href="/terms#cancel">Duoly’s cancellations and refunds section</a>,
        for EU and EEA consumers that right ends once a session has been fully
        played, because queueing an order asks Duoly to start right away. In
        practice the window is wider than the legal one anyway, since you can
        cancel for free and get 100% back until a teammate accepts.
      </p>
      <p>
        Promotional money follows a different rule. The{' '}
        <a href="/terms#balance">Duoly balance section</a> says a balance never
        expires, that cashback and level-up gifts can only be spent on Duoly,
        and that money refunded to a balance can go back to a card if you ask
        support for it. So {SINGLE_GAME.total} of refunded money is
        withdrawable, while {SINGLE_GAME.total} of level-up gift stays on Duoly.
        Austrian law governs the terms dated {LEGAL_UPDATED}, consumers keep the
        mandatory protections of their home country, and EU consumers can use
        the dispute platform at ec.europa.eu/consumers/odr.
      </p>
    </section>

    <section aria-labelledby="split-h">
      <h2 id="split-h">Where does the money you pay actually go?</h2>
      <p>
        A completed Duoly order splits two ways: {SHARE_PERCENT}% to the
        teammate, the rest to Duoly. According to{' '}
        <a href="/terms#teammates">Duoly’s teammate terms</a>, teammates earn{' '}
        {SHARE_PERCENT}% of each order’s price, and Duoly keeps{' '}
        {100 - SHARE_PERCENT}% for payments, matching, support and running the
        place. Teammate earnings are paid weekly, Friday to Friday, and{' '}
        <a href="/get-paid-to-play-games">the teammate guide</a> adds that a
        payout runs once a balance passes $25, with smaller amounts carried
        over. Paying out needs a method connected first, through Wise, PayPal,
        Payoneer or a bank.
      </p>
      <p>
        Your discount comes off before the split, so the {SHARE_PERCENT}% share
        is calculated on what you actually paid: {TEN_GAME_BUNDLE.label} at{' '}
        {TEN_GAME_BUNDLE.total} pays a share of that figure, not of the
        undiscounted one. Nobody earns a bonus for a win, which is why Duoly
        promises no rank and no result. The company keeping the remainder is the
        sole proprietorship named on <a href="/about">the about page</a>, in{' '}
        {BUSINESS_LOCATION} under GISA {BUSINESS.gisa}.
      </p>
    </section>

    <Faq heading="What do customers ask about Duoly fees?" items={faq} />

    <ClosingCta
      heading="Want to check a real price before you decide?"
      text={`A Duoly total is the price of one selection, charged once, by a sole proprietorship in ${BUSINESS_LOCATION}. Open your game, pick the rank you really hold and read the total before paying anything.`}
      extra={`You pay once and nothing is added on top, so ${SINGLE_GAME.short} is ${SINGLE_GAME.total} and that is the whole charge. Discounts come off by themselves: ${QUANTITY_PERCENT}% at ${MAX_QUANTITY} units, up to ${BUNDLE_PERCENTS[2]}% on a bundle, and coaching flat at ${COACHING_PRICE}. Cancelling is free until a teammate accepts, and an order nobody takes refunds itself after ${AUTO_CANCEL_MINUTES} minutes. If a session does go wrong, a person at Duoly reads your report; no script closes it for you. Catalog prices as of ${pricesLabel}.`}
      href="/games"
      label="Open the game catalog"
      art={{ src: '/assets/games/league-of-legends.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/about">About Duoly and who runs it</a>
        <a href="/pricing">Every Duoly game, service and price</a>
        <a href="/how-it-works">How a Duoly booking works step by step</a>
        <a href="/trust-and-safety">How Duoly checks players and payments</a>
        <a href="/press">Duoly press kit and fact sheet</a>
        <a href="/terms">Full terms of service</a>
        <a href="/games">All games and prices</a>
        <a href="/compare/e-pal">Duoly compared with E-Pal</a>
        <a href="/contact">Ask the Duoly team</a>
        <a href="/get-paid-to-play-games">Teammate earnings</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(schema)}
  />
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .fees-page h2 {
    scroll-margin-top: 96px;
  }
  .fees-table-wrap {
    margin-top: 22px;
    border: 1px solid rgba(196, 170, 255, 0.22);
    border-radius: 18px;
    overflow: hidden;
    background: #120b22;
  }
  .fees-table {
    width: 100%;
    border-collapse: collapse;
  }
  .fees-table th,
  .fees-table td {
    padding: 13px 16px;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    font-size: 15px;
    border-top: 1px solid rgba(196, 170, 255, 0.16);
  }
  .fees-table thead th {
    border-top: 0;
    background: #1b1033;
    color: #f3eeff;
  }
  .fees-table tbody th {
    color: #f3eeff;
    font-weight: 650;
    width: 38%;
  }
  .fees-table .fees-total {
    color: #f3eeff;
    font-weight: 700;
    white-space: nowrap;
  }
  .fees-page .fees-note {
    margin-top: 14px;
    font-size: 15px;
    color: #a79dc4;
  }
  @media (max-width: 680px) {
    .fees-table thead {
      display: none;
    }
    .fees-table tbody tr {
      display: grid;
      border-top: 1px solid rgba(196, 170, 255, 0.16);
    }
    .fees-table tbody tr:first-child {
      border-top: 0;
    }
    .fees-table tbody th,
    .fees-table tbody td {
      width: auto;
      border-top: 0;
      padding-top: 4px;
      padding-bottom: 4px;
    }
    .fees-table tbody th {
      padding-top: 14px;
    }
    .fees-table tbody tr td:last-child {
      padding-bottom: 14px;
    }
    .fees-table tbody td::before {
      display: inline-block;
      min-width: 92px;
      color: #a79dc4;
    }
    .fees-table tbody td:nth-of-type(1)::before {
      content: 'Per unit';
    }
    .fees-table tbody td:nth-of-type(2)::before {
      content: 'Discount';
    }
    .fees-table tbody td:nth-of-type(3)::before {
      content: 'You pay';
    }
  }
</style>

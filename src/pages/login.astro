---
// There is no sign-in page: sign-in is a popup. Old links and bookmarks to /login open it on
// the homepage, keeping a sign-in error, notice or register mode they carried.
import { signInPath } from '../site/sign-in';
const params = Astro.url.searchParams;
const target = new URL(signInPath(), Astro.url);
for (const key of ['error', 'notice', 'mode']) {
  const value = params.get(key);
  if (value && /^[a-z]{1,20}$/.test(value)) target.searchParams.set(key, value);
}
return Astro.redirect(target.pathname + target.search, 302);
---

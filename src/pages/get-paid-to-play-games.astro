---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Steps from '../components/seo/Steps.astro';
import '../components/seo/seo.css';
import { pageViewer } from '../site/viewer';
import { serializeJsonLd, CONTENT_DATES, bookingHref } from '../site/seo';
import { faqSchema } from '../server/seo/offers';
import {
  SHARE_PERCENT,
  BUNDLE_PERCENTS,
  COACHING_PRICE,
  SHORT_GAME_PRICE,
  COACHABLE_GAMES,
  PLAYABLE_GAMES,
} from '../server/seo/teammate-facts';
const { viewer, csrf } = await pageViewer(Astro);
const share = `${SHARE_PERCENT}%`;
const [b3, b5, b10] = BUNDLE_PERCENTS as [number, number, number];
const faq: [string, string][] = [
  [
    'Is this a guaranteed way to earn money playing games?',
    `No, applying guarantees no approval, no orders and no income, and a teammate earns only from completed sessions.`,
  ],
  [
    'How much of a session goes to the teammate?',
    `A teammate share is ${share} of the session price after discounts, paid in USD, and the desk shows the exact amount for every order.`,
  ],
  [
    'What is the payout minimum?',
    'Payouts run weekly once a balance passes $25, and smaller amounts carry over to the next week.',
  ],
  [
    'How are teammates paid?',
    'Bank transfer, Wise, PayPal and Payoneer are available, plus Stripe for eligible accounts, and the desk lists the open methods.',
  ],
  [
    'Can I apply for Social sessions?',
    'Yes, Social orders need Gamer Girl access, requested inside the application, and Social stays friendly company only, never dating, romantic or sexual services.',
  ],
  [
    'Can I play on a customer’s account?',
    'No, every teammate plays on a personal account and follows the game’s rules. Customers keep account control.',
  ],
  [
    'How does a coaching hour pay compared with a short game?',
    `Both pay ${share} of the price. For example, a Valorant VOD Review from Duoly costs ${COACHING_PRICE} per hour, while Skirmish 2v2 costs ${SHORT_GAME_PRICE} per game.`,
  ],
  [
    'Which voice tool do teammates use?',
    'Coordinate voice in the order room, usually through Discord. Agree the channel before loading the game, and keep customer account details private.',
  ],
];
const path = '/get-paid-to-play-games';
---

<SiteLayout
  title="Get Paid to Play Games as a Duoly Teammate | Duoly"
  description={`Get paid to play games as a Duoly teammate. Keep ${share} of every session, paid weekly once you pass $25. See requirements and apply to play, coach or host.`}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Become a teammate', path },
      ]}
    />
    <SeoHero
      eyebrow="Become a teammate"
      h1="Get paid to play games as a Duoly teammate"
      lead={`Apply to play, coach or host friendly Social sessions on Duoly. You keep ${share} of every session you complete, paid out weekly.`}
      cta={{ href: '/apply', label: 'Apply to become a teammate' }}
      secondary={{ href: '#payouts-h', label: 'How payouts work' }}
      art={[
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/social.png', alt: 'Duoly Social art' },
      ]}
      chip={`Keep ${share} of every session`}
      facts={[
        'Weekly payouts once you pass $25',
        'Bank transfer, Wise, PayPal or Payoneer',
        'Play, coach or host Social',
      ]}
    />
    <section aria-labelledby="work-h">
      <h2 id="work-h">What does a paid Duoly session actually involve?</h2>
      <p>
        A paid Duoly session is one booked block of play, coaching or voice
        company that a customer has already paid for. Teammates join the agreed
        mode, communicate respectfully and play the booked number of games or
        hours. Coaches explain decisions and give focused feedback. Gamer Girls
        host game sessions and, with Social access, friendly voice company.
      </p>
      <p>
        Reward apps pay for installs, surveys or idle playtime. Duoly pays a{' '}
        {share} share of real customer sessions, so earnings follow completed
        orders rather than screen time. A customer who books a Valorant Skirmish
        2v2 game at {SHORT_GAME_PRICE} expects the mode and the teammate tier
        they paid for, with the timing agreed in the order chat. So every order
        starts the same way: read the service, the unit and the customer notes
        before you accept it. The catalog covers {PLAYABLE_GAMES} games plus
        Social, and you can list one game or several.
      </p>
    </section>
    <section aria-labelledby="earn-h">
      <h2 id="earn-h">How much do Duoly teammates earn per session?</h2>
      <p>
        A Duoly teammate earns {share} of the session price after any customer
        discount, converted to USD. Customers pay in EUR or USD, and a teammate
        desk always shows the exact USD amount for each order.
      </p>
      <p>
        Coaching is {COACHING_PRICE} an hour across all {COACHABLE_GAMES}{' '}
        coachable games, so one completed hour pays a {share} share of{' '}
        {COACHING_PRICE}. A per-game service and an hourly lesson are different
        units, so weigh the activity as well as the figure. Valorant Skirmish
        2v2 is {SHORT_GAME_PRICE} per game, for example, which suits a teammate
        queueing a lot of short games with Discord voice running all evening.
        Your dashboard shows the USD earnings for the actual order, after
        discounts and conversion.
      </p>
      <p>
        Customer bundle discounts of {b3}%, {b5}% and {b10}% cut the session
        price first, and the {share} share applies to the discounted figure.
        Nobody earns a bonus for a win.
      </p>
    </section>
    <section aria-labelledby="payouts-h">
      <h2 id="payouts-h">When does Duoly pay out, and by which method?</h2>
      <p>
        A Duoly payout is a weekly transfer of a cleared balance. Payouts run
        once every week as soon as a balance reaches $25, and smaller amounts
        carry over to the following week rather than expiring. Teammates add
        payout details once, then the desk marks each amount pending, scheduled
        or paid.
      </p>
      <p>
        A payout needs a method first, using Wise, PayPal, Payoneer or a bank.
        Bank transfer, Wise, PayPal and Payoneer are open to every approved
        teammate, and Stripe is added for accounts that finish Stripe
        verification. The desk lists the methods open to each account, because
        the options differ by country.
      </p>
      <p>
        A weekly cycle has two consequences worth knowing. A session finished
        late in the week clears in the next payout, so a {COACHING_PRICE}{' '}
        coaching hour you run on Sunday pays its {share} share in the following
        transfer. And the {share} share arrives untaxed, so your own tax
        reporting is yours to handle.
      </p>
    </section>
    <section aria-labelledby="apply-h">
      <h2 id="apply-h">What makes a Duoly application strong?</h2>
      <p>
        A Duoly application is a short form asking which games and services an
        applicant can deliver. Applicants must be at least 18 and must follow
        both Duoly rules and each game’s rules. The{' '}
        <a href="/apply">application form</a> takes about three minutes and asks
        for games, services, a region and a communication style.
      </p>
      <p>
        Attach real rank or experience proof from an account you own, never a
        borrowed clip, and be specific about what you are good at. A Valorant
        applicant might name controller utility, entry timing or VOD decisions;
        a Rocket League applicant might name Doubles and recoveries. Coaching
        pays a {share} share of {COACHING_PRICE} an hour, the same {share} rule
        that covers teammate and Gamer Girl orders, so a coaching application
        needs to show teaching and not only rank.
      </p>
      <p>
        Duoly reviews every application, and some services need separate access.
        Social orders reach only teammates with Gamer Girl access.
      </p>
    </section>
    <Steps
      heading="What happens during a first Duoly order?"
      steps={[
        'Read the service, unit and customer preferences, then accept the order.',
        'Coordinate in the order chat, confirm the activity and voice setup, and play on your own account.',
        'Complete the order and watch the earnings land in your desk.',
      ]}
    >
      <p>
        A first Duoly order starts in the queue. An approved teammate accepts an
        order matching their schedule and rank; nothing is assigned
        automatically. Read the service, unit and customer notes before
        accepting.
      </p>
      <p>
        Use the order chat to confirm the activity, the start time and how you
        will talk, which is usually Discord. Play on your own account. The{' '}
        <a href="/terms">terms</a> forbid account sharing, and nobody needs the
        customer's password.
      </p>
      <p>
        A completed order adds the {share} share to your desk as pending USD
        earnings, whether that order was a {COACHING_PRICE} coaching hour or a
        single short game. Keep payments on Duoly, promise no rank, and send
        anything that goes wrong to <a href="/contact">support</a>.
      </p>
      <p>
        Curious what the customer sees? The checkout for a{' '}
        <a href={bookingHref('val', { service: 'duo2' })}>
          Valorant Duo Pro game
        </a>{' '}
        shows the service and the unit before payment. You do not have to book
        anything to apply.
      </p>
    </Steps>
    <Faq
      heading="What do applicants ask about getting paid to play games?"
      items={faq}
    />
    <ClosingCta
      heading="Ready to apply?"
      text="Applying to Duoly means naming the games and services you can offer, with evidence attached. Duoly reviews every application by hand, and approval arrives before any order can reach your queue."
      extra={`A review goes faster when the application is specific. Name the games and modes you really play, for example Valorant Unrated and Marvel Rivals Quick Match, attach rank proof from an account you own, and say whether coaching, teammate or Gamer Girl work actually fits your week. After approval every order runs the same way: take it from the queue, meet the customer with Discord voice, finish the session, and the ${share} share lands in your desk in USD. Payouts run weekly above $25, every coaching hour pays a share of ${COACHING_PRICE}, and the desk marks each amount pending, scheduled or paid, so you can follow a first payout from the order that earned it to the method it leaves by.`}
      href="/apply"
      label="Apply to become a teammate"
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />
    <nav class="related" aria-label="Related pages">
      <h2>Before you apply</h2>
      <div class="chips">
        <a href="/ai">How customers use Duoly in AI assistants</a>
        <a href="/games/valorant">Valorant teammate hub</a>
        <a href="/games/valorant/coaching">Valorant coaching page</a>
        <a href="/games/league-of-legends">League of Legends hub</a>
        <a href="/developers/mcp">Duoly MCP developer guide</a>
        <a href="/games">Services by game</a>
        <a href="/games/social">Social rules</a>
        <a href="/terms">Terms</a>
        <a href="/contact">Ask the Duoly team</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Get paid to play games as a Duoly teammate',
      url: new URL(path, Astro.site!).href,
      dateModified: CONTENT_DATES[path],
    })}
  />
</SiteLayout>

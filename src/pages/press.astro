---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/official.css';
import { pageViewer } from '../site/viewer';
import {
  CONTENT_DATES,
  OFFICIAL_CHANNELS,
  hubChips,
  serializeJsonLd,
} from '../site/seo';
import { faqSchema } from '../server/seo/offers';
import { officialPageSchema } from '../server/seo/official';
import { SUPPORT_EMAIL } from '../site/nav';
import { PRESS_EMAIL } from '../site/press-contact';
import {
  BUSINESS,
  BUSINESS_LOCATION,
  DISAMBIGUATION_PROSE,
  SERVED_AREAS,
} from '../site/entity';
import {
  COACHABLE_GAMES,
  COACHING_PRICE,
  PLAYABLE_GAMES,
  SHARE_PERCENT,
  SHORT_GAME_PRICE,
  SOCIAL_MODES,
} from '../server/seo/teammate-facts';
import {
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED,
  CATALOG_PRICES_UPDATED_LABEL,
  SINGLE_GAME,
} from '../server/seo/fees';
import { CATALOG_GAMES, SERVICE_COUNT } from '../server/seo/booking';
import {
  BOILERPLATE_PARAGRAPH,
  BOILERPLATE_SENTENCE,
  FACT_SHEET,
  HAS_LAUNCH_DATE,
  LAUNCH_DATE,
  LOGO_ASSETS,
  SOCIAL_IMAGE,
} from '../server/seo/press';
import { CATEGORY_HEADINGS } from '../server/seo/price-table';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/press';
const title = 'Duoly Press Kit: Facts, Boilerplate and Logos | Duoly';
const description = `The Duoly fact sheet for journalists: what Duoly is, who operates it, ${SERVICE_COUNT} services across ${CATALOG_GAMES} games, the boilerplate to quote and the logo files to download.`;
const HUB_LINKS = hubChips(['league-of-legends', 'valorant', 'marvel-rivals']);
const pricesLabel = CATALOG_PRICES_UPDATED_LABEL;
/** Session categories in words, read from the same list /pricing groups by. */
const CATEGORY_WORDS = CATEGORY_HEADINGS.map(([, heading]) =>
  heading.toLowerCase(),
).join(', ');

const faq: [string, string][] = [
  ['What is Duoly in one sentence?', BOILERPLATE_SENTENCE],
  [
    'Who operates Duoly?',
    `Duoly is a sole proprietorship based in ${BUSINESS_LOCATION}, legally represented by ${BUSINESS.representedBy} and registered under Austrian trade register number GISA ${BUSINESS.gisa}. The full legal notice, including the supervisory authority, is on the imprint.`,
  ],
  [
    'When did Duoly launch?',
    HAS_LAUNCH_DATE
      ? `Duoly was founded on ${LAUNCH_DATE}.`
      : `Duoly has not published a launch date. The checkable record is the Austrian trade licence, GISA ${BUSINESS.gisa}, listed on the imprint. Ask the team in writing for a dated milestone.`,
  ],
  [
    'How many users or sessions does Duoly have?',
    'Duoly publishes no user count, session count, revenue figure, funding figure or rating. Any number in an article about Duoly should come from the team in writing.',
  ],
  [
    'Can I use the Duoly logo in an article?',
    'Yes, in editorial coverage of Duoly, using the files on this page as they are: no recolouring, no stretching and no new lockups. Duoly licenses no game art and no publisher logos, so none is offered here.',
  ],
  ['Is this the same Duoly as the couples app?', DISAMBIGUATION_PROSE],
  [
    'What does a Duoly session cost?',
    `Teammate games start at ${SHORT_GAME_PRICE} and coaching is ${COACHING_PRICE} per hour or game in ${COACHABLE_GAMES} titles. For example, ${SINGLE_GAME.short} costs ${SINGLE_GAME.total}. The full table of ${SERVICE_COUNT} services is on the pricing page, generated from the pricing engine.`,
  ],
  [
    'How do teammates earn on Duoly?',
    `A teammate earns ${SHARE_PERCENT}% of each completed order and Duoly keeps ${100 - SHARE_PERCENT}% for payments, matching, support and the platform. Teammates are independent players and not employees, paid weekly from Friday to Friday.`,
  ],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page official-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Press', path },
      ]}
    />
    <SeoHero
      eyebrow="Press"
      h1="Duoly press kit"
      lead={`Everything a journalist needs about Duoly in one place: the fact sheet, the boilerplate to quote, the logo files to download and the address to email. Every figure here is read from the catalog or the legal notice, and where Duoly has no figure the page says so.`}
      cta={{ href: '#facts-h', label: 'Jump to the fact sheet' }}
      secondary={{
        href: `mailto:${PRESS_EMAIL}`,
        label: 'Email the press contact',
      }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        { src: '/assets/games/marvel-rivals.png', alt: 'Marvel Rivals art' },
      ]}
      chip={`${SERVICE_COUNT} services, ${CATALOG_GAMES} games`}
      facts={[
        `Based in ${BUSINESS_LOCATION}`,
        `Trade register GISA ${BUSINESS.gisa}`,
        'Logo files below, free to use editorially',
        `Teammates keep ${SHARE_PERCENT}% of each order`,
      ]}
      note={`Catalog figures read from the Duoly pricing engine on ${pricesLabel}.`}
    />

    <section aria-labelledby="what-h">
      <h2 id="what-h">What is Duoly?</h2>
      {/* The boilerplate itself, verbatim and in one paragraph, so it can be
          copied without editing. The paragraph after it explains how to use
          it rather than repeating it. */}
      <p>{BOILERPLATE_PARAGRAPH}</p>
      <p>
        The paragraph above is the Duoly boilerplate, free to quote in full or
        in part. Three figures cover most articles: {SHORT_GAME_PRICE} for the
        cheapest teammate game, {COACHING_PRICE} per coaching hour and{' '}
        {SHARE_PERCENT}% as the teammate share, read from Duoly checkout on{' '}
        {pricesLabel}. Session voice runs using Discord.
      </p>
    </section>

    <section aria-labelledby="facts-h">
      <h2 id="facts-h">What are the Duoly facts a journalist needs?</h2>
      <p>
        The Duoly fact sheet is the table below. Every row is a figure the site
        can show a source for.
      </p>
      <p>
        The operator is a sole proprietorship in {BUSINESS_LOCATION}, legally
        represented by {BUSINESS.representedBy} and registered under trade
        register number GISA {BUSINESS.gisa}, as published on{' '}
        <a href="/imprint">the imprint</a>. The catalog holds {SERVICE_COUNT}{' '}
        bookable services across {CATALOG_GAMES} games, counted and not rounded,
        with coaching in {COACHABLE_GAMES} of those titles. The money is one
        upfront payment from {SHORT_GAME_PRICE} per game or {COACHING_PRICE} per
        coaching hour, and {SHARE_PERCENT}% of each completed order goes to the
        teammate. For example, {SINGLE_GAME.short} costs {SINGLE_GAME.total},
        read from the Duoly pricing engine on {pricesLabel}.
      </p>
      <div class="official-table-wrap">
        <table class="official-table">
          <caption class="sr-only">
            {`Duoly fact sheet, with catalog figures read from the pricing engine on ${pricesLabel}`}
          </caption>
          <tbody>
            {FACT_SHEET.map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>
                  {label === 'Press contact' ? (
                    <a href={`mailto:${value}`}>{value}</a>
                  ) : (
                    value
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="official-table-note">
        Catalog figures as of{' '}
        <time datetime={CATALOG_PRICES_UPDATED}>{pricesLabel}</time>. Duoly
        publishes no user count, session count, revenue or rating, so no such
        figure appears here.
      </p>
    </section>

    <section aria-labelledby="boilerplate-h">
      <h2 id="boilerplate-h">How should an article quote Duoly?</h2>
      <p>
        The one-sentence version of the boilerplate is: “{BOILERPLATE_SENTENCE}”
      </p>
      <p>
        Use that sentence for a first mention or a caption, where a reader wants
        the country and the product in one line. Use the full paragraph at the
        end of a piece, where the catalog size, the prices and the legal form
        belong. Two phrases are worth keeping as written. “Rank-verified”,
        because a teammate passes a four-stage review before a first order. And
        the account rule, because Duoly never plays on a customer account.
      </p>
      <p>
        According to Duoly’s terms, Duoly is unaffiliated with Riot Games,
        Valve, Epic Games, Blizzard and NetEase, which is worth a line in any
        piece naming those titles. For example, a {SINGLE_GAME.total} League of
        Legends game and a {COACHING_PRICE} Valorant coaching hour are the two
        figures most articles quote, and both come from Duoly checkout as
        published prices.
      </p>
    </section>

    <section aria-labelledby="catalog-h">
      <h2 id="catalog-h">Which games and sessions does Duoly cover?</h2>
      <p>
        The Duoly catalog is {SERVICE_COUNT} bookable services across{' '}
        {CATALOG_GAMES} games, grouped into {CATEGORY_WORDS}.
      </p>
      <p>
        Teammate sessions put a ranked player in the customer’s lobby for the
        mode picked, from {SHORT_GAME_PRICE} per game. Team fills hire several
        players at once, for example a League of Legends Ranked Flex five-stack.
        Coaching covers {COACHABLE_GAMES} games, per hour or per game, at{' '}
        {COACHING_PRICE}. VOD reviews are included, run using Discord screen
        share. The {SOCIAL_MODES} voice modes sell friendly company without a
        scoreboard, adults only, never a dating service.
      </p>
      <p>
        Servers cover {SERVED_AREAS.join(', ')}, and bundles of{' '}
        {BUNDLE_SIZES[2]} take {BUNDLE_PERCENTS[2]}% off a teammate service,
        which is the deepest discount in the catalog.{' '}
        <a href="/pricing">The pricing page</a> lists all {SERVICE_COUNT} with
        their prices, and <a href="/pricing.md">pricing.md</a> carries the same
        catalog as plain text for a reader who wants to check a figure without a
        browser.
      </p>
    </section>

    <section aria-labelledby="logos-h">
      <h2 id="logos-h">Where can you download the Duoly logo?</h2>
      <p>
        The Duoly logo is the four sets of files below, each one already on the
        live site, as WebP with a PNG app icon.
      </p>
      <p>
        Pick the full logo when there is room, the wordmark for a byline, the
        mascots when the headline already says Duoly. Use them as they are: no
        recolouring, no stretching, no new lockup and no Duoly mascot beside
        another company’s mark. The dark background is part of the artwork, so
        pick a dark surface. For example,{' '}
        <a href={SOCIAL_IMAGE.href}>the social preview image</a> (
        {SOCIAL_IMAGE.label}) is the one ready-made graphic for a post.
      </p>
      <p>
        Duoly licenses no game art and no publisher logo, and the artwork on{' '}
        <a href="/pricing">the pricing page</a> belongs to its publishers, from
        Riot Games to NetEase. For anything unusual, send{' '}
        <a href={`mailto:${PRESS_EMAIL}`}>an email to the press contact</a>{' '}
        first.
      </p>
      <ul class="official-logos">
        {LOGO_ASSETS.map((asset) => (
          <li>
            <img
              src={asset.preview.href}
              alt={`Duoly ${asset.name.toLowerCase()}`}
              loading="lazy"
              decoding="async"
            />
            <span class="official-label">{asset.name}</span>
            <span class="official-detail">{asset.detail}</span>
            <span class="official-files">
              {asset.files.map((file) => (
                <a href={file.href} download>
                  {file.label} ({file.pixels})
                </a>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="contact-h">
      <h2 id="contact-h">Who do you contact about Duoly?</h2>
      <p>
        Press questions go to{' '}
        <a href={`mailto:${PRESS_EMAIL}`}>{PRESS_EMAIL}</a>, answered from{' '}
        {BUSINESS.countryName} by the same team that answers support at{' '}
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>. One address is
        the whole route: Duoly runs no separate press office and no agency, so a
        question reaches the people who built the site.
      </p>
      <p>
        Put the publication, the deadline and the exact figures you need in the
        first message, because a figure Duoly cannot document gets declined
        instead of estimated. For example, {SERVICE_COUNT} services,{' '}
        {CATALOG_GAMES} games, {SHORT_GAME_PRICE} as the lowest price and{' '}
        {COACHING_PRICE} per coaching hour are all documented, while a user
        count is not. A founder quote, an interview or an unpublished number is
        a reasonable ask, answered in writing.
      </p>
      <p>
        Order questions belong at {SUPPORT_EMAIL}, or on{' '}
        <a href="/contact">the contact form</a> and the chat bubble, which reach
        the same team. According to <a href="/imprint">Duoly’s imprint</a>,{' '}
        {BUSINESS.representedBy} in {BUSINESS_LOCATION} is the legal
        representative.
      </p>
      <p>
        The accounts below are the only ones Duoly posts from, so an account
        using the name anywhere else is not Duoly.
      </p>
      <ul class="official-channels">
        {OFFICIAL_CHANNELS.map((channel) => (
          <li>
            <a href={channel.href} rel="me noopener">
              {channel.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <Faq heading="What do journalists ask about Duoly?" items={faq} />

    <ClosingCta
      heading="Need a figure that is not on this page?"
      text={`Duoly publishes what it can document: the operator, the catalog, the prices and the rules. Email the team for anything else and expect a written answer.`}
      extra={`What a piece about Duoly needs to get right. The product: players book a rank-verified teammate or coach for a published price and play together on separate accounts using Discord voice, so this is no account boosting service and no rank or win is promised. The operator: a sole proprietorship in ${BUSINESS_LOCATION} under trade register GISA ${BUSINESS.gisa}, with the full legal notice on the imprint. The numbers: ${SERVICE_COUNT} services across ${CATALOG_GAMES} games, from ${SHORT_GAME_PRICE} per game and ${COACHING_PRICE} per coaching hour, read from Duoly checkout on ${pricesLabel}. For example, ${COACHABLE_GAMES} of the ${PLAYABLE_GAMES} bookable games sell coaching as well as teammate sessions, so almost every title carries both a session and a lesson.`}
      href="/about"
      label="Read about Duoly"
      art={{ src: '/assets/games/league-of-legends.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/about">About Duoly and who runs it</a>
        <a href="/how-it-works">How a Duoly booking works step by step</a>
        <a href="/pricing">Every Duoly game, service and price</a>
        <a href="/trust-and-safety">How Duoly checks players and payments</a>
        <a href="/fees-and-refunds">Duoly fees and refunds in full</a>
        <a href="/contact">Ask the Duoly team</a>
        <a href="/terms">Full terms of service</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      officialPageSchema(
        path,
        title,
        description,
        CONTENT_DATES[path]!,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import Hub from '../../components/seo/Hub.astro';
import GameHub from '../../components/seo/GameHub.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { pageViewer } from '../../site/viewer';
import { gameBySlug } from '../../site/games';
import { lessons } from '../../content/coaching';
import { intentForGame, intentPath } from '../../content/intent-pages';
import { socialContent, valorantContent } from '../../content/hubs';
import { hubPageFor } from '../../content/hub-pages';
import { renderTokens } from '../../content/guide-pages';
import { viewerCurrency } from '../../server/currency';
import { eurToUsd } from '../../server/fx';
import { hubOffers, hubPrices } from '../../server/seo/hub';
import {
  faqSchema,
  priceSummary,
  seoOffers,
  serviceSchema,
} from '../../server/seo/offers';
import { serializeJsonLd } from '../../site/seo';
const game = gameBySlug(Astro.params.game);
if (!game) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
// Valorant and Social shipped before the data-driven hubs and keep their own copy.
const legacy = game.id === 'val' || game.id === 'social';
const hub = legacy ? undefined : hubPageFor(game.slug);
const finished = legacy || Boolean(hub);
const copy = game.id === 'social' ? socialContent : valorantContent;
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
const context = {
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
};
const offers = legacy
  ? seoOffers(game.id, game.id === 'social' ? 'gg' : 'teammate', context)
  : [];
const groups = hub ? hubOffers(game.id, context) : undefined;
// Hub copy quotes prices through tokens filled from the checkout pricing engine.
const hubCopy =
  hub && groups
    ? renderTokens(hub, {
        ...hubPrices(game.id, { eurToUsd: 1 }),
        from: priceSummary(groups.all),
        from_lower: priceSummary(groups.all).toLowerCase(),
      })
    : undefined;
const description = hubCopy
  ? hubCopy.description
  : offers.length
    ? game.id === 'social'
      ? `Play with an e-girl on Duoly: friendly Social voice sessions with Just Chat, Watch Together, Sleep Call or Karaoke. ${priceSummary(offers)}. 18+ only.`
      : `Find Valorant teammates: free LFG options plus paid duo sessions ${priceSummary(offers).toLowerCase()}. Compare ranked and casual prices, then book a teammate.`
    : `Explore ${game.name} booking options on Duoly. Our complete game guide is being prepared.`;
const title = hubCopy
  ? hubCopy.title
  : finished
    ? copy.title
    : `${game.name} teammates | Duoly`;
---

<SiteLayout
  title={title}
  description={description}
  indexing={finished ? 'index, follow' : 'noindex, follow'}
  viewer={viewer}
  csrf={csrf}
>
  {hubCopy && groups ? (
    <GameHub game={game} copy={hubCopy} offers={groups} />
  ) : finished ? (
    <Hub game={game} offers={offers} />
  ) : (
    <PageIntro
      eyebrow="Games"
      title={`${game.name} teammates`}
      lead={`Explore ${game.name} sessions through the homepage game picker.`}
    >
      <Breadcrumbs
        items={[
          { name: 'Home', path: '/' },
          { name: 'Games', path: '/games' },
          { name: game.name, path: `/games/${game.slug}` },
        ]}
      />
      <img
        data-analytics-game={game.id}
        src={game.img}
        alt=""
        width="88"
        height="88"
        decoding="async"
      />
      <p>
        Our full teammate guide is being prepared. Check the homepage for
        current services and checkout prices.
      </p>
      <a class="cta" href="/#games">
        Choose a {game.name} session
      </a>
      {intentForGame(game.slug) && (
        <p>
          <a href={intentPath(intentForGame(game.slug)!)}>
            {game.name} duo partners and casual teammate prices
          </a>
        </p>
      )}
      {lessons[game.slug] && (
        <p>
          <a href={`/games/${game.slug}/coaching`}>
            {game.name} coaching services and prices
          </a>
        </p>
      )}
      <p>
        <a href="/games">All games</a>
      </p>
    </PageIntro>
  )}
  {hubCopy && groups && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={serializeJsonLd(
        serviceSchema(
          hubCopy.h1,
          `/games/${game.slug}`,
          groups.all,
          Astro.site!,
        ),
      )}
    />
  )}
  {hubCopy && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={serializeJsonLd(
        faqSchema(hubCopy.faq.items, `/games/${game.slug}`, Astro.site!),
      )}
    />
  )}
  {finished && !hubCopy && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={serializeJsonLd(
        serviceSchema(copy.h1, `/games/${game.slug}`, offers, Astro.site!),
      )}
    />
  )}
</SiteLayout>
<script>
  import { track } from '../../client/analytics/track';
  const game = document.querySelector<HTMLElement>('[data-analytics-game]')
    ?.dataset.analyticsGame;
  window.addEventListener(
    'load',
    () => {
      if (game) track('game_viewed', { game });
    },
    { once: true },
  );
  document
    .querySelector('a.cta')
    ?.addEventListener('click', () =>
      track('cta_clicked', { cta: 'game_book', surface: 'game' }),
    );
</script>

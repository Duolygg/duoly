---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import { pageViewer } from '../../site/viewer';
import { gameBySlug } from '../../site/games';
const game = gameBySlug(Astro.params.game);
if (!game) return Astro.rewrite('/404');
const { viewer, csrf } = await pageViewer(Astro);
// Social is not a game: time with a verified Gamer Girl (docs/product/social-sessions.md).
const social = game.id === 'social';
const copy = social
  ? {
      title: 'Social sessions | Duoly',
      heading: 'Social sessions',
      lead: 'Just chat, watch together, a sleep call or karaoke with a verified Gamer Girl, on voice within minutes.',
      card: 'Pick Social on the homepage, choose a session and how many hours, and a Gamer Girl joins you on Discord. Friendly company only, never dating, romantic or sexual services.',
      cta: 'Book a Social session',
    }
  : {
      title: `${game.name} teammates | Duoly`,
      heading: `${game.name} teammates`,
      lead: `Book a rank-verified ${game.name} teammate who joins your lobby in minutes.`,
      card: `A full guide to ${game.name} services, ranks and prices is on the way. For now, everything is bookable from the homepage.`,
      cta: `Book a ${game.name} teammate`,
    };
---

<SiteLayout
  title={copy.title}
  description={copy.lead}
  viewer={viewer}
  csrf={csrf}
>
  <PageIntro eyebrow="Games" title={copy.heading} lead={copy.lead}>
    <img class="art" src={game.img} alt="" width="88" height="88" />
    <div class="card">
      <p>{copy.card}</p>
    </div>
    <a class="cta" href="/#games">
      {copy.cta}
    </a>
    <p class="back">
      <a href="/games">All games</a>
    </p>
  </PageIntro>
</SiteLayout>

<style>
  .art {
    margin-top: 24px;
    border-radius: 20px;
  }
  .card p {
    margin: 0;
    color: #cfc4ea;
  }
  .back {
    margin-top: 16px;
  }
</style>

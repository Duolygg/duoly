---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import SeoHero from '../../../components/seo/SeoHero.astro';
import Prices from '../../../components/seo/Prices.astro';
import Steps from '../../../components/seo/Steps.astro';
import Topics from '../../../components/seo/Topics.astro';
import Faq from '../../../components/seo/Faq.astro';
import SessionExamples from '../../../components/seo/SessionExamples.astro';
import CoachFormats from '../../../components/seo/CoachFormats.astro';
import ClosingCta from '../../../components/seo/ClosingCta.astro';
import StickyBook from '../../../components/seo/StickyBook.astro';
import '../../../components/seo/seo.css';
import '../../../components/seo/coach-formats.css';
import { lessons } from '../../../content/coaching';
import { coachFormats } from '../../../content/coaching-formats';
import {
  closingAnswer,
  closingDetail,
} from '../../../server/seo/citable-answers';
import { intentForGame, intentPath } from '../../../content/intent-pages';
import { gameBySlug } from '../../../site/games';
import { pageViewer } from '../../../site/viewer';
import { viewerCurrency } from '../../../server/currency';
import { eurToUsd } from '../../../server/fx';
import {
  coachingFacts,
  priceSummary,
  seoOffers,
  serviceSchema,
  faqSchema,
} from '../../../server/seo/offers';
import {
  exampleOffers,
  withPrices,
} from '../../../server/seo/coaching-examples';
import { heroOffer } from '../../../server/seo/hero-offer';
import { COACHING_REASSURANCE } from '../../../server/seo/reassurance';
import {
  serializeJsonLd,
  GUIDE_PATH,
  bookingHref,
  COACHING_SLUGS,
} from '../../../site/seo';
const game = gameBySlug(Astro.params.game);
const lesson = lessons[Astro.params.game ?? ''];
const formats = coachFormats[Astro.params.game ?? ''];
if (!game || !lesson || !formats) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
const offers = seoOffers(game.id, 'training', {
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
});
if (!offers.length) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const summary = priceSummary(offers);
const path = `/games/${game.slug}/coaching`;
const book = bookingHref(game.id, { tab: 'training' });
// The hero card sells the lesson a reader lands on this page for: the first
// coaching service the catalog lists for the game, at its own price.
const offer = heroOffer(game.id, offers[0]!.id, offers, {
  coach: true,
});
/**
 * Sibling coaching pages, as one ring through what a player is practicing:
 * tactical shooters, then the battle royale and sandbox end, then the arcade
 * and strategy games, then the MOBAs, the MMO and the hero shooters, wrapping
 * back to Valorant.
 *
 * Every page lists the two games before it and the two after it, so every page
 * is also listed by exactly four others. That symmetry is the point: the five
 * newest coaching pages were bolted onto an eleven-game ring and ended up with
 * four or five inbound links each, under the six the build now requires
 * (scripts/seo-built.test.mjs). A ring cannot develop that gap again, because
 * adding a game to RELATED_RING gives it four inbound links and four outbound
 * ones in the same edit.
 */
const RELATED_RING = [
  'valorant',
  'counter-strike-2',
  'rainbow-six-siege',
  'call-of-duty',
  'apex-legends',
  'fortnite',
  'minecraft',
  'rocket-league',
  'teamfight-tactics',
  'league-of-legends',
  'dota-2',
  'deadlock',
  'world-of-warcraft',
  'overwatch-2',
  'marvel-rivals',
];
const relatedFor = (slug: string) => {
  const index = RELATED_RING.indexOf(slug);
  const at = (step: number) =>
    RELATED_RING[(index + step + RELATED_RING.length) % RELATED_RING.length]!;
  return index < 0 ? [] : [at(1), at(2), at(-1), at(-2)];
};
const descriptions: Record<string, string> = {
  valorant: `Valorant coaching ${summary.toLowerCase()}. Choose live Play and Learn, VOD Review or Aim and Crosshair. Set a goal and book your coach on Duoly.`,
  'league-of-legends': `League of Legends coaching ${summary.toLowerCase()}. Book live learning, VOD Review or Champion Mastery. Work on your role, lane and recall decisions.`,
  'rocket-league': `Rocket League coaching ${summary.toLowerCase()}. Book Doubles or Mechanics Training with practice packs. Work on aerials, recoveries and second-player decisions.`,
  fortnite: `Fortnite coaching at ${summary.toLowerCase()}. Book a Fortnite coach for live Ranked learning or Creative build and edit practice, with a plan for your input.`,
  'teamfight-tactics': `TFT coaching at ${summary.toLowerCase()}. Book a Teamfight Tactics Comp and Econ Review. Work on gold, roll timing, board strength and your next spending decision.`,
  'apex-legends': `Apex Legends coaching at ${summary.toLowerCase()}. Book live Ranked learning or a Firing Range Movement Course. Practice rotations and movement for your input.`,
  'marvel-rivals': `Marvel Rivals coaching ${summary.toLowerCase()}. Choose live Play and Learn or hourly Hero Coaching. Review positioning, abilities and ultimate timing.`,
  'counter-strike-2': `CS2 coaching ${summary.toLowerCase()}. Book a live Premier match, an hour of Demo Review or Utility and Lineups for the maps you queue.`,
  'overwatch-2': `Overwatch 2 coaching ${summary.toLowerCase()}. Choose live Play and Learn or hourly Role Coaching for tank, damage or support. Work on cooldowns.`,
  'rainbow-six-siege': `Rainbow Six Siege coaching ${summary.toLowerCase()}. Book a live Ranked match, an hour in the Operator Lab or a room-by-room Map and Callouts pass.`,
  'call-of-duty': `Call of Duty coaching ${summary.toLowerCase()}. Book a live Warzone hour or an hour on loadouts and movement, and work on rotations, builds and positioning.`,
  'dota-2': `Dota 2 coaching ${summary.toLowerCase()}. Book a live ranked game, a replay review or an hour on one hero, and work on laning and item timings.`,
  minecraft: `Minecraft coaching ${summary.toLowerCase()}. Book an hour of PvP drills or an hour on Bedwars, and work on aim, combos, strafing, bridging and bed defence.`,
  'world-of-warcraft': `WoW coaching ${summary.toLowerCase()}. Book a live Mythic+ hour or an hour on your class and spec, and work on talents, cooldowns, routes and interrupt order.`,
  deadlock: `Deadlock coaching ${summary.toLowerCase()}. Book a live ranked match or an hour on macro and souls, and work on farming, items and Mid Boss timings.`,
};
const description = descriptions[game.slug]!;
---

<SiteLayout
  title={lesson.title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Games', path: '/games' },
        { name: game.name, path: `/games/${game.slug}` },
        { name: 'Coaching', path },
      ]}
    />
    <SeoHero
      eyebrow={`${game.name} coaching`}
      h1={lesson.h1}
      lead={lesson.lead}
      cta={{ href: book, label: `Book ${game.name} coaching` }}
      secondary={{ href: '#prices', label: 'See prices' }}
      note={COACHING_REASSURANCE}
      art={[{ src: game.img, alt: `${game.name} game art` }]}
      chip={summary}
      offer={offer}
      facts={coachingFacts(offers)}
    />
    <section aria-labelledby="get-h">
      <h2 id="get-h">What does {game.name} coaching cover?</h2>
      <p>{withPrices(lesson.format, offers).replaceAll('**', '')}</p>
    </section>
    <CoachFormats
      copy={formats}
      answer={withPrices(formats.answer, offers)}
      detail={withPrices(formats.detail, offers)}
      choice={withPrices(formats.choice, offers)}
    />
    <Prices
      gameId={game.id}
      offers={offers}
      coach
      intro={withPrices(lesson.prices, offers)}
    />
    <SessionExamples
      gameId={game.id}
      gameName={game.name}
      examples={exampleOffers(game.id, offers)}
    />
    <Steps
      heading={`How do you book ${game.name} coaching?`}
      steps={lesson.steps.map((step) => withPrices(step, offers))}
    >
      <p>
        {withPrices(lesson.booking, offers)} See the{' '}
        <a href="/terms">payment and refund terms</a> or{' '}
        <a href="/contact">contact support</a> any time.
      </p>
    </Steps>
    <Topics
      sections={lesson.sections.map((section) => ({
        ...section,
        paragraphs: section.paragraphs.map((text) => withPrices(text, offers)),
      }))}
      label={`${game.name} focus`}
    />
    <section class="card" aria-labelledby="prep-h">
      <h2 id="prep-h">How should you prepare for {game.name} coaching?</h2>
      <ul class="checklist">
        {withPrices(lesson.prepare, offers)
          .split(/(?<=\.)\s+/)
          .map((tip) => (
            <li>{tip}</li>
          ))}
      </ul>
    </section>
    <Faq
      heading={`What do players ask about ${game.name} coaching?`}
      items={lesson.faq.map(([question, answer]) => [
        question,
        withPrices(answer, offers),
      ])}
    />
    <ClosingCta
      heading={`Ready for your ${game.name} lesson?`}
      text={closingAnswer(game.name)}
      extra={closingDetail(offers)}
      href={book}
      label={`Book ${game.name} coaching`}
      price={summary}
      art={{ src: game.img, alt: '' }}
    />
    <nav class="related" aria-label="Related pages">
      <h2>Keep exploring</h2>
      <div class="chips">
        <a href={`/games/${game.slug}`}>{game.name} teammates</a>
        {intentForGame(game.slug) && (
          <a href={intentPath(intentForGame(game.slug)!)}>
            {game.name} play-together sessions
          </a>
        )}
        <a href="/coaching">Esports coaching in every game</a>
        <a href="/blog/how-to-choose-a-gaming-coach">
          How to choose a gaming coach
        </a>
        <a href="/compare/queueup">Duoly vs QueueUp compared</a>
        <a href="/games">All games and coaching</a>
        {relatedFor(game.slug)
          .filter((slug) =>
            COACHING_SLUGS.includes(slug as (typeof COACHING_SLUGS)[number]),
          )
          .map((slug) => (
            <a href={`/games/${slug}/coaching`}>
              {lessons[slug]!.h1.split(' coaching')[0]} coaching
            </a>
          ))}
        <a href={GUIDE_PATH}>Playing together respectfully</a>
        <a href="/get-paid-to-play-games">Become a teammate</a>
      </div>
    </nav>
    {offer && <StickyBook offer={offer} />}
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      serviceSchema(`${game.name} coaching`, path, offers, Astro.site!),
    )}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      faqSchema(
        lesson.faq.map(([q, a]) => [q, withPrices(a, offers)]),
        path,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

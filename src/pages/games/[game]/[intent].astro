---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import SeoHero from '../../../components/seo/SeoHero.astro';
import Prices from '../../../components/seo/Prices.astro';
import Steps from '../../../components/seo/Steps.astro';
import Topics from '../../../components/seo/Topics.astro';
import Faq from '../../../components/seo/Faq.astro';
import ClosingCta from '../../../components/seo/ClosingCta.astro';
import FreeVsPaid from '../../../components/seo/FreeVsPaid.astro';
import LfgPost from '../../../components/seo/LfgPost.astro';
import '../../../components/seo/seo.css';
import '../../../components/seo/free-vs-paid.css';
import '../../../components/seo/lfg-post.css';
import '../../../components/seo/intent-hero.css';
import { intentPages, intentPath } from '../../../content/intent-pages';
import { intentOffers } from '../../../server/seo/intent-offers';
import { closingDetail } from '../../../server/seo/citable-answers';
import { gameBySlug } from '../../../site/games';
import { pageViewer } from '../../../site/viewer';
import { viewerCurrency } from '../../../server/currency';
import { eurToUsd } from '../../../server/fx';
import {
  priceSummary,
  serviceSchema,
  faqSchema,
} from '../../../server/seo/offers';
import { guideExamples } from '../../../server/seo/guide';
import {
  guideForGame,
  guideFaq,
  renderTokens,
} from '../../../content/guide-pages';
import {
  bookingHref,
  bookTeammateLabel,
  COACHING_SLUGS,
  serializeJsonLd,
} from '../../../site/seo';
const page = intentPages.find(
  (entry) =>
    entry.gameSlug === Astro.params.game && entry.slug === Astro.params.intent,
);
const game = gameBySlug(Astro.params.game);
if (!page || !game) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
const offers = intentOffers(page, game.id, {
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
});
const summary = priceSummary(offers);
const path = intentPath(page);
const book = bookingHref(game.id, { service: page.service });
const guidePrices = guideExamples({ eurToUsd: 1 });
const guide = guideForGame(game.slug);
const guideCopy = guide ? renderTokens(guide, guidePrices) : null;
const copy = renderTokens(page, guidePrices);
const faqItems = guideFaq(page, guidePrices);
---

<SiteLayout
  title={page.title}
  description={page.description(summary.toLowerCase())}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article
    class="seo-page"
    data-intent-page
    style={page.accent ? `--lfg-accent: ${page.accent}` : undefined}
  >
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Games', path: '/games' },
        { name: game.name, path: `/games/${game.slug}` },
        { name: 'Play together', path },
      ]}
    />
    <SeoHero
      eyebrow={`${game.name} teammates`}
      h1={page.h1}
      lead={page.lead}
      cta={{ href: book, label: bookTeammateLabel(game.name) }}
      secondary={{ href: '#prices', label: 'Compare prices' }}
      art={[{ src: game.img, alt: `${game.name} game art` }]}
      price={summary}
      facts={page.facts}
    />
    <section aria-labelledby="format-h">
      <h2 id="format-h">
        {page.formatHeading ?? 'What you get when you book'}
      </h2>
      <p>{copy.format}</p>
    </section>
    <Prices
      gameId={game.id}
      offers={offers}
      intro={copy.pricesIntro}
      updated={page.pricesChecked ?? '2026-11-06'}
    />
    <Steps
      heading={page.stepsHeading ?? 'How matching and booking work'}
      steps={copy.steps}
    >
      <p>
        Duoly reviews every teammate before any order. Read about{' '}
        <a href="/contact">the team behind Duoly</a>, check the{' '}
        <a href="/terms">payment, cancellation and refund terms</a> or{' '}
        <a href="/contact">contact support</a> for help with a booking.
      </p>
    </Steps>
    <Topics sections={copy.sections} label={`${game.name} duo plan`} />
    {guideCopy && (
      <FreeVsPaid
        guide={guideCopy}
        gameName={game.name}
        art={game.img}
        booking={book}
      >
        {guideCopy.post && (
          <LfgPost post={guideCopy.post} gameName={game.name} booking={book} />
        )}
      </FreeVsPaid>
    )}
    <section class="card" aria-labelledby="prep-h">
      <h2 id="prep-h">{page.prepareHeading ?? 'Before your first game'}</h2>
      <ul class="checklist">
        {copy.prepare.map((tip) => (
          <li>{tip}</li>
        ))}
      </ul>
    </section>
    <Faq heading={page.faqHeading} items={faqItems} />
    <ClosingCta
      heading={`Ready to play ${game.name} together?`}
      text={
        copy.closing ??
        'Choose your mode, share your role and book your next games.'
      }
      extra={closingDetail(offers)}
      href={book}
      label="Choose your teammate session"
      price={summary}
      art={{ src: game.img, alt: '' }}
    />
    <nav class="related" aria-label="Related pages">
      <h2>Find your next session</h2>
      <div class="chips">
        <a href={`/games/${game.slug}`}>{game.name} game hub</a>
        {COACHING_SLUGS.some((slug) => slug === game.slug) && (
          <a href={`/games/${game.slug}/coaching`}>{game.name} coaching</a>
        )}
        <a href="/find-gaming-buddies">Find gaming buddies in every game</a>
        <a href="/blog/what-does-lfg-mean">What does LFG mean?</a>
        <a href="/games">All games and services</a>
        <a href="/compare/e-pal">Duoly vs E-Pal comparison</a>
        {intentPages
          .filter((entry) => entry !== page)
          .map((entry) => (
            <a href={intentPath(entry)}>
              {gameBySlug(entry.gameSlug)!.name} duo sessions
            </a>
          ))}
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      serviceSchema(page.h1, path, offers, Astro.site!),
    )}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faqItems, path, Astro.site!))}
  />
</SiteLayout>

<style>
  [data-intent-page] :global(nav[aria-label='Breadcrumb'] ol) {
    gap: 4px 10px;
  }
  [data-intent-page] :global(nav[aria-label='Breadcrumb'] li) {
    white-space: nowrap;
    display: inline-block;
  }
  [data-intent-page] :global(nav[aria-label='Breadcrumb'] li + li::before) {
    content: none;
  }
  [data-intent-page]
    :global(nav[aria-label='Breadcrumb'] li:not(:last-child)::after) {
    content: '/';
    margin-left: 10px;
    color: #8e84ab;
  }
  [data-intent-page] > section > p {
    max-width: 75ch;
  }
  @media (max-width: 600px) {
    [data-intent-page] :global(.seo-hero h1) {
      max-width: none;
      text-wrap: balance;
    }
  }
</style>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import { pageViewer } from '../../site/viewer';
import { SITE_GAMES } from '../../site/games';
import { lessons } from '../../content/coaching';
import { intentForGame, intentPath } from '../../content/intent-pages';
import {
  serializeJsonLd,
  CONTENT_DATES,
  bookingHref,
  COACHING_SLUGS,
} from '../../site/seo';
import { faqSchema } from '../../server/seo/offers';
import {
  BUNDLE_PERCENTS as bundle,
  COACHABLE_GAMES,
  COACHING_PRICE,
  PLAYABLE_GAMES,
  SHORT_GAME_PRICE,
  SOCIAL_PRICE,
  SOCIAL_MODES,
} from '../../server/seo/teammate-facts';
const { viewer, csrf } = await pageViewer(Astro);
const path = '/games';
const faq: [string, string][] = [
  [
    'What is the cheapest session on Duoly?',
    `The lowest listed price is ${SHORT_GAME_PRICE} for a Valorant Skirmish 2v2 game, and prices rise with rank and session length.`,
  ],
  [
    'How much does coaching cost?',
    `Coaching is ${COACHING_PRICE} per hour or game across all ${COACHABLE_GAMES} coachable games, and bundles do not change a coaching price.`,
  ],
  [
    'Do I get a discount for booking several games?',
    `Yes, teammate bundles take ${bundle[0]}% off three units, ${bundle[1]}% off five and ${bundle[2]}% off ten, applied automatically at checkout.`,
  ],
  [
    'Does someone play on my account?',
    'No, every teammate and coach plays on a personal account, and Duoly never asks for your login.',
  ],
  [
    'Which voice app do sessions use?',
    'Most sessions run with Discord voice, agreed in the order room before the first match starts.',
  ],
  [
    'What is Duoly Social?',
    `Social is voice company without a game, at ${SOCIAL_PRICE} per hour across ${SOCIAL_MODES} modes. Social is friendly company only, never dating, romantic or sexual services.`,
  ],
  [
    'How do I know my booking is confirmed?',
    'A booking is confirmed when a teammate accepts the order from the queue. Check the order room for acceptance and coordinate the session there.',
  ],
];
---

<SiteLayout
  indexing="index, follow"
  title="Gaming Teammates and Coaching by Game | Duoly"
  description={`Browse gaming teammates and coaching on Duoly, with sessions from ${SHORT_GAME_PRICE}. Compare Valorant, League of Legends, Fortnite and more, or book friendly Social time.`}
  viewer={viewer}
  csrf={csrf}
>
  <PageIntro
    eyebrow="Games"
    title="Gaming teammates and coaching by game"
    lead={`Browse ${PLAYABLE_GAMES} games plus Social. Choose your game or open its coaching guide.`}
  >
    {/* A directory of links to the game hubs: a nav landmark rather than a bare
        list, matching the related-links pattern on the other SEO pages. Screen
        reader users reach it from the landmark menu, and text extractors read
        the answers below instead of 40 link labels. The page-directory class
        marks it as this page's own content index rather than shared site
        navigation; scripts/seo-built.test.mjs relies on that distinction. */}
    <nav
      class="page-directory"
      aria-label={`All ${PLAYABLE_GAMES} games and Social`}
    >
      <ul class="grid">
        {SITE_GAMES.map((game) => (
          <li>
            <a href={`/games/${game.slug}`}>
              <img
                src={game.img}
                alt={`${game.name} game art`}
                width="56"
                height="56"
                loading="lazy"
              />
              <span>{game.name}</span>
            </a>
            {intentForGame(game.slug) && (
              <a href={intentPath(intentForGame(game.slug)!)}>
                {game.name} play-together sessions
              </a>
            )}
            {lessons[game.slug] && (
              <a href={`/games/${game.slug}/coaching`}>{game.name} coaching</a>
            )}
            {/* One booking link per card: the directory is the page's own
                content index, so a reader can reach checkout from the game
                they came for rather than one hub hop later. */}
            <a class="book" href={bookingHref(game.id)}>
              Book {game.name} now
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <section class="answers" aria-labelledby="what-h">
      <h2 id="what-h">How do you pick a game on Duoly?</h2>
      <p>
        Choose your game first. Its hub lists every teammate service, lesson and
        price for that title. A coaching link opens the lesson guide, a
        play-together link weighs the free communities against a paid session,
        and the Book link beside them opens checkout with the game already
        chosen. Services differ by game, so check the mode and the unit before
        you pick a quantity: an hourly review and a session priced per game buy
        very different amounts of play.
      </p>
      <p>
        A Valorant player can compare Competitive, Swiftplay and a VOD Review
        from one hub. Match the server and region, agree voice in the order
        chat, and stay on your own account. Nothing here promises a win, a start
        time or a rank change.
      </p>
      <p>
        An assistant can read the same prices:{' '}
        <a href="/ai">Duoly in AI assistants</a> covers the chat side and the{' '}
        <a href="/developers/mcp">MCP developer guide</a> the API. For
        background, browse <a href="/blog">Duoly guides</a> and{' '}
        <a href="/compare/e-pal">the E-Pal comparison</a>. Payment, cancellation
        and refund details are in the <a href="/terms">terms</a> and summarised
        on <a href="/fees-and-refunds">Duoly fees and refunds</a>, and{' '}
        <a href="/about">about Duoly</a> names the company behind the site.
      </p>
    </section>
    <section class="answers" aria-labelledby="services-h">
      <h2 id="services-h">What can you book on Duoly?</h2>
      <p>
        Three things. A duo session puts a ranked teammate in your lobby for the
        mode you choose. Coaching adds a stated learning goal and runs in all{' '}
        {COACHABLE_GAMES} coachable titles. Social sells {SOCIAL_MODES} voice
        modes with no game at all. Teammate bundles reach {bundle[2]}% off, and
        coaching stays flat whatever you buy.
      </p>
      <p>
        Every booking starts with the mode, because a Swiftplay teammate and a
        Ranked teammate are separate listings at separate prices. A Valorant
        player who wants better entries books coaching, while the same player
        who just wants a calmer queue books a duo. Sessions run with Discord
        voice on accounts both people own, and Duoly never asks you for a login
        or a password.
      </p>
    </section>
    <section class="answers" aria-labelledby="cost-h">
      <h2 id="cost-h">How much does a Duoly session cost?</h2>
      <p>
        A Duoly price depends on the game, the service, the teammate rank and
        how many units you book. The cheapest session is {SHORT_GAME_PRICE} for
        a Valorant Skirmish 2v2 game. Coaching is flat at {COACHING_PRICE} per
        hour or game in every coachable title, which is why a Grandmaster League
        of Legends review costs the same as a Valorant aim lesson, and Social
        holds that same hourly rate.
      </p>
      <p>
        Teammate bundles cut the total by {bundle[0]}% at three units,{' '}
        {bundle[1]}% at five and {bundle[2]}% at ten, and they come off at
        checkout without a code. A ten-game Valorant Duo Pro bundle is the
        largest discount on the site at {bundle[2]}% below ten single bookings.
        Bundles never reach coaching. Read the unit before the figure, since a
        game and an hour price differently, and nothing is added on top of
        either: <a href="/fees-and-refunds">the fees and refunds page</a>{' '}
        carries the cancellation rules and <a href="/pricing.md">pricing.md</a>{' '}
        lists every rank.
      </p>
    </section>
    <section class="answers" aria-labelledby="choose-h">
      <h2 id="choose-h">Should you book a duo, coaching or Social?</h2>
      <p>
        The right service is whichever one matches what you want out of the next
        hour. Pick a duo when the goal is winning more games tonight: an
        Immortal Valorant teammate can hold a site while you take map control
        and call it with Discord voice. Pick coaching when the goal is
        understanding why a round keeps going wrong, because a coach pauses,
        explains and reviews. Pick Social when the goal is company and not a
        scoreboard: Just Chat, Watch Together, Sleep Call or Karaoke, on voice
        and nothing else.
      </p>
      <p>
        The price will not settle the choice for you, so go by the activity. A
        coach stops the game to explain it; a teammate plays the next round
        beside you. A ten game duo bundle costs {bundle[2]}% less than ten
        single games, while a tenth coaching hour costs the same as the first.
      </p>
    </section>
    <section class="answers" aria-labelledby="which-h">
      <h2 id="which-h">Which games have coaching and play-together guides?</h2>
      <p>
        Every game above links to a hub, which is the page listing each mode,
        rank and price for that title. Coaching covers all {COACHABLE_GAMES}{' '}
        bookable games, and {COACHING_SLUGS.length} of them carry a coaching
        guide with a worked lesson and a checklist for what to bring. Games with
        a play-together guide show a sessions link, which sets the free Discord
        routes beside the paid ones.
      </p>
      <p>
        If you would rather see one page across every title,{' '}
        <a href="/coaching">esports coaching by game</a> covers the lessons,{' '}
        <a href="/find-gaming-buddies">find gaming buddies</a> covers playing
        time, and{' '}
        <a href="/blog/what-does-lfg-mean">what LFG means in gaming</a> explains
        the shorthand you will meet in those channels. Social sits outside the
        coaching set, because {SOCIAL_MODES} voice modes of friendly company
        teach nothing about a game, and the {bundle[2]}% bundle discount covers
        teammate games and never lessons.
      </p>
    </section>
    <section class="answers" aria-labelledby="faq-h2">
      <h2 id="faq-h2">What do players ask before booking?</h2>
      <dl class="qa">
        {faq.map(([question, answer]) => (
          <>
            <dt>{question}</dt>
            <dd>
              <p>{answer}</p>
            </dd>
          </>
        ))}
      </dl>
    </section>
  </PageIntro>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Gaming teammates and coaching by game',
      url: new URL(path, Astro.site!).href,
      dateModified: CONTENT_DATES[path],
    })}
  />
</SiteLayout>

<style>
  .grid {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .grid a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border-radius: 18px;
    background: #120b22;
    border: 1px solid rgba(214, 187, 255, 0.12);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .grid a:hover {
    border-color: rgba(214, 187, 255, 0.4);
  }
  .grid img {
    border-radius: 12px;
  }
  /* Games carry a different number of child pages, so the stacks are uneven.
     Let each one fill its row and push the booking link to the bottom, and the
     actions line up across a row instead of landing wherever the links ran out. */
  .grid li {
    display: flex;
    flex-direction: column;
  }
  /* The booking link is the action in each card stack, so it carries the
     accent the rest of the site gives a call to action. */
  .grid a.book {
    margin-top: auto;
    color: #d6bbff;
    border-color: rgba(214, 187, 255, 0.28);
    background: linear-gradient(140deg, rgba(214, 187, 255, 0.1), #120b22 60%);
  }
  .grid a.book:hover {
    border-color: rgba(214, 187, 255, 0.55);
  }
  .answers {
    margin-top: 48px;
  }
  .answers h2 {
    margin: 0 0 12px;
    font-family: 'Bricolage Grotesque', 'Bricolage Fallback', sans-serif;
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #f3eeff;
  }
  .answers p {
    max-width: 70ch;
    line-height: 1.7;
    color: #cfc4ea;
  }
  .qa {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .qa dt {
    font-weight: 700;
    color: #f3eeff;
  }
  .qa dd {
    margin: 6px 0 0;
  }
  .qa dd p {
    margin: 0;
    max-width: 70ch;
    line-height: 1.7;
    color: #cfc4ea;
  }
</style>

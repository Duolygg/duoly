---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import { pageViewer } from '../../site/viewer';
import { SITE_GAMES } from '../../site/games';
import { lessons } from '../../content/coaching';
const { viewer, csrf } = await pageViewer(Astro);
---

<SiteLayout
  indexing="index, follow"
  title="Gaming Teammates and Coaching by Game | Duoly"
  description="Browse gaming teammates and coaching on Duoly, with sessions from €2.49. Compare Valorant, League of Legends, Fortnite and more, or book friendly Social time."
  viewer={viewer}
  csrf={csrf}
>
  <PageIntro
    eyebrow="Games"
    title="Gaming teammates and coaching by game"
    lead="Browse 15 games plus Social. Choose a game hub or a finished coaching guide."
  >
    <p>
      Valorant sessions start at €2.49 per game. Duo sessions focus on playing
      together. Coaching adds a specific learning goal. Social is friendly voice
      company without a game, for adults only. Payment, cancellation and refund
      details are in our <a href="/terms">terms</a>.
    </p>
    <ul class="grid">
      {SITE_GAMES.map((game) => (
        <li>
          <a href={`/games/${game.slug}`}>
            <img
              src={game.img}
              alt={`${game.name} game art`}
              width="56"
              height="56"
              loading="lazy"
            />
            <span>{game.name}</span>
          </a>
          {lessons[game.slug] && (
            <a href={`/games/${game.slug}/coaching`}>{game.name} coaching</a>
          )}
        </li>
      ))}
    </ul>
  </PageIntro>
</SiteLayout>

<style>
  .grid {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .grid a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border-radius: 18px;
    background: #120b22;
    border: 1px solid rgba(214, 187, 255, 0.12);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .grid a:hover {
    border-color: rgba(214, 187, 255, 0.4);
  }
  .grid img {
    border-radius: 12px;
  }
</style>

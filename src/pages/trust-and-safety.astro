---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/official.css';
import { pageViewer } from '../site/viewer';
import { CONTENT_DATES, hubChips, serializeJsonLd } from '../site/seo';
import { faqSchema } from '../server/seo/offers';
import { officialPageSchema } from '../server/seo/official';
import { BUSINESS, BUSINESS_LOCATION } from '../site/entity';
import { SUPPORT_EMAIL } from '../site/nav';
import {
  PLAYABLE_GAMES,
  SHARE_PERCENT,
  VALORANT_GG_PRICE,
} from '../server/seo/teammate-facts';
import {
  AUTO_CANCEL_MINUTES,
  BUNDLE_PERCENTS,
  CATALOG_PRICES_UPDATED_LABEL,
  QUANTITY_PERCENT,
  SINGLE_GAME,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';
import {
  FREE_REROLLS,
  PAYMENT_PROVIDER,
  REROLL_MINUTES,
  REVIEW_STAGES,
  TEAMMATE_MIN_RANKS,
} from '../server/seo/booking';
import { providerTier } from '../server/seo/price-table';
import { article } from '../server/seo/coaching-examples';
import { LEGAL_UPDATED } from '../design-reference/lib/site.js';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/trust-and-safety';
const title = 'Duoly Trust and Safety: How Players Are Checked | Duoly';
const description = `How Duoly checks teammates and coaches, who handles the card payment, the conduct rules both sides accept, how to report a session and what Duoly never does.`;
const HUB_LINKS = hubChips([
  'valorant',
  'league-of-legends',
  'marvel-rivals',
  'overwatch-2',
]);
const pricesLabel = CATALOG_PRICES_UPDATED_LABEL;
/** Provider tiers read from the catalog, so no page names a rank it invented. */
const DUO_PRO_TIER = providerTier('lol', 'duo2');
const DUO_APEX_TIER = providerTier('lol', 'duo3');
const VALORANT_COACH_TIER = providerTier('val', 'vod');

/**
 * The five refusals the terms put in writing, as scannable cards beside the
 * paragraph that states them in full. Same wording as the /about cards, because
 * the rules are the same rules and two pages disagreeing about them would be
 * worse than one page carrying them twice.
 */
const NOT_DUOLY: [string, string][] = [
  [
    'No account sharing',
    'Every session is played together, on your own account.',
  ],
  [
    'No rank or win promised',
    'A teammate accepts from a queue, and no result is sold.',
  ],
  [
    'No dating services',
    'Gamer Girl and Social sessions are company and conversation.',
  ],
  ['Nobody under 18', 'Customers and teammates both have to be 18 or older.'],
  ['No off-platform payment', 'Payment, chat and reports stay on duoly.gg.'],
];

const faq: [string, string][] = [
  [
    'Is Duoly safe to use?',
    `Duoly is an Austrian sole proprietorship, registered under trade register number GISA ${BUSINESS.gisa} and operated from ${BUSINESS_LOCATION}, with the operator details published in full. Payment runs through ${PAYMENT_PROVIDER}, so Duoly never sees a full card number, and every session is played on your own account. An order is one charge with nothing added on top, refundable in full until a teammate accepts.`,
  ],
  [
    'Will a Duoly teammate ever ask for my account password?',
    'No. Nobody at Duoly asks for a password, and the order chat refuses messages asking for a login before they are delivered. If anybody asks anyway, report the order from your order room.',
  ],
  [
    'How are Duoly coaches checked?',
    `A coach passes the same four-stage review as a teammate and is listed at the coach rank the game's coaching page names: an ${VALORANT_COACH_TIER} on a Valorant VOD Review hour. Coaching applicants also send a short sample review of a recorded match.`,
  ],
  [
    'Can I get a different teammate if the match is wrong?',
    `Yes. The order room offers ${FREE_REROLLS} free re-rolls in the first ${REROLL_MINUTES} minutes after matching, and a team order offers the same switch for each teammate. After that window, report the order instead and a person reviews it.`,
  ],
  [
    'Does Duoly store my card details?',
    `No. The card form at checkout belongs to ${PAYMENT_PROVIDER}, and the privacy policy states that payment details go straight to the payment provider while Duoly only sees the amount and the method. Ticking save at checkout stores the card with ${PAYMENT_PROVIDER}, and Duoly sees only its brand and last 4 digits.`,
  ],
  [
    'What happens to a teammate who breaks the rules?',
    `A report from the order room starts it, and the terms then allow a warning, a cancelled order without a refund, or a blocked account, depending on how serious the case is. A payout of ${SHARE_PERCENT}% can also be held while a report about that order is reviewed, and fake completion proof ends a teammate’s time on Duoly.`,
  ],
  [
    'Is Duoly allowed by the game publishers?',
    `Playing together in a party is allowed in all ${PLAYABLE_GAMES} games Duoly sells, and Duoly never signs into a customer account. Duoly is not affiliated with, endorsed or sponsored by Riot Games, Valve, Epic Games, Blizzard, NetEase or any other publisher, and every player stays responsible for the rules of the game being played.`,
  ],
  [
    'How do I get my data deleted?',
    `Email ${SUPPORT_EMAIL} or use the contact form and pick the privacy topic. The privacy policy lists access, correction, deletion, portability, restriction, objection and withdrawing consent as rights, answered within one month, with a complaint possible to the Austrian data protection authority.`,
  ],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page official-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Trust and safety', path },
      ]}
    />
    <SeoHero
      eyebrow="Trust and safety"
      h1="Duoly trust and safety"
      lead={`Every Duoly teammate passes a four-stage review before a first order, payment runs through ${PAYMENT_PROVIDER} and never through Duoly, and both sides sign up to the same conduct rules. Each one is set out below, with the rule you can go and read for yourself.`}
      cta={{ href: '/how-it-works', label: 'See how a booking runs' }}
      secondary={{ href: '/terms', label: 'Read the terms' }}
      art={[
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/marvel-rivals.png', alt: 'Marvel Rivals art' },
      ]}
      chip="Rank checked before a first order"
      facts={[
        'Four-stage teammate review',
        `Card handling by ${PAYMENT_PROVIDER}`,
        'Reports read by a person',
        'Nobody under 18',
      ]}
      note={`Rules quoted from the Duoly terms and privacy policy, both dated ${LEGAL_UPDATED}.`}
    />

    <section aria-labelledby="check-h">
      <h2 id="check-h">
        How does Duoly check a teammate before a first order?
      </h2>
      <p>
        A Duoly teammate is an applicant who has passed a four-step review.
        Nobody reaches the order queue before that review finishes. It starts
        with <a href="/apply">the application form</a>: a display name, an
        email, a Discord username, a country, a confirmation of being 18 or
        older, the main game, the current rank, the server region and a link to
        a short YouTube intro video.
      </p>
      <p>
        Then comes the rank check, where the Duoly team verifies the account and
        its rank history against the minimum published for that game. A League
        of Legends applicant needs Diamond 4 or higher. Then one tryout game
        with the Duoly team on Discord. Only after that does the account go
        online and start seeing orders. So a {SINGLE_GAME.total} Duo Pro game
        pairs you with {article(DUO_PRO_TIER)} {DUO_PRO_TIER} who has been
        through all four steps, and {SHARE_PERCENT}% of what you paid reaches
        them when the order is complete.
      </p>
      {/* The same four stages as a timeline. Divs and spans, so the paragraph
          above stays the one extractable answer rather than being repeated. */}
      <ol class="official-flow">
        {REVIEW_STAGES.map(([label, detail], index) => (
          <li>
            <span class="official-step">Step {index + 1}</span>
            <span class="official-label">{label}</span>
            <span class="official-detail">{detail}</span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="rank-h">
      <h2 id="rank-h">Which rank does a Duoly teammate have to hold?</h2>
      <p>
        Each game publishes its own minimum, and the application form offers
        that rank and everything above it as a fixed list:{' '}
        {TEAMMATE_MIN_RANKS.map(
          ([game, rank], index) =>
            `${index ? ', ' : ''}${game} asks for ${rank}`,
        ).join('')}
        . You can read the same tiers from the customer side on{' '}
        <a href={SINGLE_GAME.href}>a real {SINGLE_GAME.short} checkout</a>.
      </p>
      <p>
        Every service names the tier it pairs you with, so a League of Legends
        Duo Pro game means {article(DUO_PRO_TIER)} {DUO_PRO_TIER}, while Duo
        Apex means {article(DUO_APEX_TIER)} {DUO_APEX_TIER}. Coaches carry the
        coach rank on their game’s coaching page and send a sample review before
        they are approved, which is why a Valorant VOD Review hour names{' '}
        {article(VALORANT_COACH_TIER)} {VALORANT_COACH_TIER}. Gamer Girl
        sessions take any rank, because rank is not what is being booked. A
        teammate who stops keeping a verified rank honest loses the account,
        under the <a href="/terms#teammates">teammate terms</a>.
      </p>
    </section>

    <section aria-labelledby="payment-h">
      <h2 id="payment-h">How does Duoly handle your payment details?</h2>
      <p>
        A Duoly payment is one upfront charge through {PAYMENT_PROVIDER}, and
        Duoly never sees or stores a full card number. The card form at checkout
        belongs to {PAYMENT_PROVIDER}, so card data never reaches a Duoly server
        at all. <a href="/privacy">The privacy policy</a> states that payment
        details go straight to the payment provider and that Duoly only sees the
        amount and the method, plus the card brand and the last 4 digits if you
        tick save at checkout.
      </p>
      <p>
        One charge covers the whole order, a game or a coaching hour alike, so
        no stored card is needed to book again. Any {QUANTITY_PERCENT}% quantity
        discount comes off before the charge. Prices are set in euros, and a US
        dollar total adds a {USD_MARGIN_PERCENT}% currency margin, rounded up to
        .99, under the <a href="/terms#payment">payment terms</a>. A refund
        lands in your Duoly balance unless you ask for it back on the card.
      </p>
    </section>

    <section aria-labelledby="conduct-h">
      <h2 id="conduct-h">What are the conduct rules on Duoly?</h2>
      <p>
        The Duoly conduct rules are five promises both sides make, and they sit
        in <a href="/terms#conduct">the terms of service</a>, where they bind
        everyone. Respect comes first: no harassment, hate speech, threats,
        discrimination or sexual content. Nobody may ask for, give or use
        another person’s login, and nobody at Duoly asks for a password. No
        cheating, scripting, exploits or third-party tools a game does not
        allow. No payment arranged outside Duoly. And the rules of the game you
        are playing still apply on top of all of that.
      </p>
      <p>
        Gamer Girl and Social sessions are company and conversation, never
        dating, romantic or sexual services, and a request like that ends the
        session. A {VALORANT_GG_PRICE} Gamer Girl Duo game buys voice company on
        Discord and pays the same {SHARE_PERCENT}% teammate share as any other
        order. It does not buy a private contact. Teammates also sign the
        Teammate Code, published at duoly.gg/rules once a teammate signs in.
      </p>
    </section>

    <section aria-labelledby="report-h">
      <h2 id="report-h">How do you report a problem on Duoly?</h2>
      <p>
        A Duoly report is a form in the order room, and a person at Duoly reads
        every one. <a href="/terms#cancel">The terms</a> treat three cases the
        same way: a no-show, a teammate leaving and toxic behaviour all get
        reported from the order room, a real person reviews the report, and the
        order can be refunded to your Duoly balance. One rule, whether the order
        was a single game or a ten-game bundle.
      </p>
      <p>
        Two things sit behind that. The order chat blocks any message asking for
        a login or an outside payment before it reaches the other person. And a
        teammate payout can be held while a report about the order is reviewed,
        so a disputed order is never paid out first and argued about afterwards.
        Support also answers from the chat bubble and{' '}
        <a href="/contact">the contact form</a>.
      </p>
    </section>

    <section aria-labelledby="data-h">
      <h2 id="data-h">What does Duoly do with the data you give it?</h2>
      <p>
        A Duoly order collects what the session needs and nothing else, and a
        game account password is never one of those things. The order itself
        keeps the game, the service, the rank, the server, your in-game name and
        your note. Your teammate sees a first name, a profile picture, the rank,
        the server, the in-game name, the order note and the chat. Never an
        email address, and never the amount you paid. When an order waits, the
        Duoly bot posts it in the teammate server on Discord with the service,
        rank, server, note and teammate pay, and again no customer name or
        email.
      </p>
      <p>
        <a href="/privacy#rights">The privacy policy</a> lists every GDPR right
        a customer in the EU holds, from access and correction to deletion,
        portability and withdrawing consent, each answered within one month. It
        also sets out how long things are kept: orders and payment records for 7
        years, because Austrian tax law requires it, session chats and reports
        for up to 2 years, and a rejected application for 6 months. Duoly sells
        no data and runs no ad pixel, so every order leaves the same record,
        which is the order itself and nothing sold on.
      </p>
    </section>

    <section aria-labelledby="never-h">
      <h2 id="never-h">What does Duoly never do?</h2>
      <p>
        Duoly is a marketplace for played-together sessions, and that rules five
        things out. Each one is written into{' '}
        <a href="/terms">the terms of service</a>. Account sharing and boosting:
        a session is played together, the teammate stays in a personal client,
        and no password is requested. A guaranteed rank, win or start time: a
        teammate accepts from a queue, and the {SHARE_PERCENT}% teammate share
        is paid for a completed order rather than a won one. Dating, romantic or
        sexual services. Anybody under 18, on either side of a booking. And
        payment arranged off the platform.
      </p>
      <p>
        What the price buys is playing time. A League of Legends Duo Pro game
        buys one game beside {article(DUO_PRO_TIER)} {DUO_PRO_TIER}, with
        Discord voice if you want it, and a {BUNDLE_PERCENTS[2]}% bundle
        discount buys ten of those games more cheaply. Neither one buys a
        result.
      </p>
      <div class="official-grid">
        {NOT_DUOLY.map(([label, detail]) => (
          <div>
            <span class="official-label">{label}</span>
            <span class="official-detail">{detail}</span>
          </div>
        ))}
      </div>
    </section>

    <Faq heading="What do customers ask about Duoly safety?" items={faq} />

    <ClosingCta
      heading="What can you check before you book?"
      text={`All of it. Before you pay, the booking screen shows the price, the ${SHARE_PERCENT}% share the teammate keeps, who operates the site and what happens if the session fails. Everything above comes from the terms, the privacy policy and the imprint, published from ${BUSINESS_LOCATION} under trade register GISA ${BUSINESS.gisa}.`}
      extra={`On a first order, your account stays yours: a session starts with an invite, never a login, and nobody at Duoly asks for a password. Your money stays reversible until the session runs, since cancelling is free until a teammate accepts and an order nobody takes within ${AUTO_CANCEL_MINUTES} minutes refunds itself in full. A session that goes badly has a route out, which is a report from the order room that a person at Duoly reads. None of that buys a result, though. No rank, win or start time is promised at any price, on the cheapest game or the largest bundle. Prices as of ${pricesLabel}.`}
      href="/pricing"
      label={`See prices for ${PLAYABLE_GAMES} games`}
      art={{ src: '/assets/games/league-of-legends.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/how-it-works">How a Duoly booking works step by step</a>
        <a href="/pricing">Every Duoly game, service and price</a>
        <a href="/fees-and-refunds">Duoly fees and refunds in full</a>
        <a href="/about">About Duoly and who runs it</a>
        <a href="/press">Duoly press kit and fact sheet</a>
        <a href="/terms">Full terms of service</a>
        <a href="/privacy">Privacy policy</a>
        <a href="/get-paid-to-play-games">Become a Duoly teammate</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      officialPageSchema(
        path,
        title,
        description,
        CONTENT_DATES[path]!,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

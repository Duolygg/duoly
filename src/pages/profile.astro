---
import ProductLayout from '../layouts/ProductLayout.astro';
import LiveProfile from '../components/account/LiveProfile';
import { accountContext } from '../server/auth/context';
import { publicProfilesEnabled } from '../server/teammates/public-profiles';
import { DiscordResultSchema } from '../contracts/account';
const account = accountContext(Astro.request, Astro.cookies);
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
let identity = null;
try {
  identity = await account.identity();
} catch {
  Astro.response.status = 503;
}
if (!identity && Astro.response.status !== 503)
  return account.redirect('/?signin=1');
const csrf = account.csrf();
const discordParam = DiscordResultSchema.safeParse(
  Astro.url.searchParams.get('discord'),
);
const discordResult = discordParam.success ? discordParam.data : '';
const discordEnabled = !!account.config?.providers.discord;
---

<ProductLayout
  title="Your profile | Duoly"
  viewer={identity?.viewer}
  csrf={csrf}
>
  {identity ? (
    <LiveProfile
      viewer={identity.viewer}
      profile={identity.profile}
      csrf={csrf}
      discord={identity.discord}
      discordResult={discordResult}
      discordEnabled={discordEnabled}
      publicProfilesEnabled={publicProfilesEnabled()}
      client:load
    />
  ) : (
    <section role="alert">
      <h1>Account temporarily unavailable</h1>
      <p>We could not load your profile. Please try again shortly.</p>
    </section>
  )}
</ProductLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Steps from '../components/seo/Steps.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/ai.css';
import { pageViewer } from '../site/viewer';
import { CONTENT_DATES, hubChips, serializeJsonLd } from '../site/seo';
import { AI_ASSISTANTS, AI_PROMPTS, MCP, aiLaunchState } from '../site/ai';
import { calculateQuote } from '../server/pricing';
import { faqSchema } from '../server/seo/offers';
import {
  BUNDLE_PERCENTS as bundle,
  COACHABLE_GAMES,
  PLAYABLE_GAMES,
  SHORT_GAME_PRICE as shortGamePrice,
} from '../server/seo/teammate-facts';
const launch = aiLaunchState();
// Additive related links: game hubs an assistant can be pointed at directly.
const HUB_LINKS = hubChips([
  'apex-legends',
  'overwatch-2',
  'rocket-league',
  'minecraft',
]);
const coachingQuote = calculateQuote(
  { gameId: 'val', serviceId: 'vod', server: 'EU', units: 1 },
  { customerCurrency: 'EUR', eurToUsd: 1 },
);
const coachingPrice = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'EUR',
}).format(coachingQuote.customer.amountMinor / 100);
const { viewer, csrf } = await pageViewer(Astro);
const title = 'Gaming Teammates in AI Assistants | Duoly';
const description =
  'Find gaming teammates and coaching with AI assistants. See Duoly connector status, example prompts and privacy details. Review prices and pay on duoly.gg.';
const faq: [string, string][] = [
  [
    'Can I book through an AI assistant today?',
    launch.showSetup
      ? 'Connect Duoly to Claude, then review the selection and book on duoly.gg.'
      : 'The Duoly AI connection is coming soon, so book directly on duoly.gg for now.',
  ],
  [
    'Do I need a Duoly account to ask for prices?',
    'No, the six public tools need no Duoly login, although your assistant may require a paid plan or an administrator permission.',
  ],
  [
    'Can the assistant pay for my session?',
    'No. Review the service, quantity and final price on duoly.gg, then confirm payment there.',
  ],
  [
    'Does an availability result reserve a teammate?',
    'No, availability is a public signal rather than a reservation, and a teammate accepts each order from the Duoly queue.',
  ],
  [
    'Which games can I ask about?',
    `Ask about ${PLAYABLE_GAMES} games, including Valorant and League of Legends. Coaching covers ${COACHABLE_GAMES}; Social is booked on Duoly.`,
  ],
  [
    'Can I still book without an assistant?',
    'Yes. Choose a game and service directly on duoly.gg; the assistant is optional.',
  ],
  [
    'How many requests can an assistant make?',
    `Step 1 is a search, and rate limits from Duoly sit at ${MCP.rateLimits.minute} requests per minute and ${MCP.rateLimits.day} per day.`,
  ],
  [
    'Are the prices an assistant quotes the real prices?',
    `Yes. For example, get_quote reads the checkout engine, so a Valorant VOD Review reads ${coachingPrice} per hour in both places, before account perks. Coaching has no quantity discount; teammate bundles are priced separately.`,
  ],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing={launch.indexing}
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Duoly in AI assistants', path: '/ai' },
      ]}
    />
    <header class="seo-hero ai-hero">
      <div class="hero-copy">
        <p class="eyebrow">{launch.label}</p>
        <h1>Book a gaming teammate from your AI assistant</h1>
        <p class="lead">
          Tell your AI what you want to play. The Duoly connection finds
          teammates and coaching options, checks prices and prepares your
          booking link. You review and pay on duoly.gg.
        </p>
        <div class="hero-actions">
          <a class="cta" href="/">
            Book on Duoly
          </a>
          <a class="cta-ghost" href="#assistants-h">
            See assistant status
          </a>
        </div>
      </div>
      <aside class="hero-card ai-chat" aria-label="Example conversation">
        <div class="ai-chat-bar" aria-hidden="true">
          <span class="ai-chat-dots">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>Example conversation</span>
        </div>
        <p class="ai-bubble-user">
          Find me a Valorant coach for tonight under 15 euros
        </p>
        <p class="ai-tool">
          <span aria-hidden="true"></span>Checked Duoly
        </p>
        <p class="ai-bubble-bot">This coaching session fits your budget:</p>
        <div class="ai-result">
          <div class="ai-result-head">
            <span class="ai-tag">Valorant</span>
            <span class="ai-tag">Coaching</span>
          </div>
          <h2>Valorant VOD review</h2>
          <div class="ai-result-row">
            <p
              class="ai-chat-price"
              data-price-minor={coachingQuote.customer.amountMinor}
            >
              {coachingPrice} <span>per hour</span>
            </p>
            <a class="btn-sm" href="/?game=val&amp;service=vod#modes-h">
              Open booking link
            </a>
          </div>
          <p class="ai-result-note">
            Base price before account perks. A coach accepts your booking from
            the queue.
          </p>
        </div>
        <div class="ai-composer" aria-hidden="true">
          Ask a follow-up
        </div>
      </aside>
    </header>
    <section aria-labelledby="what-h">
      <h2 id="what-h">What is the Duoly connector for AI assistants?</h2>
      <p>
        The Duoly connector is a Model Context Protocol server at{' '}
        <code>{MCP.endpoint}</code> that lets an AI assistant search the Duoly
        catalog, price a session and build a booking link. No Duoly login is
        needed for the public tools, and no assistant can take a payment.
      </p>
      <p>
        Seven tools cover the whole path from a question to a checkout page.
        Step 1 is a search, step 2 is a real price and step 3 is a link back to
        duoly.gg. For example, a request for a Valorant coach under 15 euros
        returns the {coachingPrice} per hour VOD Review with a booking link
        attached, and a request for a cheap duo returns games from{' '}
        {shortGamePrice}. Prices arrive straight from Duoly, including the{' '}
        {bundle[1]}% quantity discount on five non-coaching units. Rate limits
        sit at {MCP.rateLimits.minute} requests per minute and{' '}
        {MCP.rateLimits.day} per day. The connector supports{' '}
        {MCP.protocolVersions.length} protocol versions, including{' '}
        {MCP.protocolVersions[0]}. See the developer guide for the headers each
        revision requires.
      </p>
    </section>
    <Steps
      heading="How do you book a Duoly session from an AI assistant?"
      steps={[
        'Ask your AI for a game, mode, budget and coaching goal.',
        'Compare teammates and coaches. Check the price and who is online.',
        'Open your booking link, review the details and book on duoly.gg.',
      ]}
    >
      <p>
        Booking from an assistant is a three step conversation that always ends
        on duoly.gg. First, name the game, the mode and a budget. Then let the
        assistant compare services and check who is online. Open the booking
        link and pay on Duoly.
      </p>
      <p>
        Step 3 is where the price becomes final. For example, an assistant
        quoting a Valorant VOD Review at {coachingPrice} per hour is reading the
        same engine the checkout uses, before account perks, and a five-game
        teammate booking includes the {bundle[1]}% quantity discount. A teammate
        or coach then accepts the order from the Duoly queue, so no assistant
        can reserve a person, a time or a rank on your behalf. Coaching has no
        quantity discount. Confirm the voice setup in the order room before
        starting.
      </p>
    </Steps>
    <section aria-labelledby="assistants-h">
      <h2 id="assistants-h">Which AI assistants can reach Duoly today?</h2>
      <p>
        Claude is the one assistant that can reach Duoly today, as a custom
        connector you add yourself.{' '}
        {launch.showSetup
          ? 'Add Duoly to Claude, then ask about your next session.'
          : 'Claude launches first. More assistants are coming soon.'}{' '}
        ChatGPT, Gemini, Perplexity and Mistral Le Chat are listed below as
        coming soon, which means no Duoly connection exists in those apps yet.
      </p>
      <p>
        Duoly ships as a custom connector only. It is not listed in the Claude
        directory or the ChatGPT store. Step 1 of a realistic expectation is
        knowing each person adds the connector by hand. Assistants with
        interactive cards can browse games, compare sessions and open a booking
        link from a card, while plain clients fall back to text and links. For
        example, a card in Claude shows the {coachingPrice} per hour Valorant
        VOD Review beside a booking button. Coaching covers all{' '}
        {COACHABLE_GAMES} games from Duoly. Coaching has no bundle discount.
      </p>
      <p class="ai-dev-note">
        Building your own client? Read the{' '}
        <a href="/developers/mcp">Duoly MCP developer guide</a>.
      </p>
    </section>
    <section aria-labelledby="setup-h">
      <h2 id="setup-h">How do you add Duoly to Claude?</h2>
      <p>
        Duoly is a custom connector you add in Claude. Step 1 opens Settings and
        Connectors. Step 2 adds a connector pointing at{' '}
        <code>{MCP.endpoint}</code>, and step 3 enables Duoly inside a
        conversation. No sign-in is needed, because the six public tools read
        the catalog rather than an account. A paid plan or an administrator
        permission may be required by the assistant, which is a rule from
        Anthropic rather than from Duoly.
      </p>
      {/* A status widget, not prose: ARIA list roles rather than ul/li. The styling
        already sets list-style: none, which strips native list semantics in Safari
        with VoiceOver, so the explicit roles are the reliable announcement here.
        It also keeps the badges and card labels out of the section answer that an
        extractor quotes, which is the prose above and below. */}
      <div class="ai-status" role="list">
        {AI_ASSISTANTS.map((assistant, i) => (
          <div
            class:list={['ai-assistant', { 'is-first': i === 0 }]}
            role="listitem"
          >
            <div class="ai-card-top">
              <div>
                <p class="ai-name">{assistant.name}</p>
                <p>{assistant.detail}</p>
              </div>
              <span class="ai-badge">{assistant.status}</span>
            </div>
            {launch.showSetup && assistant.steps.length > 0 && (
              <ol>
                {assistant.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            )}
          </div>
        ))}
      </div>
      {launch.showSetup && (
        <p class="ai-endpoint">
          Custom connector URL: <code>{MCP.endpoint}</code>
        </p>
      )}
      <p>
        For example, a first conversation can ask for a Valorant coach under 15
        euros and receive the {coachingPrice} per hour VOD Review, using Discord
        voice once the coach accepts the order from the queue.
      </p>
    </section>
    <section aria-labelledby="prompts-h">
      <h2 id="prompts-h">Which prompts get a useful Duoly answer?</h2>
      <p>
        A useful Duoly prompt names the game, the mode and a budget in one
        sentence. Three details change the answer most. First, the game decides
        which services exist. Coaching covers {COACHABLE_GAMES} games, and
        Social is booked on duoly.gg. Second, a budget in euros or dollars lets
        find_session filter rather than guess. Third, a named goal turns a
        teammate search into a coaching search. For example, a request for a
        Valorant coach under 15 euros returns the {coachingPrice} per hour VOD
        Review. A Valorant duo request returns short games from {shortGamePrice}
        . Add a server when ping matters, and a quantity from one to five for an
        exact selection. Five non-coaching units receive {bundle[1]}% off.
      </p>
      <ul class="ai-prompts">
        {AI_PROMPTS.slice(0, 3).map((prompt) => (
          <li class="card">{prompt}</li>
        ))}
      </ul>
      <details class="ai-more-prompts">
        <summary>More prompts</summary>
        <ul class="ai-prompts">
          {AI_PROMPTS.slice(3).map((prompt) => (
            <li class="card">{prompt}</li>
          ))}
        </ul>
      </details>
    </section>
    <section aria-labelledby="tools-h">
      <h2 id="tools-h">Which Duoly tools can an AI assistant call?</h2>
      <p>
        Seven tools are available, and six of them need no account at all. The
        read-only set covers games, services, matching, pricing, availability
        and booking links, and the seventh reads one order when you hand over a
        private code.
      </p>
      <p>
        Two tools do most of the work. First, find_session returns up to three
        matching services with real prices, for example the {coachingPrice} per
        hour Valorant VOD Review or a {shortGamePrice} Skirmish game. Second,
        get_quote prices one exact selection, including a {bundle[1]}% discount
        on five non-coaching units. Search with a game before selecting a
        service; order status uses its private code instead. get_availability
        reports public online counts from Duoly without reserving anybody.
      </p>
      <ul class="ai-tools">
        <li>
          <code>list_games</code>: Browse supported games.
        </li>
        <li>
          <code>list_services</code>: Compare services and starting prices.
        </li>
        <li>
          <code>find_session</code>: Find teammates or coaching within your
          budget.
        </li>
        <li>
          <code>get_quote</code>: Check a selected session’s base price.
        </li>
        <li>
          <code>get_availability</code>: Check public online signals without
          reserving a teammate.
        </li>
        <li>
          <code>create_booking_link</code>: Open your selection on Duoly to
          review and book.
        </li>
        <li>
          <code>get_order_status</code>: Check one order’s progress with its
          private status code.
        </li>
      </ul>
    </section>
    <section aria-labelledby="status-code-h">
      <h2 id="status-code-h">How does an order status code work?</h2>
      <p>
        An order status code is a private <code>dos_</code> token generated in
        your own order room, and nothing else unlocks order data. Step 1 is
        generating the code, step 2 is pasting the code into the conversation,
        and revoking the code in the same room ends the access immediately.
      </p>
      <p>
        A status code expires after seven days. Each request reads the current
        order status and can never change or cancel an order. For example, a
        code shared with Claude returns the current acceptance, the teammate
        display names, the team seat progress and the next step, and nothing
        about payment. A code covers one order only, so a second booking needs a
        second code. Prices stay public rather than private, which is why a
        public quote needs no code at all. Keep the code out of screenshots,
        shared links and conversation logs.
      </p>
    </section>
    <section aria-labelledby="boundaries-h">
      <h2 id="boundaries-h">
        What can an AI assistant do, and what stays with you?
      </h2>
      <p>
        An AI assistant is a research layer over the Duoly catalog. First,
        searching and link building happen inside the conversation. Second,
        paying and creating an order stay on duoly.gg. Step 1 of staying safe is
        never sharing a password. For example, Valorant coaching reads{' '}
        {coachingPrice} per hour from Duoly, with no coaching quantity discount.
      </p>
      <div class="ai-boundaries">
        <div class="card">
          <p class="ai-card-title">What the AI will do</p>
          <ul>
            <li>Search games and bookable services.</li>
            <li>Compare prices and public availability.</li>
            <li>Prepare a link to book on Duoly.</li>
            <li>Check one order when you share its private status code.</li>
          </ul>
        </div>
        <div class="card">
          <p class="ai-card-title">What the AI cannot do</p>
          <ul>
            <li>Pay for a session or create an order.</li>
            <li>See your Duoly account, card or private order history.</li>
            <li>
              Guarantee a match time, a teammate rank or a result in your game.
            </li>
          </ul>
        </div>
        <div class="card">
          <p class="ai-card-title" id="privacy-h">
            What your AI shares
          </p>
          <ul>
            <li>Your search choices such as game, service, rank and budget.</li>
            <li>
              A private status code, only if you choose to share it. It lets
              your assistant read that order’s progress and teammate display
              names.
            </li>
            <li>
              Never share passwords or payment details with your assistant.
            </li>
          </ul>
        </div>
      </div>
      <p>
        Social sessions are booked on duoly.gg for now. Play on your own game
        account and follow each game’s rules. Read our{' '}
        <a href="/terms">booking and refund terms</a> and{' '}
        <a href="/privacy">privacy policy</a>.
      </p>
    </section>
    <section aria-labelledby="trust-h">
      <h2 id="trust-h">
        How can an assistant check that Duoly is a real company?
      </h2>
      <p>
        Duoly is a sole proprietorship registered in Austria, and every fact an
        assistant needs is on a page rather than implied. First,{' '}
        <a href="/about">about Duoly</a> names the operator, the Austrian trade
        register number and the four-step rank check a teammate passes, and
        states plainly that duoly.gg is a gaming service rather than the Duoly
        couples app on Google Play. Second,{' '}
        <a href="/fees-and-refunds">Duoly fees and refunds</a> gives the whole
        price model and quotes the refund rules from the terms, so a{' '}
        {coachingPrice} coaching hour and a {shortGamePrice} game both carry 0%
        in added fees. Third, <a href="/pricing.md">pricing.md</a> carries every
        price in the catalog as plain text, generated from the pricing engine on
        each deploy. Step 1 for a cautious reader is the imprint, linked from
        about Duoly, where Austrian law requires the operator details. For
        example, an assistant quoting a price can cite pricing.md and a reader
        can check the same figure at checkout using Stripe.
      </p>
    </section>
    <Faq
      heading="What do players ask about booking through an AI assistant?"
      items={faq}
    />
    <ClosingCta
      heading="Your next teammate is on Duoly"
      text="Booking on Duoly is the same destination an assistant prepares for you. Choose your game, compare services and review the price before paying. Nothing is charged until you confirm on duoly.gg."
      extra={`Three facts close the loop. First, the price an assistant quotes is the engine price before account perks, so a Valorant VOD Review reads ${coachingPrice} per hour in both places, and a short Valorant game reads ${shortGamePrice}. Second, a teammate accepts the order from the Duoly queue rather than receiving an assignment, which is why no assistant promises a time or a rank. Third, Social sessions are booked on duoly.gg for now. Step 1 is picking a game from the ${PLAYABLE_GAMES} in the catalog, and coaching covers ${COACHABLE_GAMES} of them using Discord voice and screen share. For example, a five game bundle from Duoly carries a ${bundle[1]}% discount, and ten games carry ${bundle[2]}%.`}
      href="/"
      label="Book on Duoly"
    />
    <nav class="related" aria-label="Related pages">
      <h2>Keep exploring</h2>
      <div class="chips">
        <a href="/games">Browse games and coaching</a>
        <a href="/developers/mcp">MCP developer documentation</a>
        <a href="/compare/metafy">Duoly compared with Metafy</a>
        <a href="/compare/queueup">Duoly compared with QueueUp</a>
        <a href="/contact">Contact Duoly</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: new URL('/ai', Astro.site!).href,
      dateModified: CONTENT_DATES['/ai'],
    })}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, '/ai', Astro.site!))}
  />
</SiteLayout>

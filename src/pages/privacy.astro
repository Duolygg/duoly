---
import SiteLayout from '../layouts/SiteLayout.astro';
import LegalPage from '../design-reference/components/LegalPage.jsx';
import { PRIVACY } from '../design-reference/lib/legal';
import { pageViewer } from '../site/viewer';
const { viewer, csrf } = await pageViewer(Astro);
---

<SiteLayout title="Privacy | Duoly" viewer={viewer} csrf={csrf}>
  <LegalPage doc={PRIVACY} chrome={false} client:load />
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductLayout from '../layouts/ProductLayout.astro';
import LiveDashboard from '../components/account/LiveDashboard';
import { accountContext } from '../server/auth/context';
import { loadProView } from '../server/pro/status';
import { viewerCurrency } from '../server/currency';
const account = accountContext(Astro.request, Astro.cookies);
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
let identity = null;
try {
  identity = await account.identity();
} catch {
  Astro.response.status = 503;
}
if (!identity && Astro.response.status !== 503)
  return account.redirect('/?signin=1');
if (identity && identity.viewer.role !== 'customer')
  return account.redirect(
    identity.viewer.role === 'admin' ? '/admin' : '/teammate',
  );
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
const csrf = account.csrf();
// Duoly PRO card state (null while PRO_ENABLED is off).
const pro = identity
  ? await loadProView(account.client, identity.viewer.role)
  : null;
const proWelcome = Astro.url.searchParams.get('pro') === 'welcome';
// Same currency as the homepage: the account's, then the one picked (or auto-detected) here.
const { cur, usdRate } = await viewerCurrency(
  Astro.cookies,
  identity?.profile.currency,
);
---

{identity ? (
  <SiteLayout
    title="Your dashboard | Duoly"
    viewer={identity.viewer}
    csrf={csrf}
    bare
  >
    <LiveDashboard
      viewer={identity.viewer}
      csrf={csrf}
      pro={pro}
      proWelcome={proWelcome}
      cur={cur}
      usdRate={usdRate}
      client:load
    />
  </SiteLayout>
) : (
  <ProductLayout title="Your dashboard | Duoly">
    <section role="alert">
      <h1>Account temporarily unavailable</h1>
      <p>We could not load your account. Please try again shortly.</p>
    </section>
  </ProductLayout>
)}

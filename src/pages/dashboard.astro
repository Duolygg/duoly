---
import ProductLayout from '../layouts/ProductLayout.astro';
import CustomerOrders from '../components/account/CustomerOrders';
import { accountContext } from '../server/auth/context';
const account = accountContext(Astro.request, Astro.cookies);
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
let identity = null;
try {
  identity = await account.identity();
} catch {
  Astro.response.status = 503;
}
if (!identity && Astro.response.status !== 503)
  return account.redirect('/login');
if (identity && identity.viewer.role !== 'customer')
  return account.redirect(
    identity.viewer.role === 'admin' ? '/admin' : '/teammate',
  );
for (const [name, value] of account.headers)
  Astro.response.headers.set(name, value);
const csrf = account.csrf();
---

<ProductLayout
  title="Your dashboard | Duoly"
  viewer={identity?.viewer}
  csrf={csrf}
>
  {identity ? (
    <CustomerOrders name={identity.viewer.name} client:load />
  ) : (
    <section role="alert">
      <h1>Account temporarily unavailable</h1>
      <p>We could not load your account. Please try again shortly.</p>
    </section>
  )}
</ProductLayout>

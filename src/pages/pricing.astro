---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/official.css';
import { pageViewer } from '../site/viewer';
import {
  CONTENT_DATES,
  hubChips,
  serializeJsonLd,
  REPORT_PATH,
} from '../site/seo';
import { COMPETITOR_COUNT, HOURLY_COACHING } from '../server/seo/price-report';
import { faqSchema } from '../server/seo/offers';
import { officialPageSchema } from '../server/seo/official';
import { BUSINESS_LOCATION } from '../site/entity';
import {
  COACHABLE_GAMES,
  COACHING_PRICE,
  SHORT_GAME_PRICE,
} from '../server/seo/teammate-facts';
import {
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED,
  CATALOG_PRICES_UPDATED_LABEL,
  COACHING_HOUR,
  FIVE_COACHING_HOURS,
  FIVE_GAMES,
  MAX_QUANTITY,
  QUANTITY_PERCENT,
  SINGLE_GAME,
  TEN_GAME_BUNDLE,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';
import {
  CATEGORY_HEADINGS,
  CHEAPEST,
  DEAREST,
  PRICE_TABLE,
  ROW_COUNT,
  providerTier,
  spotPrice,
} from '../server/seo/price-table';
import { CATALOG_GAMES, MAX_TEAMMATES } from '../server/seo/booking';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/pricing';
const title = 'Duoly Pricing: Every Game, Service and Price | Duoly';
const description = `Every Duoly price in one table: ${ROW_COUNT} bookable services across ${CATALOG_GAMES} games, from ${SHORT_GAME_PRICE}, with the bundle discounts and the coaching rate, read from the pricing engine.`;
const HUB_LINKS = hubChips([
  'league-of-legends',
  'valorant',
  'counter-strike-2',
  'rocket-league',
]);
const CATALOG_YEAR = CATALOG_PRICES_UPDATED.slice(0, 4);
const pricesLabel = CATALOG_PRICES_UPDATED_LABEL;
/** Worked rank spread for the paragraph about rank, from the engine. */
const LOL_PRO_IRON = spotPrice('lol', 'duo2', 'Iron');
const LOL_PRO_TOP = spotPrice('lol', 'duo2', 'Challenger');
const LOL_NORMAL = spotPrice('lol', 'norm');
const VALORANT_COACH_TIER = providerTier('val', 'vod');
const LOL_COACH_TIER = providerTier('lol', 'vod');
/** The two ends of the catalog, named with the service each one belongs to. */
const CHEAPEST_LABEL = `${CHEAPEST.game.name} ${CHEAPEST.row.title}`;
const DEAREST_SINGLE = DEAREST.row;
/** How a price cell reads: one figure, or the rank spread behind two. */
const priceCell = (row: (typeof PRICE_TABLE)[number]['rows'][number]) =>
  row.from === row.to
    ? `${row.from} per ${row.unit}`
    : `${row.from} per ${row.unit} at ${row.fromRank}, up to ${row.to} at ${row.toRank}`;
const coversCell = (seats: number) =>
  seats > 1 ? `${seats} hired teammates` : '1 teammate';
/** Only the categories a game really sells, so no empty group header renders. */
const groupsOf = (game: (typeof PRICE_TABLE)[number]) =>
  CATEGORY_HEADINGS.flatMap(([category, heading]) => {
    const rows = game.rows.filter((row) => row.category === category);
    return rows.length ? [{ heading, rows }] : [];
  });

const faq: [string, string][] = [
  [
    'What is the cheapest session on Duoly?',
    `${CHEAPEST.row.from} for a ${CHEAPEST_LABEL}, which is the lowest listed price in the catalog as of ${pricesLabel}. Coaching starts and stops at ${COACHING_PRICE} per hour or game in all ${COACHABLE_GAMES} coachable titles.`,
  ],
  [
    'Does Duoly charge a booking fee or a service fee?',
    `No. The total shown before checkout is the amount charged, with no booking fee, no payment surcharge and no subscription. Duoly’s own cut comes out of the same figure as commission rather than being added on top, so ${SINGLE_GAME.short} costs ${SINGLE_GAME.total} and nothing else.`,
  ],
  [
    'Do bundle discounts apply to coaching?',
    `No. Coaching never takes a quantity discount, so ${MAX_QUANTITY} lessons cost ${FIVE_COACHING_HOURS.total} at ${COACHING_HOUR.total} each. Teammate bundles of ${BUNDLE_SIZES.join(', ')} units take ${BUNDLE_PERCENTS[0]}%, ${BUNDLE_PERCENTS[1]}% and ${BUNDLE_PERCENTS[2]}% off.`,
  ],
  [
    'Why do two players pay different prices for the same service?',
    `Because rank sets the price of ranked play. Step 1 of a quote is the service, Step 2 is the rank, and a higher lobby needs a stronger teammate, so the catalog prices each rank separately. Unranked modes and coaching stay flat at every rank, for example ${COACHING_PRICE} per coaching hour in all ${COACHABLE_GAMES} coachable games.`,
  ],
  [
    'Why does a team fill cost so much more than a duo?',
    `Because the price covers several hired players. A team service books up to ${MAX_TEAMMATES} teammates on one order, so ${DEAREST_SINGLE.title} in ${DEAREST.game.name} at ${DEAREST_SINGLE.to} pays ${DEAREST_SINGLE.seats} of them rather than one.`,
  ],
  [
    'Are these prices in euros or US dollars?',
    `Euros. Every figure on this page is the euro price. A US dollar total is the euro price converted at the day’s European Central Bank rate plus a ${USD_MARGIN_PERCENT}% currency margin, rounded up to .99.`,
  ],
  [
    'Where is the price for my exact rank?',
    `On the game’s own page, and in full at duoly.gg/pricing.md, which lists every rank rather than a range. This table gives the cheapest and the dearest price each service reaches, for example ${LOL_PRO_IRON} at Iron up to ${LOL_PRO_TOP} at Challenger for a League of Legends Duo Pro game.`,
  ],
  [
    'Can a Duoly price change after I book?',
    `Prices can change over time, and an order already placed keeps the price paid. The terms say so directly, and this table is regenerated from the pricing engine on every deploy, with catalog prices read on ${pricesLabel}.`,
  ],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page official-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Pricing', path },
      ]}
    />
    <SeoHero
      eyebrow="Pricing"
      h1="Duoly pricing"
      lead={`Every bookable Duoly service and what it charges, in one table. ${ROW_COUNT} services across ${CATALOG_GAMES} games, read from the pricing engine the checkout charges on rather than typed by hand.`}
      price={`${SINGLE_GAME.short}: ${SINGLE_GAME.total}`}
      cta={{ href: '#table-h', label: 'Jump to the price table' }}
      secondary={{ href: '/fees-and-refunds', label: 'Fees and refunds' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        {
          src: '/assets/games/counter-strike-2.png',
          alt: 'Counter-Strike 2 game art',
        },
      ]}
      chip={`Sessions from ${SHORT_GAME_PRICE}`}
      facts={[
        'One payment, no fee on top',
        `Coaching flat at ${COACHING_PRICE}`,
        `Bundles up to ${BUNDLE_PERCENTS[2]}% off`,
        'Prices set in euros',
      ]}
      note={`Catalog prices as of ${pricesLabel}, generated from the Duoly pricing engine.`}
    />

    <section aria-labelledby="cost-h">
      <h2 id="cost-h">How much does a Duoly session cost?</h2>
      <p>
        A Duoly session costs the published price for the exact selection, paid
        once, with nothing added on top. Teammate games start at{' '}
        {CHEAPEST.row.from} for a {CHEAPEST_LABEL} and reach{' '}
        {spotPrice('cs2', 'duo3', 'FACEIT Level 10')} for a Counter-Strike 2
        FACEIT Duo at the top FACEIT level. Coaching is flat at {COACHING_PRICE}{' '}
        per hour or game in all {COACHABLE_GAMES} coachable titles, with no rank
        multiplier at all. Team fills cover several hired teammates in one
        price, so a League of Legends Clash Roster pays four players rather than
        one. Step 1 for a real total is picking the game and the service,
        because those two decide almost everything else. For example,{' '}
        <a href={SINGLE_GAME.href}>a {SINGLE_GAME.short} order</a> costs{' '}
        {SINGLE_GAME.total} in {CATALOG_YEAR}, {MAX_QUANTITY} of the same game
        take {QUANTITY_PERCENT}% off and a {BUNDLE_SIZES[2]} game bundle takes{' '}
        {BUNDLE_PERCENTS[2]}% off. Every figure on this page is read from
        Duoly’s own pricing engine, the same code the checkout charges on.
      </p>
    </section>

    <section aria-labelledby="discount-h">
      <h2 id="discount-h">Which Duoly discounts come off automatically?</h2>
      <p>
        A Duoly discount is a quantity discount, and two of them exist, both
        applied in the checkout rather than given on request. Step 1 is choosing
        the tab, because the quantity picker and the Bundles tab are separate
        controls that never stack. The picker offers one to {MAX_QUANTITY} games
        or hours, and {MAX_QUANTITY} units take {QUANTITY_PERCENT}% off, so{' '}
        {FIVE_GAMES.short} costs {FIVE_GAMES.total} and saves {FIVE_GAMES.saved}{' '}
        against five single games. The Bundles tab sells a game’s main service
        in packs of {BUNDLE_SIZES.join(', ')} units at {BUNDLE_PERCENTS[0]}%,{' '}
        {BUNDLE_PERCENTS[1]}% and {BUNDLE_PERCENTS[2]}% off, which makes a{' '}
        {BUNDLE_SIZES[2]} game bundle the largest discount Duoly gives in{' '}
        {CATALOG_YEAR} at {TEN_GAME_BUNDLE.total}. A bundle always covers one
        teammate rather than a group. Coaching never takes a quantity discount
        at any size, so {MAX_QUANTITY} coaching hours cost exactly{' '}
        {MAX_QUANTITY} times one hour. No code and no newsletter is
        needed, because a discount is read from Duoly’s pricing engine at
        checkout.
      </p>
    </section>

    <section aria-labelledby="rank-h">
      <h2 id="rank-h">How does rank change a Duoly price?</h2>
      <p>
        Rank changes the price of ranked play only, and a lower rank pays less
        than a higher one. The reason is the teammate, because a higher lobby
        needs a stronger player and the catalog therefore prices every rank
        separately. A League of Legends Duo Pro game is {LOL_PRO_IRON} at Iron
        and {LOL_PRO_TOP} at Challenger, which is one service at two ends of the
        same ladder. Everything unranked stays flat, so a Normal Draft game is{' '}
        {LOL_NORMAL} at every rank and a {COACHING_PRICE} coaching hour never
        moves at all. Step 1 for an exact figure is opening{' '}
        <a href="/games">the game page</a>, which lists the price for each rank
        in full. For example, the table below gives the cheapest and the dearest
        price a service reaches in {CATALOG_YEAR}, so a Gold player reads a
        figure between the two. According to{' '}
        <a href="/terms#booking">Duoly’s booking terms</a>, picking the rank you
        really have matters, because a wrong rank can make a session impossible
        to play and is not a reason for a refund.
      </p>
    </section>

    <section aria-labelledby="table-h">
      <h2 id="table-h">What does every Duoly game and service cost?</h2>
      <p>
        The Duoly price table below is the whole catalog: {CATALOG_GAMES} games,{' '}
        {ROW_COUNT} bookable services and what each one charges in{' '}
        {CATALOG_YEAR}. Step 1 is finding the game in a group header, then the
        category underneath, which is one of{' '}
        {CATEGORY_HEADINGS.map(([, heading]) => heading.toLowerCase()).join(
          ', ',
        )}
        . Read the price column, where a flat service shows one figure and a
        rank-priced service shows the cheapest and the dearest price with the
        rank each one belongs to. Read the covers column, because a team fill
        price pays several hired players rather than one. For example, a{' '}
        {COACHING_PRICE} VOD Review hour is the same figure in every coachable
        game, which is why coaching needs no rank column at all. According to
        the pricing engine this table is generated from, a service name in the
        first column opens a checkout prefilled with that exact game and
        service, with Discord voice as an option.
      </p>
      <div class="official-table-wrap">
        <table class="official-table official-prices">
          <caption class="sr-only">
            {`Every Duoly game and bookable service with its price, read from the pricing engine on ${pricesLabel}`}
          </caption>
          <thead>
            <tr>
              <th scope="col">Service</th>
              <th scope="col">Plays with</th>
              <th scope="col">Covers</th>
              <th scope="col">Price</th>
            </tr>
          </thead>
          <tbody>
            {PRICE_TABLE.map((game) => (
              <>
                <tr class="official-group">
                  <th colspan="4" scope="colgroup">
                    {game.name}
                    {game.hubPath && (
                      <a href={game.hubPath}>{game.name} page</a>
                    )}
                  </th>
                </tr>
                {groupsOf(game).map((group) => (
                  <>
                    <tr class="official-sub">
                      <th colspan="4" scope="colgroup">
                        {group.heading}
                      </th>
                    </tr>
                    {group.rows.map((row) => (
                      <tr>
                        <th scope="row">
                          <a href={row.href}>{row.title}</a>
                        </th>
                        <td class="official-tier">{row.tier}</td>
                        <td>{coversCell(row.seats)}</td>
                        <td class="official-price">{priceCell(row)}</td>
                      </tr>
                    ))}
                  </>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <p class="official-table-note">
        Catalog prices as of{' '}
        <time datetime={CATALOG_PRICES_UPDATED}>{pricesLabel}</time>. Each
        service name opens the checkout with that game and service prefilled.
        For the price at one exact rank, open <a href="/games">the game page</a>{' '}
        or <a href="/pricing.md">pricing.md</a>, which lists every rank as plain
        text.
      </p>
    </section>

    <section aria-labelledby="coaching-h">
      <h2 id="coaching-h">How much does Duoly coaching cost?</h2>
      <p>
        Duoly coaching costs {COACHING_PRICE} per hour or per game, the same
        figure in all {COACHABLE_GAMES} coachable titles. The format changes
        rather than the price: a Play and Learn session is coaching while you
        play, a VOD Review is an hour spent on a recording you upload, and a
        course such as Valorant Aim and Crosshair is an hour on a single skill.
        Coaching takes no quantity discount at any size, so {MAX_QUANTITY} hours
        cost {FIVE_COACHING_HOURS.total} rather than less. A coach is listed at
        the coach rank the game’s own <a href="/coaching">coaching page</a>{' '}
        names, for example {VALORANT_COACH_TIER} in Valorant and{' '}
        {LOL_COACH_TIER} in League of Legends. Step 1 for a lesson is picking
        the format, because the price is already decided. For example,{' '}
        <a href={COACHING_HOUR.href}>a {COACHING_HOUR.short}</a> runs using
        Discord screen share and still costs {COACHING_HOUR.total} at every rank
        in {CATALOG_YEAR}. For a price outside Duoly, our{' '}
        <a href={REPORT_PATH}>2026 gaming coaching and teammate price report</a>{' '}
        puts the median coaching hour at {HOURLY_COACHING.median} across{' '}
        {HOURLY_COACHING.count} rates read from {COMPETITOR_COUNT} platforms.
      </p>
    </section>

    <section aria-labelledby="currency-h">
      <h2 id="currency-h">Does Duoly charge in euros or US dollars?</h2>
      <p>
        A Duoly price is set in euros and charged in euros or US dollars,
        whichever the customer picks at checkout. Every figure on this page is a
        euro price, because the whole catalog is priced in euros. According to{' '}
        <a href="/terms#payment">Duoly’s payment terms</a>, a dollar total is
        the euro price converted at the day’s European Central Bank rate plus a{' '}
        {USD_MARGIN_PERCENT}% currency margin, rounded up to .99, so a dollar
        figure sits a few cents above a plain mid-market conversion. A bank can
        add a foreign currency handling fee of its own, which Duoly neither sets
        nor receives. Step 1 for a dollar total is switching the currency, which
        the site remembers for a year. For example, a {SINGLE_GAME.total} game
        and a {COACHING_PRICE} coaching hour both convert the same way in{' '}
        {CATALOG_YEAR}. The rate itself comes from a public European Central
        Bank feed, and no personal data is sent there.
      </p>
    </section>

    <section aria-labelledby="assistant-h">
      <h2 id="assistant-h">
        Where can an AI assistant read the same Duoly prices?
      </h2>
      <p>
        Duoly publishes one catalog three times, all from a single pricing
        engine, so a reader and an assistant never see different numbers.{' '}
        <a href="/pricing.md">Duoly.gg/pricing.md</a> is the whole price list as
        plain markdown, carrying the price for every rank rather than a range,
        generated on each deploy. The{' '}
        <a href="/developers/mcp">Duoly MCP server</a> answers get_quote and
        find_session with a calculated price for a selection, which is the same
        engine call the table above makes. Every game page carries the per-rank
        price list for that title. Step 1 for an assistant is calling
        find_session, because a quote needs a game and a service first. For
        example, a {SINGLE_GAME.total} {SINGLE_GAME.short} reads identically on
        this page, in pricing.md and from an assistant{' '}
        <a href="/ai">using Claude</a> in {CATALOG_YEAR}. According to{' '}
        <a href="/terms#payment">the Duoly terms</a>, a price can change over
        time, and an order already placed keeps the price paid.
      </p>
    </section>

    <Faq heading="What do customers ask about Duoly prices?" items={faq} />

    <ClosingCta
      heading="Found your price?"
      text={`Every figure above comes from the Duoly pricing engine behind checkout, operated from ${BUSINESS_LOCATION}. Open your game, pick the rank you really have and read the total before paying anything.`}
      extra={`Three rules cover the whole table. One upfront payment and no fee on top, so ${SINGLE_GAME.short} is ${SINGLE_GAME.total}. Discounts are automatic: ${QUANTITY_PERCENT}% at ${MAX_QUANTITY} units and up to ${BUNDLE_PERCENTS[2]}% on a ${BUNDLE_SIZES[2]} unit bundle, with coaching flat at ${COACHING_PRICE} in all ${COACHABLE_GAMES} coachable games. Rank moves ranked play only, so the two figures in a price cell are the ends of one ladder and your own rank sits between them. For example, ${TEN_GAME_BUNDLE.short} costs ${TEN_GAME_BUNDLE.total} in ${CATALOG_YEAR} and saves ${TEN_GAME_BUNDLE.saved}, and catalog prices were read on ${pricesLabel}.`}
      href="/how-it-works"
      label="See how a booking works"
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/how-it-works">How a Duoly booking works step by step</a>
        <a href="/fees-and-refunds">Duoly fees and refunds in full</a>
        <a href="/trust-and-safety">How Duoly checks players and payments</a>
        <a href="/pricing.md">Every price as plain text</a>
        <a href="/coaching">Coaching prices by game</a>
        <a href="/about">About Duoly and who runs it</a>
        <a href="/press">Duoly press kit and fact sheet</a>
        <a href="/compare/e-pal">Duoly compared with E-Pal</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      officialPageSchema(
        path,
        title,
        description,
        CONTENT_DATES[path]!,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

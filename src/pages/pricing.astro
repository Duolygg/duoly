---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/official.css';
import { pageViewer } from '../site/viewer';
import {
  CONTENT_DATES,
  hubChips,
  serializeJsonLd,
  REPORT_PATH,
} from '../site/seo';
import { COMPETITOR_COUNT, HOURLY_COACHING } from '../server/seo/price-report';
import { faqSchema } from '../server/seo/offers';
import { officialPageSchema } from '../server/seo/official';
import { BUSINESS_LOCATION } from '../site/entity';
import {
  COACHABLE_GAMES,
  COACHING_PRICE,
  SHORT_GAME_PRICE,
} from '../server/seo/teammate-facts';
import {
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED,
  CATALOG_PRICES_UPDATED_LABEL,
  COACHING_HOUR,
  FIVE_COACHING_HOURS,
  FIVE_GAMES,
  MAX_QUANTITY,
  QUANTITY_PERCENT,
  SINGLE_GAME,
  TEN_GAME_BUNDLE,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';
import {
  CATEGORY_HEADINGS,
  CHEAPEST,
  DEAREST,
  PRICE_TABLE,
  ROW_COUNT,
  providerTier,
  spotPrice,
} from '../server/seo/price-table';
import { CATALOG_GAMES } from '../server/seo/booking';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/pricing';
const title = 'Duoly Pricing: Every Game, Service and Price | Duoly';
const description = `Every Duoly price in one table: ${ROW_COUNT} bookable services across ${CATALOG_GAMES} games, from ${SHORT_GAME_PRICE}, with the bundle discounts, the coaching rate and what each service covers.`;
const HUB_LINKS = hubChips([
  'league-of-legends',
  'valorant',
  'counter-strike-2',
  'rocket-league',
]);
const CATALOG_YEAR = CATALOG_PRICES_UPDATED.slice(0, 4);
const pricesLabel = CATALOG_PRICES_UPDATED_LABEL;
/** Worked rank spread for the paragraph about rank, from the engine. */
const LOL_PRO_IRON = spotPrice('lol', 'duo2', 'Iron');
const LOL_PRO_TOP = spotPrice('lol', 'duo2', 'Challenger');
const LOL_NORMAL = spotPrice('lol', 'norm');
const VALORANT_COACH_TIER = providerTier('val', 'vod');
const LOL_COACH_TIER = providerTier('lol', 'vod');
/** The two ends of the catalog, named with the service each one belongs to. */
const CHEAPEST_LABEL = `${CHEAPEST.game.name} ${CHEAPEST.row.title}`;
const DEAREST_SINGLE = DEAREST.row;
/** How a price cell reads: one figure, or the rank spread behind two. */
const priceCell = (row: (typeof PRICE_TABLE)[number]['rows'][number]) =>
  row.from === row.to
    ? `${row.from} per ${row.unit}`
    : `${row.from} per ${row.unit} at ${row.fromRank}, up to ${row.to} at ${row.toRank}`;
const coversCell = (seats: number) =>
  seats > 1 ? `${seats} hired teammates` : '1 teammate';
/** Only the categories a game really sells, so no empty group header renders. */
const groupsOf = (game: (typeof PRICE_TABLE)[number]) =>
  CATEGORY_HEADINGS.flatMap(([category, heading]) => {
    const rows = game.rows.filter((row) => row.category === category);
    return rows.length ? [{ heading, rows }] : [];
  });

const faq: [string, string][] = [
  [
    'What is the cheapest session on Duoly?',
    `${CHEAPEST.row.from} for a ${CHEAPEST_LABEL}, the lowest catalog price on ${pricesLabel}.`,
  ],
  [
    'Does Duoly charge a booking fee or a service fee?',
    `No, you pay the total shown before checkout, with no booking fee, surcharge or subscription, because Duoly takes its commission from that amount.`,
  ],
  [
    'Do bundle discounts apply to coaching?',
    `Coaching has no quantity discount. For example, ${FIVE_COACHING_HOURS.label} cost ${FIVE_COACHING_HOURS.total}. Bundles apply to each game's main teammate service: ${BUNDLE_SIZES.join(', ')} units take ${BUNDLE_PERCENTS[0]}%, ${BUNDLE_PERCENTS[1]}% and ${BUNDLE_PERCENTS[2]}% off.`,
  ],
  [
    'Why do two players pay different prices for the same service?',
    `Ranked services charge by your own rank, while unranked modes and coaching hold one price at every rank.`,
  ],
  [
    'Why does a team fill cost so much more than a duo?',
    `A fill pays several hired players: ${DEAREST_SINGLE.title} in ${DEAREST.game.name} covers ${DEAREST_SINGLE.seats} players at ${DEAREST_SINGLE.to}.`,
  ],
  [
    'Are these prices in euros or US dollars?',
    `Euros, and a dollar total uses the daily European Central Bank rate plus ${USD_MARGIN_PERCENT}%, rounded up to .99.`,
  ],
  [
    'Where is the price for my exact rank?',
    `Open your game page, or duoly.gg/pricing.md for every rank as plain text, because this table shows only the lowest and highest price of each service.`,
  ],
  [
    'Can a Duoly price change after I book?',
    `An order already placed keeps the price paid, and future bookings use the current catalog price, as stated in the terms.`,
  ],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page official-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Pricing', path },
      ]}
    />
    <SeoHero
      eyebrow="Pricing"
      h1="Duoly pricing"
      lead={`Every bookable Duoly service and what it charges, in one table: ${ROW_COUNT} services across ${CATALOG_GAMES} games. Each figure here is the figure checkout charges, with nothing added on top.`}
      price={`${SINGLE_GAME.short}: ${SINGLE_GAME.total}`}
      cta={{ href: '#table-h', label: 'Jump to the price table' }}
      secondary={{ href: '/fees-and-refunds', label: 'Fees and refunds' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        {
          src: '/assets/games/counter-strike-2.png',
          alt: 'Counter-Strike 2 game art',
        },
      ]}
      chip={`Sessions from ${SHORT_GAME_PRICE}`}
      facts={[
        'One payment, no fee on top',
        `Coaching flat at ${COACHING_PRICE}`,
        `Bundles up to ${BUNDLE_PERCENTS[2]}% off`,
        'Prices set in euros',
      ]}
      note={`Catalog prices as of ${pricesLabel}.`}
    />

    <section aria-labelledby="cost-h">
      <h2 id="cost-h">How much does a Duoly session cost?</h2>
      <p>
        A Duoly session costs the published price for the exact selection, paid
        once, with nothing added on top. Teammate games run from{' '}
        {CHEAPEST.row.from} for a {CHEAPEST_LABEL} up to{' '}
        {spotPrice('cs2', 'duo3', 'FACEIT Level 10')} for a Counter-Strike 2
        FACEIT Duo at the top level. Coaching is flat at {COACHING_PRICE} per
        hour or game in all {COACHABLE_GAMES} coachable titles, with no rank
        multiplier at all. A team fill pays several hired players out of one
        price, which is why a League of Legends Clash Roster costs what it does.
      </p>
      <p>
        The game and the service decide almost everything else, so start there.{' '}
        <a href={SINGLE_GAME.href}>A {SINGLE_GAME.short} order</a> is{' '}
        {SINGLE_GAME.total}; {MAX_QUANTITY} of the same game take{' '}
        {QUANTITY_PERCENT}% off, and a {BUNDLE_SIZES[2]} game bundle takes{' '}
        {BUNDLE_PERCENTS[2]}% off. Every figure in the table below is the one
        checkout would charge today, in {CATALOG_YEAR}.
      </p>
    </section>

    <section aria-labelledby="discount-h">
      <h2 id="discount-h">Which Duoly discounts come off automatically?</h2>
      <p>
        Every Duoly discount is a quantity discount, there are two of them, and
        both come off in the checkout without a code or a newsletter signup.
        Which tab you open decides which one you get: the quantity picker and
        the Bundles tab are separate controls, and they never stack.
      </p>
      <p>
        The picker runs from one to {MAX_QUANTITY} games or hours, where{' '}
        {MAX_QUANTITY} units take {QUANTITY_PERCENT}% off. That puts{' '}
        {FIVE_GAMES.short} at {FIVE_GAMES.total}, a saving of {FIVE_GAMES.saved}{' '}
        against five single games. The Bundles tab sells a game’s main service
        in packs of {BUNDLE_SIZES.join(', ')} units at {BUNDLE_PERCENTS[0]}%,{' '}
        {BUNDLE_PERCENTS[1]}% and {BUNDLE_PERCENTS[2]}% off, so the{' '}
        {BUNDLE_SIZES[2]} game bundle at {TEN_GAME_BUNDLE.total} is the biggest
        discount on the site. A bundle always covers one teammate, never a
        group. And coaching takes no quantity discount at any size, so{' '}
        {MAX_QUANTITY} coaching hours cost exactly {MAX_QUANTITY} times one
        hour.
      </p>
    </section>

    <section aria-labelledby="rank-h">
      <h2 id="rank-h">How does rank change a Duoly price?</h2>
      <p>
        Ranked teammate prices follow your current rank. Flat-price casual
        services and coaching hold the same rate at every rank. League of
        Legends Duo Pro, for example, is {LOL_PRO_IRON} per game at Iron and{' '}
        {LOL_PRO_TOP} at Challenger, while Normal Draft stays {LOL_NORMAL} per
        game and a coaching hour stays {COACHING_PRICE} wherever you sit on the
        ladder. Two figures that far apart buy different teammate tiers, so read
        the mode and the tier beside the price.
      </p>
      <p>
        The table below shows each service’s lowest and highest rate.{' '}
        <a href="/games">Your game page</a> carries the exact price at your own
        rank. Pick the rank you really hold before paying: according to{' '}
        <a href="/terms#booking">Duoly’s booking terms</a>, a wrong rank can
        make a session impossible to play and is not a reason for a refund.
        Agree the mode and the start time with your teammate in the order chat,
        then play on your own account with Discord voice.
      </p>
    </section>

    <section aria-labelledby="table-h">
      <h2 id="table-h">What does every Duoly game and service cost?</h2>
      <p>
        The table below is the whole catalog: {CATALOG_GAMES} games, {ROW_COUNT}{' '}
        bookable services and what each one charges in {CATALOG_YEAR}. Find your
        game in a group header, then the category underneath, which is one of{' '}
        {CATEGORY_HEADINGS.map(([, heading]) => heading.toLowerCase()).join(
          ', ',
        )}
        .
      </p>
      <p>
        Two columns are worth a second look. The price column shows one figure
        for a flat service, and the cheapest and dearest figure with its rank
        for a rank-priced one. The covers column matters because a team fill
        pays several hired players out of that single price. Coaching has no
        rank spread at all: a {COACHING_PRICE} VOD Review hour reads the same in
        every coachable game. Click any service name and checkout opens with
        that game and service already filled in.
      </p>
      <div class="official-table-wrap">
        <table class="official-table official-prices">
          <caption class="sr-only">
            {`Every Duoly game and bookable service with its price, as of ${pricesLabel}`}
          </caption>
          <thead>
            <tr>
              <th scope="col">Service</th>
              <th scope="col">Plays with</th>
              <th scope="col">Covers</th>
              <th scope="col">Price</th>
            </tr>
          </thead>
          <tbody>
            {PRICE_TABLE.map((game) => (
              <>
                <tr class="official-group">
                  <th colspan="4" scope="colgroup">
                    {game.name}
                    {game.hubPath && (
                      <a href={game.hubPath}>{game.name} page</a>
                    )}
                  </th>
                </tr>
                {groupsOf(game).map((group) => (
                  <>
                    <tr class="official-sub">
                      <th colspan="4" scope="colgroup">
                        {group.heading}
                      </th>
                    </tr>
                    {group.rows.map((row) => (
                      <tr>
                        <th scope="row">
                          <a href={row.href}>{row.title}</a>
                        </th>
                        <td class="official-tier">{row.tier}</td>
                        <td>{coversCell(row.seats)}</td>
                        <td class="official-price">{priceCell(row)}</td>
                      </tr>
                    ))}
                  </>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
      <p class="official-table-note">
        Catalog prices as of{' '}
        <time datetime={CATALOG_PRICES_UPDATED}>{pricesLabel}</time>. Each
        service name opens the checkout with that game and service prefilled.
        For the price at one exact rank, open <a href="/games">the game page</a>{' '}
        or <a href="/pricing.md">pricing.md</a>, which lists every rank as plain
        text.
      </p>
    </section>

    <section aria-labelledby="coaching-h">
      <h2 id="coaching-h">How much does Duoly coaching cost?</h2>
      <p>
        Duoly coaching costs {COACHING_PRICE} per hour or per game across{' '}
        {COACHABLE_GAMES} coachable titles, and it takes no quantity discount,
        so a second hour costs the same as the first and{' '}
        {FIVE_COACHING_HOURS.label} cost {FIVE_COACHING_HOURS.total}. Check the
        unit on the service card: Play and Learn is sold per match in some games
        and per hour in others, while VOD Review is always an hour on a
        recording of your own.
      </p>
      <p>
        Pick the format for the problem you have.{' '}
        <a href={COACHING_HOUR.href}>{COACHING_HOUR.label}</a> costs{' '}
        {COACHING_HOUR.total} at every rank and buys the time to pause and
        compare decisions with Discord screen share. Check the coach tier too,
        since it differs by game: Valorant lists {VALORANT_COACH_TIER}, League
        of Legends lists {LOL_COACH_TIER}. For the market outside Duoly, our{' '}
        <a href={REPORT_PATH}>2026 gaming coaching and teammate price report</a>{' '}
        found a median of {HOURLY_COACHING.median} an hour across{' '}
        {HOURLY_COACHING.count} rates from {COMPETITOR_COUNT} platforms.
      </p>
    </section>

    <section aria-labelledby="currency-h">
      <h2 id="currency-h">Does Duoly charge in euros or US dollars?</h2>
      <p>
        A Duoly price is set in euros and charged in euros or US dollars,
        whichever you pick at checkout. Every figure on this page is the euro
        price, because the whole catalog is priced in euros. According to{' '}
        <a href="/terms#payment">Duoly’s payment terms</a>, a dollar total is
        that euro price converted at the day’s European Central Bank rate plus a{' '}
        {USD_MARGIN_PERCENT}% currency margin, rounded up to .99, so it sits a
        few cents above a plain mid-market conversion.
      </p>
      <p>
        Switching currency happens at checkout, and the site remembers the
        choice for a year. The same conversion applies to everything, from a{' '}
        {SINGLE_GAME.total} game to a {COACHING_PRICE} coaching hour. Your bank
        may add a foreign currency handling fee of its own, which Duoly neither
        sets nor receives. The rate comes from a public European Central Bank
        feed, and nothing about you is sent there.
      </p>
    </section>

    <section aria-labelledby="assistant-h">
      <h2 id="assistant-h">
        Where can an AI assistant read the same Duoly prices?
      </h2>
      <p>
        Duoly publishes the same catalog in three places, so a reader and an
        assistant never see different numbers.{' '}
        <a href="/pricing.md">Duoly.gg/pricing.md</a> is the whole price list as
        plain markdown, with the figure for every rank rather than a range. The{' '}
        <a href="/developers/mcp">Duoly MCP server</a> answers get_quote and
        find_session with the price for one exact selection. And every game page
        carries the per-rank list for that title.
      </p>
      <p>
        An assistant should call find_session first, because a quote needs a
        game and a service before it can return anything. A {SINGLE_GAME.total}{' '}
        {SINGLE_GAME.short} reads identically on this page, in pricing.md, and
        from an assistant <a href="/ai">using Claude</a>. According to{' '}
        <a href="/terms#payment">the Duoly terms</a>, a price can change over
        time, and an order already placed keeps the price paid.
      </p>
    </section>

    <Faq heading="What do customers ask about Duoly prices?" items={faq} />

    <ClosingCta
      heading="Found your price?"
      text={`Every figure above is what checkout charges, from a sole proprietorship in ${BUSINESS_LOCATION}. Open your game, pick the rank you really hold and read the total before paying anything.`}
      extra={`Three rules cover the whole table. You pay once and nothing is added on top, so ${SINGLE_GAME.short} is ${SINGLE_GAME.total}. Discounts come off by themselves: ${QUANTITY_PERCENT}% at ${MAX_QUANTITY} units, up to ${BUNDLE_PERCENTS[2]}% on a ${BUNDLE_SIZES[2]} unit bundle, and coaching flat at ${COACHING_PRICE} in all ${COACHABLE_GAMES} coachable games. Rank moves ranked play and nothing else, so the two figures in a price cell are the ends of one ladder with your own rank somewhere between them. The largest discount on the site is ${TEN_GAME_BUNDLE.short} at ${TEN_GAME_BUNDLE.total}, which saves ${TEN_GAME_BUNDLE.saved}.`}
      href="/how-it-works"
      label="See how a booking works"
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/how-it-works">How a Duoly booking works step by step</a>
        <a href="/fees-and-refunds">Duoly fees and refunds in full</a>
        <a href="/trust-and-safety">How Duoly checks players and payments</a>
        <a href="/pricing.md">Every price as plain text</a>
        <a href="/coaching">Coaching prices by game</a>
        <a href="/about">About Duoly and who runs it</a>
        <a href="/press">Duoly press kit and fact sheet</a>
        <a href="/compare/e-pal">Duoly compared with E-Pal</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      officialPageSchema(
        path,
        title,
        description,
        CONTENT_DATES[path]!,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Steps from '../components/seo/Steps.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import { pageViewer } from '../site/viewer';
import {
  CONTENT_DATES,
  aboutPageSchema,
  hubChips,
  serializeJsonLd,
} from '../site/seo';
import { DISCORD_INVITE, SUPPORT_EMAIL } from '../site/nav';
import { SERVED_AREAS } from '../site/entity';
import { ABOUT_STORY } from '../content/about-story';
import { publicProfilesEnabled } from '../server/teammates/public-profiles';
import {
  COACHABLE_GAMES,
  COACHING_PRICE,
  PLAYABLE_GAMES,
  SHARE_PERCENT,
  SHORT_GAME_PRICE,
  SOCIAL_MODES,
} from '../server/seo/teammate-facts';
import {
  AUTO_CANCEL_MINUTES,
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED_LABEL,
  COACHING_HOUR,
  SINGLE_GAME,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';
import { LEGAL_UPDATED } from '../design-reference/lib/site.js';

const { viewer, csrf } = await pageViewer(Astro);
const profilesEnabled = publicProfilesEnabled();
const path = '/about';
const title = 'About Duoly: Gaming Teammate and Coach Marketplace | Duoly';
const description = `Duoly (duoly.gg) is a marketplace for rank-verified gaming teammates and coaches in ${PLAYABLE_GAMES} games. How players are checked, what a session costs and how you pay.`;
// Additive related links, same pattern as the other SEO pages.
const HUB_LINKS = hubChips([
  'league-of-legends',
  'valorant',
  'marvel-rivals',
  'counter-strike-2',
]);
/**
 * Duoly at a glance, rendered as a table so extractors read the facts as
 * pairs. Owner decision 12 November 2026: the operator's name, address and
 * trade register number belong on the imprint only, not on this page.
 */
const glance: [string, string][] = [
  ['Games', `${PLAYABLE_GAMES} games plus ${SOCIAL_MODES} voice session types`],
  ['Coaching', `Lessons and VOD reviews in ${COACHABLE_GAMES} games`],
  ['Matchmaking regions', SERVED_AREAS.join(', ')],
  ['Payment', 'Card through Stripe, or your Duoly balance'],
  [
    'If nobody accepts',
    `Your order cancels after ${AUTO_CANCEL_MINUTES} minutes and the full amount returns to your balance`,
  ],
  ['Teammate share', `${SHARE_PERCENT}% of every order`],
  ['Voice chat', 'Discord'],
  ['Contact', SUPPORT_EMAIL],
];
/**
 * The founder story, the named founders and the timeline are owner-supplied
 * (src/content/about-story.ts). Empty lists render nothing at all: no heading,
 * no placeholder, no "coming soon". A reader sees a page without that section
 * rather than a page promising content it does not have.
 */
const { story, founders, milestones } = ABOUT_STORY;
/**
 * The five refusals the terms of service put in writing, as scannable cards
 * beside the paragraph that states them in full. Each one is a rule in
 * src/design-reference/lib/legal.js, not a promise invented for this page.
 */
const NOT_DUOLY: [string, string][] = [
  [
    'No account sharing',
    'Every session is played together, on your own account.',
  ],
  [
    'No rank or win promised',
    'A teammate accepts from a queue, and no result is sold.',
  ],
  [
    'No dating services',
    'Gamer Girl and Social sessions are company and conversation.',
  ],
  ['Nobody under 18', 'Customers and teammates both have to be 18 or older.'],
  ['No off-platform payment', 'Payments and order messages stay on duoly.gg.'],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page about-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'About Duoly', path },
      ]}
    />
    <SeoHero
      eyebrow="About Duoly"
      h1="About Duoly"
      lead={`Duoly is where you book a teammate or a coach for your next session, by the game or by the hour, across ${PLAYABLE_GAMES} games. We check a player’s rank before they can take an order, and you see the full price before you pay.`}
      cta={{ href: '/games', label: `Browse ${PLAYABLE_GAMES} games` }}
      secondary={{ href: '/fees-and-refunds', label: 'Prices and refunds' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        { src: '/assets/games/marvel-rivals.png', alt: 'Marvel Rivals art' },
      ]}
      chip="Rank-verified teammates"
      facts={[
        `${PLAYABLE_GAMES} games plus voice sessions`,
        `Coaching in ${COACHABLE_GAMES} games`,
        `Not accepted in ${AUTO_CANCEL_MINUTES} minutes? Full refund to balance`,
        `Teammates keep ${SHARE_PERCENT}% of every order`,
      ]}
      note={`Prices as of ${CATALOG_PRICES_UPDATED_LABEL}.`}
    />

    <section aria-labelledby="what-h">
      <h2 id="what-h">What is Duoly?</h2>
      <p>
        Duoly is a marketplace for gaming teammates and coaches. Choose a game{' '}
        and session type, then book by the game or by the hour. A verified{' '}
        player accepts your order and joins your lobby on their own account.
      </p>
      <p>
        You play together using Discord for voice. Your game account stays{' '}
        yours: nobody at Duoly needs your password. You can also ask an AI{' '}
        assistant about sessions and prices, then follow its booking link to{' '}
        Duoly.
      </p>
    </section>

    <section aria-labelledby="which-duoly-h">
      <h2 id="which-duoly-h">
        Is this the same Duoly as the couples app or Duolingo?
      </h2>
      <p>No. Duoly.gg is the gaming marketplace.</p>
      <p>
        You book in your browser and meet your teammate using Discord. The Duoly
        app on Google Play is for couples, and Duolingo teaches languages.
        Neither one has anything to do with us.
      </p>
    </section>

    {story.length > 0 && (
      <section aria-labelledby="story-h">
        <h2 id="story-h">Why was Duoly built?</h2>
        {story.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    )}

    <section aria-labelledby="who-h">
      <h2 id="who-h">Who is behind Duoly?</h2>
      <p>
        We’re a small team of players with years of experience running{' '}
        competitive gaming services. We bring that experience to the way we{' '}
        select teammates and help players book a session.
      </p>
      {/* Behind the profiles flag: /teammates answers 404 while it is off. */}
      {profilesEnabled && (
        <p>
          Teammates have public profiles with their games, checked ranks and{' '}
          reviews from players they have queued with.{' '}
          <a href="/teammates">Meet the teammates</a> before you book, and save{' '}
          the ones you like so you can book them again.
        </p>
      )}
      <div class="about-table-wrap">
        <table class="about-table">
          <caption class="sr-only">Duoly at a glance</caption>
          <tbody>
            {glance.map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>
                  {label === 'Contact' ? (
                    <a href={`mailto:${value}`}>{value}</a>
                  ) : (
                    value
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {founders.length > 0 && (
      <section aria-labelledby="founders-h">
        <h2 id="founders-h">Who are the people behind Duoly?</h2>
        <ul class="about-people">
          {founders.map((person) => (
            <li>
              {person.photo && (
                <img
                  src={person.photo.src}
                  alt={person.photo.alt}
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div>
                <p class="about-person-name">{person.name}</p>
                <p class="about-person-role">{person.role}</p>
                <p class="about-person-bio">{person.bio}</p>
                {person.profile && (
                  <p class="about-person-link">
                    <a href={person.profile} rel="noopener">
                      {person.name} profile
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Steps
      heading="How do you book a teammate or coach on Duoly?"
      steps={[
        'Pick your game and session type, then your rank and how many games or hours you want. Review the total before paying.',
        'Pay once by card through Stripe or from your Duoly balance. Your order goes out to the rank-verified teammates for that game.',
        'The first one to accept joins your lobby. Agree on voice chat in the order room and play together on your own accounts.',
      ]}
    >
      <p>
        Book a block of play, coaching or voice company with a verified player.{' '}
        If nobody accepts within {AUTO_CANCEL_MINUTES} minutes, your order{' '}
        cancels automatically and the full amount returns to your Duoly balance.
      </p>
      <p>
        Try <a href={SINGLE_GAME.href}>{SINGLE_GAME.short}</a> or{' '}
        <a href={COACHING_HOUR.href}>{COACHING_HOUR.short}</a>.{' '}
        <a href="/how-it-works">How Duoly works step by step</a> explains what{' '}
        happens from choosing a session to meeting your teammate.
      </p>
    </Steps>

    <section aria-labelledby="catalog-h">
      <h2 id="catalog-h">Which games and services does Duoly sell?</h2>
      <p>
        You can book teammates, team fills and coaching across {PLAYABLE_GAMES}{' '}
        games, plus {SOCIAL_MODES} voice session types. A team fill books{' '}
        several players at once, such as a League of Legends Ranked Flex{' '}
        five-stack.
      </p>
      <p>
        Coaching is available in {COACHABLE_GAMES} games. Choose a lesson or a{' '}
        VOD review, where your coach goes through your recording with you using{' '}
        Discord screen share. Social sessions offer company and conversation for{' '}
        adults and are never a dating service.
      </p>
      <p>
        The games include League of Legends, Valorant, Counter-Strike 2,{' '}
        Fortnite, Marvel Rivals, Rocket League, Dota 2 and World of Warcraft.{' '}
        Regions include {SERVED_AREAS.join(', ')}. Browse{' '}
        <a href="/games">the games page</a> for sessions or{' '}
        <a href="/pricing">the pricing page</a> for the full list.
      </p>
    </section>

    <section aria-labelledby="verify-h">
      <h2 id="verify-h">
        How does Duoly check a teammate before a first order?
      </h2>
      <p>
        Every Duoly teammate completes an application, rank check and tryout{' '}
        before taking orders. The <a href="/apply">application form</a> asks for{' '}
        their game, rank and region, a short introduction video and confirmation{' '}
        that they are at least 18.
      </p>
      <p>
        We review their account and rank history, then play a tryout game with{' '}
        them using Discord. After approval, they can go online and accept{' '}
        orders. Each game’s coaching page also lists the coach rank.
      </p>
      <p>
        Teammates work independently under{' '}
        <a href="/terms#teammates">Duoly’s teammate terms</a>. Read{' '}
        <a href="/trust-and-safety">trust and safety</a> for more about player{' '}
        checks and how to report a problem.
      </p>
    </section>

    <section aria-labelledby="pay-h">
      <h2 id="pay-h">What does a Duoly session cost, and how do you pay?</h2>
      <p>
        Teammate games start at {SHORT_GAME_PRICE}. Coaching costs{' '}
        {COACHING_PRICE} per hour or game. You see the full total before paying{' '}
        by card through Stripe or from your Duoly balance.
      </p>
      <p>
        Bundles of {BUNDLE_SIZES[0]}, {BUNDLE_SIZES[1]} and {BUNDLE_SIZES[2]}{' '}
        teammate games save {BUNDLE_PERCENTS[0]}%, {BUNDLE_PERCENTS[1]}% and{' '}
        {BUNDLE_PERCENTS[2]}%. Coaching has no quantity discount.
      </p>
      <p>
        Prices are in euros. US dollar payments use the day’s European Central{' '}
        Bank rate plus a {USD_MARGIN_PERCENT}% currency margin, rounded up to{' '}
        .99. See <a href="/terms#payment">the payment terms</a> and{' '}
        <a href="/fees-and-refunds">fees and refunds</a> for details, or{' '}
        <a href="/pricing.md">pricing.md</a> for the plain text price list.
      </p>
    </section>

    <section aria-labelledby="not-h">
      <h2 id="not-h">What does Duoly not do?</h2>
      <p>
        Duoly sells time playing together. Sessions follow the{' '}
        <a href="/terms">terms of service</a>, dated {LEGAL_UPDATED}, including{' '}
        the rules against cheating and forbidden third-party tools.
      </p>
      <p>
        Duoly is unaffiliated with Riot Games, Valve, Epic Games, Blizzard and{' '}
        NetEase. A teammate accepts your order from the queue, so a start time{' '}
        cannot be guaranteed.
      </p>
      <div class="about-nots">
        {NOT_DUOLY.map(([label, detail]) => (
          <div>
            <span class="about-not-label">{label}</span>
            <span class="about-not-detail">{detail}</span>
          </div>
        ))}
      </div>
    </section>

    {milestones.length > 0 && (
      <section aria-labelledby="timeline-h">
        <h2 id="timeline-h">What has happened at Duoly so far?</h2>
        <ol class="about-timeline">
          {milestones.map((milestone) => (
            <li>
              <time datetime={milestone.date}>{milestone.date}</time>
              <p class="about-milestone-label">{milestone.label}</p>
              {milestone.detail && <p>{milestone.detail}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}

    <section aria-labelledby="rules-h">
      <h2 id="rules-h">Where are Duoly’s rules, policies and support?</h2>
      <p>
        The <a href="/terms">terms of service</a> cover bookings and conduct,{' '}
        with separate sections for{' '}
        <a href="/terms#cancel">cancellations and refunds</a> and{' '}
        <a href="/terms#balance">your Duoly balance</a>. Teammates also follow{' '}
        the Teammate Code at duoly.gg/rules and the{' '}
        <a href="/terms#teammates">teammate terms</a>.
      </p>
      <p>
        The <a href="/privacy">privacy policy</a> explains what we collect and{' '}
        <a href="/privacy#rights">your data rights</a>. If you need help with an{' '}
        order, use <a href="/contact">the contact form</a> or the chat bubble.{' '}
        Have your order number ready so we can find your booking.
      </p>
      <p>
        For news and assets, visit <a href="/press">the Duoly press kit</a>. You{' '}
        can also explore <a href="/ai">Duoly in AI assistants</a> and the{' '}
        <a href="/developers/mcp">MCP reference</a>, or join the{' '}
        <a href={DISCORD_INVITE} rel="noopener">
          Duoly Discord
        </a>
        .
      </p>
    </section>

    <ClosingCta
      heading="Ready to look at the catalog?"
      text="Pick your game and see which sessions fit your plans. You can review the full price before booking."
      extra="Play alongside a teammate on your own account, or bring a recording to a coach for a closer look at your game."
      href="/games"
      label={`Browse ${PLAYABLE_GAMES} games`}
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/fees-and-refunds">Duoly fees, prices and refunds</a>
        <a href="/how-it-works">How a Duoly booking works step by step</a>
        <a href="/pricing">Every Duoly game, service and price</a>
        <a href="/trust-and-safety">How Duoly checks players and payments</a>
        <a href="/press">Duoly press kit and fact sheet</a>
        <a href="/games">All games and services</a>
        <a href="/compare/e-pal">Duoly compared with E-Pal</a>
        <a href="/ai">Duoly in AI assistants</a>
        <a href="/developers/mcp">MCP developer reference</a>
        <a href="/get-paid-to-play-games">Become a Duoly teammate</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      aboutPageSchema(
        path,
        title,
        description,
        CONTENT_DATES[path]!,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .about-page h2 {
    scroll-margin-top: 96px;
  }
  .about-table-wrap {
    margin-top: 22px;
    border: 1px solid rgba(196, 170, 255, 0.22);
    border-radius: 18px;
    overflow: hidden;
    background: #120b22;
  }
  .about-table {
    width: 100%;
    border-collapse: collapse;
  }
  .about-table th,
  .about-table td {
    padding: 13px 18px;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    border-top: 1px solid rgba(196, 170, 255, 0.14);
    font-size: 15px;
  }
  .about-table tr:first-child th,
  .about-table tr:first-child td {
    border-top: 0;
  }
  .about-table th {
    width: 230px;
    color: #b9add8;
    font-weight: 600;
  }
  .about-table td {
    color: #f3eeff;
  }
  @media (max-width: 600px) {
    .about-table th,
    .about-table td {
      display: block;
      width: auto;
    }
    .about-table td {
      padding-top: 0;
      border-top: 0;
    }
  }
  /* The founder cards and the timeline only render once the owner fills
     src/content/about-story.ts, so these rules sit unused until then. They
     follow the card language of the other SEO blocks rather than inventing a
     second one. */
  .about-people {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .about-people li {
    display: flex;
    gap: 16px;
    padding: 20px;
    border-radius: 18px;
    background: #120b22;
    border: 1px solid rgba(196, 170, 255, 0.18);
  }
  .about-people img {
    border-radius: 14px;
    flex: 0 0 auto;
  }
  .about-person-name {
    margin: 0;
    font-weight: 700;
    color: #f3eeff;
  }
  .about-person-role {
    margin: 2px 0 0;
    font-size: 14px;
    color: #d6bbff;
  }
  .about-page .about-person-bio {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .about-person-link {
    margin: 10px 0 0;
    font-size: 14px;
  }
  .about-nots {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
  }
  .about-nots > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border-radius: 16px;
    background: #120b22;
    border: 1px solid rgba(196, 170, 255, 0.18);
  }
  .about-not-label {
    font-family: 'Bricolage Grotesque', 'Bricolage Fallback', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #f3eeff;
  }
  .about-not-detail {
    font-size: 14.5px;
    line-height: 1.55;
    color: #a79dc4;
  }
  .about-timeline {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .about-timeline li {
    padding: 16px 0 0;
    border-top: 2px solid rgba(196, 170, 255, 0.2);
  }
  .about-timeline time {
    font-size: 14px;
    font-weight: 700;
    color: #d6bbff;
  }
  .about-milestone-label {
    margin: 4px 0 0;
    font-weight: 650;
    color: #f3eeff;
  }
</style>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Steps from '../components/seo/Steps.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import { pageViewer } from '../site/viewer';
import {
  CONTENT_DATES,
  aboutPageSchema,
  hubChips,
  serializeJsonLd,
} from '../site/seo';
import { DISCORD_INVITE, SUPPORT_EMAIL } from '../site/nav';
import {
  BUSINESS,
  BUSINESS_LOCATION,
  DISAMBIGUATION_PROSE,
  SERVED_AREAS,
} from '../site/entity';
import { ABOUT_STORY } from '../content/about-story';
import {
  COACHABLE_GAMES,
  COACHING_PRICE,
  PLAYABLE_GAMES,
  SHARE_PERCENT,
  SHORT_GAME_PRICE,
  SOCIAL_MODES,
} from '../server/seo/teammate-facts';
import {
  AUTO_CANCEL_MINUTES,
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED_LABEL,
  COACHING_HOUR,
  MAX_QUANTITY,
  QUANTITY_PERCENT,
  SINGLE_GAME,
  TEN_GAME_BUNDLE,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';
import { LEGAL_UPDATED } from '../design-reference/lib/site.js';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/about';
const title = 'About Duoly: Gaming Teammate and Coach Marketplace | Duoly';
const description = `Duoly (duoly.gg) is an Austrian marketplace for rank-verified gaming teammates and coaches in ${PLAYABLE_GAMES} games. Who runs it, how players are checked, how you pay.`;
// Additive related links, same pattern as the other SEO pages.
const HUB_LINKS = hubChips([
  'league-of-legends',
  'valorant',
  'marvel-rivals',
  'counter-strike-2',
]);
/** The operator facts, rendered as a table so extractors read them as pairs. */
const operator: [string, string][] = [
  ['Business name', BUSINESS.legalName],
  ['Legal form', BUSINESS.legalForm],
  ['Business location', BUSINESS_LOCATION],
  ['Trade register (GISA)', BUSINESS.gisa],
  ['Legally represented by', BUSINESS.representedBy],
  ['Contact', SUPPORT_EMAIL],
];
/**
 * The founder story, the named founders and the timeline are owner-supplied
 * (src/content/about-story.ts). Empty lists render nothing at all: no heading,
 * no placeholder, no "coming soon". A reader sees a page without that section
 * rather than a page promising content it does not have.
 */
const { story, founders, milestones } = ABOUT_STORY;
/**
 * The five refusals the terms of service put in writing, as scannable cards
 * beside the paragraph that states them in full. Each one is a rule in
 * src/design-reference/lib/legal.js, not a promise invented for this page.
 */
const NOT_DUOLY: [string, string][] = [
  [
    'No account sharing',
    'Every session is played together, on your own account.',
  ],
  [
    'No rank or win promised',
    'A teammate accepts from a queue, and no result is sold.',
  ],
  [
    'No dating services',
    'Gamer Girl and Social sessions are company and conversation.',
  ],
  ['Nobody under 18', 'Customers and teammates both have to be 18 or older.'],
  ['No off-platform payment', 'Payment, chat and reports stay on duoly.gg.'],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page about-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'About Duoly', path },
      ]}
    />
    <SeoHero
      eyebrow="About Duoly"
      h1="About Duoly"
      lead={`Duoly is where you book a teammate or a coach for your next session, by the game or by the hour, across ${PLAYABLE_GAMES} games. We check a player’s rank before they can take an order, and you see the full price before you pay.`}
      cta={{ href: '/games', label: `Browse ${PLAYABLE_GAMES} games` }}
      secondary={{ href: '/fees-and-refunds', label: 'Prices and refunds' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        { src: '/assets/games/marvel-rivals.png', alt: 'Marvel Rivals art' },
      ]}
      chip={`Sessions from ${SHORT_GAME_PRICE}`}
      facts={[
        `Based in ${BUSINESS_LOCATION}`,
        `Trade register GISA ${BUSINESS.gisa}`,
        `${PLAYABLE_GAMES} games plus voice sessions`,
        `Teammates keep ${SHARE_PERCENT}% of every order`,
      ]}
      note={`Prices on this page come from Duoly checkout, last changed ${CATALOG_PRICES_UPDATED_LABEL}.`}
    />

    <section aria-labelledby="what-h">
      <h2 id="what-h">What is Duoly?</h2>
      <p>
        Duoly is a marketplace for gaming teammates and coaches. Pick a game, a
        session type and how many games or hours you want, and the total shows
        up before checkout. Pay once and your order goes out to the players we
        have verified for that game. The first one to accept joins your lobby
        and plays alongside you, on an account of their own.
      </p>
      <p>
        Nobody at Duoly signs into your account and nobody asks for your
        password. That is the difference between playing with someone and
        handing your account over.
      </p>
      <p>
        For example, {SINGLE_GAME.label} costs {SINGLE_GAME.total}, ten of them
        cost {BUNDLE_PERCENTS[2]}% less each, and {COACHING_HOUR.label} is{' '}
        {COACHING_HOUR.total}. You pay by card through Stripe and session voice
        runs using Discord. An assistant such as Claude can read the same prices
        from the Duoly MCP server and hand you a booking link before you ever
        open the site.
      </p>
    </section>

    <section aria-labelledby="which-duoly-h">
      <h2 id="which-duoly-h">
        Is this the same Duoly as the couples app or Duolingo?
      </h2>
      <p>No. {DISAMBIGUATION_PROSE}</p>
      <p>
        The names sit close enough to get mixed up, so here is how to tell them
        apart. Duoly.gg sells sessions with real players in named games, for
        example {SINGLE_GAME.total} for a League of Legends game with a Master+
        teammate and {COACHING_HOUR.total} for a Valorant coaching hour. The
        site is operated from {BUSINESS.city} in {BUSINESS.countryName} by the
        sole proprietorship in the table below, registered under GISA{' '}
        {BUSINESS.gisa} and named on the <a href="/imprint">imprint</a>. There
        is no Duoly app to install, because the picker, the payment and the
        order room all live in a browser and the session itself runs using
        Discord. The Duoly on Google Play is a relationship app for couples, and
        Duolingo teaches languages. Neither one has anything to do with us.
      </p>
    </section>

    {story.length > 0 && (
      <section aria-labelledby="story-h">
        <h2 id="story-h">Why was Duoly built?</h2>
        {story.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    )}

    <section aria-labelledby="who-h">
      <h2 id="who-h">Who runs Duoly?</h2>
      <p>
        Duoly is run by a team in {BUSINESS.countryName} and Switzerland who
        have spent years running competitive gaming services. We play the games
        in the catalog ourselves, which is why the rank checks are strict and
        the service list looks the way it does.
      </p>
      <p>
        The legal side is short. The legal form is {BUSINESS.legalForm}, the
        business sits in {BUSINESS_LOCATION}, the trade register number is GISA{' '}
        {BUSINESS.gisa}, and {BUSINESS.representedBy} is the legal
        representative. The street address, the chamber membership and the
        supervisory authority are on the <a href="/imprint">imprint</a>, where
        Austrian law puts them, and email reaches the team at{' '}
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
      </p>
      <p>
        Before you spend anything you can read the refund rules, the conduct
        rules and every price in the catalog, for example {SHORT_GAME_PRICE} for
        a Valorant Skirmish 2v2 game. Teammates keep {SHARE_PERCENT}% of each
        order and meet their customers using Discord.
      </p>
      <div class="about-table-wrap">
        <table class="about-table">
          <caption class="sr-only">
            Operator of duoly.gg, as published on the imprint
          </caption>
          <tbody>
            {operator.map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>
                  {label === 'Contact' ? (
                    <a href={`mailto:${value}`}>{value}</a>
                  ) : (
                    value
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {founders.length > 0 && (
      <section aria-labelledby="founders-h">
        <h2 id="founders-h">Who are the people behind Duoly?</h2>
        <ul class="about-people">
          {founders.map((person) => (
            <li>
              {person.photo && (
                <img
                  src={person.photo.src}
                  alt={person.photo.alt}
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div>
                <p class="about-person-name">{person.name}</p>
                <p class="about-person-role">{person.role}</p>
                <p class="about-person-bio">{person.bio}</p>
                {person.profile && (
                  <p class="about-person-link">
                    <a href={person.profile} rel="noopener">
                      {person.name} profile
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Steps
      heading="How do you book a teammate or coach on Duoly?"
      steps={[
        `Pick your game and session type, then your rank and how many games or hours you want. The total appears before you pay, for example ${SINGLE_GAME.total} for ${SINGLE_GAME.short}.`,
        'Pay once by card through Stripe or from your Duoly balance. Your order goes out to the rank-verified teammates for that game.',
        'The first one to accept joins your lobby. Agree voice in the order room and play together on your own accounts.',
      ]}
    >
      <p>
        A booking is one paid block of play, coaching or voice company with a
        verified player. Your session type and your rank set the price, you are
        charged once up front, and an order nobody takes within{' '}
        {AUTO_CANCEL_MINUTES} minutes cancels itself and puts 100% of the amount
        back in your Duoly balance.
      </p>
      <p>
        Want to see a real total? Open{' '}
        <a href={SINGLE_GAME.href}>
          {SINGLE_GAME.short} at {SINGLE_GAME.total}
        </a>{' '}
        or{' '}
        <a href={COACHING_HOUR.href}>
          {COACHING_HOUR.short} at {COACHING_HOUR.total}
        </a>
        . <a href="/how-it-works">How Duoly works step by step</a> walks the
        same flow from the picker to the refund rules.
      </p>
    </Steps>

    <section aria-labelledby="catalog-h">
      <h2 id="catalog-h">Which games and services does Duoly sell?</h2>
      <p>
        Duoly sells four kinds of session across {PLAYABLE_GAMES} games, plus a
        voice-only category.
      </p>
      <p>
        Teammate sessions put a ranked player in your lobby for the mode you
        pick, from {SHORT_GAME_PRICE} for a Valorant Skirmish 2v2 game. A team
        fill is a single booking for several hired players at once, for example
        a League of Legends Ranked Flex five-stack. Coaching runs in all{' '}
        {COACHABLE_GAMES} bookable games, per hour or per game, at{' '}
        {COACHING_PRICE}. VOD reviews are included, where a coach walks through
        your own recording using Discord screen share. The {SOCIAL_MODES} voice
        modes are friendly company without a scoreboard, adults only, never a
        dating service.
      </p>
      <p>
        The catalog spans League of Legends, Valorant, Counter-Strike 2,
        Fortnite, Marvel Rivals, Rocket League, Dota 2 and World of Warcraft,
        with servers across {SERVED_AREAS.join(', ')}. Bundles of{' '}
        {BUNDLE_SIZES[2]} take {BUNDLE_PERCENTS[2]}% off a teammate service.
        Coaching stays flat. Browse <a href="/games">the games page</a>, or read
        every service and its price in one table on{' '}
        <a href="/pricing">the pricing page</a>.
      </p>
    </section>

    <section aria-labelledby="verify-h">
      <h2 id="verify-h">
        How does Duoly check a teammate before a first order?
      </h2>
      <p>
        A Duoly teammate is a player who has passed a four-step review, and
        nobody reaches the queue before it finishes.
      </p>
      <p>
        The first step is the <a href="/apply">application form</a>: name,
        email, Discord, a confirmation of being 18 or older, the rank, the
        region and a link to a short video introducing the applicant. Then the
        rank check, where Duoly compares the account and the rank history
        against the minimum rank published for the game. Then one tryout game
        with the Duoly team using Discord. Only after the tryout does an account
        go online.
      </p>
      <p>
        Coaches are listed at the coach rank named on the coaching page for the
        game, for example Grandmaster+ for a {COACHING_PRICE} League of Legends
        VOD review and Master+ for a {SINGLE_GAME.total} Duo Pro game. According
        to <a href="/terms#teammates">Duoly’s teammate terms</a>, teammates are
        independent players and not employees, have to keep a verified rank
        honest, and earn {SHARE_PERCENT}% of each order. The whole review, the
        payment handling and the conduct rules sit on{' '}
        <a href="/trust-and-safety">trust and safety</a>.
      </p>
    </section>

    <section aria-labelledby="pay-h">
      <h2 id="pay-h">What does a Duoly session cost, and how do you pay?</h2>
      <p>
        A session costs the published price for your selection, paid once, with
        nothing added on top. Teammate games start at {SHORT_GAME_PRICE}.
        Coaching is {COACHING_PRICE} per hour or game. {SINGLE_GAME.short} is{' '}
        {SINGLE_GAME.total}.
      </p>
      <p>
        Two discounts apply on their own: {MAX_QUANTITY} units take{' '}
        {QUANTITY_PERCENT}% off, and bundles of three, five and ten take{' '}
        {BUNDLE_PERCENTS[0]}%, {BUNDLE_PERCENTS[1]}% and {BUNDLE_PERCENTS[2]}%
        off. For example, ten League of Legends games at Gold rank come to{' '}
        {TEN_GAME_BUNDLE.total} and save you {TEN_GAME_BUNDLE.saved}. You pay by
        card through Stripe or from your Duoly balance when you queue the order,
        and Duoly never sees or stores your full card details.
      </p>
      <p>
        According to <a href="/terms#payment">Duoly’s payment terms</a>, prices
        are set in euros. Pick US dollars and you pay the euro price converted
        at the day’s European Central Bank rate plus a {USD_MARGIN_PERCENT}%
        currency margin, rounded up to .99. The whole model is on{' '}
        <a href="/fees-and-refunds">fees and refunds</a>, and every price in the
        catalog sits in <a href="/pricing.md">pricing.md</a>.
      </p>
    </section>

    <section aria-labelledby="not-h">
      <h2 id="not-h">What does Duoly not do?</h2>
      <p>
        A Duoly session is a game played together, and that rules five things
        out. Each one is written into the <a href="/terms">terms of service</a>{' '}
        dated {LEGAL_UPDATED}.
      </p>
      <p>
        No account sharing and no boosting: you play together, your teammate
        stays in their own client, and nobody at Duoly asks for your password.
        No guaranteed rank, win or start time: a teammate accepts from the
        queue, and the {SHARE_PERCENT}% share is paid for a completed order,
        whatever the scoreline. No dating, romantic or sexual service, because
        Gamer Girl and Social sessions are company and conversation. Nobody
        under 18 books or works as a teammate. No payment arranged off the
        platform, and no cheating, scripting or forbidden third-party tools.
      </p>
      <p>
        Duoly is also unaffiliated with Riot Games, Valve, Epic Games, Blizzard
        and NetEase. For example, {SINGLE_GAME.total} buys you one League of
        Legends game beside a Master+ player using Discord voice, and a{' '}
        {BUNDLE_PERCENTS[2]}% bundle discount still buys you no result.
      </p>
      {/* The same five refusals as scannable cards. Plain divs and spans on
          purpose: the paragraph above is the extractable answer, and repeating
          it in p or li elements would duplicate the text for a reader and for
          anything that reads the page as prose. */}
      <div class="about-nots">
        {NOT_DUOLY.map(([label, detail]) => (
          <div>
            <span class="about-not-label">{label}</span>
            <span class="about-not-detail">{detail}</span>
          </div>
        ))}
      </div>
    </section>

    {milestones.length > 0 && (
      <section aria-labelledby="timeline-h">
        <h2 id="timeline-h">What has happened at Duoly so far?</h2>
        <ol class="about-timeline">
          {milestones.map((milestone) => (
            <li>
              <time datetime={milestone.date}>{milestone.date}</time>
              <p class="about-milestone-label">{milestone.label}</p>
              {milestone.detail && <p>{milestone.detail}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}

    <section aria-labelledby="rules-h">
      <h2 id="rules-h">Where are Duoly’s rules, policies and support?</h2>
      <p>
        Every rule Duoly runs on is a published document, and each link below
        opens the section it names.
      </p>
      <p>
        The <a href="/terms">terms of service</a>, dated {LEGAL_UPDATED}, carry
        the booking, payment and conduct rules, with{' '}
        <a href="/terms#cancel">cancellations and refunds</a> and{' '}
        <a href="/terms#balance">the Duoly balance</a> as sections of their own.
        The <a href="/privacy">privacy policy</a> lists what Duoly collects and{' '}
        <a href="/privacy#rights">the GDPR rights</a> a customer in the EU can
        use, for example the right to ask for a copy of the data Duoly holds.
        The <a href="/imprint">imprint</a> names the operator and the
        supervisory authority in {BUSINESS.countryName}. Teammates also sign the
        Teammate Code at duoly.gg/rules, on top of{' '}
        <a href="/terms#teammates">the teammate terms</a> that set the{' '}
        {SHARE_PERCENT}% share.
      </p>
      <p>
        Anything else goes to <a href="/contact">the contact form</a> or the
        chat bubble, and someone on the team answers. A refund question moves
        fastest with the order number to hand, because one rule covers a{' '}
        {SINGLE_GAME.total} game and a {TEN_GAME_BUNDLE.total} bundle.
        Journalists start at <a href="/press">the Duoly press kit</a>, and
        developers or assistant users at{' '}
        <a href="/developers/mcp">the MCP reference</a> or{' '}
        <a href="/ai">Duoly in AI assistants</a>. Every session runs using
        Discord voice, and the{' '}
        <a href={DISCORD_INVITE} rel="noopener">
          Duoly Discord
        </a>{' '}
        invite sits in your order room.
      </p>
    </section>

    <ClosingCta
      heading="Ready to look at the catalog?"
      text={`Duoly is an Austrian marketplace for rank-verified gaming teammates and coaches, operated from ${BUSINESS_LOCATION} under trade register GISA ${BUSINESS.gisa}. Browse ${PLAYABLE_GAMES} games, read the price for your rank and book when the figure suits you.`}
      extra={`What to know before a first booking. The price on the card is the price Stripe charges, with ${BUNDLE_PERCENTS[0]}%, ${BUNDLE_PERCENTS[1]}% and ${BUNDLE_PERCENTS[2]}% off bundles of three, five and ten applied at checkout, which is the biggest discount Duoly gives. A teammate accepts from the queue, so no start time is promised, and an order nobody takes within ${AUTO_CANCEL_MINUTES} minutes refunds itself. Every session runs on your own account using Discord voice, and no rank or result is guaranteed. For example, a ${COACHING_PRICE} coaching hour and a ${SHORT_GAME_PRICE} teammate game both carry 0% in added fees.`}
      href="/games"
      label={`Browse ${PLAYABLE_GAMES} games`}
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/fees-and-refunds">Duoly fees, prices and refunds</a>
        <a href="/how-it-works">How a Duoly booking works step by step</a>
        <a href="/pricing">Every Duoly game, service and price</a>
        <a href="/trust-and-safety">How Duoly checks players and payments</a>
        <a href="/press">Duoly press kit and fact sheet</a>
        <a href="/games">All games and services</a>
        <a href="/compare/e-pal">Duoly compared with E-Pal</a>
        <a href="/ai">Duoly in AI assistants</a>
        <a href="/developers/mcp">MCP developer reference</a>
        <a href="/get-paid-to-play-games">Become a Duoly teammate</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      aboutPageSchema(
        path,
        title,
        description,
        CONTENT_DATES[path]!,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .about-page h2 {
    scroll-margin-top: 96px;
  }
  .about-table-wrap {
    margin-top: 22px;
    border: 1px solid rgba(196, 170, 255, 0.22);
    border-radius: 18px;
    overflow: hidden;
    background: #120b22;
  }
  .about-table {
    width: 100%;
    border-collapse: collapse;
  }
  .about-table th,
  .about-table td {
    padding: 13px 18px;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    border-top: 1px solid rgba(196, 170, 255, 0.14);
    font-size: 15px;
  }
  .about-table tr:first-child th,
  .about-table tr:first-child td {
    border-top: 0;
  }
  .about-table th {
    width: 230px;
    color: #b9add8;
    font-weight: 600;
  }
  .about-table td {
    color: #f3eeff;
  }
  @media (max-width: 600px) {
    .about-table th,
    .about-table td {
      display: block;
      width: auto;
    }
    .about-table td {
      padding-top: 0;
      border-top: 0;
    }
  }
  /* The founder cards and the timeline only render once the owner fills
     src/content/about-story.ts, so these rules sit unused until then. They
     follow the card language of the other SEO blocks rather than inventing a
     second one. */
  .about-people {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .about-people li {
    display: flex;
    gap: 16px;
    padding: 20px;
    border-radius: 18px;
    background: #120b22;
    border: 1px solid rgba(196, 170, 255, 0.18);
  }
  .about-people img {
    border-radius: 14px;
    flex: 0 0 auto;
  }
  .about-person-name {
    margin: 0;
    font-weight: 700;
    color: #f3eeff;
  }
  .about-person-role {
    margin: 2px 0 0;
    font-size: 14px;
    color: #d6bbff;
  }
  .about-page .about-person-bio {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .about-person-link {
    margin: 10px 0 0;
    font-size: 14px;
  }
  .about-nots {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
  }
  .about-nots > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border-radius: 16px;
    background: #120b22;
    border: 1px solid rgba(196, 170, 255, 0.18);
  }
  .about-not-label {
    font-family: 'Bricolage Grotesque', 'Bricolage Fallback', sans-serif;
    font-size: 16px;

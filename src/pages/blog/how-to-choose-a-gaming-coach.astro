---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SeoHero from '../../components/seo/SeoHero.astro';
import Steps from '../../components/seo/Steps.astro';
import Faq from '../../components/seo/Faq.astro';
import ClosingCta from '../../components/seo/ClosingCta.astro';
import '../../components/seo/seo.css';
import OfferCard from '../../components/seo/OfferCard.astro';
import '../../components/seo/article.css';
import '../../components/seo/free-vs-paid.css';
import '../../components/seo/guide-article.css';
import { pageViewer } from '../../site/viewer';
import { heroOffer } from '../../server/seo/hero-offer';
import { seoOffers, faqSchema } from '../../server/seo/offers';
import {
  coachingDirectory,
  directoryPrice,
} from '../../server/seo/directories';
import { SHARE_PERCENT } from '../../server/seo/teammate-facts';
import { viewerCurrency } from '../../server/currency';
import { eurToUsd } from '../../server/fx';
import {
  serializeJsonLd,
  bookingHref,
  CONTENT_DATES,
  organizationSchema,
  REPORT_PATH,
} from '../../site/seo';
// The survey's own figures, imported rather than retyped, so this guide can
// never quote a median the report has stopped publishing.
import {
  COMPETITOR_COUNT,
  HOURLY_COACHING,
} from '../../server/seo/price-report';
import { SURVEY_CHECKED_LABEL } from '../../content/price-report-2026';

const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
const context = {
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
};
// Every lesson price on this page comes out of the same checkout engine the
// price cards use, so a catalog change rewrites the guide on the next build.
const coached = coachingDirectory(context);
const lessonPrice = directoryPrice(coached);
const valorant = seoOffers('val', 'training', context);
const league = seoOffers('lol', 'training', context);
const overwatch = seoOffers('ow', 'training', context);
const pick = (offers: typeof valorant, id: string) =>
  offers.find((offer) => offer.id === id)!;
const valVod = pick(valorant, 'vod');
// The lesson this guide keeps coming back to, priced through the engine.
const lessonOffer = heroOffer('val', 'vod', valorant)!;
/** The coach rank without the catalog's format suffix ("Immortal+ coach"). */
const lessonCoach = lessonOffer.tier.split(' · ')[0]!;
const valAim = pick(valorant, 'aim');
const lolVod = pick(league, 'vod');
const lolChamp = pick(league, 'champ');
const owRole = pick(overwatch, 'role');
const learn = pick(valorant, 'learn');
const path = '/blog/how-to-choose-a-gaming-coach';
const title = 'How to Choose a Gaming Coach | Duoly';
const h1 = 'How to choose a gaming coach';
const description =
  'How to choose a gaming coach: check the rank proof, what one session includes, the price per hour, real session reviews and the refund terms before you pay.';
// Each competitor figure below was read from the cited page on this date.
const CHECKED = '2026-11-09';
const CHECKED_LABEL = '9 November 2026';
const metafySessions = 'https://metafy.gg/overwatch/sessions';
const metafyFees =
  'https://help.metafy.gg/en/articles/14676126-buyer-fees-breakdown';
const queueupDocs = 'https://queueup.gg/docs';
const sources = [
  {
    title: 'Metafy Overwatch 2 sessions: coach-set session prices',
    url: metafySessions,
  },
  { title: 'Metafy help centre: buyer fees breakdown', url: metafyFees },
  {
    title: 'QueueUp documentation: session price, intro and guarantee',
    url: queueupDocs,
  },
];
const checks = [
  {
    label: 'Rank proof you can look at',
    text: 'Ask for the account, a tracker page or a match history, plus the date somebody last checked it.',
  },
  {
    label: 'A session plan in writing',
    text: 'A good coach can name what the hour contains before you pay: a replay, a live game or a drill list.',
  },
  {
    label: 'A price per hour, with fees',
    text: 'Compare the total at checkout. A coach-set rate plus a platform fee is the number you actually pay.',
  },
  {
    label: 'Reviews tied to real sessions',
    text: 'Feedback naming the game, the date and what changed is evidence. A bare star average is not.',
  },
  {
    label: 'Refund terms you have read',
    text: 'Find out what happens on a no-show, in the first 5 minutes and when a bundle is half used.',
  },
];
const flags = [
  'A promised rank by a deadline. Nobody can sell a result in a game other people also play.',
  'A rank with no way to check it, or a check with no date on it.',
  'Payment moved into a private message instead of the platform checkout.',
  'An hour with no plan, where you both work out what to do after the clock starts.',
  'A review wall with no session, game or date attached to any entry.',
];
const faqItems: [string, string][] = [
  [
    'How do you choose a gaming coach?',
    'Check rank proof, the session plan, the total including fees, reviews tied to sessions and refund terms before paying.',
  ],
  [
    'How much does a gaming coach cost?',
    `A Duoly lesson is ${lessonPrice}, the same price in every game Duoly coaches. On Metafy, one-hour Overwatch 2 lessons were listed at USD 25 to USD 50 on ${CHECKED_LABEL}. QueueUp prices an Instant session at 24 QueueCoins, which it states is USD 24 for 45 minutes.`,
  ],
  [
    'How can you verify a gaming coach rank?',
    'Ask for the game account or a public tracker page, then check the current season. An undated screenshot does not establish a current rank.',
  ],
  [
    'What should a first coaching session include?',
    `A first session is a plan, one replay or one live game, and 2 or 3 things to practice afterwards. For example, ${valVod.title} from Duoly is one ${valVod.unit} with an ${valVod.provider} coach and ends with the fixes written down.`,
  ],
  [
    'Is a cheap coach worse than an expensive one?',
    'Compare rank proof, the lesson plan and session reviews. Price alone cannot establish teaching quality.',
  ],
  [
    'Can a coach play on your account?',
    'No. Keep your password private. Duoly lessons use your own account, using Discord for voice and screen share.',
  ],
];
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  mainEntityOfPage: new URL(path, Astro.site!).href,
  datePublished: '2026-11-09',
  dateModified: CONTENT_DATES[path],
  author: organizationSchema(Astro.site!),
  publisher: organizationSchema(Astro.site!),
  image: new URL('/og/duoly.jpg', Astro.site!).href,
};
const check = 'M6.5 11.2 3.3 8l1.1-1.1 2.1 2.1 5.1-5.1 1.1 1.1z';
const cross = 'M4.6 4.6l6.8 6.8m0-6.8-6.8 6.8';
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page seo-article">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Blog', path: '/blog' },
        { name: 'How to choose a gaming coach', path },
      ]}
    />
    <SeoHero
      eyebrow="Guide"
      h1={h1}
      lead="Check five things before you pay a gaming coach: proof of the rank, what one session contains, the price per hour including fees, reviews tied to real sessions, and the refund terms. Any coach worth the hour can answer all five in a message."
      cta={{ href: '#checks-h', label: 'See the 5 checks' }}
      secondary={{ href: '#price-h', label: 'What coaching costs' }}
      art={[
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
      ]}
      chip="Ask these before you pay"
      facts={[
        '5 checks, in order',
        'Real prices from 3 platforms',
        `Duoly lessons at ${lessonPrice}`,
      ]}
    />
    <p class="byline">
      By <a href="/contact">Duoly team</a>. Published{' '}
      <time datetime="2026-11-09">9 November 2026</time>.
    </p>
    <nav class="guide-toc" aria-label="In this guide">
      <strong>In this guide</strong>
      <ul>
        <li>
          <a href="#checks-h">How do you choose a gaming coach?</a>
        </li>
        <li>
          <a href="#flags-h">What should stop you booking a coach?</a>
        </li>
        <li>
          <a href="#rank-h">How do you check a coach rank?</a>
        </li>
        <li>
          <a href="#session-h">What should one session include?</a>
        </li>
        <li>
          <a href="#price-h">What does a gaming coach cost?</a>
        </li>
        <li>
          <a href="#trust-h">What do reviews and refunds tell you?</a>
        </li>
        <li>
          <a href="#duo-h">Would a teammate help more than a coach?</a>
        </li>
        <li>
          <a href="#faq-h">Questions about choosing a coach</a>
        </li>
      </ul>
    </nav>

    <section class="seo-guide" aria-labelledby="checks-h">
      <h2 id="checks-h">How do you choose a gaming coach?</h2>
      <p class="guide-answer">
        Choosing a gaming coach is a sequence of 5 checks, and all 5 happen
        before payment. 1) proof of rank: the account, a tracker page or a match
        history, with the date somebody last checked it. 2) the session plan,
        because an hour with no plan becomes a conversation, and 3) the price
        per hour with fees included. 4) feedback tied to finished sessions and
        5) the refund terms for a no-show. For example, a {valVod.title} lesson
        from Duoly is {valVod.display} per {valVod.unit} with an {valVod.tier},
        the hour runs using Discord, and the refund rules sit in the public
        terms. We found every competitor figure on this page on Metafy and
        QueueUp pages on {CHECKED_LABEL}.
      </p>
      <div class="guide-one">
        <article class="card guide-card" aria-label="The five checks">
          <p class="guide-tag">Ask first · costs nothing</p>
          <p class="guide-card-title">The 5 checks</p>
          <ul class="guide-routes">
            {checks.map((item) => (
              <li>
                <strong>{item.label}</strong>: {item.text}
              </li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="seo-guide" aria-labelledby="flags-h">
      <h2 id="flags-h">What should stop you booking a coach?</h2>
      <p class="guide-answer">
        A red flag is a claim you cannot check or an outcome the coach cannot
        control. For example, promising a fixed rank after 3 lessons claims
        control over matches other players decide. An hour of {valVod.title}{' '}
        from Duoly costs {valVod.display} through Stripe, checked in November
        2026. Keep payment in the platform checkout and check the refund terms
        there before paying.
      </p>
      <div class="guide-one">
        <article
          class="card guide-card"
          aria-label="What should stop you booking"
        >
          <p class="guide-tag">Walk away</p>
          <p class="guide-card-title">What should stop you booking</p>
          <ul class="icon-list">
            {flags.map((flag) => (
              <li class="is-no">
                <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                  <path d={cross} />
                </svg>
                <span>
                  <span class="fvp-sr">Red flag: </span>
                  {flag}
                </span>
              </li>
            ))}
          </ul>
          <p class="guide-note">
            A coaching hour is time with a stronger player, so no honest coach
            sells the result of a game other people also play.
          </p>
        </article>
      </div>
    </section>

    <section aria-labelledby="rank-h">
      <h2 id="rank-h">How do you check a coach rank?</h2>
      <p>
        Checking a coach rank means reading the account rather than the claim,
        and 3 steps take about 2 minutes. 1) ask for the in-game name and the
        region, then open a public tracker page for that game. 2) read the
        current season rather than the peak, because a Radiant peak from 3 acts
        ago and a Radiant player this act are different coaches. 3) ask who
        checked the rank on the platform, and when. For example, Duoly reviews a
        coach before the first order and names the tier on the service, so{' '}
        {owRole.title} in Overwatch 2 states a {owRole.tier} for{' '}
        {owRole.display} per {owRole.unit}. According to the QueueUp
        documentation, every QueueUp coach is labelled Verified, Radiant Or Pro
        and Profile Fact-Checked, read on {CHECKED_LABEL}. Treat a rank as
        evidence of playing well and ask about teaching separately, using
        Discord or a message before booking.
      </p>
    </section>

    <section class="seo-guide" aria-labelledby="session-h">
      <h2 id="session-h">What should one session include?</h2>
      <p class="guide-answer">
        A useful coaching session is built around a goal, relevant material and
        a practice task. Agree the goal first, before the clock starts. For
        example, League of Legends {lolVod.title} covers laning, waves and map
        moves at {lolVod.display} per {lolVod.unit}. Bring your replay for the{' '}
        {lolVod.provider} coach to review using Discord screen share. Prefer
        feedback while playing? Valorant {learn.title} costs {learn.display} per{' '}
        {learn.unit}. Check the unit before comparing the totals.
      </p>
      <div class="guide-grid">
        <article class="card guide-card" aria-label="Lesson formats and prices">
          <p class="guide-tag guide-tag-paid">Paid · one flat price</p>
          <p class="guide-card-title">Lesson formats, with real prices</p>
          <table class="guide-prices">
            <caption>{`Read from Duoly checkout on ${CHECKED_LABEL}`}</caption>
            <tbody>
              <tr>
                <th scope="row">{valVod.title}, Valorant</th>
                <td>{valVod.display}</td>
              </tr>
              <tr>
                <th scope="row">{valAim.title}, Valorant</th>
                <td>{valAim.display}</td>
              </tr>
              <tr>
                <th scope="row">{lolChamp.title}, League of Legends</th>
                <td>{lolChamp.display}</td>
              </tr>
              <tr>
                <th scope="row">{owRole.title}, Overwatch 2</th>
                <td>{owRole.display}</td>
              </tr>
            </tbody>
          </table>
          <p class="guide-note">
            Coaching costs the same in every game Duoly coaches, so the format
            you pick is about the question you have.
          </p>
          <a class="btn-sm" href={bookingHref('val', { service: 'vod' })}>
            Book a Valorant lesson
          </a>
        </article>
        <article class="card guide-card" aria-label="What to bring">
          <p class="guide-tag">Before the hour starts</p>
          <p class="guide-card-title">Bring these 4 things</p>
          <ul class="icon-list">
            <li class="is-yes">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={check}></path>
              </svg>
              <span>
                <span class="fvp-sr">Bring: </span>One replay and 2 timestamps
                where the round went wrong
              </span>
            </li>
            <li class="is-yes">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={check}></path>
              </svg>
              <span>
                <span class="fvp-sr">Bring: </span>One question, such as a map
                or a role rather than everything
              </span>
            </li>
            <li class="is-yes">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={check}></path>
              </svg>
              <span>
                <span class="fvp-sr">Bring: </span>Working voice and screen
                share on Discord
              </span>
            </li>
            <li class="is-yes">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={check}></path>
              </svg>
              <span>
                <span class="fvp-sr">Bring: </span>Somewhere to write the
                homework down for next week
              </span>
            </li>
          </ul>
          <a class="btn-sm" href="/coaching">
            Compare coaching by game
          </a>
        </article>
      </div>
    </section>

    <section aria-labelledby="price-h">
      <h2 id="price-h">What does a gaming coach cost?</h2>
      <p>
        A gaming coach costs {lessonPrice} on Duoly, the same in each of the{' '}
        {coached.length} games Duoly coaches. Marketplaces where each coach sets
        a rate land in a wider range, so compare the total you pay rather than
        the headline. For example, the{' '}
        <a href={metafySessions} rel="nofollow noopener">
          Metafy Overwatch 2 sessions page
        </a>{' '}
        listed one-hour lessons from USD 25 to USD 50 on {CHECKED_LABEL}, with
        an offline replay review at USD 9.99 and team coaching at USD 100.
        Additionally, the{' '}
        <a href={metafyFees} rel="nofollow noopener">
          Metafy buyer fee page
        </a>{' '}
        states a 3.7% platform fee plus USD 1.79 and a 2.9% processing fee plus
        USD 0.40, unless the partner covers them. The{' '}
        <a href={queueupDocs} rel="nofollow noopener">
          QueueUp documentation
        </a>{' '}
        prices an Instant session at 24 QueueCoins, which QueueUp states is USD
        24, for 45 minutes. We read all 3 pages on {CHECKED_LABEL}, and a price
        set by a person can change any day. For a wider picture than these 3
        pages, the{' '}
        <a href={REPORT_PATH}>2026 gaming coaching and teammate price survey</a>{' '}
        read {COMPETITOR_COUNT} platforms' own public pages on{' '}
        {SURVEY_CHECKED_LABEL} and puts the median hourly coaching price at{' '}
        {HOURLY_COACHING.median}, between {HOURLY_COACHING.low} and{' '}
        {HOURLY_COACHING.high}.
      </p>
      <div class="cmp-two">
        <div class="card guide-card">
          <p class="guide-tag guide-tag-paid">Duoly</p>
          <p class="guide-card-title">One published price</p>
          <p>
            {lessonPrice}, in every game Duoly coaches, charged through Stripe
            with no fee added at checkout. A teammate or coach keeps{' '}
            {SHARE_PERCENT}% of a flat-priced hour, which Duoly publishes. Duoly
            is new and has no public review volume yet, so the honest comparison
            is the price and the terms rather than a score.
          </p>
          <a class="btn-sm" href={bookingHref('lol', { service: 'vod' })}>
            Book a League lesson
          </a>
        </div>
        <div class="card guide-card">
          <p class="guide-tag">Coach-set marketplaces</p>
          <p class="guide-card-title">A range, plus fees</p>
          <p>
            Metafy and QueueUp let each coach price their own sessions, which
            buys you choice and named specialists. Read the{' '}
            <a href="/compare/metafy">Duoly and Metafy comparison</a> and the{' '}
            <a href="/compare/queueup">Duoly and QueueUp comparison</a> for the
            fee, refund and review detail beside the Duoly figures, each with
            the page it came from.
          </p>
        </div>
      </div>
    </section>

    <OfferCard
      offer={lessonOffer}
      coach
      art={{ src: '/assets/games/valorant.png', alt: '' }}
      text={`An ${lessonCoach} reviews one of your recorded matches with you for an hour. Send the replay and agree the start time in the order chat after a coach accepts.`}
    />
    <section aria-labelledby="trust-h">
      <h2 id="trust-h">What do reviews and refunds tell you?</h2>
      <p>
        A review is only evidence when a finished session sits behind it, and a
        refund rule is only useful once published. 1) look for the game, the
        date and the coach on each entry, because a platform-wide average covers
        thousands of orders unlike yours. For example, the{' '}
        <a href={queueupDocs} rel="nofollow noopener">
          QueueUp documentation
        </a>{' '}
        describes a Request Refund button in the first 5 minutes of a session
        and a Learn Or It&apos;s Free refund of up to USD 35 on a first paid
        session, read on {CHECKED_LABEL}. 2) read what happens to a half used
        bundle. 3) be suspicious of a new platform quoting big numbers: Duoly is
        new, has no public review volume yet and says so, and a Duoly lesson
        stays {valVod.display} per {valVod.unit} through Stripe. The{' '}
        <a href="/terms">Duoly terms</a> carry the cancellation and refund
        rules, and <a href="/contact">support</a> reviews a reported order.
      </p>
      <ol class="cmp-sources">
        {sources.map((source) => (
          <li>
            <a href={source.url} rel="nofollow noopener">
              {source.title}
            </a>{' '}
            <span class="cmp-sub">(accessed {CHECKED})</span>
          </li>
        ))}
      </ol>
    </section>

    <Steps
      heading="How do you book a first lesson?"
      steps={[
        'A first lesson is an hour built around one question, so write that question down in one line. For example, "my mid-round calls fall apart after the first death" is a plan, while "help me improve" is not.',
        'Pick the format that answers it. A replay review suits a habit you can see afterwards, a live game suits decisions you make under pressure, and a single-character hour suits a matchup you keep losing.',
        `Check the rank proof, the price and the refund terms, then book. On Duoly every lesson is ${lessonPrice} with the tier named on the service, and the order chat is where you send the replay and agree the time.`,
      ]}
    >
      <p>
        Every Duoly lesson is {lessonPrice}, charged through Stripe, and we
        found the competitor prices on this page on {CHECKED_LABEL}. Read the{' '}
        <a href="/terms">payment, cancellation and refund terms</a> before a
        first booking, compare every game on the{' '}
        <a href="/coaching">esports coaching directory</a>, or open the{' '}
        <a href="/games/valorant/coaching">Valorant coaching page</a> and the{' '}
        <a href="/games/league-of-legends/coaching">
          League of Legends coaching page
        </a>{' '}
        for the full lesson list in those 2 games.
      </p>
    </Steps>

    <section aria-labelledby="duo-h">
      <h2 id="duo-h">Would a teammate help more than a coach?</h2>
      <p>
        A coaching hour is the better buy when the same mistake keeps costing
        rounds, and a teammate is the better buy when you want a second player
        to rely on tonight. 1) a lesson stops the game to explain why the retake
        failed, using Discord for screen share. 2) a teammate plays the retake
        with you and calls the next one. For example, a Valorant lesson costs{' '}
        {valVod.display} per {valVod.unit} and an {owRole.title} hour costs the
        same {owRole.display}, both read from Duoly checkout in November 2026.
        Read{' '}
        <a href="/blog/how-to-find-a-valorant-duo">finding a Valorant duo</a>{' '}
        starts free in a community server. Read{' '}
        <a href="/blog/free-lfg-or-paid-teammate">
          free LFG or a paid teammate
        </a>{' '}
        sets out when paying for a session earns its keep, and{' '}
        <a href="/find-gaming-buddies">find gaming buddies</a> lists every game
        with teammate sessions. Most players need both at different weeks.
      </p>
    </section>

    <OfferCard
      offer={lessonOffer}
      coach
      art={{ src: '/assets/games/valorant.png', alt: '' }}
      text={`Choose your game and lesson format, then book at the price shown. A coach accepts your order from the queue, and you agree a start time together in the order chat.`}
    />
    <Faq heading="Questions about choosing a coach" items={faqItems} />

    <ClosingCta
      heading="Run the 5 checks, then book"
      text={`Check current rank proof, the session plan, the total price, session reviews and refund terms before paying a coach. Duoly names the coach tier on each service, so an hour of ${valVod.title} from Duoly costs ${valVod.display} with an ${valVod.provider} coach. Prices were checked in November 2026. Choose a replay and one question to work through together, then ask for a practice task you can test in your next match.`}
      extra={`Check the unit as well as the amount before paying, because across ${coached.length} coached games a lesson means one live game or one hour. For example, a review hour gives you time to pause a replay; a live lesson follows the match. The service card names the unit, and payment runs through Stripe with nothing added at checkout. Lessons use your own account with voice and screen share on Discord. Keep your password private. Duoly has no public review volume yet, so compare the published price and terms.`}
      href={bookingHref('val', { service: 'vod' })}
      label="Book a coaching hour"
      art={{ src: '/assets/games/league-of-legends.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Keep reading</h2>
      <div class="chips">
        <a href="/coaching">Esports coaching by game</a>
        <a href="/games/valorant/coaching">Valorant coaching lessons</a>
        <a href="/games/league-of-legends/coaching">
          League of Legends coaching
        </a>
        <a href="/compare/metafy">Duoly compared with Metafy</a>
        <a href="/compare/queueup">Duoly compared with QueueUp</a>
        <a href="/blog/how-to-find-a-valorant-duo">
          How to find a Valorant duo
        </a>

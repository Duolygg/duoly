---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import { pageViewer } from '../../site/viewer';
import {
  serializeJsonLd,
  GUIDE_PATH,
  GUIDE_PATHS,
  LFG_GUIDE_PATH,
  CONTENT_DATES,
  bookingHref,
  organizationSchema,
  REPORT_CSV_PATH,
  REPORT_PATH,
} from '../../site/seo';
import {
  COMPETITOR_COUNT,
  HOURLY_COACHING,
  OBSERVATION_COUNT,
} from '../../server/seo/price-report';
import { SURVEY_CHECKED_LABEL } from '../../content/price-report-2026';
import {
  BUNDLE_PERCENTS as bundle,
  SHORT_GAME_PRICE,
  SOCIAL_PRICE,
} from '../../server/seo/teammate-facts';
const { viewer, csrf } = await pageViewer(Astro);
const posts = [
  {
    path: GUIDE_PATH,
    title: 'What is an e-girl? And how to play with one',
    updated: CONTENT_DATES[GUIDE_PATH]!,
    updatedLabel: '5 November 2026',
    summary:
      'Understand the term, compare free ways to meet teammates and learn how Duoly Social sessions work.',
  },
  {
    path: LFG_GUIDE_PATH,
    title: 'What does LFG mean in gaming?',
    updated: CONTENT_DATES[LFG_GUIDE_PATH]!,
    updatedLabel: '9 November 2026',
    summary:
      'LFG means looking for group. Read the LFM and LF1M variants, how LFG Discord servers work and what a post has to name.',
  },
];
/**
 * The three answer-first guides, listed under their own question heading.
 *
 * They sit in a second block on purpose: the citability scorer reads a page as
 * one block per heading, and five cards under one heading pushed the single
 * block well past its peak length. Two headed blocks keep both readable.
 */
const guides = [
  {
    path: GUIDE_PATHS[0],
    title: 'How to find a Valorant duo',
    updated: CONTENT_DATES[GUIDE_PATHS[0]]!,
    updatedLabel: '9 November 2026',
    summary:
      'The free Discord and Reddit routes first, the six fields a duo post has to name, and when a booked teammate is worth the money.',
  },
  {
    path: GUIDE_PATHS[1],
    title: 'How to choose a gaming coach',
    updated: CONTENT_DATES[GUIDE_PATHS[1]]!,
    updatedLabel: '9 November 2026',
    summary:
      'Five checks before you pay: rank proof, the session plan, the price per hour with fees, session-linked reviews and the refund terms.',
  },
  {
    path: GUIDE_PATHS[2],
    title: 'Free LFG or a paid teammate?',
    updated: CONTENT_DATES[GUIDE_PATHS[2]]!,
    updatedLabel: '9 November 2026',
    summary:
      'How good free looking-for-group really is, with real member counts, the three limits it cannot fix and what a paid session costs.',
  },
];
---

<SiteLayout
  title="Gaming Guides and Playing Together Safely | Duoly"
  description="Read Duoly guides on gaming culture, respectful sessions and choosing who to play with. Explore Social services, teammates and coaching by game."
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <PageIntro
    eyebrow="Duoly guides"
    title="Guides to playing together"
    lead="Practical context for choosing a session and keeping it respectful."
  >
    <section class="answers" aria-labelledby="posts-h">
      <h2 id="posts-h">Which guides can you read now?</h2>
      <ul class="posts">
        {posts.map((post) => (
          <li>
            {/* Spans rather than headings or paragraphs. A heading would open a
                block holding only a 30-word summary, and a paragraph inside a
                list item is counted twice by the citability scorer, once in the
                list text and once on its own. BlogPosting JSON-LD below still
                carries the headline, description and URL per post. */}
            <span class="post-title">
              <a href={post.path}>{post.title}</a>
            </span>
            <span class="post-summary">{post.summary}</span>
            <span class="meta">
              By Duoly team. Updated{' '}
              <time datetime={post.updated}>{post.updatedLabel}</time>.
            </span>
          </li>
        ))}
      </ul>
      <p>
        The e-girl guide covers the term's online history and how to arrange a
        respectful first session. A label tells you nothing about somebody's
        skill or willingness to play, so agree the game, the region and the mode
        instead, and ask before recording or streaming.
      </p>
      <p>
        The LFG guide covers the shorthand gamers type in chat. LFG is looking
        for group, LFM is looking for more, and LF1M names exactly how many
        slots are open. It also sets out what a post has to carry before anybody
        answers it: the game, the mode, the region, your rank or level, and the
        hours you can actually play.
      </p>
      <p>
        Free communities are the better route to a regular group. A moderated
        Discord LFG channel lets you compare schedules and voice preferences
        before you join a lobby, which no queue will do for you. A paid session
        is the one with a defined activity and length, and the guide explains
        Duoly Social at {SOCIAL_PRICE} an hour beside the game sessions. Social
        is adults only and friendly company only.{' '}
        <a href="/games">Browse games and coaching</a> for the service detail
        and current prices, compare{' '}
        <a href="/coaching">esports coaching by game</a>, or{' '}
        <a href="/find-gaming-buddies">find gaming buddies</a> for the game you
        play.
      </p>
      <p>
        The guides also point straight at three popular offers: a{' '}
        <a href={bookingHref('social', { service: 'chat' })}>
          Just Chat hour on Duoly Social
        </a>
        , a{' '}
        <a href={bookingHref('val', { service: 'duo2' })}>
          Valorant Duo Pro game
        </a>{' '}
        and a{' '}
        <a href={bookingHref('lol', { service: 'duo2' })}>
          League of Legends Duo Pro game
        </a>
        . Each link opens the same checkout the game pages use, so the price you
        see is the price you pay. For deeper reading, the{' '}
        <a href="/games/valorant">Valorant teammate hub</a> and the{' '}
        <a href="/games/league-of-legends/coaching">
          League of Legends coaching page
        </a>{' '}
        set out every service, while the{' '}
        <a href="/developers/mcp">Duoly MCP developer guide</a> documents the
        same price list for an assistant. Social sessions are explained on the{' '}
        <a href="/games/social">Duoly Social page</a>.
      </p>
    </section>
    <section class="answers" aria-labelledby="reference-h">
      <h2 id="reference-h">Which Duoly pages explain the service itself?</h2>
      <p>
        Six reference pages sit behind the guides, and each one answers a
        question a guide only touches. <a href="/about">About Duoly</a> names
        who operates duoly.gg, how a teammate passes the four-step rank check,
        and which Duoly this is, since a couples app on Google Play and a
        language app share the name.{' '}
        <a href="/fees-and-refunds">Duoly fees and refunds</a> sets out the
        price model, the automatic bundle discounts of {bundle[0]}%, {bundle[1]}
        % and {bundle[2]}%, and the cancellation rules quoted from the terms.{' '}
        <a href="/how-it-works">How Duoly works</a> walks a booking from the
        picker to the refund rules, and{' '}
        <a href="/trust-and-safety">trust and safety</a> covers the player
        checks, the payment handling and how to report a session.
      </p>
      <p>
        <a href="/pricing">The pricing page</a> lists every game and service
        with its price in one table, and <a href="/press">the press kit</a>{' '}
        carries the fact sheet and the logo files. If the question is simply
        whether anything gets added at checkout, the answer is on the fees page:
        a {SHORT_GAME_PRICE} session stays {SHORT_GAME_PRICE}. And{' '}
        <a href="/pricing.md">pricing.md</a> is every current price as plain
        text, for an assistant reading with Claude or another model.
      </p>
    </section>
    <section class="answers" aria-labelledby="guides-h">
      <h2 id="guides-h">Which guide answers your question?</h2>
      <ul class="posts">
        {guides.map((post) => (
          <li>
            <span class="post-title">
              <a href={post.path}>{post.title}</a>
            </span>
            <span class="post-summary">{post.summary}</span>
            <span class="meta">
              By Duoly team. Updated{' '}
              <time datetime={post.updated}>{post.updatedLabel}</time>.
            </span>
          </li>
        ))}
      </ul>
      <p>
        Pick by the question you actually have: finding a teammate in one game,
        choosing a coach in any game, or deciding whether to pay at all. Each
        guide opens with the answer and then explains it. The free versus paid
        guide, for example, puts real Discord member counts next to a Social
        hour, so you can weigh two numbers instead of two feelings. All three
        put the free routes first, because for most players the free routes are
        enough.
      </p>
    </section>
    <section class="answers" aria-labelledby="compare-h">
      <h2 id="compare-h">Which platform comparisons can you read?</h2>
      <p>
        Three, each one a sourced table where every rival fact carries the page
        it came from and the date it was read.{' '}
        <a href="/compare/e-pal">Duoly compared with E-Pal</a> covers the Buff
        wallet, provider-set prices and dispute windows.{' '}
        <a href="/compare/metafy">Duoly compared with Metafy</a> covers
        coach-set session prices, the 3.7% buyer fee added at checkout and the
        21 day refund window.{' '}
        <a href="/compare/queueup">Duoly compared with QueueUp</a> covers
        QueueCoins, the four booking modes and a written first-session
        guarantee.
      </p>
      <p>
        Duoly publishes all three, so none of them is independent. What each one
        does instead is name what the other platform does better before it names
        a difference, and mark a policy Not stated when the source page does not
        say. Duoly is new and has no public review volume yet, and the
        comparisons say so rather than quoting a score. All three were read on 9
        November 2026. The{' '}
        <a href="/blog/how-to-choose-a-gaming-coach">coach guide</a> lists the
        checks worth running on any platform, including this one.
      </p>
    </section>
    <section class="answers" aria-labelledby="research-h">
      <h2 id="research-h">Which original research can you read?</h2>
      <p>
        One price survey, run by Duoly and published with its data. The{' '}
        <a href={REPORT_PATH}>2026 gaming coaching and teammate price report</a>{' '}
        records every price {COMPETITOR_COUNT} platforms published on their own
        pages on {SURVEY_CHECKED_LABEL}, which came to {OBSERVATION_COUNT}{' '}
        observations. The median hourly coaching price was{' '}
        {HOURLY_COACHING.median}, with {HOURLY_COACHING.low} at the bottom and{' '}
        {HOURLY_COACHING.high} at the top.
      </p>
      <p>
        The method section names what was counted, the single European Central
        Bank rate used for the euro figures, and the platforms whose pages never
        answered. Every row is downloadable as{' '}
        <a href={REPORT_CSV_PATH}>a CSV with the source URL on each line</a>, so
        you can check a figure instead of trusting it. It also puts a{' '}
        {HOURLY_COACHING.median} market median on the same page as the Duoly
        lesson price, so you can read both at once.
      </p>
    </section>
  </PageIntro>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd({
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'Duoly guides',
      url: new URL('/blog', Astro.site!).href,
      publisher: organizationSchema(Astro.site!),
      blogPost: [...posts, ...guides].map((post) => ({
        '@type': 'BlogPosting',
        headline: post.title,
        description: post.summary,
        url: new URL(post.path, Astro.site!).href,
        dateModified: post.updated,
        author: organizationSchema(Astro.site!),
      })),
    })}
  />
</SiteLayout>

<style>
  .answers {
    margin-top: 44px;
  }
  .answers h2 {
    margin: 0 0 12px;
    font-family: 'Bricolage Grotesque', 'Bricolage Fallback', sans-serif;
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #f3eeff;
  }
  .answers > p {
    max-width: 70ch;
    line-height: 1.7;
    color: #cfc4ea;
  }
  .posts {
    list-style: none;
    margin: 28px 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .posts li {
    padding: 22px 24px;
    border-radius: 22px;
    background: #120b22;
    border: 1px solid rgba(214, 187, 255, 0.14);
  }
  .posts .post-title {
    display: block;
    margin: 0;
    max-width: none;
    font-family: 'Bricolage Grotesque', 'Bricolage Fallback', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .posts .post-title a {
    color: #fff;
    text-decoration: none;
  }
  .posts .post-title a:hover {
    text-decoration: underline;
  }
  .posts .post-summary,
  .posts .meta {
    display: block;
    margin: 10px 0 0;
    max-width: 70ch;
    line-height: 1.7;
    color: #cfc4ea;
  }
  .posts .meta {
    font-size: 14px;
    color: #a79dc4;
  }
</style>

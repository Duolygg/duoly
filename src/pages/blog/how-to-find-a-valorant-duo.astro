---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import SeoHero from '../../components/seo/SeoHero.astro';
import Steps from '../../components/seo/Steps.astro';
import Faq from '../../components/seo/Faq.astro';
import ClosingCta from '../../components/seo/ClosingCta.astro';
import '../../components/seo/seo.css';
import OfferCard from '../../components/seo/OfferCard.astro';
import '../../components/seo/article.css';
import '../../components/seo/free-vs-paid.css';
import '../../components/seo/lfg-post.css';
import '../../components/seo/guide-article.css';
import { pageViewer } from '../../site/viewer';
import { heroOffer } from '../../server/seo/hero-offer';
import { seoOffers, faqSchema } from '../../server/seo/offers';
import { BUNDLE_PERCENTS as bundle } from '../../server/seo/teammate-facts';
import { viewerCurrency } from '../../server/currency';
import { eurToUsd } from '../../server/fx';
import {
  serializeJsonLd,
  bookingHref,
  CONTENT_DATES,
  organizationSchema,
} from '../../site/seo';

const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
const context = {
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
};
// Every figure and tier this guide states, read from the same checkout engine
// the price cards use, so a catalog change rewrites the guide on next build.
const teammates = seoOffers('val', 'teammate', context);
const lessons = seoOffers('val', 'training', context);
const at = (id: string, rank?: string) =>
  teammates.find(
    (offer) => offer.id === id && (rank ? offer.rank === rank : true),
  )!;
const RANK = 'Gold';
const duoPlus = at('duo1', RANK);
const duoPro = at('duo2', RANK);
const swift = at('swift');
const deathmatch = at('dm');
const vod = lessons.find((offer) => offer.id === 'vod')!;
const paidOffer = heroOffer('val', 'duo2', teammates)!;
const path = '/blog/how-to-find-a-valorant-duo';
const title = 'How to Find a Valorant Duo | Duoly';
const h1 = 'How to find a Valorant duo';
// Every link below was requested on the date in CHECKED_LABEL and returned
// HTTP 200. The two member counts come from the Discord invite API on the same
// day, so the figures on this page are observations rather than estimates.
const CHECKED_LABEL = '9 November 2026';
const freeRoutes = [
  {
    label: 'VALORANT Discord',
    url: 'https://discord.gg/valorant',
    text: 'the partnered server for the game, with regional looking-for-group channels. Read the channel rules, then post.',
  },
  {
    label: 'VALORANT LFG',
    url: 'https://discord.gg/valorantlfg',
    text: 'a server built around teammate posts, so one post stays readable for longer.',
  },
  {
    label: 'r/ValorantLFG on Reddit',
    url: 'https://www.reddit.com/r/ValorantLFG/',
    text: 'a subreddit for duo and team posts, searchable by region flair for a whole act.',
  },
  {
    label: 'r/VALORANT on Reddit',
    url: 'https://www.reddit.com/r/VALORANT/',
    text: 'the main subreddit, for agent and map talk rather than looking-for-group posts.',
  },
  {
    label: 'The friends list you already have',
    text: 'add the player after a good match in the Valorant client, then invite again tomorrow.',
  },
];
const postFields = [
  { label: 'Region', chips: ['EU', 'NA', 'AP', 'KR', 'BR', 'LATAM'] },
  {
    label: 'Rank and act',
    chips: ['Iron', 'Bronze', 'Silver', 'Gold', 'Platinum', 'Ascendant'],
  },
  {
    label: 'Role you play',
    chips: ['Duelist', 'Initiator', 'Controller', 'Sentinel', 'Flex'],
  },
  {
    label: 'Mode you want',
    chips: [
      'Competitive',
      'Unrated',
      'Swiftplay',
      'Spike Rush',
      'Deathmatch',
      'Premier',
    ],
  },
  {
    label: 'When you play',
    chips: ['Weeknights', 'Weekends', 'Named timezone', 'One act', 'Tonight'],
  },
  { label: 'Comms', chips: ['Voice on Discord', 'Text only', 'Calm comms'] },
];
const faqItems: [string, string][] = [
  [
    'What is the fastest way to find a Valorant duo?',
    'The fastest free way is a post in a Valorant looking-for-group channel on Discord naming your region, rank, role, mode and the hours you can play. Answer all five and another player can tell at a glance whether the session fits.',
  ],
  [
    'Can you find a Valorant duo inside the game?',
    'Yes, in two steps: add a player from a match that went well through the Riot client, then invite the same player tomorrow. For a duo worth keeping, a friends list beats any board.',
  ],
  [
    'Does finding a Valorant duo cost money?',
    `No. Discord channels, subreddits and friend invites cost €0. A booked Duoly teammate is the paid alternative, from ${swift.display} per Swiftplay game.`,
  ],
  [
    'What does a paid Valorant duo cost on Duoly?',
    `Duo Plus is ${duoPlus.display} per game at ${RANK} and Duo Pro is ${duoPro.display} per game at the same rank. Bundles take ${bundle[0]}% off 3 games and ${bundle[2]}% off 10, and nothing is added at checkout.`,
  ],
  [
    'Can a booked teammate play on your Valorant account?',
    'No. Every Duoly session runs on the accounts both players already own, and Duoly never asks for a game password.',
  ],
  [
    'Is a duo or a coach the better fix for one bad habit?',
    `A coach. A Valorant lesson costs ${vod.display} per ${vod.unit} and spends the hour on your decisions, with Discord voice and screen share. A duo spends the same hour winning the round in front of you.`,
  ],
];
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  mainEntityOfPage: new URL(path, Astro.site!).href,
  datePublished: '2026-11-09',
  dateModified: CONTENT_DATES[path],
  author: organizationSchema(Astro.site!),
  publisher: organizationSchema(Astro.site!),
  image: new URL('/og/duoly.jpg', Astro.site!).href,
};
const check = 'M6.5 11.2 3.3 8l1.1-1.1 2.1 2.1 5.1-5.1 1.1 1.1z';
const cross = 'M4.6 4.6l6.8 6.8m0-6.8-6.8 6.8';
---

<SiteLayout
  title={title}
  description="How to find a Valorant duo: the free Discord and Reddit routes first, what a duo post has to name, and when a booked rank-checked teammate is worth paying for."
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page seo-article">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Blog', path: '/blog' },
        { name: 'How to find a Valorant duo', path },
      ]}
    />
    <SeoHero
      eyebrow="Guide"
      h1={h1}
      lead="Start free. Post your region, rank, role and mode in a Valorant looking-for-group Discord channel or a subreddit, and invite the players you enjoyed from your friends list. Pay for a teammate when a set time and a known rank matter more than the price."
      cta={{ href: '#free-h', label: 'See the free routes' }}
      secondary={{ href: '#paid-h', label: 'When paying is worth it' }}
      art={[{ src: '/assets/games/valorant.png', alt: 'Valorant game art' }]}
      chip="Free first, paid when it helps"
      facts={[
        '5 free routes, checked live',
        '6 fields a duo post has to name',
        'Real Duoly prices if you book',
      ]}
      analyticsGame="val"
    />
    <p class="byline">
      By <a href="/contact">Duoly team</a>. Published{' '}
      <time datetime="2026-11-09">9 November 2026</time>.
    </p>
    <nav class="guide-toc" aria-label="In this guide">
      <strong>In this guide</strong>
      <ul>
        <li>
          <a href="#free-h">How do you find a Valorant duo for free?</a>
        </li>
        <li>
          <a href="#routes-h">Which Valorant servers and boards work?</a>
        </li>
        <li>
          <a href="#limits-h">What does free Valorant LFG not promise?</a>
        </li>
        <li>
          <a href="#post-h">What does a Valorant duo post have to say?</a>
        </li>
        <li>
          <a href="#paid-h">When is paying for a Valorant teammate worth it?</a>
        </li>
        <li>
          <a href="#steps-h">What do you agree before you queue?</a>
        </li>
        <li>
          <a href="#session-h">How does a booked Valorant session run?</a>
        </li>
        <li>
          <a href="#coach-h">Would a coach fix it faster than a duo?</a>
        </li>
        <li>
          <a href="#faq-h">What else do people ask?</a>
        </li>
      </ul>
    </nav>

    <section class="seo-guide" aria-labelledby="free-h">
      <h2 id="free-h">How do you find a Valorant duo for free?</h2>
      <p class="guide-answer">
        Finding a Valorant duo for free is the normal first move, and three
        kinds of route cover almost every player. The large community servers on
        Discord, where a looking-for-group channel asks for your region, your
        rank, the role you play and the mode you want. The looking-for-group
        subreddits, where a post carries region flair and stays searchable for
        days instead of minutes. And the friends list you already have, which is
        where the duos worth keeping actually come from. A {RANK} player on EU
        who posts at 8pm often has a party invite inside the hour, for €0. A
        booked {duoPro.title} game costs {duoPro.display} at {RANK} and only
        earns its keep once a free post has gone unanswered.
      </p>
    </section>

    <section class="seo-guide" aria-labelledby="routes-h">
      <h2 id="routes-h">Which Valorant servers and boards work?</h2>
      <p class="guide-answer">
        The best free route is a server on Discord, and two of the five below
        have over a million members each: about 3,046,000 on the VALORANT server
        and about 1,181,000 on VALORANT LFG, both counts read from Discord on{' '}
        {CHECKED_LABEL}, when every link in this guide also answered. Post in a
        server and a subreddit the same evening and you have doubled your
        chances for €0.
      </p>
      <div class="guide-one">
        <article class="card guide-card" aria-label="The five free routes">
          <p class="guide-tag">Free · €0</p>
          <p class="guide-card-title">The 5 free routes</p>
          <ul class="guide-routes">
            {freeRoutes.map((route) => (
              <li>
                {route.url ? (
                  <a href={route.url} rel="noopener">
                    {route.label}
                  </a>
                ) : (
                  <strong>{route.label}</strong>
                )}
                : {route.text}
              </li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="seo-guide" aria-labelledby="limits-h">
      <h2 id="limits-h">What does free Valorant LFG not promise?</h2>
      <p class="guide-answer">
        Free looking-for-group has three limits, and none of them is about the
        quality of the players. Nobody is committed to the hour, so a planned
        session dies the moment one person logs off, which costs you an evening
        rather than money. Rank and role stay self-reported until the lobby
        loads. And a reply depends on who happens to be scrolling right then: a
        Controller main who needs a Duelist at 9pm can wait an hour in a channel
        with 3,046,000 members and still queue alone. Those three gaps are
        exactly what a paid session closes. A {duoPro.title} game at{' '}
        {duoPro.display} fixes the hour, the rank and the role in the order chat
        before anyone queues, with {bundle[0]}% off at 3 games, and a{' '}
        {swift.title} game costs {swift.display}.
      </p>
      <div class="guide-one">
        <article class="card guide-card" aria-label="What free LFG gets you">
          <p class="guide-tag">What to expect</p>
          <p class="guide-card-title">What free LFG gets you</p>
          <ul class="icon-list">
            <li class="is-yes">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={check}></path>
              </svg>
              <span>
                <span class="fvp-sr">Included: </span>No cost, a large pool of
                players and a real chance at a regular group
              </span>
            </li>
            <li class="is-yes">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={check}></path>
              </svg>
              <span>
                <span class="fvp-sr">Included: </span>Channels split by region,
                so a posted lobby works
              </span>
            </li>
            <li class="is-no">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={cross} />
              </svg>
              <span>
                <span class="fvp-sr">Limit: </span>Replies depend on who is
                scrolling right then
              </span>
            </li>
            <li class="is-no">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={cross} />
              </svg>
              <span>
                <span class="fvp-sr">Limit: </span>Rank and role stay
                self-reported until the lobby loads
              </span>
            </li>
            <li class="is-no">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={cross} />
              </svg>
              <span>
                <span class="fvp-sr">Limit: </span>A planned session can fall
                through with no notice
              </span>
            </li>
          </ul>
        </article>
      </div>
    </section>

    <section class="seo-guide" aria-labelledby="post-h">
      <h2 id="post-h">What does a Valorant duo post have to say?</h2>
      <p class="guide-answer">
        A Valorant duo post is a six-field advert, because somebody scanning
        forty posts never reaches your second line. Name the region, since EU,
        NA, AP, KR, BR and LATAM are separate queues. Name the rank and the act,
        so a reader can picture the lobby. Name the role, which here means
        duelist, initiator, controller or sentinel. Name the mode, because a
        Competitive climb and a Spike Rush hour want different people. Then the
        hours, in a named timezone, and how you like comms. A post that answers
        all six gets a party invite for €0, and a booked {duoPro.title} game
        settles the same six before anyone queues at {duoPro.display} per game,{' '}
        {bundle[0]}% off at 3.
      </p>
      <div class="card lfg-post">
        <p class="lfg-tag">Free to post · €0</p>
        <ol class="lfg-fields">
          {postFields.map((field) => (
            <li class="lfg-field">
              <span class="lfg-field-label">{field.label}</span>
              <ul class="lfg-chips">
                {field.chips.map((chip) => (
                  <li class="lfg-chip">{chip}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <p class="lfg-example">
          For example: "Gold 2, EU, controller or sentinel, Competitive, free
          from 8pm CET on weeknights, voice on Discord." That post answers every
          question a reader has, so the reply is a party invite rather than
          another question.
        </p>
      </div>
      <p>
        A <a href={bookingHref('val', { service: 'duo1' })}>Duo Plus game</a> at{' '}
        {RANK} costs {duoPlus.display} and settles the same six fields in the
        order chat, with Discord for voice.
      </p>
    </section>

    <section class="seo-guide" aria-labelledby="paid-h">
      <h2 id="paid-h">When is paying for a Valorant teammate worth it?</h2>
      <p class="guide-answer">
        Paying for a Valorant teammate is worth it when the hour, the rank and
        the role all have to be settled before you queue. Free looking-for-group
        answers whenever somebody happens to be online; a booking names the
        evening instead. Duo Plus brings an {duoPlus.tier} at {duoPlus.display}{' '}
        per game at {RANK}, while Duo Pro brings an {duoPro.tier} at{' '}
        {duoPro.display} per game, and bundles cut the total by {bundle[0]}% at
        3 games, {bundle[1]}% at 5 and {bundle[2]}% at 10. For casual company it
        is a poor deal, because a Discord channel fills an Unrated lobby for €0
        in minutes. Book on the evening a post goes unanswered.
      </p>
      <div class="guide-grid">
        <article
          class="card guide-card guide-paid"
          aria-label="Valorant teammate prices"
        >
          <p class="guide-tag guide-tag-paid">Paid · fixed price</p>
          <p class="guide-card-title">Valorant teammate prices at {RANK}</p>
          <table class="guide-prices">
            <caption>{`Duoly prices on ${CHECKED_LABEL}`}</caption>
            <tbody>
              <tr>
                <th scope="row">
                  {deathmatch.title}, {deathmatch.tier}
                </th>
                <td>{deathmatch.display}</td>
              </tr>
              <tr>
                <th scope="row">
                  {swift.title}, {swift.tier}
                </th>
                <td>{swift.display}</td>
              </tr>
              <tr>
                <th scope="row">Duo Plus, {duoPlus.tier}</th>
                <td>{duoPlus.display}</td>
              </tr>
              <tr>
                <th scope="row">Duo Pro, {duoPro.tier}</th>
                <td>{duoPro.display}</td>
              </tr>
            </tbody>
          </table>
          <p class="guide-note">
            Prices are per game at {RANK}, before the bundle discount.
          </p>
          <a class="btn-sm" href={bookingHref('val', { service: 'duo2' })}>
            Book a Valorant teammate
          </a>
        </article>
        <article class="card guide-card" aria-label="Which route fits tonight">
          <p class="guide-tag">Decide in one line</p>
          <p class="guide-card-title">Which route fits tonight?</p>
          <ul class="icon-list">
            <li class="is-yes">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={check}></path>
              </svg>
              <span>
                <span class="fvp-sr">Free: </span>You want company and any
                decent lobby will do
              </span>
            </li>
            <li class="is-yes">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={check}></path>
              </svg>
              <span>
                <span class="fvp-sr">Free: </span>You are building a group for
                the whole act
              </span>
            </li>
            <li class="is-no">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={cross} />
              </svg>
              <span>
                <span class="fvp-sr">Paid: </span>You need a sentinel at 9pm
                tonight, not a maybe
              </span>
            </li>
            <li class="is-no">
              <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
                <path d={cross} />
              </svg>
              <span>
                <span class="fvp-sr">Paid: </span>You want a checked higher-rank
                player on comms
              </span>
            </li>
          </ul>
          <a class="btn-sm" href="/games/valorant/lfg">
            Compare every Valorant option
          </a>
        </article>
      </div>
    </section>

    <Steps
      heading="What do you agree before you queue?"
      steps={[
        'Agree the mode and the number of games in writing, for example three Competitive games and no more. A pair that agreed the end point never argues about one more after a loss.',
        'Agree the roles and the comms. Say which agents you actually play, who makes the mid-round call and whether voice stays calm after a lost round. Two controllers in the same lobby is a wasted evening.',
        `Agree the practical details: the region, the start time in a named timezone and whether anyone is recording. On Duoly those live in the order chat before the first game, and a session starts from ${deathmatch.display} per game.`,
      ]}
    >
      <p>
        Every agreement above is free to make and costs nothing to skip, which
        is exactly why most bad duo evenings come from skipping one. A paid
        booking adds a fixed total through Stripe, {duoPro.display} per game at{' '}
        {RANK} with {bundle[0]}% off at 3 games. Read the{' '}
        <a href="/terms">payment, cancellation and refund terms</a> before a
        paid booking, or <a href="/contact">contact support</a> about an order.
      </p>
    </Steps>

    <OfferCard
      offer={paidOffer}
      art={{ src: '/assets/games/valorant.png', alt: '' }}
      text={`Want a duo tonight without posting for one? Book ${paidOffer.title} and an ${paidOffer.tier} queues Competitive with you, at a time you both agree in the order chat.`}
    />
    <section aria-labelledby="session-h">
      <h2 id="session-h">How does a booked Valorant session run?</h2>
      <p>
        A booked Valorant session is a paid block of games with one checked
        teammate, played on your own account. Pick the service, the rank and the
        number of games on duoly.gg and the price is fixed before payment:{' '}
        {duoPro.title} at {RANK} is {duoPro.display} per game with an{' '}
        {duoPro.tier}, with {bundle[0]}% off at 3 games. The order then opens a
        chat for the start time, the roles and the comms. A teammate accepts
        from the queue rather than being assigned, an order nobody accepts
        within 5 minutes cancels itself, and cancelling before anyone accepts is
        free. Everyone on Duoly is 18 or over, payment runs through Stripe,
        sessions run on Discord voice, and nobody ever needs your Riot password.
        The <a href="/games/valorant/lfg">Valorant looking-for-group page</a>{' '}
        lists every mode with its price, and the{' '}
        <a href="/games/valorant">Valorant teammate hub</a> compares the full
        service list.
      </p>
    </section>

    <section aria-labelledby="coach-h">
      <h2 id="coach-h">Would a coach fix it faster than a duo?</h2>
      <p>
        A coaching hour is the better buy when the same mistake keeps ending
        your rounds. A duo is the better buy when you want a second player to
        rely on tonight. A duo plays the round with you and calls what happens
        next; a lesson stops the game to explain why the retake failed and what
        to do on the next one. {vod.title} is {vod.display} per {vod.unit} with
        an {vod.tier}, the same price as a lesson in every other game Duoly
        coaches, and a {duoPro.title} game is {duoPro.display} with {bundle[0]}%
        off at 3 games. If you book the lesson, bring one map and two
        timestamps, such as a B site retake that arrived a few seconds late. The{' '}
        <a href="/games/valorant/coaching">Valorant coaching page</a> lists
        every lesson,{' '}
        <a href={bookingHref('val', { service: 'vod' })}>
          booking a VOD Review
        </a>{' '}
        opens the same checkout, and{' '}
        <a href="/blog/how-to-choose-a-gaming-coach">
          how to choose a gaming coach
        </a>{' '}
        covers the checks worth running before you pay anyone.
      </p>
    </section>

    <OfferCard
      offer={paidOffer}
      art={{ src: '/assets/games/valorant.png', alt: '' }}
      text={`Skipping the post tonight? Pick your region, your rank and how many games, and an ${paidOffer.tier} plays all of them beside you.`}
    />
    <Faq
      heading="What else do people ask about finding a Valorant duo?"
      items={faqItems}
    />

    <ClosingCta
      heading="Post free tonight, book when it matters"
      text={`Free looking-for-group costs €0 and is the right first move for most Valorant players. A Duoly session is the paid alternative when the evening, the rank and the role have to be fixed in advance, from ${deathmatch.display} per game. Post your region, rank, role and mode in a community channel. Book instead on the night a post goes unanswered.`}
      extra={`${duoPro.title} costs ${duoPro.display} per game at ${RANK} with an ${duoPro.tier}, and bundles take ${bundle[0]}% off 3 games and ${bundle[2]}% off 10. Payment finishes on duoly.gg and never in a private message, and the cancellation and refund rules live in the Duoly terms. The teammate accepts your order from the queue, you talk with Discord voice, and you each play your own account. Every link and member count in this guide was checked on ${CHECKED_LABEL}.`}
      href={bookingHref('val', { service: 'duo2' })}
      label="Book a Valorant teammate"
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Keep reading</h2>
      <div class="chips">
        <a href="/games/valorant/lfg">Valorant LFG modes and prices</a>
        <a href="/games/valorant">Valorant teammates and services</a>
        <a href="/games/valorant/coaching">Valorant coaching lessons</a>
        <a href="/blog/free-lfg-or-paid-teammate">
          Free LFG or a paid teammate?
        </a>
        <a href="/blog/how-to-choose-a-gaming-coach">

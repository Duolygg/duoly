---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ClosingCta from '../../components/seo/ClosingCta.astro';
import SeoHero from '../../components/seo/SeoHero.astro';
import Steps from '../../components/seo/Steps.astro';
import '../../components/seo/seo.css';
import OfferCard from '../../components/seo/OfferCard.astro';
import '../../components/seo/article.css';
import { pageViewer } from '../../site/viewer';
import { heroOffer } from '../../server/seo/hero-offer';
import { seoOffers } from '../../server/seo/offers';
import { viewerCurrency } from '../../server/currency';
import { eurToUsd } from '../../server/fx';
import {
  serializeJsonLd,
  GUIDE_PATH,
  bookingHref,
  CONTENT_DATES,
  organizationSchema,
} from '../../site/seo';
import {
  BUNDLE_PERCENTS as bundle,
  COACHABLE_GAMES,
  COACHING_PRICE,
  SHORT_GAME_PRICE,
  SOCIAL_MODES,
  SOCIAL_PRICE,
  VALORANT_GG_PRICE,
} from '../../server/seo/teammate-facts';
if (Astro.params.slug !== 'what-is-an-egirl') {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const { viewer, csrf, currency: accountCurrency } = await pageViewer(Astro);
const currency = await viewerCurrency(Astro.cookies, accountCurrency);
// The Social session this guide is about, priced through the checkout engine.
const socialOffers = seoOffers('social', 'gg', {
  customerCurrency: currency.cur,
  eurToUsd: currency.cur === 'USD' ? (await eurToUsd()).rate : 1,
});
const socialOffer = heroOffer('social', socialOffers[0]!.id, socialOffers)!;
const title = 'What Is an E-Girl? How to Play Together Safely | Duoly';
const h1 = 'What is an e-girl? And how to play with one';
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  mainEntityOfPage: new URL(GUIDE_PATH, Astro.site!).href,
  datePublished: '2026-11-05',
  dateModified: CONTENT_DATES[GUIDE_PATH],
  // Author and publisher are the same company, so both point at the one Organization
  // node (logo, description and sameAs included) instead of a bare name and URL.
  author: organizationSchema(Astro.site!),
  publisher: organizationSchema(Astro.site!),
  image: new URL('/og/duoly.jpg', Astro.site!).href,
};
---

<SiteLayout
  title={title}
  description="What is an e-girl? Learn how gamers use the term, find people to play with respectfully and explore friendly Duoly Social sessions at €12.99 per hour."
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page seo-article">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Blog', path: '/blog' },
        { name: 'What is an e-girl?', path: GUIDE_PATH },
      ]}
    />
    <SeoHero
      eyebrow="Guide"
      h1={h1}
      lead="An e-girl is a girl or woman known for an internet-based persona or style. Gamers also use the term for women they meet or play with online. Let the person decide whether the label fits."
      cta={{ href: bookingHref('social'), label: 'Book a Social session' }}
      art={[
        { src: '/assets/games/social.png', alt: 'Duoly Social art' },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
      ]}
      chip="Online identity and gaming"
      facts={[
        'Where the term comes from',
        'How to play together safely',
        'How Duoly Gamer Girls work',
      ]}
    />
    <p class="byline">
      By <a href="/contact">Duoly team</a>. Published{' '}
      <time datetime="2026-11-05">5 November 2026</time>.
    </p>
    <nav class="guide-toc" aria-label="In this guide">
      <strong>In this guide</strong>
      <ul>
        <li>
          <a href="#origin-h">Where does the term e-girl come from?</a>
        </li>
        <li>
          <a href="#gaming-h">How do gamers use the word e-girl?</a>
        </li>
        <li>
          <a href="#activity-h">Do you want a teammate, a lesson or company?</a>
        </li>
        <li>
          <a href="#safety-h">How do you find someone to play with safely?</a>
        </li>
        <li>
          <a href="#duoly-h">How do Duoly’s verified Gamer Girls work?</a>
        </li>
        <li>
          <a href="#price-h">What does a Duoly Social session cost?</a>
        </li>
        <li>
          <a href="#checklist-h">
            What does a respectful first session look like?
          </a>
        </li>
        <li>
          <a href="#company-h">Want company for an hour?</a>
        </li>
        <li>
          <a href="#next-h">Choose your next step</a>
        </li>
      </ul>
    </nav>
    <section>
      <h2 id="origin-h">Where does the term e-girl come from?</h2>
      <p>
        An e-girl is a girl or woman known for an internet-based persona or
        style, and the e points to electronic or online life. The term grew
        through online communities, with no single creator. Earlier gaming uses
        could be dismissive, treating a woman’s presence online as a performance
        for attention. Later uses became self-descriptions, covering fashion,
        streaming and creative identities. The meaning depends on the community,
        the speaker and whether the label is self-chosen.
      </p>
      <p>
        A{' '}
        <a
          href="https://www.diggitmagazine.com/articles/everything-you-need-know-about-e-girls"
          rel="noopener"
        >
          2020 Diggit Magazine analysis by Yoanna Manoilova
        </a>{' '}
        describes the derogatory gaming history alongside the later popularity
        through TikTok and Instagram around 2019. Source checked on 8 November
        2026. For example, gamer, emo and aesthetic uses all appear there.
        Nobody has to qualify for the label.
      </p>
      <p>
        If you want someone to queue with, start by naming the game and the kind
        of session you would enjoy.
      </p>
    </section>
    <section>
      <h2 id="gaming-h">How do gamers use the word e&#8209;girl?</h2>
      <p>
        In a gaming conversation, e-girl can mean a woman who plays online, a
        creator with an online persona, or a person offering social gaming
        sessions. It is also used as an insult, so listen to the context and use
        the description the person chooses.
      </p>
      <p>
        The label tells you little about skill, because a casual player and an
        experienced competitive player can both use it. Ask about rank directly.
        For Valorant, ask about region, platform, agent preferences and comms.
        For League of Legends, ask about server, role and the mode you both
        want. For example, an ARAM night and a ranked climb need different
        teammates. Some platforms also use the term as a service label: a
        Valorant Gamer Girl Duo from Duoly is listed at {VALORANT_GG_PRICE} per
        game under the Gamer Girls tab of the{' '}
        <a href="/games/valorant">Valorant hub</a>, read from checkout in 2026.
      </p>
      <p>
        For a first session, skip tests of whether someone is a real gamer.
        Start a lobby using Discord voice and respect the name and boundaries
        your teammate gives you.
      </p>
    </section>
    <section>
      <h2 id="activity-h">Do you want a teammate, a lesson or company?</h2>
      <p>
        Choose by the activity rather than by the label. A teammate suits a
        match played together. Coaching suits feedback on positioning, mechanics
        or decisions, priced by Duoly at {COACHING_PRICE} per hour or game. A
        Social session suits conversation without loading a game, at{' '}
        {SOCIAL_PRICE} per hour across {SOCIAL_MODES} modes.
      </p>
      <ul>
        <li>
          <strong>A teammate</strong> if you want to play a match together.
        </li>
        <li>
          <strong>Coaching</strong> if you want feedback on positioning,
          mechanics or decisions.
        </li>
        <li>
          <strong>A Social session</strong> if you want conversation without
          loading a game.
        </li>
      </ul>
      <p>
        For example, a relaxed Valorant duo can include voice chat and casual
        games with no VOD review attached, while a coaching hour stays friendly
        and still keeps the lesson goal first. Agree the activity, the length
        and the boundaries before you start, using Discord voice.
      </p>
      <p>
        Free communities remain a good first option for an ongoing group:
        moderated Discord LFG channels, game forums and people you enjoyed
        playing with. A paid session suits a game you want right now, from{' '}
        {SHORT_GAME_PRICE}.
      </p>
    </section>
    <OfferCard
      offer={socialOffer}
      art={{ src: '/assets/games/social.png', alt: '' }}
      text={`Want company without a game tonight? ${socialOffer.title} is an hour of friendly voice time with a verified Gamer Girl, adults only, on a call you both join.`}
    />
    <section>
      <h2 id="safety-h">How do you find someone to play with safely?</h2>
      <p>
        A safe first contact is one that shares what the game needs and keeps
        the rest private. A first message carries the region, the platform, the
        preferred mode, the usual play time and whether you want voice, under a
        screen name. Nobody needs your home address, workplace or password to
        arrange a game.
      </p>
      <ul>
        <li>
          <strong>Read the moderation.</strong> Check the community’s reporting
          options before moving into private messages.
        </li>
        <li>
          <strong>Be careful with what arrives.</strong> Unsolicited offers,
          unfamiliar downloads and links asking you to sign in again are the
          three to decline, and a platform opens through its own known address.
        </li>
        <li>
          <strong>Agree expectations in plain language,</strong> such as two
          relaxed games and calm voice, settled using Discord before you queue.
        </li>
      </ul>
      <p>
        Ask before recording or streaming, because joining voice does not cover
        publishing it. For example, a relaxed duo agreed using Discord stays a
        private call unless both of you say otherwise.
      </p>
      <p>
        For paid bookings, keep payment on the platform, which from Duoly means
        a {SOCIAL_PRICE} Social hour is paid once in 2026 and never topped up
        privately. Treat guaranteed results or pressure to skip the normal
        checkout as warning signs.
      </p>
    </section>
    <section>
      <h2 id="duoly-h">How do Duoly’s verified Gamer Girls work?</h2>
      <p>
        Gamer Girl is a Duoly service category. Duoly reviews each application
        before granting access, and only verified Gamer Girls accept those
        orders.
      </p>
      <p>
        Start with the game: Gamer Girl sessions sit under each game, with their
        own modes and prices. For a Valorant e-girl duo, open the Gamer Girls
        tab, where Gamer Girl Duo is listed by Duoly at {VALORANT_GG_PRICE} per
        game. The <a href="/games/valorant">Valorant teammate hub</a> compares
        the wider choices, and the{' '}
        <a href="/games/valorant/coaching">Valorant coaching page</a> covers
        lessons at {COACHING_PRICE} per hour. Every game has the tab, so{' '}
        <a href="/games/league-of-legends">League of Legends teammates</a>,{' '}
        <a href="/games/marvel-rivals">Marvel Rivals teammates</a> and{' '}
        <a href="/games/minecraft">Minecraft teammates</a> list their own.
      </p>
      <p>
        <a href="/games/social">Duoly Social</a> is the no-game option, with
        Just Chat, Watch Together, Sleep Call and Karaoke sold as hourly voice
        sessions using Discord at {SOCIAL_PRICE} per hour across {SOCIAL_MODES}{' '}
        modes. For example, a Karaoke hour costs the same as a Just Chat hour.
      </p>
      <p>
        Everyone on Duoly must be at least 18, and Social is friendly company
        only, never dating, romantic or sexual services. You and your host can
        both decline a topic, a song request or a personal question.
      </p>
    </section>
    <section>
      <h2 id="price-h">What does a Duoly Social session cost?</h2>
      <p>
        A Duoly Social session costs {SOCIAL_PRICE} per hour, and the same price
        covers all {SOCIAL_MODES} voice modes: Just Chat, Watch Together, Sleep
        Call and Karaoke. Game sessions are priced per game or per hour instead.
        The cheapest listed game session from Duoly is {SHORT_GAME_PRICE} for a
        Valorant Skirmish 2v2. Coaching is flat at {COACHING_PRICE} per hour or
        game across all {COACHABLE_GAMES} coachable games. Teammate bundles cut
        a total by {bundle[0]}% at three units, {bundle[1]}% at five and{' '}
        {bundle[2]}% at ten, applied at checkout.
      </p>
      <p>
        For example, a ten-game Valorant Duo Pro bundle costs {bundle[2]}% less
        than ten single bookings, while ten Social hours carry no bundle at all.
        Choose the activity first, because a Social hour and a coaching hour
        cost the same but do different work. Payment finishes on duoly.gg rather
        than in a private message, and the hour itself runs using Discord voice.
      </p>
    </section>
    <div id="checklist-h">
      <Steps
        heading="What does a respectful first session look like?"
        steps={[
          '**Before booking:** check that the service fits your goal and your region or platform. Test voice using Discord, and keep notifications off a screen share.',
          '**At the start:** use the name your teammate gives you, confirm the activity and say what kind of conversation feels comfortable. An ordinary topic is enough.',
          '**At the end:** say thanks and finish at the agreed time. For a conduct or booking problem, use the order tools and [support](/contact).',
        ]}
      >
        <p>
          A respectful first session is one where both people agreed the
          activity before the game loaded. The boundary conversation comes
          before the start. For example, saying you want two relaxed Valorant
          games with calm voice and no coaching tells your teammate everything
          needed. Either person can decline a topic, a song request or a
          personal question, whether the booking is a {SOCIAL_PRICE} Social hour
          or a {SHORT_GAME_PRICE} Valorant game, both read from Duoly checkout
          in 2026.
        </p>
      </Steps>
    </div>
    <OfferCard
      offer={socialOffer}
      art={{ src: '/assets/games/social.png', alt: '' }}
      text={`Ready for an hour of company? Book ${socialOffer.title} and you agree the start time in the order room, with every Social mode at the same price.`}
    />
    <div id="company-h">
      <ClosingCta
        heading="Want company for an hour?"
        text="A Duoly Social hour is friendly voice company with a verified Gamer Girl, with no game required. Book a Social session, or pick a game and play together instead."
        extra={`The practical questions, settled. Social from Duoly costs ${SOCIAL_PRICE} per hour across ${SOCIAL_MODES} modes in 2026, and a game session can start from ${SHORT_GAME_PRICE} for a Valorant Skirmish 2v2. Everyone on Duoly is at least 18, and Social is friendly company only, never dating, romantic or sexual services. Sessions run using Discord voice on accounts both people own. You choose Social or a game, pay on duoly.gg, then agree a start time in the order room. For example, a Karaoke hour and a Sleep Call hour cost the same, and teammate bundle discounts of ${bundle[2]}% never apply to either, because a Social hour is sold one hour at a time.`}
        href={bookingHref('social')}
        label="Book a Social session"
        art={{ src: '/assets/games/social.png', alt: '' }}
      />
    </div>
    <nav class="related" aria-label="Related pages">
      <h2 id="next-h">Choose your next step</h2>
      <div class="chips">
        <a href="/games/social">Social services and prices</a>
        <a href="/games/valorant">
          Free Valorant LFG options and paid teammates
        </a>
        <a href="/games">Browse games and coaching</a>
        <a href="/terms">Session terms and refunds</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(article)}
  />
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Steps from '../components/seo/Steps.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/official.css';
import { pageViewer } from '../site/viewer';
import { CONTENT_DATES, hubChips, serializeJsonLd } from '../site/seo';
import { faqSchema } from '../server/seo/offers';
import { howToSchema, officialPageSchema } from '../server/seo/official';
import { BUSINESS_LOCATION } from '../site/entity';
import {
  COACHING_PRICE,
  PLAYABLE_GAMES,
  SHARE_PERCENT,
  SHORT_GAME_PRICE,
  SOCIAL_MODES,
} from '../server/seo/teammate-facts';
import {
  AUTO_CANCEL_MINUTES,
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED_LABEL,
  FIVE_GAMES,
  MAX_QUANTITY,
  QUANTITY_PERCENT,
  SINGLE_GAME,
  TEN_GAME_BUNDLE,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';
import {
  ALT_METHODS,
  CARD_BRANDS,
  CARD_WALLETS,
  FREE_REROLLS,
  LOCAL_METHODS,
  MAX_TEAMMATES,
  MOODS,
  PAYMENT_PROVIDER,
  PROOF_MAX,
  PROOF_MIN,
  QUANTITY_STEPS,
  REROLL_MINUTES,
  SERVICE_COUNT,
} from '../server/seo/booking';
import { spotPrice } from '../server/seo/price-table';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/how-it-works';
/** The worked Valorant example, priced through the engine like every figure. */
const VALORANT_IMMORTAL_DUO = spotPrice('val', 'duo2', 'Immortal');
const title = 'How Duoly Works: Booking a Teammate Step by Step | Duoly';
const description = `Every step of a Duoly booking, start to finish: the eight choices the picker asks for, one upfront ${PAYMENT_PROVIDER} payment, how matching works, the session itself and the refund rules.`;
const HUB_LINKS = hubChips([
  'league-of-legends',
  'valorant',
  'counter-strike-2',
  'fortnite',
]);
const pricesLabel = CATALOG_PRICES_UPDATED_LABEL;
/** Methods in one sentence, so a new Stripe method needs no copy edit here. */
const WALLET_LIST = [...CARD_WALLETS, ...ALT_METHODS].join(', ');
const LOCAL_LIST = LOCAL_METHODS.join(', ');

/**
 * The eight selections the booking picker asks for, in its own order.
 *
 * Rendered as plain divs beside the paragraph that states the same list: the
 * paragraph is the extractable answer, and repeating it as list items would
 * duplicate the whole thing for a reader and for anything reading the page as
 * prose.
 */
const CHOICES: [string, string][] = [
  ['Game', `${PLAYABLE_GAMES} titles plus the voice-only Social category.`],
  [
    'Service',
    `One of ${SERVICE_COUNT} bookable session types, from Duo Pro to a VOD Review hour.`,
  ],
  ['Your rank', 'Ranked play only, because rank sets the price.'],
  ['Server', 'The region your account queues in.'],
  [
    'Quantity',
    `${QUANTITY_STEPS[0]} to ${MAX_QUANTITY} games or hours, or a bundle of ${BUNDLE_SIZES.join(', ')}.`,
  ],
  ['Teammates', `One, or up to ${MAX_TEAMMATES} on a team service.`],
  ['In-game name', 'So the invite reaches the right account.'],
  ['Voice and mood', `Discord voice, plus ${MOODS.join(', ')}.`],
];

/** The three steps, shared by the visible list and the HowTo JSON-LD. */
const STEPS: [string, string][] = [
  [
    'Pick the game, the service and the quantity',
    'Pick the game and the service, then your rank and how many games or hours you want. The total appears on the screen before you pay anything.',
  ],
  [
    'Pay once, upfront',
    `Pay once with a card, ${WALLET_LIST} or your Duoly balance, and the order goes live to rank-verified teammates for that game.`,
  ],
  [
    'Accept the invite and play',
    'The first teammate who accepts joins your lobby. You agree voice in the order room and move to Discord for it, and both of you stay on your own accounts.',
  ],
];
const HOW_TO_STEPS = STEPS.map(([name, text], index) => ({
  name,
  text,
  anchor: index === 2 ? 'session-h' : 'steps-h',
}));

const faq: [string, string][] = [
  [
    'How long does it take to find a Duoly teammate?',
    `Duoly promises no start time. Your order goes live to every teammate verified for that game and the first one to accept takes it, which the terms describe as usually a couple of minutes. An order nobody accepts within ${AUTO_CANCEL_MINUTES} minutes cancels itself and returns the full amount to your Duoly balance.`,
  ],
  [
    'Do I have to give Duoly my game account password?',
    `No, and nobody at Duoly will ever ask for one. Every session is played together: the teammate joins your lobby from their own account, which is the line between a duo session and account boosting. The order chat refuses a message asking for a login before it is delivered, and the teammate earns ${SHARE_PERCENT}% of the order for playing rather than for winning.`,
  ],
  [
    'Can I choose which teammate I play with?',
    `Not before the order goes live, because a teammate accepts from a queue. Once matched, the order room offers ${FREE_REROLLS} free re-rolls in the first ${REROLL_MINUTES} minutes, and a team order offers the same switch for each teammate.`,
  ],
  [
    'Do I need Discord to book on Duoly?',
    'Only for voice. Text orders run in the order chat on duoly.gg, while voice sessions and coaching screen shares happen on Discord, which is why a VOD Review asks for it.',
  ],
  [
    'Am I charged per game or once for the whole order?',
    `Once, when you queue. You read the total, then pay it in a single charge that covers every game or hour in the order, with nothing billed afterwards and no subscription. ${FIVE_GAMES.short} is one payment of ${FIVE_GAMES.total}, the ${QUANTITY_PERCENT}% discount already taken off.`,
  ],
  [
    'What does a Duoly session cost?',
    `Teammate games start at ${SHORT_GAME_PRICE} and coaching is ${COACHING_PRICE} per hour or game in every coachable title. For example, ${SINGLE_GAME.short} costs ${SINGLE_GAME.total}. The pricing page lists every game and service.`,
  ],
  [
    'What happens if my teammate never shows up?',
    'Report the order from your order room. The terms cover a no-show, a teammate leaving and toxic behaviour the same way: a real person reviews the report and can refund the order to your balance.',
  ],
  [
    'Can I book several teammates at once?',
    `Yes, up to ${MAX_TEAMMATES} on a team service such as a League of Legends Ranked 5s or a Valorant Premier Roster. A bundle always covers one teammate, so the two controls are separate.`,
  ],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page official-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'How Duoly works', path },
      ]}
    />
    <SeoHero
      eyebrow="How it works"
      h1="How Duoly works"
      lead={`Pick a game and a service, pay once, and the first rank-verified teammate who takes your order joins your lobby. Every step is below, from the eight things the picker asks for to what happens when a session goes wrong.`}
      price={`${SINGLE_GAME.short}: ${SINGLE_GAME.total}`}
      cta={{ href: SINGLE_GAME.href, label: 'Open a real booking' }}
      secondary={{ href: '/pricing', label: 'See every price' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        {
          src: '/assets/games/counter-strike-2.png',
          alt: 'Counter-Strike 2 game art',
        },
      ]}
      chip={`Coaching ${COACHING_PRICE} per hour`}
      facts={[
        'One payment when you queue',
        'Play on your own account',
        `Free cancel until a teammate accepts`,
        `Unaccepted after ${AUTO_CANCEL_MINUTES} minutes refunds itself`,
      ]}
      note={`Prices as of ${pricesLabel}.`}
    />

    <section aria-labelledby="book-h">
      <h2 id="book-h">How does booking a teammate on Duoly work?</h2>
      <p>
        Booking a teammate on Duoly means paying upfront for a set number of
        games or hours with a rank-verified player. You pick the game, the
        service and the quantity, and the total appears before you pay anything.
        Payment is a single charge through {PAYMENT_PROVIDER}, taken the moment
        the order joins the queue. The match comes last, because a teammate
        chooses to accept your order and nobody is assigned to it.
      </p>
      <p>
        Buying more of the same thing costs less per game: {MAX_QUANTITY} of one
        game take {QUANTITY_PERCENT}% off, and a {BUNDLE_SIZES[2]} game bundle
        takes {BUNDLE_PERCENTS[2]}% off. Coaching is priced per hour or per game
        and takes no discount at all. The figure on the booking screen is the
        figure you pay, which is written into{' '}
        <a href="/terms#payment">the terms of service</a>. And nobody at Duoly
        asks for a password, ever.
      </p>
    </section>

    <Steps
      heading="What are the three steps to book a Duoly session?"
      answer="The three steps are picking what you want, paying for it once, and playing with the teammate who accepts the order."
      steps={STEPS.map(([, text]) => text)}
    >
      <p>
        The service and your own rank set the figure, and you pay it once for
        the whole order, with nothing charged after a game. Prices are set in
        euros, and a US dollar total adds a {USD_MARGIN_PERCENT}% currency
        margin. You can open <a href={SINGLE_GAME.href}>{SINGLE_GAME.short}</a>{' '}
        to see the real booking screen these three steps describe.
      </p>
    </Steps>

    <section aria-labelledby="choices-h">
      <h2 id="choices-h">Which choices does the Duoly booking form ask for?</h2>
      <p>
        The Duoly booking form asks for eight things, and they are all on one
        screen. It opens on the game, from {PLAYABLE_GAMES} titles plus a
        voice-only category, then the service: one session type out of{' '}
        {SERVICE_COUNT}, such as Duo Pro, a League of Legends Ranked 5s or a VOD
        Review hour. Ranked play asks for your own rank, because rank sets the
        price, and every service asks which server or region your account plays
        on.
      </p>
      <p>
        Quantity runs {QUANTITY_STEPS[0]} to {MAX_QUANTITY} games or hours,
        where {MAX_QUANTITY} units take {QUANTITY_PERCENT}% off, or a Bundles
        pack of {BUNDLE_SIZES.join(', ')} units at {BUNDLE_PERCENTS[0]}%,{' '}
        {BUNDLE_PERCENTS[1]}% and {BUNDLE_PERCENTS[2]}% off. A team service asks
        how many teammates you want, up to {MAX_TEAMMATES}. Your in-game name is
        what sends the invite to the right account. The last two choices are
        voice, which runs on Discord, and a mood, from {MOODS.join(', ')}.
      </p>
      {/* The same eight selections as scannable chips. Divs and spans on
          purpose: the paragraph above is the answer a reader and an extractor
          both get, so these must not repeat it as prose. */}
      <div class="official-grid">
        {CHOICES.map(([label, detail]) => (
          <div>
            <span class="official-label">{label}</span>
            <span class="official-detail">{detail}</span>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="pay-h">
      <h2 id="pay-h">How do you pay for a Duoly session?</h2>
      <p>
        Payment is one upfront charge through {PAYMENT_PROVIDER}, taken when the
        order joins the queue. Checkout opens on the amount you were already
        shown, with no booking fee, no payment surcharge and no subscription.
        You can pay with {CARD_BRANDS.join(' and ')}, with {WALLET_LIST}, or
        with a local method such as {LOCAL_LIST}.
      </p>
      <p>
        Duoly never sees or stores full card details, because the card form
        belongs to {PAYMENT_PROVIDER}. Your payment details go straight to the
        payment provider, and Duoly only sees the amount and the method, which
        the <a href="/privacy">privacy policy</a> spells out. Your Duoly balance
        can cover part of an order or all of it, and it is where refunds and
        level-up gifts land. Any quantity discount still comes off before the
        balance does. The whole model sits on{' '}
        <a href="/fees-and-refunds">fees and refunds</a>.
      </p>
    </section>

    <section aria-labelledby="queue-h">
      <h2 id="queue-h">What happens after you pay for a Duoly order?</h2>
      <p>
        A queued order is an open offer to every teammate verified for that
        game, and the first one to accept takes it. The order room opens with
        your selection and the chat, and shows the teammate’s rank as soon as
        somebody accepts. An order that waits a while also gets posted by the
        Duoly bot in the teammate server on Discord, carrying the service, the
        rank, the server, your order note and the teammate pay. Never your name
        or your email.
      </p>
      <p>
        No start time is promised. An order nobody accepts within{' '}
        {AUTO_CANCEL_MINUTES} minutes cancels itself and returns 100% of the
        amount to your Duoly balance, and you can{' '}
        <a href="/terms#cancel">cancel free of charge</a> yourself until a
        teammate accepts. A refund is the whole amount you paid, discount
        included.
      </p>
    </section>

    <section aria-labelledby="session-h">
      <h2 id="session-h">What happens during a Duoly session?</h2>
      <p>
        A Duoly session is played together, with you and your teammate on
        separate accounts in the same lobby. The in-game invite goes out to the
        name on your order as soon as somebody accepts. Voice runs on Discord
        when you booked voice, and the order chat carries everything else. Any
        message asking for a login or an outside payment is blocked before it
        reaches the other person.
      </p>
      <p>
        Under the Teammate Code, a teammate plays every game that was booked and
        never asks for account access. If the match is wrong anyway, you can
        re-roll free of charge {FREE_REROLLS} times in the first{' '}
        {REROLL_MINUTES} minutes. What you are buying is the playing time. A
        Valorant Duo Pro order at Immortal pairs you with an Immortal+ player at{' '}
        {VALORANT_IMMORTAL_DUO} per game, and that is a strong player beside
        you, with no promise about the rank you end up at.
      </p>
    </section>

    <section aria-labelledby="end-h">
      <h2 id="end-h">How does a Duoly session end?</h2>
      <p>
        A session ends when your teammate uploads proof and marks the order
        done. The proof is {PROOF_MIN} to {PROOF_MAX} screenshots of the match
        history or the end screens with both players visible, and the completion
        flow will not close the order without them. You can rate the teammate
        afterwards, and a rating stays about the session.
      </p>
      <p>
        Then the money splits. A teammate earns {SHARE_PERCENT}% of the order
        price, paid weekly from Friday to Friday, and Duoly keeps{' '}
        {100 - SHARE_PERCENT}% for payments, matching, support and running the
        place. A coach on a VOD Review hour earns the same share. Under the{' '}
        <a href="/terms#teammates">teammate terms</a> a payout can be held while
        a report about the order is reviewed, and fake proof ends a teammate’s
        time on Duoly outright. Nobody earns a bonus for a win, which is exactly
        why Duoly promises no result.
      </p>
    </section>

    <section aria-labelledby="wrong-h">
      <h2 id="wrong-h">What if a Duoly session goes wrong?</h2>
      <p>
        The route out is a report from the order room, and a person at Duoly
        reads it. <a href="/terms#cancel">The terms</a> cover three cases in one
        line: “No-show, a teammate leaving, toxic behaviour: report it from your
        order room. A real person reviews it and can refund the order to your
        balance.” The size of the order makes no difference to that.
      </p>
      <p>
        A refund reaches your Duoly balance by default, so you can rebook
        straight away, and money in a balance can go back to a card on request.
        For EU and EEA consumers the 14-day right of withdrawal ends once a
        session has been fully played, because queueing an order asks Duoly to
        start right away. Austrian law governs the terms, and a consumer keeps
        every mandatory protection of their home country. Full detail sits on{' '}
        <a href="/fees-and-refunds">fees and refunds</a> and{' '}
        <a href="/trust-and-safety">trust and safety</a>.
      </p>
    </section>

    <Faq heading="What do customers ask before a first booking?" items={faq} />

    <ClosingCta
      heading="What should you get right on a first booking?"
      text={`The rank is the thing most first bookings get wrong, so pick the one you really hold. A wrong rank can make a session impossible to play, and the terms do not treat that as a reason for a refund. Then add your in-game name and server so the invite can reach you, and choose voice only if you actually want to talk. Duoly runs across ${PLAYABLE_GAMES} games plus ${SOCIAL_MODES} voice modes, from ${BUSINESS_LOCATION}.`}
      extra={`Duoly also promises less than you might expect. There is no fixed start time, because a teammate accepts the order when one is free, and there is no promise about your rank or your win rate. An order nobody takes within ${AUTO_CANCEL_MINUTES} minutes refunds itself in full. The biggest saving on the site is ${TEN_GAME_BUNDLE.short} at ${TEN_GAME_BUNDLE.total}, which takes ${TEN_GAME_BUNDLE.saved} off.`}
      href="/pricing"
      label="See every Duoly price"
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/pricing">Every Duoly game, service and price</a>
        <a href="/trust-and-safety">How Duoly checks players and payments</a>
        <a href="/fees-and-refunds">Duoly fees and refunds in full</a>
        <a href="/about">About Duoly and who runs it</a>
        <a href="/press">Duoly press kit and fact sheet</a>
        <a href="/games">All games and services</a>
        <a href="/ai">Duoly in AI assistants</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      howToSchema(
        path,
        'How to book a Duoly teammate',
        description,
        HOW_TO_STEPS,
        Astro.site!,
      ),
    )}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      officialPageSchema(
        path,
        title,
        description,
        CONTENT_DATES[path]!,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

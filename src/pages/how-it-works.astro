---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import SeoHero from '../components/seo/SeoHero.astro';
import Steps from '../components/seo/Steps.astro';
import Faq from '../components/seo/Faq.astro';
import ClosingCta from '../components/seo/ClosingCta.astro';
import '../components/seo/seo.css';
import '../components/seo/official.css';
import { pageViewer } from '../site/viewer';
import { CONTENT_DATES, hubChips, serializeJsonLd } from '../site/seo';
import { faqSchema } from '../server/seo/offers';
import { howToSchema, officialPageSchema } from '../server/seo/official';
import { BUSINESS_LOCATION } from '../site/entity';
import {
  COACHING_PRICE,
  PLAYABLE_GAMES,
  SHARE_PERCENT,
  SHORT_GAME_PRICE,
  SOCIAL_MODES,
} from '../server/seo/teammate-facts';
import {
  AUTO_CANCEL_MINUTES,
  BUNDLE_PERCENTS,
  BUNDLE_SIZES,
  CATALOG_PRICES_UPDATED,
  CATALOG_PRICES_UPDATED_LABEL,
  COACHING_HOUR,
  FIVE_GAMES,
  MAX_QUANTITY,
  QUANTITY_PERCENT,
  SINGLE_GAME,
  TEN_GAME_BUNDLE,
  USD_MARGIN_PERCENT,
} from '../server/seo/fees';
import {
  ALT_METHODS,
  CARD_BRANDS,
  CARD_WALLETS,
  FREE_REROLLS,
  LOCAL_METHODS,
  MAX_TEAMMATES,
  MOODS,
  PAYMENT_PROVIDER,
  PROOF_MAX,
  PROOF_MIN,
  QUANTITY_STEPS,
  REROLL_MINUTES,
  SERVICE_COUNT,
} from '../server/seo/booking';
import { spotPrice } from '../server/seo/price-table';
import { LEGAL_UPDATED } from '../design-reference/lib/site.js';

const { viewer, csrf } = await pageViewer(Astro);
const path = '/how-it-works';
/** The worked Valorant example, priced through the engine like every figure. */
const VALORANT_IMMORTAL_DUO = spotPrice('val', 'duo2', 'Immortal');
const title = 'How Duoly Works: Booking a Teammate Step by Step | Duoly';
const description = `Every step of a Duoly booking as the site really runs it: the eight choices the picker asks for, one upfront ${PAYMENT_PROVIDER} payment, matching, the session and the refund rules.`;
const HUB_LINKS = hubChips([
  'league-of-legends',
  'valorant',
  'counter-strike-2',
  'fortnite',
]);
/** The catalog year, derived so a sentence cannot outlive the prices it dates. */
const CATALOG_YEAR = CATALOG_PRICES_UPDATED.slice(0, 4);
const pricesLabel = CATALOG_PRICES_UPDATED_LABEL;
/** Methods in one sentence, so a new Stripe method needs no copy edit here. */
const WALLET_LIST = [...CARD_WALLETS, ...ALT_METHODS].join(', ');
const LOCAL_LIST = LOCAL_METHODS.join(', ');

/**
 * The eight selections the booking picker asks for, in its own order.
 *
 * Rendered as plain divs beside the paragraph that states the same list: the
 * paragraph is the extractable answer, and repeating it as list items would
 * duplicate the whole thing for a reader and for anything reading the page as
 * prose.
 */
const CHOICES: [string, string][] = [
  ['Game', `${PLAYABLE_GAMES} titles plus the voice-only Social category.`],
  [
    'Service',
    `One of ${SERVICE_COUNT} bookable session types, from Duo Pro to a VOD Review hour.`,
  ],
  ['Your rank', 'Ranked play only, because rank sets the price.'],
  ['Server', 'The region your account queues in.'],
  [
    'Quantity',
    `${QUANTITY_STEPS[0]} to ${MAX_QUANTITY} games or hours, or a bundle of ${BUNDLE_SIZES.join(', ')}.`,
  ],
  ['Teammates', `One, or up to ${MAX_TEAMMATES} on a team service.`],
  ['In-game name', 'So the invite reaches the right account.'],
  ['Voice and mood', `Discord voice, plus ${MOODS.join(', ')}.`],
];

/** The three steps, shared by the visible list and the HowTo JSON-LD. */
const STEPS: [string, string][] = [
  [
    'Pick the game, the service and the quantity',
    `Pick the game and the service, then your rank and how many games or hours you want. The total appears before you pay, for example ${SINGLE_GAME.total} for ${SINGLE_GAME.short}.`,
  ],
  [
    'Pay once, upfront',
    `Pay once with a card, ${WALLET_LIST} or your Duoly balance, and the order goes live to rank-verified teammates for that game.`,
  ],
  [
    'Accept the invite and play',
    'The first teammate who accepts joins your lobby, voice is agreed using Discord in the order room, and both players stay on their own accounts.',
  ],
];
const HOW_TO_STEPS = STEPS.map(([name, text], index) => ({
  name,
  text,
  anchor: index === 2 ? 'session-h' : 'steps-h',
}));

const faq: [string, string][] = [
  [
    'How long does it take to find a Duoly teammate?',
    `Duoly promises no start time. Your order goes live to every teammate verified for that game and the first one to accept takes it, which the terms describe as usually a couple of minutes. An order nobody accepts within ${AUTO_CANCEL_MINUTES} minutes cancels itself and returns the full amount to your Duoly balance.`,
  ],
  [
    'Do I have to give Duoly my game account password?',
    `No, and nobody at Duoly will ever ask for one. Every session is played together: the teammate joins your lobby from their own account, which is the line between a duo session and account boosting. The order chat refuses a message asking for a login before it is delivered, and the teammate earns ${SHARE_PERCENT}% of the order for playing rather than for winning.`,
  ],
  [
    'Can I choose which teammate I play with?',
    `Not before the order goes live, because a teammate accepts from a queue. Once matched, the order room offers ${FREE_REROLLS} free re-rolls in the first ${REROLL_MINUTES} minutes, and a team order offers the same switch for each teammate.`,
  ],
  [
    'Do I need Discord to book on Duoly?',
    `Only for voice. Text orders run in the order chat on duoly.gg, while voice sessions and coaching screen shares run using Discord, which is why a ${COACHING_PRICE} VOD Review asks for it.`,
  ],
  [
    'Am I charged per game or once for the whole order?',
    `Once, when you queue. Step 1 is the total, Step 2 is the single charge, and the terms state one upfront payment for every game or hour in the order, with no charge after each game and no subscription. For example, ${FIVE_GAMES.short} is one payment of ${FIVE_GAMES.total} at ${QUANTITY_PERCENT}% off.`,
  ],
  [
    'What does a Duoly session cost?',
    `Teammate games start at ${SHORT_GAME_PRICE} and coaching is ${COACHING_PRICE} per hour or game in every coachable title. For example, ${SINGLE_GAME.short} costs ${SINGLE_GAME.total}, and ${MAX_QUANTITY} of them take ${QUANTITY_PERCENT}% off. Every price for every game is on the pricing page.`,
  ],
  [
    'What happens if my teammate never shows up?',
    `Report the order from your order room. The terms cover a no-show, a teammate leaving and toxic behaviour the same way: a real person reviews the report and can refund the order to your balance, whether the order was ${SINGLE_GAME.total} or ${TEN_GAME_BUNDLE.total}.`,
  ],
  [
    'Can I book several teammates at once?',
    `Yes, up to ${MAX_TEAMMATES} on a team service such as a League of Legends Ranked 5s or a Valorant Premier Roster. A bundle always covers one teammate, so the two controls are separate.`,
  ],
];
---

<SiteLayout
  title={title}
  description={description}
  indexing="index, follow"
  viewer={viewer}
  csrf={csrf}
>
  <article class="seo-page official-page">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'How Duoly works', path },
      ]}
    />
    <SeoHero
      eyebrow="How it works"
      h1="How Duoly works"
      lead={`A Duoly booking is one paid block of play, coaching or voice company with a rank-verified player. Here is every step as the site really runs it, from the eight choices the picker asks for to the refund rules.`}
      price={`${SINGLE_GAME.short}: ${SINGLE_GAME.total}`}
      cta={{ href: SINGLE_GAME.href, label: 'Open a real booking' }}
      secondary={{ href: '/pricing', label: 'See every price' }}
      art={[
        {
          src: '/assets/games/league-of-legends.png',
          alt: 'League of Legends game art',
        },
        { src: '/assets/games/valorant.png', alt: 'Valorant game art' },
        {
          src: '/assets/games/counter-strike-2.png',
          alt: 'Counter-Strike 2 game art',
        },
      ]}
      chip={`Coaching ${COACHING_PRICE} per hour`}
      facts={[
        'One payment when you queue',
        'Play on your own account',
        `Free cancel until a teammate accepts`,
        `Unaccepted after ${AUTO_CANCEL_MINUTES} minutes refunds itself`,
      ]}
      note={`Prices read from the Duoly pricing engine. Catalog prices as of ${pricesLabel}.`}
    />

    <section aria-labelledby="book-h">
      <h2 id="book-h">How does booking a teammate on Duoly work?</h2>
      <p>
        A Duoly booking is one paid block of play, coaching or voice company
        with a rank-verified player, bought before the session rather than
        billed after. First, Step 1 picks the game, the service and the
        quantity, and the total appears before any payment. Second, Step 2 is
        one upfront payment through {PAYMENT_PROVIDER}, taken the moment the
        order is queued. Third, Step 3 is the match, because a teammate accepts
        from a queue rather than being assigned. For example,{' '}
        {SINGLE_GAME.short} costs {SINGLE_GAME.total} in {CATALOG_YEAR},{' '}
        {MAX_QUANTITY} of the same game take {QUANTITY_PERCENT}% off and a{' '}
        {BUNDLE_SIZES[2]} game bundle takes {BUNDLE_PERCENTS[2]}% off. A{' '}
        {COACHING_HOUR.short} is {COACHING_HOUR.total}, read live from Duoly’s
        pricing engine. According to{' '}
        <a href="/terms#payment">the terms of service</a>, dated {LEGAL_UPDATED}
        , the price you see at checkout is the price you pay, and nobody at
        Duoly asks for a password.
      </p>
    </section>

    <Steps
      heading="What are the three steps to book a Duoly session?"
      steps={STEPS.map(([, text]) => text)}
    >
      <p>
        Step 1 of a Duoly order sets the price, because the service and the
        customer rank decide the figure. Step 2 is one upfront payment rather
        than a charge per game. Step 3 is the match, and an order nobody accepts
        within {AUTO_CANCEL_MINUTES} minutes cancels itself and returns 100% of
        the amount to the Duoly balance. According to{' '}
        <a href="/terms#payment">Duoly’s payment terms</a>, prices are set in
        euros and a US dollar total adds a {USD_MARGIN_PERCENT}% currency
        margin. For example, a {COACHING_HOUR.label} costs {COACHING_HOUR.total}{' '}
        using Discord screen share, and{' '}
        <a href={SINGLE_GAME.href}>
          {SINGLE_GAME.short} at {SINGLE_GAME.total}
        </a>{' '}
        opens the same checkout this page describes.
      </p>
    </Steps>

    <section aria-labelledby="choices-h">
      <h2 id="choices-h">Which choices does the Duoly booking form ask for?</h2>
      <p>
        A Duoly order is a selection of eight things, asked for in one picker
        rather than across a checkout funnel. Step 1 is the game, from{' '}
        {PLAYABLE_GAMES} titles plus a voice-only category. Second comes the
        service, which is one bookable session type out of {SERVICE_COUNT} in
        the catalog, such as Duo Pro at {SINGLE_GAME.perUnit} per game, a League
        of Legends Ranked 5s or a {COACHING_HOUR.total} VOD Review hour. Third
        is your own rank, which only ranked play asks for, because rank sets the
        price. Fourth is the server or region the account plays on. Fifth is the
        quantity: {QUANTITY_STEPS[0]} to {MAX_QUANTITY} games or hours, where{' '}
        {MAX_QUANTITY} units take {QUANTITY_PERCENT}% off, or a Bundles pack of{' '}
        {BUNDLE_SIZES.join(', ')} units at {BUNDLE_PERCENTS[0]}%,{' '}
        {BUNDLE_PERCENTS[1]}% and {BUNDLE_PERCENTS[2]}% off. Sixth is the number
        of teammates, up to {MAX_TEAMMATES} on a team service. Seventh is the
        in-game name, so an invite reaches the right account. Eighth is voice
        and a mood, from {MOODS.join(', ')}. For example, a voice order meets
        the teammate using Discord, and every figure here comes from Duoly’s own
        pricing engine in {CATALOG_YEAR}.
      </p>
      {/* The same eight selections as scannable chips. Divs and spans on
          purpose: the paragraph above is the answer a reader and an extractor
          both get, so these must not repeat it as prose. */}
      <div class="official-grid">
        {CHOICES.map(([label, detail]) => (
          <div>
            <span class="official-label">{label}</span>
            <span class="official-detail">{detail}</span>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="pay-h">
      <h2 id="pay-h">How do you pay for a Duoly session?</h2>
      <p>
        Payment is one upfront charge through {PAYMENT_PROVIDER}, taken when the
        order is queued. Step 1 at checkout is the amount, which is the total
        already shown: no booking fee, no payment surcharge and no subscription
        in {CATALOG_YEAR}. Second, the methods are the ones switched on in{' '}
        {PAYMENT_PROVIDER}, from {CARD_BRANDS.join(' and ')} to {WALLET_LIST}{' '}
        and local options such as {LOCAL_LIST}. Third, Duoly never sees or
        stores full card details, because the card form belongs to{' '}
        {PAYMENT_PROVIDER}. According to{' '}
        <a href="/privacy">Duoly’s privacy policy</a>, payment details go
        straight to the payment provider and Duoly only sees the amount and the
        method. Part or all of an order can also come from a Duoly balance,
        where refunds and level-up gifts land. For example, {SINGLE_GAME.total}{' '}
        of balance covers {SINGLE_GAME.short} with no card charge, and a{' '}
        {QUANTITY_PERCENT}% quantity discount still comes off first. The whole
        model sits on <a href="/fees-and-refunds">fees and refunds</a>.
      </p>
    </section>

    <section aria-labelledby="queue-h">
      <h2 id="queue-h">What happens after you pay for a Duoly order?</h2>
      <p>
        A queued Duoly order is an open offer to every teammate verified for
        that game, and the first to accept takes it. Step 1 is the order room,
        which opens with your selection, the chat and the teammate’s rank once
        somebody accepts. Second, an order that waits a while is posted by the
        Duoly bot in the teammate server using Discord, carrying the service,
        rank, server and teammate pay, and never a customer name or email.
        Third, no start time is promised, so an order nobody accepts within{' '}
        {AUTO_CANCEL_MINUTES} minutes cancels itself and returns 100% of the
        amount to your Duoly balance. According to{' '}
        <a href="/terms#cancel">Duoly’s cancellation terms</a>, you can also
        cancel free of charge in the order room until a teammate accepts. For
        example, a {FIVE_GAMES.total} five-game order bought at{' '}
        {QUANTITY_PERCENT}% off refunds {FIVE_GAMES.total} in full rather than a
        part of the total, as published from Duoly’s refund rules in{' '}
        {CATALOG_YEAR}.
      </p>
    </section>

    <section aria-labelledby="session-h">
      <h2 id="session-h">What happens during a Duoly session?</h2>
      <p>
        A Duoly session is played together, with the customer and the teammate
        on separate accounts in the same lobby. Step 1 is the in-game invite,
        sent as soon as a teammate accepts, to the in-game name on the order.
        Second, voice runs using Discord when voice was booked, and the order
        chat carries everything else. Third, the chat refuses any message asking
        for a login or an outside payment, enforced on the server rather than in
        the browser alone. According to the Teammate Code, a teammate plays
        every game that was booked and never asks for account access. A teammate
        who is not the right fit can be re-rolled free of charge {FREE_REROLLS}{' '}
        times in the first {REROLL_MINUTES} minutes after matching. For example,
        a Valorant Duo Pro order at Immortal rank pairs an Immortal+ player at{' '}
        {VALORANT_IMMORTAL_DUO} per game in {CATALOG_YEAR}, with no rank and no
        win promised, while a {SHORT_GAME_PRICE} Skirmish 2v2 game buys the same{' '}
        {SHARE_PERCENT}% teammate share of a smaller total.
      </p>
    </section>

    <section aria-labelledby="end-h">
      <h2 id="end-h">How does a Duoly session end?</h2>
      <p>
        A Duoly session ends when the teammate uploads proof and marks the order
        done. Step 1 is the proof: {PROOF_MIN} to {PROOF_MAX} screenshots of the
        match history or the end screens with both players visible, which the
        completion flow requires rather than suggests. Second, you can rate the
        teammate, and a review stays about the session. Third, the money splits:
        a teammate earns {SHARE_PERCENT}% of the order price, paid weekly from
        Friday to Friday, and Duoly keeps {100 - SHARE_PERCENT}% for payments,
        matching, support and the platform. For example, a completed{' '}
        {COACHING_HOUR.total} Valorant VOD Review hour pays the coach{' '}
        {SHARE_PERCENT}% of that total. According to{' '}
        <a href="/terms#teammates">Duoly’s teammate terms</a>, a payout can be
        held while a report about an order is reviewed, and fake proof ends a
        teammate’s time on the platform. Nobody earns a bonus for a win, which
        is why Duoly promises no result.
      </p>
    </section>

    <section aria-labelledby="wrong-h">
      <h2 id="wrong-h">What if a Duoly session goes wrong?</h2>
      <p>
        A report from the order room is the route, and a person at Duoly reads
        every one. Step 1 is the report, and{' '}
        <a href="/terms#cancel">the terms</a> dated {LEGAL_UPDATED} cover three
        cases identically: “No-show, a teammate leaving, toxic behaviour: report
        it from your order room. A real person reviews it and can refund the
        order to your balance.” Second, a refund reaches your Duoly balance by
        default, so rebooking is immediate, and money refunded to a balance can
        go back to a card on request. Third, for EU and EEA consumers the 14-day
        right of withdrawal ends once a session has been fully played, because
        queueing asks Duoly to start right away. For example, a{' '}
        {SINGLE_GAME.total} game and a {TEN_GAME_BUNDLE.total} ten-game bundle
        at {BUNDLE_PERCENTS[2]}% off follow one rule in {CATALOG_YEAR}. Under
        Austrian law, quoted from Duoly’s terms, a consumer keeps every
        mandatory home-country protection. Full detail sits on{' '}
        <a href="/fees-and-refunds">fees and refunds</a> and{' '}
        <a href="/trust-and-safety">trust and safety</a>.
      </p>
    </section>

    <Faq heading="What do customers ask before a first booking?" items={faq} />

    <ClosingCta
      heading="Ready to run the three steps for real?"
      text={`A first Duoly order is a three-step job that ends in a lobby: ${SINGLE_GAME.short} costs ${SINGLE_GAME.total} and coaching is ${COACHING_PRICE} per hour across ${PLAYABLE_GAMES} games plus ${SOCIAL_MODES} voice modes, operated from ${BUSINESS_LOCATION}. Open your game, pick the rank you really have and read the total before paying anything.`}
      extra={`Three things decide whether a first booking goes well. First, Step 1 is picking the rank you really have, because a wrong rank can make a session impossible to play and, according to the terms, is not a reason for a refund. Second, add your in-game name and server so the invite can reach you, and choose voice only if you want to talk using Discord. Third, remember what is not promised: no start time, no rank and no win, and an order nobody takes within ${AUTO_CANCEL_MINUTES} minutes refunds itself in full. For example, ${TEN_GAME_BUNDLE.short} costs ${TEN_GAME_BUNDLE.total} at ${BUNDLE_PERCENTS[2]}% off in ${CATALOG_YEAR} and saves ${TEN_GAME_BUNDLE.saved}, the largest discount Duoly gives.`}
      href="/pricing"
      label="See every Duoly price"
      art={{ src: '/assets/games/valorant.png', alt: '' }}
    />

    <nav class="related" aria-label="Related pages">
      <h2>Read next</h2>
      <div class="chips">
        <a href="/pricing">Every Duoly game, service and price</a>
        <a href="/trust-and-safety">How Duoly checks players and payments</a>
        <a href="/fees-and-refunds">Duoly fees and refunds in full</a>
        <a href="/about">About Duoly and who runs it</a>
        <a href="/press">Duoly press kit and fact sheet</a>
        <a href="/games">All games and services</a>
        <a href="/ai">Duoly in AI assistants</a>
        {HUB_LINKS.map((hub) => (
          <a href={hub.path}>{hub.name} teammates and prices</a>
        ))}
        <a href="/blog">All Duoly guides</a>
      </div>
    </nav>
  </article>
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      howToSchema(
        path,
        'How to book a Duoly teammate',
        description,
        HOW_TO_STEPS,
        Astro.site!,
      ),
    )}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(faqSchema(faq, path, Astro.site!))}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={serializeJsonLd(
      officialPageSchema(
        path,
        title,
        description,
        CONTENT_DATES[path]!,
        Astro.site!,
      ),
    )}
  />
</SiteLayout>

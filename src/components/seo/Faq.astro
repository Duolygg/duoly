---
interface Props {
  items: [string, string][];
  heading?: string;
}
const { items, heading = 'Frequently asked questions' } = Astro.props;
---

<section aria-labelledby="faq-h">
  <h2 id="faq-h">{heading}</h2>
  <div class="faq-list">
    {items.map(([question, answer]) => (
      <details>
        <summary>{question}</summary>
        <p>{answer}</p>
      </details>
    ))}
  </div>
</section>

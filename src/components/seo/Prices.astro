---
import { type seoOffers } from '../../server/seo/offers';
import { pricesAnswer, priceNote } from '../../server/seo/citable-answers';
import { SITE_GAMES } from '../../site/games';
import { bookingHref } from '../../site/seo';
import {
  CATALOG_PRICES_UPDATED,
  CATALOG_PRICES_UPDATED_LABEL,
} from '../../site/price-dates';
interface Props {
  gameId: string;
  offers: ReturnType<typeof seoOffers>;
  /** What the provider line names: "coach" pages say "Immortal+ coach". */
  coach?: boolean;
  intro?: string;
  /** Heading text and anchor, so a page can show more than one price group. */
  heading?: string;
  id?: string;
  /** Pages with several price groups date them once, under the last group. */
  dated?: boolean;
}
const {
  gameId,
  offers,
  coach = false,
  intro,
  heading,
  id = 'prices',
  dated = true,
} = Astro.props;
const gameName = SITE_GAMES.find((game) => game.id === gameId)?.name;
const headingText =
  heading ??
  `How much does ${gameName} ${coach ? 'coaching' : 'teammate booking'} cost?`;
// Every card below is a checkout quote, so the day beside them is the day the
// catalog moved, not a day the page remembers. No page passes one in:
// src/site/price-dates.ts carries the reasoning.
// One card per service; ranked services list their price per customer rank.
const services = [
  ...new Map(offers.map((offer) => [offer.id, offer])).values(),
];
// Keep every provider tier visible alongside its service.
const providerText = (provider: string) =>
  coach ? `${provider} coach` : provider;
// When every card is the same flat price, say it once instead of on every card.
const samePrice =
  services.length > 1 &&
  offers.every(
    (offer) => !offer.rank && offer.amountMinor === offers[0]!.amountMinor,
  );
const cols = services.length % 3 === 0 ? 3 : Math.min(services.length, 4);
const cards = services.map((service) => {
  const rows = offers.filter((offer) => offer.id === service.id);
  const cheapest = [...rows].sort((a, b) => a.amountMinor - b.amountMinor)[0]!;
  return {
    service,
    rows,
    cheapest,
    ranked: Boolean(service.rank),
    varies: rows.some((row) => row.amountMinor !== cheapest.amountMinor),
  };
});
---

<section aria-labelledby={id}>
  <h2 id={id}>{headingText}</h2>
  <p class="section-intro">{intro ?? pricesAnswer(gameId, offers, coach)}</p>
  <div class="price-grid" data-cols={cols}>
    {cards.map(({ service, rows, cheapest, ranked, varies }) => (
      <article class="card price-card">
        <strong class="service-name">{service.title}</strong>
        <span class="who">{providerText(service.provider)}</span>
        <p>{service.desc}</p>
        {ranked ? (
          <>
            <details>
              <summary>Price by your rank</summary>
              {/* A rank and its price are a name/value pair, so the rows are a
                  description list rather than a bullet list. */}
              <dl class="rank-prices">
                {rows.map((row) => (
                  <div
                    data-service={row.id}
                    data-rank={row.rank}
                    data-price-minor={row.amountMinor}
                  >
                    <dt>{row.rank}</dt>
                    <dd>{row.display}</dd>
                  </div>
                ))}
              </dl>
            </details>
            <p class="price">
              {varies && <span class="from">From </span>}
              <span class="money">{cheapest.display}</span> / {cheapest.unit}
              {cheapest.seats > 1 && (
                <span class="seats">for {cheapest.seats} teammates</span>
              )}
            </p>
          </>
        ) : (
          <p
            class={samePrice ? 'price same' : 'price'}
            data-service={service.id}
            data-price-minor={service.amountMinor}
          >
            <span class="money">{service.display}</span> / {service.unit}
            {service.seats > 1 && (
              <span class="seats">for {service.seats} teammates</span>
            )}
          </p>
        )}
        <a
          class="btn-sm"
          href={bookingHref(gameId, { service: service.id })}
          aria-label={`Book ${service.title}`}
        >
          Book
        </a>
      </article>
    ))}
  </div>
  <p class="price-note">{priceNote(offers, coach)}</p>
  {dated && (
    <p class="price-updated">
      Prices as of{' '}
      <time datetime={CATALOG_PRICES_UPDATED}>
        {CATALOG_PRICES_UPDATED_LABEL}
      </time>
      .
    </p>
  )}
</section>

<style>
  .price-note {
    margin-top: 18px;
    font-size: 15px;
    color: #b8abd8;
  }
  .section-intro {
    max-width: 75ch;
  }
  section[aria-labelledby='prices'] > .section-intro {
    max-width: none;
  }
  .service-name {
    display: block;
    font-size: 1.12rem;
    line-height: 1.3;
  }
</style>

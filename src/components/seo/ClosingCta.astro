---
import { gameArtSizes, gameArtSrcSet } from '../../site/game-art';
interface Props {
  heading: string;
  text: string;
  /** Second paragraph: the practical booking facts a reader (or an AI assistant
      quoting the page) needs before paying. The price line closes it. */
  extra?: string;
  href: string;
  label: string;
  price?: string;
  art?: { src: string; alt: string };
}
const { heading, text, extra, href, label, art, price } = Astro.props;
---

<section class={art ? 'closing' : 'closing no-art'} aria-labelledby="closing-h">
  {art && (
    <img
      src={art.src}
      srcset={gameArtSrcSet(art.src)}
      sizes={gameArtSizes(88)}
      alt={art.alt}
      width="88"
      height="88"
      loading="lazy"
      decoding="async"
    />
  )}
  <div>
    <h2 id="closing-h">{heading}</h2>
    <p>
      {text}
      {!extra && price && (
        <>
          {' '}
          <span class="nowrap">{price}.</span>
        </>
      )}
    </p>
    {extra && (
      <p class="closing-detail">
        {extra}
        {price && (
          <>
            {' '}
            <span class="nowrap">{price}.</span>
          </>
        )}
      </p>
    )}
  </div>
  <a class="cta" href={href} data-cta="closing">
    {label}
  </a>
</section>

---
import { gameArtSizes, gameArtSrcSet } from '../../site/game-art';
import type { HeroOffer } from '../../server/seo/hero-offer';
interface Props {
  eyebrow: string;
  h1: string;
  lead: string;
  price?: string;
  cta: { href: string; label: string };
  note?: string;
  secondary?: { href: string; label: string };
  art: { src: string; alt: string }[];
  /** The at-a-glance price range, for a hero with no offer card. */
  chip?: string;
  facts: string[];
  /**
   * The service this page sells, with its own booking button in the hero card.
   * Without it the card stays the plain at-a-glance panel.
   */
  offer?: HeroOffer;
  /** data-analytics-game on the first image (game hubs track game_viewed). */
  analyticsGame?: string;
}
const nowrapTerms = (text: string) =>
  text
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replace(/\be-girl\b/g, '<span class="nowrap">e-girl</span>');
const {
  eyebrow,
  h1,
  lead,
  price,
  cta,
  secondary,
  art,
  chip,
  facts,
  offer,
  analyticsGame,
  note,
} = Astro.props;
---

<header class="seo-hero">
  <div class="hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={nowrapTerms(h1)} />
    <p class="lead">{lead}</p>
    {price && !offer && <p class="hero-price">{price}</p>}
    {/* One primary per viewport. When the card carries its own booking button
        the left column keeps the same link as a secondary, because two filled
        buttons for one action make a reader choose between identical things. */}
    <div class="hero-actions">
      <a class={offer ? 'cta-ghost' : 'cta'} href={cta.href}>
        {cta.label}
      </a>
      {secondary && (
        <a class={offer ? 'hero-link' : 'cta-ghost'} href={secondary.href}>
          {secondary.label}
        </a>
      )}
    </div>
    {note && <p class="hero-note">{note}</p>}
  </div>
  <aside
    class={offer ? 'hero-card hero-offer' : 'hero-card'}
    aria-label={offer ? `Book ${offer.title}` : 'At a glance'}
  >
    <div class="top">
      <div class="art">
        {art.map((image, index) => (
          <img
            src={image.src}
            srcset={gameArtSrcSet(image.src)}
            sizes={gameArtSizes(120)}
            alt={image.alt}
            width="120"
            height="120"
            fetchpriority={index === 0 ? 'high' : 'auto'}
            loading="eager"
            decoding="async"
            data-analytics-game={index === 0 ? analyticsGame : undefined}
          />
        ))}
      </div>
      {offer ? (
        <div class="offer-head">
          <p class="offer-service">{offer.title}</p>
          <p class="offer-tier">{offer.tier}</p>
          <p class="offer-price">
            <span class="money">{offer.price}</span> per {offer.unit}
          </p>
        </div>
      ) : (
        chip && <p class="price-chip">{chip}</p>
      )}
    </div>
    {/* One price on the card, and it is this tier's own. The card used to
        print "Cheapest session on this page: ..." under its booking button,
        which offered a reader a different, cheaper product in the one place
        reserved for acting on this one. The cheapest session is stated once in
        the intro above the price grid (src/components/seo/Prices.astro), where
        a reader is comparing services rather than booking one. */}
    {offer && (
      <a
        class="cta offer-cta"
        href={offer.href}
        aria-label={
          offer.label === offer.labelFull ? undefined : offer.labelFull
        }
      >
        {offer.label}
      </a>
    )}
    <ul class="facts">
      {(offer ? offer.facts : facts).map((fact) => (
        <li>{fact}</li>
      ))}
    </ul>
  </aside>
</header>

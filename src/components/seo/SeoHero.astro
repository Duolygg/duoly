---
import type { HeroOffer } from '../../server/seo/hero-offer';
interface Props {
  eyebrow: string;
  h1: string;
  lead: string;
  price?: string;
  cta: { href: string; label: string };
  note?: string;
  secondary?: { href: string; label: string };
  art: { src: string; alt: string }[];
  chip?: string;
  /** What the chip price covers, so a range is never read as one price. */
  chipLabel?: string;
  facts: string[];
  /**
   * The service this page sells, with its own booking button in the hero card.
   * Without it the card stays the plain at-a-glance panel.
   */
  offer?: HeroOffer;
  /** data-analytics-game on the first image (game hubs track game_viewed). */
  analyticsGame?: string;
}
const nowrapTerms = (text: string) =>
  text
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replace(/\be-girl\b/g, '<span class="nowrap">e-girl</span>');
const {
  eyebrow,
  h1,
  lead,
  price,
  cta,
  secondary,
  art,
  chip,
  chipLabel,
  facts,
  offer,
  analyticsGame,
  note,
} = Astro.props;
---

<header class="seo-hero">
  <div class="hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1 set:html={nowrapTerms(h1)} />
    <p class="lead">{lead}</p>
    {price && <p class="hero-price">{price}</p>}
    <div class="hero-actions">
      <a class="cta" href={cta.href}>
        {cta.label}
      </a>
      {secondary && (
        <a class="cta-ghost" href={secondary.href}>
          {secondary.label}
        </a>
      )}
    </div>
    {note && <p class="hero-note">{note}</p>}
  </div>
  <aside
    class={offer ? 'hero-card hero-offer' : 'hero-card'}
    aria-label={offer ? `Book ${offer.title}` : 'At a glance'}
  >
    <div class="top">
      <div class="art">
        {art.map((image, index) => (
          <img
            src={image.src}
            alt={image.alt}
            width="120"
            height="120"
            fetchpriority={index === 0 ? 'high' : 'auto'}
            loading="eager"
            decoding="async"
            data-analytics-game={index === 0 ? analyticsGame : undefined}
          />
        ))}
      </div>
      {offer ? (
        <div class="offer-head">
          <p class="offer-service">{offer.title}</p>
          <p class="offer-tier">{offer.tier}</p>
          <p class="offer-price">
            <span class="money">{offer.price}</span> per {offer.unit}
          </p>
        </div>
      ) : (
        chip && <p class="price-chip">{chip}</p>
      )}
    </div>
    {offer && (
      <>
        <a class="cta offer-cta" href={offer.href}>
          {offer.label}
        </a>
        {/* The chip stays under the button, labelled, so the range across every
            service on the page can never be read as this service's price. */}
        {chip && (
          <p class="price-chip">
            {chipLabel ? `${chipLabel}: ` : ''}
            {chip}
          </p>
        )}
        {offer.cheapest && (
          <p class="offer-floor">
            Cheapest session: {offer.cheapest.title} at {offer.cheapest.price}{' '}
            per {offer.cheapest.unit}.
          </p>
        )}
      </>
    )}
    <ul class="facts">
      {facts.map((fact) => (
        <li>{fact}</li>
      ))}
    </ul>
  </aside>
</header>

---
/** The only icon set the profile pages draw: one arrow, one share, one heart. */
interface Props {
  name: 'arrow' | 'share' | 'heart';
}
const { name } = Astro.props;
const paths = {
  arrow: 'M2.75 8h10.5M9 3.75 13.25 8 9 12.25',
  share:
    'M8 10.25V2.5m0 0L5.25 5.25M8 2.5l2.75 2.75M3 9.25v3.25a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V9.25',
  heart:
    'M8 13.25C4.9 11.2 2.75 9.3 2.75 6.9A2.9 2.9 0 0 1 8 5.2a2.9 2.9 0 0 1 5.25 1.7c0 2.4-2.15 4.3-5.25 6.35Z',
};
---

<svg
  class="tp-ico"
  viewBox="0 0 16 16"
  width="16"
  height="16"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d={paths[name]}
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>

---
/*
 * A teammate in the directory: the shared card (still one link to the profile, so it stays one
 * tab stop and every existing check on .tp-card holds) with the directory's extra rows inside it,
 * and an action bar attached under it. The actions sit outside the link because a link may not
 * contain buttons: entry price, save, quick view and book.
 */
import type { PublicTeammateCard } from '../../contracts/teammate-profile';
import TeammateCard from './TeammateCard.astro';
import Icon from './Icon.astro';
import { bookFor, entryPrice } from '../../server/teammates/directory';
import { profileGame } from '../../server/teammates/profile-page';

interface Props {
  card: PublicTeammateCard;
  saved?: boolean;
  /** 'customer' saves in place, 'signin' sends to sign-in first, 'none' shows no heart. */
  saveMode: 'customer' | 'signin' | 'none';
  index?: number;
  extra?: boolean;
}
const { card, saved = false, saveMode, index = 0, extra = false } = Astro.props;
const price = entryPrice(card.game);
const game = profileGame(card.game);
const languages = (card.languages ?? []).slice(0, 3);
const vibes = (card.vibeTags ?? []).slice(0, 3);
---

<article
  class:list={['dc', { 'is-extra': extra }]}
  style={`--i:${Math.min(index, 12)}`}
  data-card
  data-slug={card.slug}
  data-name={card.name.toLowerCase()}
>
  <TeammateCard card={card}>
    <span class="dc-extra" slot="extra">
      {(card.gamerGirl || vibes.length > 0 || languages.length > 0) && (
        <span class="dc-tags">
          {card.gamerGirl && <span class="tp-gg-badge">Gamer Girl</span>}
          {vibes.map((v) => (
            <span class="dc-tag">{v}</span>
          ))}
          {languages.length > 0 && (
            <span class="dc-lang" title={`Speaks ${languages.join(', ')}`}>
              <svg
                viewBox="0 0 16 16"
                width="13"
                height="13"
                aria-hidden="true"
              >
                <circle
                  cx="8"
                  cy="8"
                  r="6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                ></circle>
                <path
                  d="M2 8h12M8 2c1.8 1.8 2.6 3.8 2.6 6S9.8 12.2 8 14C6.2 12.2 5.4 10.2 5.4 8S6.2 3.8 8 2Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                ></path>
              </svg>
              {languages.join(' · ')}
            </span>
          )}
        </span>
      )}
      {card.quote && (
        <span class="dc-quote">
          <span aria-hidden="true">&ldquo;</span>
          {card.quote}
        </span>
      )}
    </span>
  </TeammateCard>
  <div class="dc-bar">
    {price && (
      <p class="dc-price">
        from <strong>{price.price}</strong>
        <span>per {price.unit}</span>
      </p>
    )}
    <div class="dc-actions">
      {saveMode !== 'none' &&
        (saveMode === 'customer' ? (
          <button
            class="dc-icon dc-save"
            type="button"
            aria-pressed={saved ? 'true' : 'false'}
            aria-label={saved ? `${card.name} is saved` : `Save ${card.name}`}
            data-dc-save
          >
            <Icon name="heart" />
          </button>
        ) : (
          <a
            class="dc-icon dc-save"
            href="/?signin=1"
            aria-label={`Save ${card.name}`}
            data-dc-signin
          >
            <Icon name="heart" />
            <span class="md-visually-hidden">Save {card.name}</span>
          </a>
        ))}
      <button
        class="dc-icon dc-peek"
        type="button"
        aria-label={`Quick view of ${card.name}`}
        aria-haspopup="dialog"
        data-dc-peek
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path
            d="M1.8 8S4.2 3.5 8 3.5 14.2 8 14.2 8 11.8 12.5 8 12.5 1.8 8 1.8 8Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          ></path>
          <circle
            cx="8"
            cy="8"
            r="2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
          ></circle>
        </svg>
      </button>
      <a
        class="dc-book"
        href={bookFor(card.game)}
        data-dc-book
        aria-label={`Book ${card.name} for ${game.name}`}
      >
        Book
      </a>
    </div>
  </div>
</article>

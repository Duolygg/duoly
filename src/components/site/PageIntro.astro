---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  narrow?: boolean;
  /** Vertically and horizontally centred block for short pages such as the 404. */
  centered?: boolean;
}
const { eyebrow, title, lead, narrow = false, centered = false } = Astro.props;
---

<section class:list={['page', { narrow, centered }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</section>

<style>
  .page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 56px 24px 24px;
  }
  .page.narrow {
    max-width: 760px;
  }
  .page.centered {
    box-sizing: border-box;
    min-height: min(68vh, 640px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-bottom: 56px;
  }
  .page.centered .lead {
    margin-left: auto;
    margin-right: auto;
  }
  .eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d6bbff;
  }
  h1 {
    margin: 8px 0 0;
    font-family: 'Bricolage Grotesque', 'Bricolage Fallback', sans-serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: #fff;
  }
  .lead {
    max-width: 640px;
    margin: 14px 0 0;
    font-size: 17px;
    color: #a79dc4;
  }
  .page :global(a:not(.cta)) {
    color: #d6bbff;
    text-decoration: underline;
    text-decoration-color: rgba(214, 187, 255, 0.4);
    text-underline-offset: 3px;
  }
  .page :global(a:not(.cta):hover) {
    color: #fff;
  }
  .page :global(.cta) {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    margin-top: 24px;
    padding: 0 20px;
    border-radius: 13px;
    background: #f3eeff;
    color: #17092e;
    font-weight: 700;
    text-decoration: none;
  }
  .page :global(.card) {
    margin-top: 24px;
    padding: 24px;
    border-radius: 22px;
    background: #120b22;
    border: 1px solid rgba(214, 187, 255, 0.14);
  }
  @media (max-width: 480px) {
    .page {
      padding: 40px 16px 16px;
    }
  }
</style>

---
import { CONSENT_COOKIE, CONSENT_DAYS } from '../../contracts/consent';
---

{/* An <aside> rather than a <div>: the banner is complementary chrome that follows
    the page content in the DOM, and text extractors (Readability-style parsers,
    citability scorers, LLM crawlers) drop `aside` while they fold a trailing `div`
    into the last content section. ARIA does not allow role="dialog" on an aside
    (Lighthouse "ARIA role should be appropriate for the element"), so the dialog
    role and name sit on an unstyled inner wrapper. The outer aside keeps the
    class and the data hook, so the look and the scripts are unchanged.

    The banner is hidden by this component's own CSS rather than by the `hidden` attribute, and
    `html[data-cookie-prompt]` (set from the cookie by a synchronous script in the layout head,
    before any of <body> is parsed) decides whether it is up. The attribute used to be removed by
    the script below, which on a throttled phone painted the paragraph 1.4 s after first paint and
    made it the largest contentful paint; now the first style pass already has the answer. Both
    states keep the `hidden` attribute's semantics for a visitor with no JavaScript and for one
    who has already chosen: display:none is not rendered, not focusable and not in the
    accessibility tree. */}
<aside class="cookie-banner" data-cookie-banner>
  <div role="dialog" aria-live="polite" aria-label="Cookie settings">
    <p>
      We use necessary cookies to run the site. Optional analytics help us
      improve it, marketing measures ads, and a creator cookie remembers whose
      link you used for 30 days. You choose which to allow.{' '}
      <a href="/privacy#cookies">Privacy</a>
    </p>
    <div class="cookie-actions">
      <button type="button" data-consent="necessary">
        Only necessary
      </button>
      <button
        type="button"
        data-customise
        aria-expanded="false"
        aria-controls="cookie-purposes"
      >
        Customise
      </button>
      <button type="button" data-consent="all">
        Accept all
      </button>
    </div>
    <div id="cookie-purposes" data-cookie-purposes hidden>
      <label for="cookie-analytics">
        <input
          id="cookie-analytics"
          type="checkbox"
          aria-describedby="cookie-analytics-help"
        />
        Analytics
      </label>
      <p id="cookie-analytics-help">
        Helps us see which pages and steps work, using PostHog hosted in the EU.
        Session recordings hide what you type.
      </p>
      <label for="cookie-marketing">
        <input
          id="cookie-marketing"
          type="checkbox"
          aria-describedby="cookie-marketing-help"
        />
        Marketing
      </label>
      <p id="cookie-marketing-help">
        Lets us tell Meta and Google Ads when a visit from their ads led to a
        booking, so we can measure and improve our ads. No ad pixels on the
        site, we send it from our servers.
      </p>
      <label for="cookie-referral">
        <input
          id="cookie-referral"
          type="checkbox"
          aria-describedby="cookie-referral-help"
        />
        Creator link
      </label>
      <p id="cookie-referral-help">
        Remembers the creator whose link you used for 30 days so they get credit
        for your first order.
      </p>
      <div class="cookie-actions">
        <button type="button" data-save-choices>
          Save choices
        </button>
      </div>
    </div>
  </div>
</aside>
<script
  is:inline
  define:vars={{ cookieName: CONSENT_COOKIE, days: CONSENT_DAYS }}
>
  (() => {
    const banner = document.querySelector('[data-cookie-banner]');
    if (!banner) return;
    const purposes = banner.querySelector('[data-cookie-purposes]');
    const customise = banner.querySelector('[data-customise]');
    const analytics = banner.querySelector('#cookie-analytics');
    const marketing = banner.querySelector('#cookie-marketing');
    const referral = banner.querySelector('#cookie-referral');
    const read = () =>
      document.cookie
        .split(';')
        .map((c) => c.trim())
        .find((c) => c.startsWith(cookieName + '='))
        ?.slice(cookieName.length + 1);
    // Same strict wire format and legacy mapping as contracts/consent.ts.
    const parse = (value) => {
      if (value === 'all' || value === 'necessary')
        return {
          version: 2,
          analytics: false,
          marketing: false,
          referral: value === 'all',
        };
      const match = /^v2\.a([01])\.m([01])\.r([01])$/.exec(value || '');
      return match
        ? {
            version: 2,
            analytics: match[1] === '1',
            marketing: match[2] === '1',
            referral: match[3] === '1',
          }
        : null;
    };
    window.__duolyConsent = parse(read());
    // One switch for the banner, shared with the head script: an attribute on <html> so the
    // first style pass can read it before the banner element exists.
    const root = document.documentElement;
    const open = (up) => {
      if (up === root.hasAttribute('data-cookie-prompt')) return;
      if (up) root.setAttribute('data-cookie-prompt', '');
      else root.removeAttribute('data-cookie-prompt');
    };
    const show = (settings = false) => {
      const state = parse(read());
      analytics.checked = state?.analytics ?? false;
      marketing.checked = state?.marketing ?? false;
      referral.checked = state?.referral ?? false;
      purposes.hidden = !settings;
      customise.setAttribute('aria-expanded', String(settings));
      open(true);
    };
    // The head script already put the banner up for a visitor who has not chosen; this fills in
    // the category boxes for one who has an old or malformed value.
    if (!/^v2\.a[01]\.m[01]\.r[01]$/.test(read() || '')) show();
    if (location.hash === '#cookie-settings') show(true);
    addEventListener('hashchange', () => {
      if (location.hash === '#cookie-settings') show(true);
    });
    document
      .querySelectorAll('[data-cookie-settings], a[href$="#cookie-settings"]')
      .forEach((el) =>
        el.addEventListener('click', (event) => {
          event.preventDefault();
          show(true);
          analytics.focus();
        }),
      );
    customise.addEventListener('click', () => {
      purposes.hidden = false;
      customise.setAttribute('aria-expanded', 'true');
      analytics.focus();
    });
    const save = (state) => {
      const value =
        'v2.a' +
        (state.analytics ? '1' : '0') +
        '.m' +
        (state.marketing ? '1' : '0') +
        '.r' +
        (state.referral ? '1' : '0');
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      document.cookie =
        cookieName +
        '=' +
        value +
        '; Path=/; Max-Age=' +
        days * 86400 +
        '; SameSite=Lax' +
        secure;
      open(false);
      window.__duolyConsent = state;
      window.dispatchEvent(new CustomEvent('duoly:consent', { detail: state }));
      // Apply the referral choice immediately without navigating away.
      fetch(location.href, {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { accept: 'text/html' },
      }).catch(() => {});
    };
    banner.querySelectorAll('[data-consent]').forEach((button) =>
      button.addEventListener('click', () => {
        const allow = button.getAttribute('data-consent') === 'all';
        save({
          version: 2,
          analytics: allow,
          marketing: allow,
          referral: allow,
        });
      }),
    );
    banner.querySelector('[data-save-choices]').addEventListener('click', () =>
      save({
        version: 2,
        analytics: analytics.checked,
        marketing: marketing.checked,
        referral: referral.checked,
      }),
    );
  })();
</script>

<style>
  /* Not rendered until the head script says a choice is missing, or the script below reopens
     the settings. Hiding the banner here rather than with the `hidden` attribute is what lets
     the first paint already show its final state. */
  .cookie-banner {
    display: none;
    position: fixed;
    z-index: 60;
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: 560px;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    box-sizing: border-box;
    margin-inline: auto;
    padding: 18px 20px;
    border-radius: 16px;
    background: #120b22;
    border: 1px solid rgba(196, 170, 255, 0.14);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
    color: #d9d2ee;
    font-size: 14px;
    line-height: 1.55;
  }
  :global(html[data-cookie-prompt]) .cookie-banner {
    display: block;
  }
  .cookie-banner [hidden] {
    display: none;
  }
  .cookie-banner p {
    margin: 0 0 14px;
  }
  .cookie-banner a {
    color: #c4aaff;
  }
  .cookie-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .cookie-actions button {
    flex: 1 1 130px;
    font: inherit;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 12px;
    border: 1px solid rgba(196, 170, 255, 0.24);
    background: #1b1230;
    color: #fff;
    cursor: pointer;
  }
  @media (max-width: 480px) {
    .cookie-actions button {
      flex-basis: 100%;
    }
  }
  .cookie-banner :focus-visible {
    outline: 2px solid #c4aaff;
    outline-offset: 2px;
  }
  [data-cookie-purposes] {
    margin-top: 18px;
  }
  .cookie-banner label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }
  .cookie-banner input {
    width: 20px;
    height: 20px;
    accent-color: #c4aaff;
  }
</style>

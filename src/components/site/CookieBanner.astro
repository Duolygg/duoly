---
// The site's cookie banner (owner decision 2026-10-27). It asks once, on the first visit,
// before any optional cookie is set. "Accept all" allows the creator referral cookie
// (ledger #28); "Only necessary" refuses it and removes one that exists. The choice is kept
// in the duoly-consent cookie and can be changed from "Cookie settings" in the footer and
// on the privacy page. Both buttons are equal, so refusing is as easy as accepting.
import { CONSENT_COOKIE, CONSENT_DAYS } from '../../contracts/consent';
---

<div
  class="cookie-banner"
  data-cookie-banner
  role="dialog"
  aria-live="polite"
  aria-label="Cookie settings"
  hidden
>
  <p>
    We use the cookies the site needs to work. If you came here through a
    creator's link, we would also like to remember that creator for 30 days so
    they get credit for your first order. That cookie is optional.
    <a href="/privacy#cookies">Privacy</a>
  </p>
  <div class="cookie-actions">
    <button type="button" data-consent="necessary">
      Only necessary
    </button>
    <button type="button" data-consent="all">
      Accept all
    </button>
  </div>
</div>
<script is:inline define:vars={{ name: CONSENT_COOKIE, days: CONSENT_DAYS }}>
  (() => {
    const banner = document.querySelector('[data-cookie-banner]');
    if (!banner) return;
    const current = document.cookie
      .split('; ')
      .find((c) => c.startsWith(name + '='));
    const show = () => {
      banner.hidden = false;
    };
    if (!current || location.hash === '#cookie-settings') show();
    addEventListener('hashchange', () => {
      if (location.hash === '#cookie-settings') show();
    });
    document
      .querySelectorAll('[data-cookie-settings], a[href$="#cookie-settings"]')
      .forEach((el) =>
        el.addEventListener('click', (event) => {
          event.preventDefault();
          show();
        }),
      );
    banner.querySelectorAll('[data-consent]').forEach((button) =>
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-consent');
        const secure = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie =
          name +
          '=' +
          value +
          '; Path=/; Max-Age=' +
          days * 86400 +
          '; SameSite=Lax' +
          secure;
        banner.hidden = true;
        // Let the server apply the choice now: set the referral cookie from this
        // page's ?ref= link, or remove an existing one.
        fetch(location.href, {
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { accept: 'text/html' },
        }).catch(() => {});
      }),
    );
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    z-index: 60;
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: 560px;
    margin-inline: auto;
    padding: 18px 20px;
    border-radius: 16px;
    background: #120b22;
    border: 1px solid rgba(196, 170, 255, 0.14);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
    color: #d9d2ee;
    font-size: 14px;
    line-height: 1.55;
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-banner p {
    margin: 0 0 14px;
  }
  .cookie-banner a {
    color: #c4aaff;
  }
  .cookie-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }
  .cookie-actions button {
    font: inherit;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 12px;
    border: 1px solid rgba(196, 170, 255, 0.24);
    background: #1b1230;
    color: #fff;
    cursor: pointer;
  }
  .cookie-actions button:focus-visible {
    outline: 2px solid #c4aaff;
    outline-offset: 2px;
  }
</style>

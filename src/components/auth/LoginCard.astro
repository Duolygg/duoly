---
import type { LoginProviders } from '../../contracts/account';
interface Props {
  csrf: string;
  providers: LoginProviders;
  register: boolean;
  signup: boolean;
  error?: string;
  notice?: string;
  registered?: boolean;
  prefill?: string | undefined;
}
const {
  csrf,
  providers,
  register,
  signup,
  error,
  notice,
  registered = false,
  prefill,
} = Astro.props;
const unconfigured =
  !providers.google && !providers.discord && !providers.email;
---

<section
  class:list={['login-card dl-auth', { 'is-registered': registered }]}
  aria-labelledby="login-heading"
>
  <div class="dl-auth-side brand-panel" aria-hidden="true">
    <img src="/assets/brand/logo-wordmark.webp" alt="" width="96" height="36" />
    <img
      class="mascots"
      src="/assets/brand/logo-mascots.webp"
      alt=""
      width="250"
      height="158"
    />
    <p>
      Never solo
      <br />
      <span>queue again.</span>
    </p>
  </div>
  <div class="login-content">
    <h1 id="login-heading">
      {register ? 'Create your Duoly account' : 'Sign in to Duoly'}
    </h1>
    <p class="intro">Your account, your teammates.</p>
    {unconfigured && (
      <p class="notice">Account sign-in is not configured yet.</p>
    )}
    {register && !signup && (
      <p class="notice">Registration is currently closed.</p>
    )}
    {error && (
      <p class="error" id="login-error" role="alert">
        {error}
      </p>
    )}
    {registered && (
      <div class="registered" role="status">
        <span class="reg-badge" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <circle
              cx="10"
              cy="8"
              r="4"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M3 20c0-3.3 3.1-6 7-6 1.4 0 2.7.3 3.8.9"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
            <path
              class="reg-check"
              d="m15 18 2.2 2.2L21.5 16"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
        <div class="reg-text">
          <strong>This email is already registered</strong>
          <span>
            Welcome back! Sign in below, or continue with Google or Discord if
            that’s how you joined.
          </span>
        </div>
      </div>
    )}
    {notice && (
      <p class="notice" role="status">
        {notice}
      </p>
    )}
    {!providers.google && (
      <p class="delivery" id="google-availability">
        Google sign-in is not connected yet.
      </p>
    )}
    <div class="providers">
      <form method="POST" action="/auth/oauth">
        <input type="hidden" name="csrf" value={csrf} />
        <input type="hidden" name="provider" value="google" />
        <button
          class="provider"
          type="submit"
          disabled={!providers.google}
          aria-describedby={
            !providers.google ? 'google-availability' : undefined
          }
        >
          Continue with Google
        </button>
      </form>
      <form method="POST" action="/auth/oauth">
        <input type="hidden" name="csrf" value={csrf} />
        <input type="hidden" name="provider" value="discord" />
        <button
          class="provider discord"
          type="submit"
          disabled={!providers.discord}
        >
          Continue with Discord
        </button>
      </form>
    </div>
    <p class="divider">or use email</p>
    <form
      method="POST"
      action={register ? '/auth/password/register' : '/auth/password/login'}
      aria-describedby={error ? 'login-error' : undefined}
    >
      <input type="hidden" name="csrf" value={csrf} />
      <label for="signin-email">Email address</label>
      <div class="dl-field">
        <input
          id="signin-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          value={prefill}
          required
          disabled={!providers.email || (register && !signup)}
        />
      </div>
      <label for="signin-password">Password</label>
      <div class="dl-field">
        <input
          id="signin-password"
          name="password"
          type="password"
          autocomplete={register ? 'new-password' : 'current-password'}
          autofocus={registered}
          minlength="8"
          maxlength="128"
          required
          disabled={!providers.email || (register && !signup)}
        />
      </div>
      <button
        class="primary"
        type="submit"
        disabled={!providers.email || (register && !signup)}
      >
        {register ? 'Create account' : 'Sign in with email'}
      </button>
    </form>
    <p class="delivery">
      {register
        ? 'Use at least 8 characters. Confirm your email before signing in.'
        : 'Keep your password private. Duoly teammates never need access to your account.'}
    </p>
    <a class="back-link" href={register ? '/login' : '/login?mode=register'}>
      {register ? 'Already have an account? Sign in' : 'Create an account'}
    </a>
  </div>
</section>
<style>
  .login-card {
    max-width: 880px;
    margin: 48px auto;
    border-radius: 30px;
    overflow: hidden;
    background: #120b22;
    border: 1px solid rgba(214, 187, 255, 0.16);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.4);
  }
  .brand-panel {
    display: flex;
    flex-direction: column;
    padding: 32px;
    background:
      radial-gradient(
        120% 80% at 20% 0%,
        rgba(240, 166, 255, 0.16),
        transparent 60%
      ),
      radial-gradient(
        90% 70% at 100% 100%,
        rgba(214, 187, 255, 0.14),
        transparent 60%
      ),
      #1b1033;
    border-right: 1px solid rgba(214, 187, 255, 0.12);
  }
  .mascots {
    width: 100%;
    max-width: 250px;
    height: auto;
    margin: auto;
    padding: 32px 0;
  }
  .brand-panel p {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0;
  }
  .brand-panel span {
    color: #d6bbff;
  }
  .login-content {
    padding: 32px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  h1 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(26px, 4vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0;
  }
  .intro {
    color: #a79dc4;
    margin: 10px 0 24px;
  }
  .providers {
    display: grid;
    gap: 10px;
  }
  form {
    margin: 0;
  }
  button {
    width: 100%;
    min-height: 48px;
    padding: 12px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 700;
  }
  .provider {
    background: #f3eeff;
    border: 1px solid transparent;
    color: #17092e;
  }
  .discord {
    background: #5865f2;
    color: #fff;
  }
  .primary {
    background: #d6bbff;
    color: #17092e;
    border: none;
    margin-top: 14px;
  }
  button:disabled {
    opacity: 0.5;
  }
  button:disabled:hover {
    filter: none;
  }
  label {
    display: block;
    margin: 12px 0 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #a79dc4;
    font-size: 13px;
    margin: 22px 0;
  }
  .divider::before,
  .divider::after {
    content: '';
    height: 1px;
    flex: 1;
    background: rgba(196, 170, 255, 0.16);
  }
  .notice,
  .error {
    padding: 12px;
    border-radius: 12px;
    border: 1px solid rgba(214, 187, 255, 0.25);
    background: #1b1033;
  }
  .error {
    color: #ffb2be;
    border-color: rgba(255, 138, 155, 0.4);
  }
  .delivery {
    color: #a79dc4;
    font-size: 13px;
    margin: 14px 0 0;
  }
  .back-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
  }
  .registered {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 18px;
    padding: 16px 18px 16px 20px;
    border-radius: 16px;
    color: #f3eeff;
    background:
      linear-gradient(#1b1033, #1b1033) padding-box,
      linear-gradient(
          110deg,
          rgba(214, 187, 255, 0.25) 0%,
          #f0a6ff 35%,
          #d6bbff 50%,
          rgba(214, 187, 255, 0.25) 70%
        )
        border-box;
    background-size:
      100% 100%,
      250% 100%;
    border: 1.5px solid transparent;
    overflow: hidden;
    animation:
      reg-in 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.25) both,
      reg-border 2.4s 0.3s ease-in-out 2;
  }
  .registered::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 30%,
      rgba(240, 166, 255, 0.18) 50%,
      transparent 70%
    );
    transform: translateX(-120%);
    animation: reg-shine 1.1s 0.45s ease-out both;
    pointer-events: none;
  }
  .reg-badge {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #17092e;
    background: linear-gradient(135deg, #f0a6ff, #d6bbff);
    animation: reg-pop 0.6s 0.15s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  .reg-badge::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid rgba(240, 166, 255, 0.6);
    opacity: 0;
    animation: reg-ring 1.6s 0.6s ease-out 2 both;
  }
  .reg-check {
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
    animation: reg-draw 0.45s 0.55s ease-out forwards;
  }
  .reg-text {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .reg-text strong {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 16px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .reg-text span {
    font-size: 13.5px;
    color: #c9bfe6;
    line-height: 1.45;
  }
  .is-registered {
    animation: reg-nudge 0.5s 0.1s ease-in-out both;
  }
  .is-registered #signin-email {
    animation: reg-field 1.6s 0.7s ease-out both;
  }
  @keyframes reg-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes reg-border {
    0%,
    100% {
      background-position:
        0 0,
        100% 0;
    }
    50% {
      background-position:
        0 0,
        0% 0;
    }
  }
  @keyframes reg-shine {
    to {
      transform: translateX(120%);
    }
  }
  @keyframes reg-pop {
    from {
      transform: scale(0.3) rotate(-25deg);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes reg-ring {
    from {
      transform: scale(0.85);
      opacity: 1;
    }
    to {
      transform: scale(1.35);
      opacity: 0;
    }
  }
  @keyframes reg-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes reg-nudge {
    0%,
    100% {
      transform: none;
    }
    20% {
      transform: translateX(-7px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(2px);
    }
  }
  @keyframes reg-field {
    0% {
      box-shadow: 0 0 0 0 rgba(240, 166, 255, 0.55);
    }
    100% {
      box-shadow: 0 0 0 10px rgba(240, 166, 255, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .registered,
    .registered::after,
    .reg-badge,
    .reg-badge::before,
    .reg-check,
    .is-registered,
    .is-registered #signin-email {
      animation: none;
    }
    .reg-check {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 920px) {
    .login-card {
      margin: 32px 16px;
    }
  }
  @media (max-width: 480px) {
    .login-content {
      padding: 24px 20px;
    }
    .login-card {
      border-radius: 24px;
    }
  }
</style>

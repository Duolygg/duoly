---
import type { LoginProviders } from '../../contracts/account';
interface Props {
  csrf: string;
  providers: LoginProviders;
  register: boolean;
  signup: boolean;
  error?: string;
  notice?: string;
  registered?: boolean;
  prefill?: string | undefined;
}
const {
  csrf,
  providers,
  register,
  signup,
  error,
  notice,
  registered = false,
  prefill,
} = Astro.props;
const perks = [
  'Matched in under 2 minutes',
  'Balance and favourite teammates saved',
  'Your own dashboard to track the climb',
];
const unconfigured =
  !providers.google && !providers.discord && !providers.email;
---

<section
  class:list={['login-card dl-auth', { 'is-registered': registered }]}
  aria-labelledby="login-heading"
>
  <div class="dl-auth-side brand-panel" aria-hidden="true">
    <img src="/assets/brand/logo-wordmark.webp" alt="" width="96" height="36" />
    <div class="mascot-wrap">
      <img
        class="mascots"
        src="/assets/brand/logo-mascots.webp"
        alt=""
        width="250"
        height="158"
      />
    </div>
    <p class="tagline">
      Never solo
      <br />
      <span>queue again.</span>
    </p>
    <ul class="perks">
      {perks.map((perk) => (
        <li>
          <span class="tick">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#5EEAA8"
              stroke-width="3.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 6L9 17l-5-5"></path>
            </svg>
          </span>
          {perk}
        </li>
      ))}
    </ul>
    <div class="reviews">
      <span class="avatars">
        <img src="/assets/avatars/avatar-1.png" alt="" width="30" height="30" />
        <img src="/assets/avatars/avatar-2.png" alt="" width="30" height="30" />
        <img src="/assets/avatars/avatar-3.png" alt="" width="30" height="30" />
      </span>
      <span class="review-text">
        <strong>★ 4.9 / 5</strong>
        <span>from 38k reviews</span>
      </span>
    </div>
  </div>
  <div class="login-content">
    <nav class="mode-tabs" aria-label="Account">
      <a href="/login" aria-current={register ? undefined : 'page'}>
        Log in
      </a>
      <a
        href="/login?mode=register"
        aria-current={register ? 'page' : undefined}
      >
        Create account
      </a>
    </nav>
    <h1 id="login-heading">
      {register ? 'Create your account' : 'Welcome back'}
    </h1>
    <p class="intro">Your account, your teammates.</p>
    {unconfigured && (
      <p class="notice">Account sign-in is not configured yet.</p>
    )}
    {register && !signup && (
      <p class="notice">Registration is currently closed.</p>
    )}
    {error && (
      <p class="error" id="login-error" role="alert">
        {error}
      </p>
    )}
    {registered && (
      <div class="registered" role="status">
        <span class="reg-badge" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <circle
              cx="10"
              cy="8"
              r="4"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M3 20c0-3.3 3.1-6 7-6 1.4 0 2.7.3 3.8.9"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
            <path
              class="reg-check"
              d="m15 18 2.2 2.2L21.5 16"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
        <div class="reg-text">
          <strong>This email is already registered</strong>
          <span>
            Welcome back! Sign in below, or continue with Google or Discord if
            that’s how you joined.
          </span>
        </div>
      </div>
    )}
    {notice && (
      <p class="notice" role="status">
        {notice}
      </p>
    )}
    <div class="providers">
      <form method="POST" action="/auth/oauth">
        <input type="hidden" name="csrf" value={csrf} />
        <input type="hidden" name="provider" value="discord" />
        <button
          class="provider discord"
          type="submit"
          disabled={!providers.discord}
        >
          <img
            src="/assets/social/discord-white.png"
            alt=""
            width="22"
            height="17"
          />
          Discord
        </button>
      </form>
      <form method="POST" action="/auth/oauth">
        <input type="hidden" name="csrf" value={csrf} />
        <input type="hidden" name="provider" value="google" />
        <button
          class="provider google"
          type="submit"
          disabled={!providers.google}
          aria-describedby={
            !providers.google ? 'google-availability' : undefined
          }
        >
          <img
            src="/assets/social/google-g.png"
            alt=""
            width="18"
            height="19"
          />
          Google
        </button>
      </form>
    </div>
    {!providers.google && (
      <p class="delivery" id="google-availability">
        Google sign-in is not connected yet.
      </p>
    )}
    <p class="divider">or with email</p>
    <form
      class="email-form"
      method="POST"
      action={register ? '/auth/password/register' : '/auth/password/login'}
      aria-describedby={error ? 'login-error' : undefined}
    >
      <input type="hidden" name="csrf" value={csrf} />
      <label class="dl-field" for="signin-email">
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="5" width="18" height="14" rx="3"></rect>
          <path d="M3 7l9 6 9-6"></path>
        </svg>
        <span class="sr-only">Email address</span>
        <input
          id="signin-email"
          name="email"
          type="email"
          placeholder="you@email.com"
          autocomplete="email"
          maxlength="254"
          value={prefill}
          required
          disabled={!providers.email || (register && !signup)}
        />
      </label>
      <label class="dl-field" for="signin-password">
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4" y="10" width="16" height="11" rx="3"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
        </svg>
        <span class="sr-only">Password</span>
        <input
          id="signin-password"
          name="password"
          type="password"
          placeholder="Password (8+ characters)"
          autocomplete={register ? 'new-password' : 'current-password'}
          autofocus={registered}
          minlength="8"
          maxlength="128"
          required
          disabled={!providers.email || (register && !signup)}
        />
      </label>
      <button
        class="primary"
        type="submit"
        disabled={!providers.email || (register && !signup)}
      >
        {register ? 'Create account' : 'Log in'}
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="M13 6l6 6-6 6"></path>
        </svg>
      </button>
    </form>
    <p class="switch">
      {register ? 'Already have an account?' : 'New to Duoly?'}{' '}
      <a href={register ? '/login' : '/login?mode=register'}>
        {register ? 'Log in' : 'Create an account'}
      </a>
    </p>
    <p class="legal">
      By continuing you agree to our <a href="/terms">Terms</a> and{' '}
      <a href="/privacy">Privacy Policy</a>.
    </p>
  </div>
</section>
<style>
  .login-card {
    max-width: 880px;
    margin: 48px auto;
    border-radius: 30px;
    overflow: hidden;
    background: #120b22;
    border: 1px solid rgba(214, 187, 255, 0.16);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.7);
    animation: dlpop 0.24s ease-out;
  }
  .brand-panel {
    display: flex;
    flex-direction: column;
    padding: 32px;
    background:
      radial-gradient(
        120% 80% at 20% 0%,
        rgba(240, 166, 255, 0.16),
        transparent 60%
      ),
      radial-gradient(
        90% 70% at 100% 100%,
        rgba(214, 187, 255, 0.14),
        transparent 60%
      ),
      #1b1033;
    border-right: 1px solid rgba(214, 187, 255, 0.12);
  }
  .brand-panel > img {
    width: 96px;
    height: 36px;
    display: block;
  }
  .mascot-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 0;
  }
  .mascots {
    width: 100%;
    max-width: 250px;
    height: auto;
    display: block;
    animation: dlfloat 6s ease-in-out infinite;
  }
  .tagline {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0;
  }
  .tagline span {
    color: #d6bbff;
  }
  .perks {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 14px;
    color: #cfc4ea;
  }
  .perks li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tick {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(94, 234, 168, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .reviews {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(9, 4, 20, 0.5);
    border: 1px solid rgba(196, 170, 255, 0.12);
  }
  .avatars {
    display: flex;
  }
  .avatars img {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px #1b1033;
  }
  .avatars img + img {
    margin-left: -8px;
  }
  .review-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .review-text strong {
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
  }
  .review-text span {
    font-size: 12px;
    color: #a79dc4;
  }
  .login-content {
    padding: 32px 32px 26px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .mode-tabs {
    display: inline-flex;
    gap: 2px;
    padding: 4px;
    border-radius: 14px;
    background: #090414;
    border: 1px solid rgba(196, 170, 255, 0.1);
  }
  .mode-tabs a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    color: #a79dc4;
    text-decoration: none;
  }
  .mode-tabs a[aria-current='page'] {
    background: #f3eeff;
    color: #17092e;
  }
  h1 {
    margin: 22px 0 0;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .intro {
    margin: 8px 0 18px;
    font-size: 14.5px;
    color: #a79dc4;
  }
  .providers {
    margin-top: 22px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  form {
    margin: 0;
  }
  .provider {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 50px;
    border-radius: 14px;
    border: none;
    font-size: 15px;
    font-weight: 600;
  }
  .discord {
    background: #5865f2;
    color: #fff;
  }
  .google {
    background: #fff;
    color: #1f1f1f;
  }
  .email-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 54px;
    margin-top: 2px;
    border-radius: 14px;
    border: none;
    background: #d6bbff;
    color: #17092e;
    font-size: 15.5px;
    font-weight: 700;
  }
  button:disabled {
    opacity: 0.5;
  }
  button:disabled:hover {
    filter: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0 16px;
    font-size: 12.5px;
    color: #6a6086;
  }
  .divider::before,
  .divider::after {
    content: '';
    height: 1px;
    flex: 1;
    background: rgba(196, 170, 255, 0.12);
  }
  .notice,
  .error {
    margin: 0 0 12px;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 13.5px;
    background: rgba(240, 166, 255, 0.1);
    border: 1px solid rgba(240, 166, 255, 0.28);
    color: #f7d6ff;
  }
  .error {
    color: #ffb2be;
    background: rgba(255, 138, 155, 0.08);
    border-color: rgba(255, 138, 155, 0.4);
  }
  .delivery {
    color: #a79dc4;
    font-size: 13px;
    margin: 10px 0 0;
  }
  .switch {
    margin: 16px 0 0;
    text-align: center;
    font-size: 14px;
    color: #a79dc4;
  }
  .switch a {
    color: #d6bbff;
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .legal {
    margin: 12px 0 0;
    text-align: center;
    font-size: 12px;
    line-height: 1.5;
    color: #6a6086;
  }
  .registered {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 18px;
    padding: 16px 18px 16px 20px;
    border-radius: 16px;
    color: #f3eeff;
    background:
      linear-gradient(#1b1033, #1b1033) padding-box,
      linear-gradient(
          110deg,
          rgba(214, 187, 255, 0.25) 0%,
          #f0a6ff 35%,
          #d6bbff 50%,
          rgba(214, 187, 255, 0.25) 70%
        )
        border-box;
    background-size:
      100% 100%,
      250% 100%;
    border: 1.5px solid transparent;
    overflow: hidden;
    animation:
      reg-in 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.25) both,
      reg-border 2.4s 0.3s ease-in-out 2;
  }
  .registered::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 30%,
      rgba(240, 166, 255, 0.18) 50%,
      transparent 70%
    );
    transform: translateX(-120%);
    animation: reg-shine 1.1s 0.45s ease-out both;
    pointer-events: none;
  }
  .reg-badge {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #17092e;
    background: linear-gradient(135deg, #f0a6ff, #d6bbff);
    animation: reg-pop 0.6s 0.15s cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  .reg-badge::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid rgba(240, 166, 255, 0.6);
    opacity: 0;
    animation: reg-ring 1.6s 0.6s ease-out 2 both;
  }
  .reg-check {
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
    animation: reg-draw 0.45s 0.55s ease-out forwards;
  }
  .reg-text {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .reg-text strong {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 16px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .reg-text span {
    font-size: 13.5px;
    color: #c9bfe6;
    line-height: 1.45;
  }
  .is-registered {
    animation: reg-nudge 0.5s 0.1s ease-in-out both;
  }
  .is-registered #signin-email {
    animation: reg-field 1.6s 0.7s ease-out both;
  }
  @keyframes reg-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes reg-border {
    0%,
    100% {
      background-position:
        0 0,
        100% 0;
    }
    50% {
      background-position:
        0 0,
        0% 0;
    }
  }
  @keyframes reg-shine {
    to {
      transform: translateX(120%);
    }
  }
  @keyframes reg-pop {
    from {
      transform: scale(0.3) rotate(-25deg);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes reg-ring {
    from {
      transform: scale(0.85);
      opacity: 1;
    }
    to {
      transform: scale(1.35);
      opacity: 0;
    }
  }
  @keyframes reg-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes reg-nudge {
    0%,
    100% {
      transform: none;
    }
    20% {
      transform: translateX(-7px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(2px);
    }
  }
  @keyframes reg-field {
    0% {
      box-shadow: 0 0 0 0 rgba(240, 166, 255, 0.55);
    }
    100% {
      box-shadow: 0 0 0 10px rgba(240, 166, 255, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .registered,
    .registered::after,
    .reg-badge,
    .reg-badge::before,
    .reg-check,
    .is-registered,
    .is-registered #signin-email {
      animation: none;
    }
    .reg-check {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 920px) {
    .login-card {
      margin: 32px 16px;
    }
  }
  @media (max-width: 480px) {
    .login-content {
      padding: 24px 20px;
    }
    .login-card {
      border-radius: 24px;
    }
  }
</style>
